# RmlUi's private FreeType library needs the same OT-SVG renderer as classic text.
# No renderer is copied into the MIT dependency; this is a narrow application hook.
set(_source "${RMLUI_SOURCE_DIR}/Source/Core/FontEngineDefault/FreeTypeInterface.cpp")
file(SHA256 "${_source}" _before)
if(_before STREQUAL "8f9062468b3a1e5e48516979d42b5915a51906a2572784d76eefa4c77e993d1c")
  return()
endif()
if(NOT _before STREQUAL "a02c816ddaf2a8619b6aa45629cd7f7ef5c0913e54f9bb374d4c7287a74f86d5")
  message(FATAL_ERROR "RmlUi SVG hook requires the pinned 6.3 FreeType source")
endif()
file(READ "${_source}" _text)
set(_anchor "static FT_Library ft_library = nullptr;")
string(FIND "${_text}" "${_anchor}" _found)
if(_found LESS 0)
  message(FATAL_ERROR "Pinned RmlUi FreeType application hook no longer matches")
endif()
string(REPLACE "#include FT_FREETYPE_H" "#include FT_FREETYPE_H\n#include FT_MODULE_H" _text "${_text}")
string(REPLACE "${_anchor}" "${_anchor}\n\nextern \"C\" bool slRmlSetSvgHooks(void* hooks)\n{\n    return ft_library && FT_Property_Set(ft_library, \"ot-svg\", \"svg-hooks\", hooks) == 0;\n}\n" _text "${_text}")
file(WRITE "${_source}" "${_text}")
file(SHA256 "${_source}" _after)
if(NOT _after STREQUAL "8f9062468b3a1e5e48516979d42b5915a51906a2572784d76eefa4c77e993d1c")
  message(FATAL_ERROR "Unexpected RmlUi SVG hook output")
endif()
