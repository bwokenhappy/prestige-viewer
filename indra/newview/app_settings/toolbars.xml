<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<!-- Prestige: Firestorm-style bottom bar (icons only), fewer side buttons -->
<toolbars>
  <bottom_toolbar
    button_display_mode="icons_only">
    <command name="chat"/>
    <command name="speak"/>
    <command name="move"/>
    <command name="view"/>
    <command name="people"/>
    <command name="appearance"/>
    <command name="search"/>
    <command name="map"/>
    <command name="minimap"/>
    <command name="snapshot"/>
    <command name="photo_studio"/>
    <command name="weather"/>
    <command name="inventory"/>
    <command name="ao"/>
    <command name="quick_prefs"/>
  </bottom_toolbar>
  <left_toolbar
    button_display_mode="icons_only_small">
    <command name="avatar"/>
    <command name="profile"/>
    <command name="places"/>
    <command name="destinations"/>
    <command name="myenvironments"/>
    <command name="stats"/>
    <command name="performance"/>
    <command name="lightbox"/>
  </left_toolbar>
  <right_toolbar
    button_display_mode="icons_only">
  </right_toolbar>
</toolbars>
