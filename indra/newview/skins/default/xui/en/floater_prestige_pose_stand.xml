<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<floater
 positioning="cascading"
 save_rect="true"
 can_resize="false"
 height="96"
 width="280"
 layout="topleft"
 name="prestige_pose_stand"
 single_instance="true"
 title="Pose stand">
    <text
     follows="left|top"
     height="16"
     layout="topleft"
     left="10"
     name="pose_label"
     top="26"
     width="40">
        Pose:
    </text>
    <combo_box
     follows="left|top|right"
     height="22"
     layout="topleft"
     left_pad="2"
     name="pose_combo"
     tool_tip="The pose to hold while this window is open. T-pose, A-pose, Arms down, Arms forward and Legs apart are still poses on your screen only (for fitting); Arms out and the sitting poses everyone around you sees."
     top="22"
     width="160">
        <combo_box.item label="T-pose" name="t_pose" value="t_pose" />
        <combo_box.item label="A-pose" name="a_pose" value="a_pose" />
        <!-- <Prestige> was Standing 1-4 (the default idle stands: no visible change) -->
        <combo_box.item label="Arms down" name="arms_down" value="arms_down" />
        <combo_box.item label="Arms forward" name="arms_forward" value="arms_forward" />
        <combo_box.item label="Legs apart" name="legs_apart" value="legs_apart" />
        <combo_box.item label="Arms out (fitting)" name="arms_out" value="arms_out" />
        <combo_box.item label="Sitting on the ground" name="sit_ground" value="sit_ground" />
        <combo_box.item label="Sitting (chair)" name="sit_chair" value="sit_chair" />
        <!-- </Prestige> -->
    </combo_box>
    <button
     follows="top|right"
     height="22"
     image_overlay="Arrow_Left_Off"
     layout="topleft"
     left_pad="4"
     name="prev_btn"
     tool_tip="Previous pose"
     top_delta="0"
     width="28" />
    <button
     follows="top|right"
     height="22"
     image_overlay="Arrow_Right_Off"
     layout="topleft"
     left_pad="2"
     name="next_btn"
     tool_tip="Next pose"
     top_delta="0"
     width="28" />
    <button
     follows="left|top"
     height="22"
     label="Adjust height..."
     layout="topleft"
     left="10"
     name="height_btn"
     tool_tip="Raise or lower your avatar (hover height)"
     top_pad="12"
     width="120" />
    <button
     follows="top|right"
     height="22"
     label="Done"
     layout="topleft"
     left="190"
     name="done_btn"
     tool_tip="Stop posing (your AO comes back on if it was on)"
     top_delta="0"
     width="80" />
</floater>
