<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<!-- Prestige: the ReShade FX effects in a window of their own (toolbar ReShade button). The panel
     is Photo Studio's Effects panel (sl_panel_fx_effects, SLPanelPhotoStudioEffects); the same
     panel is the ReShade tab in Preferences. -->
<floater
 positioning="cascading"
 save_rect="true"
 can_resize="true"
 height="520"
 min_height="320"
 min_width="320"
 width="380"
 layout="topleft"
 name="prestige_reshade"
 single_instance="true"
 title="ReShade">
    <panel
     class="sl_panel_fx_effects"
     filename="panel_photo_studio_effects.xml"
     follows="all"
     height="496"
     layout="topleft"
     left="4"
     name="reshade_effects"
     top="20"
     width="372" />
</floater>
