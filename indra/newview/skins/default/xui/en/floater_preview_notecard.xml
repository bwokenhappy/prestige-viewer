<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<floater
 can_pop_out="true"
 legacy_header_height="18"
 can_resize="true"
 default_tab_group="1"
 height="385"
 layout="topleft"
 min_height="267"
 min_width="330"
 name="preview notecard"
 help_topic="preview_notecard"
 positioning="centered"
 save_rect="true"
 title="NOTECARD:"
 width="400">
    <floater.string
     name="no_object">
        Unable to find object containing this notecard.
    </floater.string>
    <floater.string
     name="not_allowed">
        You do not have permission to view this notecard.
    </floater.string>
    <floater.string
     name="Title">
        Notecard: [NAME]
    </floater.string>
    <icon
     follows="top|right"
     height="18"
     image_name="Lock"
     layout="topleft"
     left="322"
     mouse_opaque="true"
     name="lock"
     top="4"
     width="18" />
    <text
     type="string"
     length="1"
     follows="left|top"
     font="SansSerif"
     height="19"
     layout="topleft"
     left="10"
     name="desc txt"
     top="22"
     width="90">
        Description:
    </text>
    <line_editor
     border_style="line"
     border_thickness="1"
     follows="left|top|right"
     font="SansSerif"
     height="22"
     layout="topleft"
     left_pad="0"
     max_length_bytes="127"
     name="desc"
     width="296" />
    <button
     follows="left|top"
     height="20"
     is_toggle="true"
     label="Text"
     layout="topleft"
     left="4"
     name="view_mode_text"
     tool_tip="Show the notecard as plain text, for editing"
     top="48"
     width="74" />
    <button
     follows="left|top"
     height="20"
     is_toggle="true"
     label="Formatted"
     layout="topleft"
     left_pad="2"
     name="view_mode_formatted"
     tool_tip="Show the notecard formatted as Markdown (read only)"
     top="48"
     width="74" />
    <button
     follows="left|top"
     height="20"
     is_toggle="true"
     label="Split"
     layout="topleft"
     left_pad="2"
     name="view_mode_split"
     tool_tip="Edit the Markdown source with a live formatted preview beside it"
     top="48"
     width="74" />
    <layout_stack
     animate="false"
     follows="all"
     height="281"
     layout="topleft"
     left="4"
     name="notecard_view_stack"
     orientation="horizontal"
     tab_group="1"
     top="70"
     width="392">
        <layout_panel
         auto_resize="true"
         height="281"
         layout="topleft"
         min_width="80"
         name="editor_panel"
         user_resize="true"
         width="196">
            <text_editor
             type="string"
             length="1"
             embedded_items="true"
             follows="left|top|right|bottom"
             font="SansSerif"
             height="281"
             ignore_tab="false"
             layout="topleft"
             left="0"
             max_length="65536"
             name="Notecard Editor"
             parse_urls="false" 
             spellcheck="true"
             tab_group="1"
             top="0"
             use_color="true"
             show_emoji_helper="true"
             width="196"
             word_wrap="true">
                Loading...
            </text_editor>
        </layout_panel>
        <layout_panel
         auto_resize="true"
         height="281"
         layout="topleft"
         min_width="80"
         name="markdown_panel"
         user_resize="true"
         visible="false"
         width="196">
            <text_editor
             follows="all"
             font="SansSerif"
             height="281"
             layout="topleft"
             left="0"
             max_length="262144"
             name="markdown_view"
             parse_urls="true"
             read_only="true"
             tab_group="1"
             top="0"
             width="196"
             word_wrap="true" />
        </layout_panel>
    </layout_stack>
      <button
     follows="left|bottom"
     height="22"
     label="Edit..."
     label_selected="Edit"
     layout="topleft"
     left="4"
     name="Edit"
     top="356"
     width="100" />
    <button
     follows="right|bottom"
     height="22"
     label="Save"
     label_selected="Save"
     layout="topleft"
     left="178"
     name="Save"
     top="356"
     width="100" />
    <button
     follows="right|bottom"
     height="22"
     label="Delete"
     label_selected="Delete"
     layout="topleft"
     left="288"
     name="Delete"
     top="356"
     width="100" />
</floater>
