<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<!-- Prestige: the AO window in Firestorm's Animation Overrider layout (owner's request, 1.8.8), on
     Prestige's AO engine (SLFloaterAO). The AO is turned on / off with the tick on the toolbar's AO
     button; walk-backwards, swimming, idles, Always and imports are in the AO editor (wrench / the
     arrow at the bottom right). -->
<floater
 positioning="cascading"
 save_rect="true"
 can_resize="false"
 height="440"
 width="246"
 layout="topleft"
 name="sl_ao"
 help_topic="sl_ao"
 single_instance="true"
 title="Animation Overrider">
    <combo_box
     follows="left|top"
     height="22"
     layout="topleft"
     left="8"
     name="set_combo"
     tool_tip="The AO set shown below. Click the tick to use it."
     top="26"
     width="198" />
    <button
     follows="left|top"
     height="22"
     image_overlay="Check_Mark"
     layout="topleft"
     left_pad="4"
     name="use_btn"
     tool_tip="Use this set now (and turn the AO on)"
     top_delta="0"
     width="26" />
    <check_box
     follows="left|top"
     height="16"
     label="Default"
     layout="topleft"
     left="8"
     name="default_check"
     tool_tip="Ticked: this is the set the AO uses (it is kept for your next login)"
     top_pad="6"
     width="150" />
    <button
     follows="left|top"
     height="22"
     image_overlay="AddItem_Off"
     layout="topleft"
     left="180"
     name="new_btn"
     tool_tip="New set"
     top_delta="-3"
     width="26" />
    <button
     follows="left|top"
     height="22"
     image_overlay="TrashItem_Off"
     layout="topleft"
     left_pad="4"
     name="delete_btn"
     tool_tip="Delete this set (its folder goes to the trash)"
     top_delta="0"
     width="26" />
    <check_box
     follows="left|top"
     height="16"
     label="Override Sits"
     layout="topleft"
     left="8"
     name="sit_override"
     tool_tip="Replace the sit on objects with this set's Sitting animations"
     top_pad="4"
     width="120" />
    <check_box
     follows="left|top"
     height="16"
     label="Be smart"
     layout="topleft"
     left="134"
     name="smart_sit"
     tool_tip="Leave the seat's own animation alone when the furniture animates you"
     top_delta="0"
     width="100" />
    <check_box
     follows="left|top"
     height="16"
     label="Disable Stands in Mouselook"
     layout="topleft"
     left="8"
     name="no_mouselook"
     tool_tip="No standing animations while you are in mouselook"
     top_pad="6"
     width="228" />
    <combo_box
     follows="left|top"
     height="22"
     layout="topleft"
     left="8"
     name="state_combo"
     tool_tip="The state whose animations are listed (the number is how many it has)"
     top_pad="8"
     width="228" />
    <scroll_list
     column_padding="0"
     draw_heading="false"
     follows="left|top"
     height="176"
     layout="topleft"
     left="8"
     multi_select="false"
     name="anim_list"
     tool_tip="Animations for this state. Drag animations here from your inventory to add them."
     top_pad="6"
     width="196">
        <scroll_list.columns
         name="name"
         relative_width="1" />
    </scroll_list>
    <button
     follows="left|top"
     height="26"
     image_overlay="Arrow_Up"
     layout="topleft"
     left_pad="6"
     name="up_btn"
     tool_tip="Move up"
     top_delta="0"
     width="26" />
    <button
     follows="left|top"
     height="26"
     image_overlay="Arrow_Down"
     layout="topleft"
     left_delta="0"
     name="down_btn"
     tool_tip="Move down"
     top_pad="6"
     width="26" />
    <button
     follows="left|top"
     height="26"
     image_overlay="Edit_Wrench"
     layout="topleft"
     left_delta="0"
     name="edit_btn"
     tool_tip="Open the full AO editor"
     top_pad="54"
     width="26" />
    <button
     follows="left|top"
     height="26"
     image_overlay="TrashItem_Off"
     layout="topleft"
     left_delta="0"
     name="remove_btn"
     tool_tip="Remove the selected animation from this state"
     top_pad="6"
     width="26" />
    <check_box
     follows="left|top"
     height="16"
     label="Cycle"
     layout="topleft"
     left="8"
     name="cycle_check"
     tool_tip="Switch to the next animation every Cycle time seconds"
     top="334"
     width="80" />
    <check_box
     follows="left|top"
     height="16"
     label="Randomize order"
     layout="topleft"
     left="96"
     name="random_check"
     tool_tip="Play this state's animations in random order"
     top_delta="0"
     width="140" />
    <spinner
     decimal_digits="2"
     follows="left|top"
     height="20"
     increment="1"
     label="Cycle time (secs):"
     label_width="150"
     layout="topleft"
     left="8"
     max_val="3600"
     min_val="1"
     name="interval_spin"
     top_pad="6"
     width="228" />
    <button
     follows="left|top"
     height="22"
     label="Reload"
     layout="topleft"
     left="8"
     name="reload_btn"
     tool_tip="Read your AO sets from inventory again"
     top_pad="4"
     width="228" />
    <button
     follows="left|top"
     height="22"
     image_overlay="Arrow_Left"
     layout="topleft"
     left="8"
     name="prev_btn"
     tool_tip="Previous animation"
     top_pad="4"
     width="98" />
    <button
     follows="left|top"
     height="22"
     image_overlay="Arrow_Right"
     layout="topleft"
     left_pad="4"
     name="next_btn"
     tool_tip="Next animation"
     top_delta="0"
     width="98" />
    <button
     follows="left|top"
     height="22"
     image_overlay="Arrow_Small_Down"
     layout="topleft"
     left_pad="4"
     name="more_btn"
     tool_tip="More AO options (the full AO editor)"
     top_delta="0"
     width="24" />
</floater>
