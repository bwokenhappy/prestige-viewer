<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<context_menu
 layout="topleft"
 name="Notification Well Button Context Menu">
    <menu_item_call
     label="Close All"
     layout="topleft"
     name="Close All">
        <menu_item_call.on_click
         function="NotificationWellChicletMenu.Action"
         parameter="close all" />
        <menu_item_call.on_enable
         function="NotificationWellChicletMenu.EnableItem"
         parameter="can close all" />
    </menu_item_call>
    <!-- <Prestige> Notification Center -->
    <menu_item_call
     label="Notification Center..."
     layout="topleft"
     name="Notification Center">
        <menu_item_call.on_click
         function="Floater.ToggleOrBringToFront"
         parameter="notification_center" />
    </menu_item_call>
    <!-- </Prestige> -->
</context_menu>
