<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<panel
 follows="all"
 height="423"
 label="Things"
 layout="topleft"
 min_height="300"
 min_width="240"
 name="main inventory panel">
  <panel.string
   name="Itemcount">
  </panel.string>
  <!-- <Prestige> Firestorm-style counter: items and folders together ("Elements"), details in the tooltip -->
  <panel.string
   name="ItemcountFetching">
    Fetching [ELEMENT_COUNT] Elements... [FILTER]
  </panel.string>
  <panel.string
   name="ItemcountCompleted">
    [ELEMENT_COUNT] Elements [FILTER]
  </panel.string>
  <panel.string
   name="ItemcountUnknown">
    Fetched [ELEMENT_COUNT] Elements [FILTER]
  </panel.string>
  <panel.string
   name="ItemcountTooltip">
    [ITEM_COUNT] Items and [CATEGORY_COUNT] Folders [FILTER]
  </panel.string>
  <!-- </Prestige> -->
  <panel.string name="inventory_title">Inventory</panel.string> <!-- <Prestige> Firestorm casing -->
  <panel.string name="default_mode_btn">Multi_Folder_Mode</panel.string>
  <panel.string name="single_folder_mode_btn">Single_Folder_Mode</panel.string>
  <!-- <Prestige> Firestorm layout: search field on top, then Collapse / Expand / Filter row,
       then the tabs, and the button bar with the counter and trash at the bottom -->
  <layout_stack
   follows="left|top|right"
   height="25"
   animate="false"
   top="4"
   left="4"
   right="-4"
   orientation="horizontal"
   name="top_stack">
    <layout_panel
     border="false"
     bevel_style="in"
     user_resize="false"
     auto_resize="false"
     height="25"
     width="65"
     name="nav_buttons"
     visible="false">
     <button
      follows="top|left"
      height="23"
      image_selected="Single_Folder_Back"
      image_pressed="Single_Folder_Back"
      image_unselected="Single_Folder_Back"
      scale_image="false"
      layout="topleft"
      left="3"
      top="2"
      name="back_btn"
      tool_tip="Back"
      width="20" />
     <button
      follows="top|left"
      height="23"
      image_selected="Single_Folder_Forward"
      image_pressed="Single_Folder_Forward"
      image_unselected="Single_Folder_Forward"
      scale_image="false"
      layout="topleft"
      left_pad="1"
      name="forward_btn"
      tool_tip="Forward"
      width="20" />
     <button
      follows="top|left"
      height="23"
      image_selected="Single_Folder_Up"
      image_pressed="Single_Folder_Up"
      image_unselected="Single_Folder_Up"
      scale_image="false"
      layout="topleft"
      left_pad="1"
      name="up_btn"
      tool_tip="Go up one level"
      width="20" />
    </layout_panel>
    <layout_panel
      border="false"
      bevel_style="in"
      user_resize="false"
      height="25"
      width="410"
      visible="true"
      name="filter_layout_panel">
      <filter_editor
       text_pad_left="10"
       follows="left|top|right"
       height="23"
       label="Filter Inventory"
       layout="topleft"
       left="0"
       top="0"
       max_length_chars="300"
       highlight_text_field="true"
       name="inventory search editor"
       tool_tip="Type in one or more words to search for"
       width="299" />
      <combo_box
       height="23"
       layout="topleft"
       left_pad="2"
       top="0"
       name="search_type"
       tool_tip="Search by"
       follows="top|right"
       width="82">
       <item
        label="Name"
        name="Name"
        value="search_by_name"/>
       <item
        label="Creator"
        name="Creator"
        value="search_by_creator"/>
       <item
        label="Description"
        name="Description"
        value="search_by_description"/>
       <item
        label="UUID"
        name="UUID"
        value="search_by_UUID"/>
      </combo_box>
      <menu_button
       follows="top|right"
       tool_tip="View &amp; sort options"
       height="23"
       image_hover_unselected="Toolbar_Middle_Over"
       image_overlay="Conv_toolbar_sort"
       image_selected="Toolbar_Middle_Selected"
       image_unselected="Toolbar_Middle_Off"
       layout="topleft"
       left_pad="2"
       top="0"
       name="view_btn"
       width="25" />
    </layout_panel>
  </layout_stack>
  <layout_stack
   follows="left|top|right"
   height="18"
   animate="false"
   top_pad="4"
   left="4"
   right="-4"
   name="ctrl_stack"
   orientation="horizontal">
    <layout_panel
     border="false"
     bevel_style="in"
     user_resize="false"
     auto_resize="false"
     height="18"
     width="168"
     name="collapse_expand_buttons">
      <button
       follows="top|left"
       height="18"
       label="Collapse"
       layout="topleft"
       left="0"
       top="0"
       name="collapse_all_btn"
       tool_tip="Collapse all folders"
       width="80" />
      <button
       follows="top|left"
       height="18"
       label="Expand"
       layout="topleft"
       left_pad="4"
       name="expand_all_btn"
       tool_tip="Expand all folders (opens the folders already loaded in this view)"
       width="80" />
    </layout_panel>
    <layout_panel
     border="false"
     bevel_style="in"
     user_resize="false"
     height="18"
     width="242"
     name="filter_ctrls">
      <text
       follows="top|left"
       height="18"
       layout="topleft"
       left="4"
       top="2"
       name="filter_label"
       width="36">
        Filter:
      </text>
      <combo_box
       follows="top|left|right"
       height="18"
       layout="topleft"
       left_pad="2"
       top="0"
       right="-34"
       name="filter_combo_box"
       tool_tip="Show only this type of item">
        <combo_box.item value="filter_type_all" label="All Types" />
        <combo_box.item value="filter_separator" label="------------" enabled="false" />
        <combo_box.item value="filter_type_animations" label="Animations" />
        <combo_box.item value="filter_type_calling_cards" label="Calling Cards" />
        <combo_box.item value="filter_type_clothing" label="Clothing / Body Parts" />
        <combo_box.item value="filter_type_gestures" label="Gestures" />
        <combo_box.item value="filter_type_landmarks" label="Landmarks" />
        <combo_box.item value="filter_type_notecards" label="Notecards" />
        <combo_box.item value="filter_type_objects" label="Objects" />
        <combo_box.item value="filter_type_scripts" label="Scripts" />
        <combo_box.item value="filter_type_sounds" label="Sounds" />
        <combo_box.item value="filter_type_textures" label="Textures" />
        <combo_box.item value="filter_type_snapshots" label="Snapshots" />
        <combo_box.item value="filter_type_materials" label="Materials" />
        <combo_box.item value="filter_type_settings" label="Settings" />
        <combo_box.item value="filter_separator" label="------------" enabled="false" />
        <combo_box.item value="filter_type_custom" label="Custom..." />
      </combo_box>
      <menu_button
       follows="top|right"
       tool_tip="Search visibility options"
       height="18"
       image_overlay="Inv_Toolbar_SearchVisibility"
       layout="topleft"
       right="-1"
       top="0"
       name="options_visibility_btn"
       width="31" />
    </layout_panel>
  </layout_stack>
  <!-- </Prestige> -->
    <!-- <Prestige> heights fit the Firestorm layout (two rows on top, button bar below) -->
    <panel
     follows="all"
     halign="center"
     height="335"
     layout="topleft"
     left="3"
     right="-3"
     name="default_inventory_panel"
     top_pad="4">
      <tab_container
       follows="all"
       halign="center"
       height="335"
       layout="topleft"
       left="0"
       name="inventory filter tabs"
       open_tabs_on_drag_and_drop="true"
       tab_position="top"
       tab_min_width="100"
       use_tab_offset="true"
       top="0">
        <inventory_panel
         bg_opaque_color="PanelDefaultBackgroundColor"
         bg_alpha_color="PanelDefaultBackgroundColor"
         background_visible="true"
         border="false"
         bevel_style="none"
         follows="all"
         label="Inventory"
         help_topic="my_inventory_tab"
         layout="topleft"
         name="All Items"
         sort_order_setting="InventorySortOrder"
         show_item_link_overlays="true"
         preinitialize_views="false"
         scroll.reserve_scroll_corner="false">
            <folder double_click_override="true"/>
        </inventory_panel>
        <recent_inventory_panel
         bg_opaque_color="PanelDefaultBackgroundColor"
         bg_alpha_color="PanelDefaultBackgroundColor"
         background_visible="true"
         border="false"
         bevel_style="none"
         follows="all"
         label="Recent"
         help_topic="recent_inventory_tab"
         layout="topleft"
         name="Recent Items"
         show_item_link_overlays="true"
         preinitialize_views="false"
         scroll.reserve_scroll_corner="false">
            <folder double_click_override="true"/>
        </recent_inventory_panel>
        <inventory_panel
         name="Worn Items"
         label="Worn"
         show_empty_message="false"
         follows="all"
         layout="topleft"
         bg_opaque_color="PanelDefaultBackgroundColor"
         bg_alpha_color="PanelDefaultBackgroundColor"
         background_visible="true"
         preinitialize_views="false"
         border="false"
         bevel_style="none"
         scroll.reserve_scroll_corner="false">
            <folder double_click_override="true"/>
        </inventory_panel>
        <favorites_inventory_panel
         bg_opaque_color="PanelDefaultBackgroundColor"
         bg_alpha_color="PanelDefaultBackgroundColor"
         background_visible="true"
         border="false"
         bevel_style="none"
         follows="all"
         label="Favorites"
         help_topic="recent_inventory_tab"
         layout="topleft"
         name="Favorites"
         show_item_link_overlays="true"
         preinitialize_views="false"
         scroll.reserve_scroll_corner="false">
          <folder double_click_override="true"/>
        </favorites_inventory_panel>
      </tab_container>
    </panel>
    <panel
     follows="all"
     halign="center"
     height="335"
     layout="topleft"
     left="7"
     name="combination_view_inventory"
     top_delta="0"
     visible="false">
     <layout_stack
      follows="all"
      layout="topleft"
      height="335"
      name="combination_view_stack"
      animate="false"
      drag_handle_thickness="6"
      drag_handle_first_indent="18"
      drag_handle_second_indent="18"
      drag_handle_shift="5"
      show_drag_handle="true"
      top="0"
      left="0"
      orientation="vertical">
       <layout_panel
        border="false"
        bevel_style="in"
        user_resize="true"
        auto_resize="true"
        height="222"
        min_width="150"
        name="comb_gallery_layout">
        <panel
         class="inventory_gallery"
         filename="panel_inventory_gallery.xml"
         left="0"
         top="1"
         height="222"
         name="comb_gallery_view_inv"
         background_visible="true"
         follows="all"
         layout="topleft">
        </panel>
       </layout_panel>
       <layout_panel
        border="false"
        bevel_style="in"
        user_resize="true"
        auto_resize="true"
        height="113"
        min_height="100"
        name="comb_inventory_layout">
        <single_folder_inventory_panel
         name="comb_single_folder_inv"
         follows="all"
         left="0"
         top="1"
         height="113"
         layout="topleft"
         show_item_link_overlays="true"
         bg_opaque_color="DkGray2"
         bg_alpha_color="DkGray2"
         background_visible="true"
         border="false"
         bevel_style="none"
         scroll.reserve_scroll_corner="false">
         <item
          single_folder_mode="true"
          folder_indentation="-8"/>
         <folder
          single_folder_mode="true"
          folder_indentation="-8"/>
        </single_folder_inventory_panel>
       </layout_panel>
     </layout_stack>
    </panel>
    <!-- </Prestige> -->
    <!-- <Prestige> Firestorm button bar: gear, add, new window, filters, view mode,
         the element counter and the trash (drop items on it to delete them) -->
    <panel
     follows="left|right|bottom"
     height="25"
     layout="topleft"
     bottom="-4"
     left="4"
     right="-4"
     name="bottom_panel">
      <menu_button
       follows="bottom|left"
       tool_tip="Show additional options"
       height="25"
       image_hover_unselected="Toolbar_Left_Over"
       image_overlay="OptionsMenu_Off"
       image_selected="Toolbar_Left_Selected"
       image_unselected="Toolbar_Left_Off"
       layout="topleft"
       left="0"
       top="0"
       name="options_gear_btn"
       width="31" />
      <button
       follows="bottom|left"
       height="25"
       image_hover_unselected="Toolbar_Middle_Over"
       image_overlay="AddItem_Off"
       image_selected="Toolbar_Middle_Selected"
       image_unselected="Toolbar_Middle_Off"
       layout="topleft"
       left_pad="1"
       name="add_btn"
       tool_tip="Create new item"
       width="31" />
      <button
       follows="bottom|left"
       height="25"
       image_hover_unselected="Toolbar_Middle_Over"
       image_overlay="Inv_NewWindow"
       image_selected="Toolbar_Middle_Selected"
       image_unselected="Toolbar_Middle_Off"
       layout="topleft"
       left_pad="1"
       name="new_inv_btn"
       tool_tip="Additional inventory window"
       width="31" />
      <button
       follows="bottom|left"
       height="25"
       image_hover_unselected="Toolbar_Middle_Over"
       image_overlay="Inv_ShowFilters"
       image_selected="Toolbar_Middle_Selected"
       image_unselected="Toolbar_Middle_Off"
       is_toggle="true"
       layout="topleft"
       left_pad="1"
       name="show_filters_inv_btn"
       tool_tip="Show filters (lit while the filter window is open)"
       width="31" />
      <button
       follows="bottom|left"
       tool_tip="Switch between views"
       height="25"
       image_hover_unselected="Toolbar_Middle_Over"
       image_overlay="Single_Folder_Mode"
       image_selected="Toolbar_Middle_Selected"
       image_unselected="Toolbar_Middle_Off"
       layout="topleft"
       left_pad="1"
       name="view_mode_btn"
       width="31" />
      <icon
       follows="bottom|left|right"
       height="25"
       image_name="Toolbar_Middle_Off"
       layout="topleft"
       left_pad="1"
       top="0"
       right="-33"
       name="dummy_icon" />
      <text
       type="string"
       length="1"
       follows="bottom|left|right"
       height="17"
       layout="topleft"
       left_delta="8"
       top="4"
       right="-41"
       name="ItemcountText"
       font="SansSerifMedium"
       valign="center"
       use_ellipses="true">
        Elements
      </text>
      <dnd_button
       follows="bottom|right"
       height="25"
       image_hover_unselected="Toolbar_Right_Over"
       image_overlay="TrashItem_Off"
       image_selected="Toolbar_Right_Selected"
       image_unselected="Toolbar_Right_Off"
       layout="topleft"
       right="-1"
       top="0"
       name="trash_btn"
       tool_tip="Delete the selected items (or drop items here)"
       width="31" />
    </panel>
    <!-- </Prestige> -->
</panel>
