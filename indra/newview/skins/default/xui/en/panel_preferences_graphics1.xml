  <button
    follows="top|left"
    height="23"
    label="Advanced Settings..."
    layout="topleft"
    left_pad="10"
    name="AdvancedSettings"
    top_delta="0"
    width="200">
    <button.commit_callback
      function="Pref.Advanced"
      parameter="advanced" />
  </button>

</panel>
