  <slider
    control_name="RenderQualityPerformance"
    decimal_digits="0"
    follows="left|top"
    height="16"
    increment="1"
    initial_value="0"
    layout="topleft"
    left="150"
    max_val="6"
    name="QualityPerformanceSelection"
    show_text="false"
    top_delta="-2"
    width="275">
    <slider.commit_callback
      function="Pref.QualityPerformance"/>
  </slider>

<!-- This block shows Basic Settings -->

  <slider
    control_name="RenderFarClip"
    decimal_digits="0"
    follows="left|top"
    height="16"
    increment="8"
    initial_value="160"
    label="Draw distance:"
    label_width="187"
    layout="topleft"
    left="30"
    min_val="8"
    max_val="4096"
    name="DrawDistance"
    tool_tip="How far the world is drawn, in meters (up to 4096). Loaded regions are capped at a 5x5 square around yours (SlipstreamMaxRegionRing)."
    top_delta="40"
    width="427" />
  <text
    type="string"
    length="1"
    follows="left|top"
    height="12"
    layout="topleft"
    left_delta="427"
    name="DrawDistanceMeterText2"
    top_delta="0"
    width="128">
     m
  </text>

  <button
  height="23"
  label="Automatic adjustments settings"
  layout="topleft"
  left="30"
  name="AutoAdjustmentsButton"
  top_delta="30"
  width="200">
    <button.commit_callback
      function="Pref.AutoAdjustments"/>
  </button>

  <button
    follows="left|top"
    height="23"
    label="Water effects..."
    layout="topleft"
    left="240"
    name="WaterEffectsButton"
    tool_tip="Waves, wave intensity, foam, ripples and splashes: switch each water effect on or off"
    top_delta="0"
    width="140">
    <button.commit_callback
      function="Floater.Show"
      parameter="water_options"/>
  </button>

    <text
      type="string"
      length="1"
      follows="left|top"
      height="16"
      layout="topleft"
      left="30"
      top_delta="42"
      width="128"
      name="AvatarComplexityModeLabel"
      text_readonly_color="LabelDisabledColor">
        Avatar display:
    </text>
    <combo_box
     control_name="RenderAvatarComplexityMode"
     height="23"
     layout="topleft"
     left_delta="130"
     top_delta="-4"
     name="AvatarComplexityMode"
     width="150">
        <combo_box.item
         label="Limit by complexity"
         name="0"
         value="0"/>
        <combo_box.item
         label="Always show friends"
         name="1"
         value="1"/>
        <combo_box.item
         label="Only show friends"
         name="2"
         value="2"/>
    </combo_box>
  
  <slider
    control_name="IndirectMaxComplexity"
    tool_tip="Controls at what point a visually complex avatar is drawn as a JellyDoll"
    follows="left|top"
    height="16"
    initial_value="101"
    increment="1"
    label="Avatar maximum complexity:"
    label_width="165"
    layout="topleft"
    left="30"
    min_val="1"
    max_val="101"
    name="IndirectMaxComplexity"
    show_text="false"
    top_delta="28"
    width="300">
    <slider.commit_callback
      function="Pref.UpdateIndirectMaxComplexity"
      parameter="IndirectMaxComlexityText" />
  </slider>
  <text
    type="string"
    length="1"
    follows="left|top"
    height="16"
    layout="topleft"
    top_delta="0"
    left_delta="304"
    text_readonly_color="LabelDisabledColor"
    name="IndirectMaxComplexityText"
    width="65">
       0
  </text>

  <slider
    control_name="IndirectMaxNonImpostors"
    name="IndirectMaxNonImpostors"
    decimal_digits="0"
    increment="1"
    initial_value="12"
    show_text="true"
    min_val="1"
    max_val="66"
    label="Maximum number of animated avatars:"
    follows="left|top"
    layout="topleft"
    height="16"
    label_width="240"
    left="30"
    top_delta="20"
    width="393">
      <slider.commit_callback
        function="Pref.UpdateIndirectMaxNonImpostors"
        parameter="IndirectNonImpostorsText" />
  </slider>
  <text
    type="string"
    length="1"
    follows="left|top"
    height="16"
    layout="topleft"
    top_delta="0"
    left_delta="397"
    text_readonly_color="LabelDisabledColor"
    name="IndirectMaxNonImpostorsText"
    width="65">
      0
  </text> 
    
  <button
    height="23"
    label="Exceptions..."
    layout="topleft"
    left="48"
    name="RenderExceptionsButton"
    top_delta="24"
    width="100">
    <button.commit_callback
      function="Pref.RenderExceptions"/>
  </button>

  <slider
    control_name="RenderExposure"
    enabled_control="RenderHDREnabled"
    decimal_digits="1"
    follows="left|top"
    height="16"
    increment="0.1"
    initial_value="160"
    label="Brightness (exposure)"
    label_width="145"
    layout="topleft"
    left="30"
    min_val="0.5"
    max_val="4.0"
    name="RenderExposure"
    show_text="true"
    top_pad="14"
    width="260">
  </slider>

  <!-- Motion blur (#118): the switch and its shutter time side by side, right of the
       Exceptions button / exposure rows (positions relative to RenderExposure above).
       Both bound: like every bound control here (and on the Advanced floater they came
       from) they are part of a graphics preset. -->
  <check_box
    control_name="RenderVKMotionBlur"
    follows="left|top"
    height="16"
    label="Motion blur"
    layout="topleft"
    left="310"
    name="MotionBlur"
    tool_tip="Things that move on screen streak along their motion (another avatar flying past; the world when you fly or drive fast). Works with every upscaler (DLSS, FSR) and without one."
    top_delta="-33"
    width="190" />
  <slider
    control_name="RenderVKMotionBlurShutter"
    decimal_digits="3"
    enabled_control="RenderVKMotionBlur"
    follows="left|top"
    height="16"
    increment="0.001"
    initial_value="0.0166667"
    label="Shutter (s)"
    label_width="70"
    layout="topleft"
    left="310"
    max_val="0.05"
    min_val="0"
    name="MotionBlurShutter"
    tool_tip="Exposure time in seconds, i.e. how long a streak is. 1/60 s is the default; 0 is no blur. Greyed out while motion blur is off."
    top_delta="33"
    width="200" />

<!-- End of Basic Settings block -->

  <!-- Effects quick access (#545): the switch and the preset, without opening
       Photo Studio. Deliberately NOT bound with control_name: every bound
       control on this panel becomes part of a graphics preset (getControlNames),
       and loading "Low" must not switch effects off or swap the effects preset.
       LLPanelPreferenceGraphics wires and syncs them by hand. -->
  <check_box
    follows="left|top"
    height="16"
    label="Effects (ReShade FX)"
    layout="topleft"
    left="10"
    name="FxEnabled"
    tool_tip="Run the effects stack: ReShade FX effects on the world, set up in Photo Studio > Effects. Also on a key you can set in Controls (Toggle Effects)."
    top="345"
    width="160" />
  <text
    type="string"
    length="1"
    follows="left|top"
    height="16"
    layout="topleft"
    left_pad="10"
    name="FxPresetLabel"
    top_delta="1"
    width="48">
      Preset:
  </text>
  <combo_box
    follows="left|top"
    height="20"
    layout="topleft"
    left_pad="2"
    name="FxPresetCombo"
    tool_tip="The effects preset in use (ReShade .ini, in ~/.slipstreamviewer/fx/presets)"
    top_delta="-3"
    width="200" />

  <!-- <Prestige> picture: sharpening (the same setting as Advanced > Sharpening) and a little
       extra colour for the whole picture. Bound, so graphics presets keep them. -->
  <slider
    control_name="RenderCASSharpness"
    decimal_digits="2"
    follows="left|top"
    height="16"
    increment="0.05"
    initial_value="0.4"
    label="Sharpen"
    label_width="60"
    layout="topleft"
    left="10"
    max_val="1.0"
    min_val="0.0"
    name="PrestigeSharpen"
    show_text="true"
    tool_tip="Sharpens the picture (contrast adaptive sharpening, after any upscaler). 0 = off; 0.4 is the default; higher is crisper."
    top="372"
    width="185" />
  <slider
    control_name="PrestigeBaseSaturation"
    decimal_digits="2"
    follows="left|top"
    height="16"
    increment="0.01"
    initial_value="1.08"
    label="Saturation"
    label_width="62"
    layout="topleft"
    left="200"
    max_val="1.5"
    min_val="0.5"
    name="PrestigeBaseSaturation"
    show_text="true"
    tool_tip="Colour of the whole picture: 1 = as rendered, 1.08 (default) a little richer, lower is more muted. Works on top of the colour grade."
    top="372"
    width="190" />
  <check_box
    control_name="PrestigeJewelryDetail"
    height="16"
    label="Jewelry detail"
    layout="topleft"
    left="395"
    name="PrestigeJewelryDetail"
    tool_tip="Makes rings, chains, grills and other shiny jewelry look real: ray-traced reflections in metal and stones (RTX / ray tracing GPUs), sharp full-resolution reflections instead of soft ones, a live reflection probe that shows you and the people around you, small mesh kept detailed at a distance, and a slight sparkle on bright highlights. Costs some performance. Untick to put your previous settings back."
    top="372"
    width="120" />
  <!-- </Prestige> -->

  <button
    follows="top|left"
    height="23"
    label="Save settings as a preset..."
