<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<panel
	  follows="all"
	  height="570"
	  label="Things"
	  layout="topleft"
	  min_height="350"
	  min_width="240"
	  name="objects panel">
    <panel
		 follows="all"
		 layout="topleft"
		 left="0"
		 name="sidepanel_inventory_panel"
		 top="0"
		 label=""
		 height="570"
		 visible="true"
		 default_tab_group="1">
      <layout_stack
              follows="left|right|top|bottom"
              layout="topleft"
              left="0"
              top="0"
              tab_group="1"
              orientation="vertical"
              name="inventory_layout_stack"
              height="560">
             <layout_panel
                 name="main_inventory_layout_panel"
                 layout="topleft"
                 auto_resize="true"
                 user_resize="false"
                 min_dim="150"
                 follows="bottom|left|right"
                 height="300">
                 <panel
                      class="panel_main_inventory"
                      filename="panel_main_inventory.xml"
                      follows="all"
                      layout="topleft"
                      left="0"
                      name="panel_main_inventory"
                      top="0"
                      label=""
                      height="300" />
             </layout_panel>
             <!-- <Prestige> Received items (the marketplace / delivery inbox) at the bottom, like
                  Firestorm: a header with the count (click: fold / unfold), a refresh button,
                  and the inbox's contents. Shown once the account has an inbox. -->
             <layout_panel
                 name="inbox_layout_panel"
                 layout="topleft"
                 auto_resize="false"
                 user_resize="true"
                 min_dim="30"
                 follows="bottom|left|right"
                 visible="false"
                 width="418"
                 height="220">
                 <button
                      follows="left|top|right"
                      halign="left"
                      height="26"
                      image_overlay="Accordion_ArrowOpened_Off"
                      image_overlay_alignment="left"
                      imgoverlay_label_space="8"
                      label="Received items"
                      layout="topleft"
                      left="4"
                      name="inbox_btn"
                      pad_left="8"
                      tool_tip="Marketplace purchases and deliveries. Click to fold or unfold. Drag items into your inventory to keep them there."
                      top="2"
                      width="374" />
                 <button
                      follows="top|right"
                      height="26"
                      image_overlay="Refresh_Off"
                      layout="topleft"
                      left_pad="4"
                      name="inbox_refresh"
                      tool_tip="Check for new deliveries"
                      top_delta="0"
                      width="32" />
                 <inventory_panel
                      allow_multi_select="true"
                      follows="all"
                      height="186"
                      layout="topleft"
                      left="4"
                      name="inventory_inbox"
                      show_empty_message="false"
                      show_item_link_overlays="true"
                      start_folder.type="inbox"
                      top="32"
                      width="410" />
             </layout_panel>
             <!-- </Prestige> -->
         </layout_stack>
	</panel>
</panel>
