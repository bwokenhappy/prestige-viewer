<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<panel
	  follows="all"
	  height="570"
	  label="Things"
	  layout="topleft"
	  min_height="350"
	  min_width="240"
	  name="objects panel">
    <panel
		 follows="all"
		 layout="topleft"
		 left="0"
		 name="sidepanel_inventory_panel"
		 top="0"
		 label=""
		 height="570"
		 visible="true"
		 default_tab_group="1">
      <!-- <Prestige> the inventory straight in the window, stretching on every side. It used to sit
           in a one-panel layout_stack (the Received Items panel below it is gone, #489) whose panel was
           300 tall and bottom-anchored: when the stack had not laid out yet, the inventory stayed 300
           tall at the bottom of a taller window, under a blank band. No code looks the stack up. -->
      <panel
           class="panel_main_inventory"
           filename="panel_main_inventory.xml"
           follows="all"
           layout="topleft"
           left="0"
           name="panel_main_inventory"
           top="0"
           label=""
           height="570" />
	</panel>
</panel>
