// disocclusions).
float rtrTemporalAlphaStoch(float rough) { return 1.0 / mix(8.0, 20.0, smoothstep(RTR_STOCH_ROUGH, 0.6, rough)); }
// The previous frame's position of camera-relative point Xr (X - cam_origin), in render pixels
// (continuous), and its previous view depth pw; false off screen / behind the previous camera.
bool rtrPrevPos(vec3 Xr, out vec2 fp, out float pw)
{
    const vec4 c = ssr.views[CLEAN_VIEW].taa_prev_vp * vec4(Xr, 1.0);
    pw = c.w;
    fp = vec2(-1.0);
    if (!(c.w > 1e-4)) return false;
    const vec2 puv = c.xy / c.w * 0.5 + 0.5;
    if (!(all(greaterThanEqual(puv, vec2(0.0))) && all(lessThan(puv, vec2(1.0))))) return false;
    fp = puv * vec2(float(g_draw_push.width), float(g_draw_push.height));
    return true;
}
// BILINEAR HISTORY at previous position fp: the 2 x 2 texels of history layer `layer` around it
// whose stored view depth matches ew (the receiver's previous depth there), renormalised over the
// taps that match. i0 / w: the taps and their weights (the moment fetch reuses them); false: none.
bool rtrHistFetch(vec2 fp, float ew, uint layer, out vec3 h, out ivec2 i0, out vec4 w)
{
    const vec2 b = fp - 0.5;
    i0 = ivec2(floor(b));
    const vec2 f = b - floor(b);
    const vec4 bw = vec4((1.0 - f.x) * (1.0 - f.y), f.x * (1.0 - f.y), (1.0 - f.x) * f.y, f.x * f.y);
    h = vec3(0.0);
    w = vec4(0.0);
    if (!(ew > 1e-3)) return false;
    const ivec2 sz = ivec2(int(g_draw_push.width), int(g_draw_push.height));
    float ws = 0.0;
    [[unroll]] for (int k = 0; k < 4; ++k)
    {
        const ivec2 q = i0 + ivec2(k & 1, k >> 1);
        if (any(lessThan(q, ivec2(0))) || any(greaterThanEqual(q, sz))) continue;
        const vec4 t = imageLoad(uRtHist, RTH_TEXEL(q, layer));
        if (!(t.a > 0.01 && abs(t.a - ew) < 0.02 * ew + 0.05 && all(lessThan(abs(t.rgb), vec3(60000.0))))) continue;
        w[k] = bw[k];
        h += bw[k] * t.rgb;
        ws += bw[k];
    }
    if (!(ws > 1e-3)) return false;
    w /= ws;
    h /= ws;
    return true;
}
// res: this frame's result; mu / sigma: the glossy gather's mean / deviation (one tap's), nEff its
// effective sample count; P, Ng (toward the camera), V: the receiver; tRefl: the mean hit distance
// (0: a miss); vz its view depth now; surfaceFirst: no virtual-image candidate. Writes this frame's
// history texels; returns the blend.
vec3 rtrTemporal(ivec2 px, vec3 res, vec3 mu, vec3 sigma, float nEff, vec3 P, vec3 Ng, vec3 V, float tRefl, float vz,
                 bool surfaceFirst, float rough)
{
    const uint par = (rtt_param.w >> 8) & 1u;
    const uint prev = par ^ 1u;
    vec3 h = vec3(0.0);
    ivec2 hi0 = ivec2(0);
    vec4 hw = vec4(0.0);
    bool ok = false;
    if (ssr.taa_params.z < 0.5)
    {
        const vec3 Pr = P - ssr.cam_origin.xyz;
        vec2 fp;
        float pw;
        // VIRTUAL IMAGE candidate
        vec3 hV = vec3(0.0);
        ivec2 iV = ivec2(0);
        vec4 wV = vec4(0.0);
        bool okV = false;
        if (!surfaceFirst && rtrPrevPos(Pr - V * (tRefl > 0.0 ? tRefl : 1000.0), fp, pw))
        {
            // the receiver plane under that previous position: where the previous camera's ray
            // through it meets the plane, and that point's previous view depth
            const mat4 iM = inverse(ssr.views[CLEAN_VIEW].taa_prev_vp);
            const vec2 ndc = fp / vec2(float(g_draw_push.width), float(g_draw_push.height)) * 2.0 - 1.0;
            vec4 a = iM * vec4(ndc, 1.0, 1.0), b = iM * vec4(ndc, 0.5, 1.0);
            a.xyz /= a.w;
            b.xyz /= b.w;
            const vec3 dl = b.xyz - a.xyz;
            const float den = dot(Ng, dl);
            if (abs(den) > 1e-6 * length(dl))
            {
                const vec3 Q = a.xyz + dl * (dot(Ng, Pr - a.xyz) / den);
                const float ew = (ssr.views[CLEAN_VIEW].taa_prev_vp * vec4(Q, 1.0)).w;
                okV = rtrHistFetch(fp, ew, prev, hV, iV, wV);
            }
        }
        // SURFACE candidate
        vec3 hS = vec3(0.0);
        ivec2 iS = ivec2(0);
        vec4 wS = vec4(0.0);
        const bool okS = rtrPrevPos(Pr, fp, pw) && rtrHistFetch(fp, pw, prev, hS, iS, wS);
        // both: the one nearer this frame's gather mean
        const bool useV = okV && (!okS || length(hV - mu) <= length(hS - mu));
        ok = okV || okS;
        h = useV ? hV : hS;
        hi0 = useV ? iV : iS;
        hw = useV ? wV : wS;
    }
    // the history's temporal variance / length (layer 2 + prev), with the same taps
    vec4 aux = vec4(0.0);
    if (ok)
    {
        [[unroll]] for (int k = 0; k < 4; ++k)
            if (hw[k] > 0.0) aux += hw[k] * imageLoad(uRtHist, RTH_TEXEL(hi0 + ivec2(k & 1, k >> 1), 2u + prev));
    }
    g_rtr_hist_lum = ok ? rrtLum(h) : -1.0;
