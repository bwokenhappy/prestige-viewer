// (#87) GI: the denoised GI irradiance at this pixel (clean_gi_common.glsl), the final image's own
// texel at the render extent, else the depth-aware 4-tap upsample (deferPdnFetch's rule; alpha =
// the texel's view depth, <= 0 = no surface / unknown). ok: some tap lies on this surface.
// skyVis: the denoised sky visibility (layer 1's red; 1 where unknown).
// ok: some tap has a surface -- the CLOSEST-depth tap stands in where none lies on this surface (a
// silhouette): before, such pixels fell back to the probes' sky ambient -- a bright rim on every
// edge of a dark room (the owner's red rims on the tub).
// EDGE-SAFE (GI_F_UPS_NORMAL, RenderVKGIUpsampleNormal; N: this pixel's shading normal): (1) each tap
// is also weighted by its normal's agreement (the GI GEOM guide, this frame's parity: prm4.w) -- a hair
// strand lying ON its body has the body's depth but not its normal, and the depth stop alone averaged
// the two surfaces' GI; (2) where none of the 4 taps lies on this surface (a strand thinner than a GI
// texel, or one the jittered GI sample missed), the best-matching texel of the 4 x 4 around it (depth,
// then normal) stands in before the closest-depth fallback -- never an average across the silhouette.
// (#978 phase 2, GI_F_LAG: RenderVKGILatencyFrame) ONE FRAME OF LATENCY: the GI images hold LAST frame's
// result. REPROJECTION: P into last frame's unjittered view (ssr.views[CLEAN_VIEW].taa_prev_vp, camera-relative to this
// recording's eye as every temporal pass maps it) -- its uv in last frame's GI grid and its view depth
// there (clip w, the images' alpha convention: the GI denoiser's own reprojection compares the same
// pair, clean_deferred_light.comp giPrevDelta). The 4 bilinear taps around it count only on THIS
// surface (depth within 3 %, normal-weighted by last frame's GEOM -- prm4.w names its parity under
// GI_F_LAG); no closest-depth stand-in (under a moving camera that is a disocclusion, not a
// silhouette); (GI_LAG_REVEAL) a tap facing over 60 degrees away is off this surface too. DISOCCLUSION
// (no tap on this surface): the ring beside it, then (GI_LAG_REVEAL) the reveal march along the plane
// (deferGiLagRevealMarch); then -- or off last frame's screen, a history reset -- teleport / region crossing /
// camera cut: ssr.taa_params.z --, or GI_F_LAG_STALE -- the radiance cache's world cell at P (last frame's
// irradiance there: occlusion-aware, camera-independent), (GI_LAG_REVEAL) else the mean of the 4 cells beside
// it in its face plane, else no estimate (the probes' diffuse, as an untraced pixel; skyVis 1: no specular
// occlusion). GI_LAG_REVEAL = RenderVKGILagRevealSearch (an A/B, default on): bit 1 of prm4.w under GI_F_LAG
// (bit 0 the GEOM parity). OBJECT MOTION (deferGiLagPrev): a surface that moved on its own -- the motion target's
// skinned class, or a rigid surface whose motion vector departs from the camera-only point by over half a
// pixel (a vehicle, a moving prim) -- is looked up along its MOTION VECTOR, at its own last-frame view depth
// (the motion target's z). Before, every surface took the camera-only point: an avatar flying fast with the
// camera following it is nearly still on screen but metres away in the world, so its camera-only point
// last frame lay on the ground / sky behind it -- no tap on this surface, a "disocclusion" -- and its
// pixels took the radiance cache's 0.25 m world cells at P (cells its own body had filled a frame or
// more ago, at other body parts) or, with no cell, the probes: blocky patches of light and dark over the
// body that changed every frame as it crossed the cells. Walking hid it (the camera-only point moved a
// few pixels and still landed on the body). The sub-texel jitter of last frame's GI samples (scale < 1)
// is ignored.
// (RenderVKGIDebug 7 under GI_F_LAG) what deferGiFetchLag took: 0 last frame's taps / ring, 1 the reveal march,
// 2 a cache cell, 3 nothing (the probes' / sky ambient)
uint g_gi_lag_src = 0u;
// Last frame's uv (in [0, 1] on screen; -1 none) and view depth of the receiver at P (this pixel).
void deferGiLagPrev(vec3 P, out vec2 puv, out float pz)
{
    const vec4 c = ssr.views[CLEAN_VIEW].taa_prev_vp * vec4(P - ssr.cam_origin.xyz, 1.0);
    puv = c.w > 1e-4 ? c.xy / c.w * 0.5 + 0.5 : vec2(-1.0);
    pz = c.w;
#ifdef GI_LAG_MV_BOUND
    if (!(ssr.taa_params.y > 0.5)) return;   // (no motion vectors this frame: camera-only)
    const vec2 R2 = vec2(float(g_draw_push.width), float(g_draw_push.height));
    const vec4 mo = texelFetch(uReuseMotion, ivec3(ivec2(CLEAN_FRAG_XY), DEFER_LAYER), 0);
    const uint cls = receiverMotionClass(mo.w);
    if (cls == 0u || !(mo.z > 0.0) || any(isnan(mo.xy)) || any(isinf(mo.xy))) return;
    const vec2 jit = ssr.taa_params.w > 0.5 ? ssr.taa_jitter.zw * 0.5 : vec2(0.0);
    const vec2 mv = CLEAN_FRAG_XY / R2 - jit - mo.xy;
    // (a static surface keeps the camera-only point: exact in fp32, where the fp16 motion vector is not)
    if (cls == 1u && c.w > 1e-4)
    {
        const vec2 dpx = (mv - puv) * R2;
        if (!(dot(dpx, dpx) > 0.25)) return;
    }
    puv = mv;
    pz = mo.z;
#endif
}
#define GI_MOV_CONSUMER
#include "clean_gi_movers.glsl"   // (RenderVKGIMoverSamples: giMoverFetch -- deferReflIn)
// (RenderVKGIMoverSamples) the mover GI at receiver P: this frame's entry at the pixel, or under GI_F_LAG last frame's
// at the camera reprojection (a 3 x 3 depth search). False: none (not a mover, not listed, over the cap, stale).
bool deferGiMoverRead(vec3 P, out vec3 Em)
{
    Em = vec3(0.0);
    if (all(equal(gi.mov.xy, uvec2(0u)))) return false;   // (a header word: uniform)
    if ((gi.cfg.x & GI_F_LAG) != 0u)
    {
        vec2 puv;
        float pz;
        deferGiLagPrev(P, puv, pz);   // (along the motion vectors: a mover's entry is where IT was last frame)
        if (!(pz > 1e-4) || any(lessThan(puv, vec2(0.0)))) return false;
        return giMoverFetch(puv * vec2(float(g_draw_push.width), float(g_draw_push.height)), pz, true, Em);
    }
    return giMoverFetch(CLEAN_FRAG_XY, dot(P - linfo.cam_pos.xyz, linfo.cam_fwd.xyz), false, Em);
}
// (GI_LAG_REVEAL, RenderVKGILagRevealSearch) THE REVEAL MARCH: a static receiver whose 4 taps and ring found no texel
// on its surface -- the band an orbit / a pan uncovers behind an avatar is many GI texels wide per frame, the ring
// reaches 2 (3 on the axes) -- walks ITS OWN PLANE (P, N) in the world along the line its point moved on screen
// (last frame's uv puv -> this frame's): the same surface was visible beside the occluder's edge last frame along that
// line, ahead of puv when the camera orbits the occluder (the background moves, the occluder stays) and behind it when
// the camera translates (the nearer occluder moves further). Each step is the plane point's exact last-frame uv and
// view depth (taa_prev_vp): a texel counts only within 3 % of the PLANE's depth there and (GI_F_UPS_NORMAL) facing
// within ~25 degrees -- never the occluder in front of it. 8 steps a side out to 1.5 x the motion + 2 texels (at most
// 64), nearest first. Before, these pixels fell to the radiance cache's cell at P or, with none (a surface hidden longer
// than the cache's eviction age has none), to NO GI: the probes' / sky ambient with no specular or haze occlusion --
// a lighter, blue band in the occluder's shape. Returns the texel, or (-1, -1).
ivec2 deferGiLagRevealMarch(vec3 P, vec3 N, vec2 puv, ivec2 dims, bool fin, bool nrm, int gpar)
{
    const mat4 pvp = ssr.views[CLEAN_VIEW].taa_prev_vp;
    const vec3 Pr = P - ssr.cam_origin.xyz;
    // (static receivers only: a mover's puv follows its motion vector, and its plane last frame is not this one)
    const vec4 c0 = pvp * vec4(Pr, 1.0);
    const vec2 D = vec2(dims);
    if (!(c0.w > 1e-4) || any(greaterThan(abs((c0.xy / c0.w * 0.5 + 0.5 - puv) * D), vec2(0.5)))) return ivec2(-1);
    const vec4 c1 = ssr.views[CLEAN_VIEW].taa_cur_vp * vec4(Pr, 1.0);
    if (!(c1.w > 1e-4)) return ivec2(-1);
    const vec2 d = c1.xy / c1.w * 0.5 + 0.5 - puv;   // (uv: where the point moved since last frame)
    const float Ld = length(d * D);                   // (... in GI texels)
    if (!(Ld > 1.5) || isinf(Ld)) return ivec2(-1);   // (the ring above covered a smaller step)
    // the plane's tangents and how a metre along each moves its last-frame uv (finite difference at 1 % of the depth)
    const vec3 Tx = normalize(abs(N.z) < 0.9 ? cross(N, vec3(0.0, 0.0, 1.0)) : cross(N, vec3(1.0, 0.0, 0.0)));
    const vec3 Ty = cross(N, Tx);
    const float h = max(0.01 * c0.w, 0.005);
    const vec4 cx = pvp * vec4(Pr + h * Tx, 1.0);
    const vec4 cy = pvp * vec4(Pr + h * Ty, 1.0);
    if (!(cx.w > 1e-4) || !(cy.w > 1e-4)) return ivec2(-1);
    const vec2 jx = (cx.xy / cx.w * 0.5 + 0.5 - puv) / h;
    const vec2 jy = (cy.xy / cy.w * 0.5 + 0.5 - puv) / h;
    const float det = jx.x * jy.y - jx.y * jy.x;
    if (!(abs(det) > 1e-12) || isinf(det)) return ivec2(-1);   // (edge-on: the plane has no screen extent)
    // the plane displacement whose last-frame uv moves by d (t = 1)
    const vec3 T = ((jy.y * d.x - jy.x * d.y) / det) * Tx + ((jx.x * d.y - jx.y * d.x) / det) * Ty;
    const float tmax = min(1.5 + 2.0 / Ld, 64.0 / Ld);
    const ivec2 mx = dims - 1;
    [[dont_unroll]] for (int k = 1; k <= 16; ++k)
    {
        const float t = (k & 1) != 0 ? float((k + 1) >> 1) * (tmax / 8.0) : -float(k >> 1) * (tmax / 8.0);
        const vec4 cp = pvp * vec4(Pr + t * T, 1.0);
        if (!(cp.w > 1e-4)) continue;
        const vec2 uq = cp.xy / cp.w * 0.5 + 0.5;
        if (any(lessThan(uq, vec2(0.0))) || any(greaterThan(uq, vec2(1.0)))) continue;
        const ivec2 q = clamp(ivec2(floor(uq * D)), ivec2(0), mx);
        const float az = abs((fin ? imageLoad(uGiIn, ivec3(q, PDN_L(0))) : imageLoad(uGiOut, ivec3(q, PDN_L(0)))).a);
        if (!(az > 0.0) || abs(az - cp.w) >= max(cp.w * 0.03, 0.05)) continue;
        if (nrm && abs(dot(N, pdnUnpackN(imageLoad(uGiGeom, ivec3(q, PDN_L(gpar))).y))) < 0.9) continue;
        g_gi_lag_src = 1u;
        return q;
    }
    return ivec2(-1);
}
vec3 deferGiFetchLag(vec3 P, vec3 N, out bool ok, out float skyVis)
{
    ok = false;
    skyVis = 1.0;
    g_gi_lag_src = 0u;
    // (RenderVKGILagRevealSearch: prm4.w's bit 1 under GI_F_LAG; bit 0 the GEOM parity)
    const bool lagReveal = ((int(gi.prm4.w + 0.5) >> 1) & 1) != 0;
    // Last frame's GI is stale as a whole after a cut / a skipped trace, or after a global recovery (the
    // change list's overflow: the cache restarted too). A HARD change sphere at P is not a reason: this mode
    // shows every change one frame late, and last frame's GI is what that frame had; the trace after this
    // combine restarts the history inside the sphere. (Rejecting it there sent every pixel inside to the
    // probes for a frame -- light without GI's occlusion: a flash at each geometry change.) A surface the
    // change moved fails the taps' depth / normal tests below as any disocclusion does.
    const bool stale = (gi.cfg.x & GI_F_LAG_STALE) != 0u || ssr.taa_params.z > 0.5 || (gi.sph_n.y & 1u) != 0u;
    vec2 puv;
    float pz;
    deferGiLagPrev(P, puv, pz);
    if (!stale && pz > 1e-4 && all(greaterThanEqual(puv, vec2(0.0))) && all(lessThanEqual(puv, vec2(1.0))))
    {
        const bool fin = (gi.cfg.x & GI_F_FINAL_IN) != 0u;
        const ivec2 dims = fin ? imageSize(uGiIn).xy : imageSize(uGiOut).xy;
        const ivec2 mx = dims - 1;
        const vec2 f = puv * vec2(dims) - 0.5;
        const ivec2 b = ivec2(floor(f));
        const vec2 fr = f - vec2(b);
        const float tol = max(pz * 0.03, 0.05);   // (pz: last frame's view depth of P)
        const bool nrm = (gi.cfg.x & GI_F_UPS_NORMAL) != 0u;
        const int gpar = int(gi.prm4.w + 0.5) & 1;
        vec4 bw, e, inf;
        vec4 tc[4];
        float tv[4];
        [[unroll]] for (int k = 0; k < 4; ++k)
        {
            const ivec2 o = ivec2(k & 1, k >> 1);
            const ivec2 q = clamp(b + o, ivec2(0), mx);
            bw[k] = (o.x == 1 ? fr.x : 1.0 - fr.x) * (o.y == 1 ? fr.y : 1.0 - fr.y);
            tc[k] = fin ? imageLoad(uGiIn, ivec3(q, PDN_L(0))) : imageLoad(uGiOut, ivec3(q, PDN_L(0)));
            tv[k] = (fin ? imageLoad(uGiIn, ivec3(q, PDN_L(1))) : imageLoad(uGiOut, ivec3(q, PDN_L(1)))).r;
            const float az = abs(tc[k].a);
            e[k] = az > 0.0 ? abs(az - pz) / tol : 1e30;
            inf[k] = tc[k].a < 0.0 ? 0.05 : 1.0;
            if (nrm && az > 0.0)
            {
                const float cn = clamp(abs(dot(N, pdnUnpackN(imageLoad(uGiGeom, ivec3(q, PDN_L(gpar))).y))), 0.0, 1.0);
                inf[k] *= max(pow(cn, 8.0), 1e-3);
                // (GI_LAG_REVEAL) a tap facing over 60 degrees away is another surface, not a weight: the
                // occluder's silhouette within 3 % of a revealed neck / shoulder / hair behind it (the soft
                // weight alone normalised back to the occluder's GI when all four taps lay on it)
                if (lagReveal && cn < 0.5) e[k] = 1e30;
            }
        }
        if (min(min(e.x, e.y), min(e.z, e.w)) < 1.0)
        {
            const vec4 w = upsampleWeights4(bw, e, inf);
            vec3 col = vec3(0.0);
            float v = 0.0;
            [[unroll]] for (int k = 0; k < 4; ++k) { col += w[k] * tc[k].rgb; v += w[k] * tv[k]; }
            ok = true;
            skyVis = clamp(v, 0.0, 1.0);
            return col;
        }
        // REVEALED SURFACE (the camera moves around an avatar / a pillar: the static wall behind it comes into
        // view): last frame's point lies on the occluder, so no tap there is on this surface. The same surface was
        // usually visible right beside the occluder's edge last frame: the best texel on it among the 4 x 4's outer
        // ring and 4 more 3 texels out (the axes) (depth within the tolerance, then the normal; point-sampled), with its own
        // sky visibility. Before, these pixels took the radiance cache's cell -- or the probes / sky ambient where
        // there was none -- with the sky visibility 1: no specular occlusion and the full haze sky, so newly
        // revealed surfaces showed lighter and BLUE (the unoccluded sky specular and haze) for a few frames.
        float best = 1e30;
        ivec2 bq = ivec2(-1);
        const ivec2 cq = ivec2(floor(f + 0.5));
        [[dont_unroll]] for (int k = 0; k < 20; ++k)
        {
            ivec2 q;
            if (k < 16)
            {
                const ivec2 o = ivec2(k & 3, k >> 2) - 1;
                if (o.x >= 0 && o.x <= 1 && o.y >= 0 && o.y <= 1) continue;   // (the 4 taps above)
                q = b + o;
            }
            else
            {
                const ivec2 kDir[4] = ivec2[4](ivec2(3, 0), ivec2(-3, 0), ivec2(0, 3), ivec2(0, -3));
                q = cq + kDir[k - 16];
            }
            if (any(lessThan(q, ivec2(0))) || any(greaterThan(q, mx))) continue;
            const float az = abs((fin ? imageLoad(uGiIn, ivec3(q, PDN_L(0))) : imageLoad(uGiOut, ivec3(q, PDN_L(0)))).a);
            if (!(az > 0.0)) continue;
            const float eq = abs(az - pz) / tol;
            if (eq >= 1.0) continue;
            const float c = clamp(abs(dot(N, pdnUnpackN(imageLoad(uGiGeom, ivec3(q, PDN_L(gpar))).y))), 0.0, 1.0);
            if (nrm && c < 0.9) continue;   // (another face: a corner's other wall)
            const float sc = eq + 2.0 * (1.0 - c);
            if (sc < best) { best = sc; bq = q; }
        }
        if (bq.x < 0 && lagReveal) bq = deferGiLagRevealMarch(P, N, puv, dims, fin, nrm, gpar);
        if (bq.x >= 0)
        {
            ok = true;
            skyVis = clamp((fin ? imageLoad(uGiIn, ivec3(bq, PDN_L(1))) : imageLoad(uGiOut, ivec3(bq, PDN_L(1)))).r, 0.0, 1.0);
            return (fin ? imageLoad(uGiIn, ivec3(bq, PDN_L(0))) : imageLoad(uGiOut, ivec3(bq, PDN_L(0)))).rgb;
        }
    }
    if ((gi.cfg.x & GI_F_CACHE) != 0u && giCacheSlots() != 0u)
    {
        const vec3 cam = pc.u_cam_time.xyz;
        const vec3 Nv = dot(N, CL_VIEW_EYE(linfo, P, cam) - P) < 0.0 ? -N : N;   // (the trace's cell rule: N toward the viewer)
        float edge;
        const int level = giCellLevel(P, cam, edge);
        const uint axis = giCellAxis(Nv);
        const uint bucket = giCellBucket(Nv, axis);
        const ivec3 cq = ivec3(floor(P / edge));
        vec3 E;
        if (giCacheReadLag(giCacheFind(giCellKeyQ(cq, level, bucket)), E))
        {
            // (the cell keeps no sky visibility: -1 = derive it from the cell's irradiance against the sky / probe
            //  irradiance it replaces -- deferReflIn; before: 1, the full sky specular and haze on a cell-lit pixel)
            ok = true;
            skyVis = -1.0;
            g_gi_lag_src = 2u;
            return E;
        }
        // (GI_LAG_REVEAL) no cell at P: a surface hidden behind the occluder for longer than the cache's eviction age
        // (RenderVKGICacheEvictFrames) has none. The mean of the four cells beside it in its face plane (same level and
        // face bucket), which the parts of it left visible kept alive.
        if (lagReveal)
        {
            vec3 sum = vec3(0.0);
            float n = 0.0;
            [[dont_unroll]] for (int k = 0; k < 4; ++k)
            {
                ivec3 o = ivec3(0);
                o[(axis + 1u + uint(k >> 1)) % 3u] = (k & 1) != 0 ? 1 : -1;
                if (giCacheReadLag(giCacheFind(giCellKeyQ(cq + o, level, bucket)), E)) { sum += E; n += 1.0; }
            }
            if (n > 0.0)
            {
                ok = true;
                skyVis = -1.0;
                g_gi_lag_src = 2u;
                return sum / n;
            }
        }
    }
    g_gi_lag_src = 3u;
    return vec3(0.0);
}
vec3 deferGiFetch(vec3 P, vec3 N, out bool ok, out float skyVis)
{
    if ((gi.cfg.x & GI_F_LAG) != 0u) return deferGiFetchLag(P, N, ok, skyVis);   // (a header word: uniform)
    ok = false;
    skyVis = 1.0;
    const bool fin = (gi.cfg.x & GI_F_FINAL_IN) != 0u;
    const ivec2 dims = fin ? imageSize(uGiIn).xy : imageSize(uGiOut).xy;
    const ivec2 mx = dims - 1;
    const vec2 rr = vec2(dims) / vec2(float(g_draw_push.width), float(g_draw_push.height));
    if (dims.x >= int(g_draw_push.width))
    {
        const ivec2 q = clamp(ivec2(CLEAN_FRAG_XY), ivec2(0), mx);
        const vec4 t = fin ? imageLoad(uGiIn, ivec3(q, PDN_L(0))) : imageLoad(uGiOut, ivec3(q, PDN_L(0)));
        const vec4 t1 = fin ? imageLoad(uGiIn, ivec3(q, PDN_L(1))) : imageLoad(uGiOut, ivec3(q, PDN_L(1)));
        ok = t.a != 0.0;
        skyVis = clamp(t1.r, 0.0, 1.0);
        return t.rgb;
    }
    // (the texels' sample phase this frame: the jitter, or 0 under GI_F_STABLE_SAMPLES -- giRenderPixel)
    const vec2 j = (ssr.taa_params.w > 0.5 && (gi.cfg.x & GI_F_STABLE_SAMPLES) == 0u) ? ssr.taa_jitter.xy : vec2(0.0);
    const vec2 f = CLEAN_FRAG_XY * rr - 0.5 - j;
    const ivec2 b = ivec2(floor(f));
    const vec2 fr = f - vec2(b);
    GIR_PREC const float vz = dot(P - linfo.cam_pos.xyz, linfo.cam_fwd.xyz);
    const float tol = max(vz * 0.03, 0.05);
    const bool nrm = (gi.cfg.x & GI_F_UPS_NORMAL) != 0u;   // (a header word: uniform)
    const int gpar = int(gi.prm4.w + 0.5) & 1;
    vec4 bw, e, inf;
    vec4 tc[4];
    float tv[4];
    [[unroll]] for (int k = 0; k < 4; ++k)
    {
        const ivec2 o = ivec2(k & 1, k >> 1);
        const ivec2 q = clamp(b + o, ivec2(0), mx);
        bw[k] = (o.x == 1 ? fr.x : 1.0 - fr.x) * (o.y == 1 ? fr.y : 1.0 - fr.y);
        tc[k] = fin ? imageLoad(uGiIn, ivec3(q, PDN_L(0))) : imageLoad(uGiOut, ivec3(q, PDN_L(0)));
        tv[k] = (fin ? imageLoad(uGiIn, ivec3(q, PDN_L(1))) : imageLoad(uGiOut, ivec3(q, PDN_L(1)))).r;
        const float az = abs(tc[k].a);
        e[k] = az > 0.0 ? abs(az - vz) / tol : 1e30;
        inf[k] = tc[k].a < 0.0 ? 0.05 : 1.0;
        // (both normals face the viewer: the trace flips its N toward V -- |cos|)
        if (nrm && az > 0.0)
            inf[k] *= max(pow(clamp(abs(dot(N, pdnUnpackN(imageLoad(uGiGeom, ivec3(q, PDN_L(gpar))).y))), 0.0, 1.0), 8.0), 1e-3);
    }
    ok = min(min(e.x, e.y), min(e.z, e.w)) < 1e29;   // (a surface in some tap: the closest stands in)
    if (nrm && ok && min(min(e.x, e.y), min(e.z, e.w)) >= 1.0)
    {
        // no tap on this surface: the best of the 4 x 4's outer ring (depth within the tolerance,
        // then the normal), point-sampled
        float best = 1e30;
        ivec2 bq = ivec2(-1);
        [[dont_unroll]] for (int k = 0; k < 16; ++k)
        {
            const ivec2 o = ivec2(k & 3, k >> 2) - 1;
            if (o.x >= 0 && o.x <= 1 && o.y >= 0 && o.y <= 1) continue;   // (the 4 taps above)
            const ivec2 q = b + o;
            if (any(lessThan(q, ivec2(0))) || any(greaterThan(q, mx))) continue;
            const float az = abs((fin ? imageLoad(uGiIn, ivec3(q, PDN_L(0))) : imageLoad(uGiOut, ivec3(q, PDN_L(0)))).a);
            if (!(az > 0.0)) continue;
            const float eq = abs(az - vz) / tol;
            if (eq >= 1.0) continue;
            const float c = clamp(abs(dot(N, pdnUnpackN(imageLoad(uGiGeom, ivec3(q, PDN_L(gpar))).y))), 0.0, 1.0);
            const float sc = eq + 2.0 * (1.0 - c);
            if (sc < best) { best = sc; bq = q; }
        }
        if (bq.x >= 0)
        {
            skyVis = clamp((fin ? imageLoad(uGiIn, ivec3(bq, PDN_L(1))) : imageLoad(uGiOut, ivec3(bq, PDN_L(1)))).r, 0.0, 1.0);
            return (fin ? imageLoad(uGiIn, ivec3(bq, PDN_L(0))) : imageLoad(uGiOut, ivec3(bq, PDN_L(0)))).rgb;
        }
    }
    const vec4 w = upsampleWeights4(bw, e, inf);
    vec3 c = vec3(0.0);
    float v = 0.0;
    [[unroll]] for (int k = 0; k < 4; ++k) { c += w[k] * tc[k].rgb; v += w[k] * tv[k]; }
    skyVis = clamp(v, 0.0, 1.0);
    return c;
}
// THE GI RULE: where GI ran and has an estimate on this surface, it REPLACES the probes' diffuse
// irradiance (x RenderVKGIIntensity), floored by RenderVKGIMinAmbient x the probes' value (0: a
// sealed room goes dark). The specular stays the probes' / SSR's / RT reflections'. Classic
// atmospherics treat the irradiance as sRGB (lightSurface converts it back): so is GI's.
// SPECULAR OCCLUSION (RenderVKGISpecOcclusion, header cfg bits): the probes' / SSR's / legacy env
// specular (refl.spec, refl.env: PBR IBL, legacy glossenv + shiny env -- every material path takes
// them from here) scaled by what GI saw of the sky: 1 = the sky visibility (the fraction of fresh
// cosine rays that escaped, denoised), 2 = max(that, GI irradiance / the probe irradiance it
// replaced). A sealed room then reflects no sky (the owner's grey sheen on a shiny wood floor, the
// lit-looking quilted walls). Pixels the RT reflections trace (RT mark this frame, spec roughness
// under its threshold) keep their specular: their rays are occluded already.
// (gi-glass) THE CACHE SPECULAR (GIX_CACHE_SPEC, RenderVKGICacheSpec): a rough receiver's specular environment from
// the GI radiance cache instead of a reflection ray. The receiver's own cell (its fill's key: P, the shading normal
// toward the viewer) holds the mean radiance E of the fresh cosine rays its receivers traced (irradiance / pi:
// occluded by construction -- a sealed room's cells hold no sky) and their luminance-weighted MEAN DIRECTION v
// (GIX_CACHE_DIR; clean_gi_common.glsl GI_DIR_BASE). An L1 model of the radiance over the hemisphere fitted to the
// two moments: under cosine sampling a constant field gives v = 2/3 N; the excess e = v - 2/3 N recovers the linear
// term as 4 e (tangential) and 2 e (normal: E[w w^T] = diag(1/4, 1/4, 1/2)). The reflection lobe of roughness r
// convolves that band by g ~ 1 - alpha / 3 (a mirror keeps it, the cosine lobe's 2/3 at alpha 1):
//   L(R) = E x clamp(1 + g (4 e_t . R + 2 e_n R_n), 0, 3) x RenderVKGICacheSpecGain.
// A window's light reaches a rough wall's reflection from the window's side, without a ray, without noise (the
// cell is a mean over many receivers and ~32 frames), at the cache cell's resolution (0.25 m near the camera).
// ok false: no cell / no estimate -- the caller keeps today's specular (the probes / SSR, occluded).
// Cost: up to 4 hash finds + 4 x 16 B cell reads + 4 x 16 B direction reads per lit pixel above 0.75 c.
vec3 deferCacheSpec(SurfaceLit s, vec3 P, out bool ok)
{
    ok = false;
    const vec3 cam = pc.u_cam_time.xyz;
    const vec3 V = linfo.cam_fwd.w > 0.5 ? -linfo.cam_fwd.xyz : normalize(cam - P);
    const vec3 N = dot(s.N, V) < 0.0 ? -s.N : s.N;   // (the fill's normal: giReuseFinish's N)
    // THE FACE-PLANE FILTER (giCacheForward's mode 1): the 4 cells around P in its face's plane, bilinear -- one
    // nearest cell showed the 0.25 m grid as blocks on a wall. The combine runs after this frame's resolve (as the
    // forward reader): the cells as it left them, no change-sphere rejection.
    float edge;
    const int level = giCellLevel(P, cam, edge);
    const uint axis = giCellAxis(N);
    const uint bucket = giCellBucket(N, axis);
    const vec3 gq = P / edge - 0.5;
    ivec3 b = ivec3(floor(gq));
    vec3 fq = gq - vec3(b);
    b[axis] = int(floor(P[axis] / edge));
    fq[axis] = 0.0;
    const uint dirBase = GI_DIR_BASE(giCacheSlots());
    vec3 Es = vec3(0.0), vs = vec3(0.0);
    float ws = 0.0;
    for (int i = 0; i < 8; ++i)
    {
        const ivec3 o = ivec3(i & 1, (i >> 1) & 1, (i >> 2) & 1);
        const vec3 t = mix(1.0 - fq, fq, vec3(o));
        const float wi = t.x * t.y * t.z;
        if (wi < 1e-3) continue;   // (the far layer's corners: weight 0, no find)
        const uint slot = giCacheFind(giCellKeyQ(b + o, level, bucket));
        vec3 Ec;
        bool sp;
        if (!giCacheReadCell(slot, false, Ec, sp)) continue;
        const uint dw = gi_data[dirBase + slot].w;
        Es += wi * Ec;
        vs += wi * ((dw & (1u << 30)) != 0u ? giUnpackDir(dw) : (2.0 / 3.0) * N);
        ws += wi;
    }
    if (!(ws > 0.0)) return vec3(0.0);
    const vec3 E = Es / ws;
    const vec3 v = vs / ws;
    const vec3 e = v - (2.0 / 3.0) * N;
    const float en = dot(e, N);
    const vec3 et = e - en * N;
    const vec3 R = reflect(-V, N);
    const float rough = clamp(dsSpecRough(s), 0.0, 1.0);
    const float g = 1.0 - rough * rough * (1.0 / 3.0);
    const float f = clamp(1.0 + g * (4.0 * dot(et, R) + 2.0 * en * dot(R, N)), 0.0, 3.0);
    vec3 L = max(E, vec3(0.0)) * (f * max(gi.prm.x, 0.0) * max(uintBitsToFloat(gi.xcfg.z), 0.0));
    if (any(isnan(L)) || any(isinf(L))) return vec3(0.0);
    ok = true;
    return atmosClassic() ? atmosLinearToSrgb(L) : L;
}
vec3 g_cs_dbg = vec3(0.0);   // (gi-glass) the reflection-source debug view's colour (GIX_DBG_*)
SurfaceRefl deferReflIn(SurfaceLit s)
{
    SurfaceRefl r = deferReflInBase(s);
    if (giFrameOn() && s.model != SURF_FULLBRIGHT && (gi.cfg.x & GI_F_ON) != 0u)
    {
        bool ok;
        float skyVis;
        vec3 E = deferGiFetch(g_ds_P, s.N, ok, skyVis);
        // (RenderVKGIMoverSamples, clean_gi_movers.glsl) a MOVER pixel's own full-resolution GI where its entry exists;
        // the sky visibility stays the reduced-extent GI's
        vec3 Em;
        if (deferGiMoverRead(g_ds_P, Em)) { E = Em; ok = true; }
        if (ok && !any(isnan(E)) && !any(isinf(E)))
        {
            E = max(E, vec3(0.0)) * max(gi.prm.x, 0.0);
            const vec3 probeIrr = r.irr;
            const vec3 Ec = atmosClassic() ? atmosLinearToSrgb(E) : E;
            if (skyVis < 0.0)
            {
                // (deferGiFetchLag's radiance-cache stand-in: no sky visibility kept) the GI irradiance against the
                // sky / probe irradiance it replaces -- specular-occlusion mode 2's estimate
                const float pl = giLum(probeIrr);
                skyVis = pl > 1e-4 ? clamp(giLum(Ec) / pl, 0.0, 1.0) : 1.0;
            }
            r.irr = max(Ec, probeIrr * clamp(gi.prm.y, 0.0, 1.0));
            // (cel shading's sky-ambient reference: clean_surface_light.glsl g_gi_amb_occ)
            if ((gi.cfg.x & GI_F_CEL_OCC) != 0u) g_gi_amb_occ = max(skyVis, clamp(gi.prm.y, 0.0, 1.0));
            // (GI_F_HAZE_OCC) the haze's sky in-scatter x min(1, 2 x sky visibility): a sealed room 0, a
            // wall under open sky (half the hemisphere) 1, open ground 1
            if ((gi.cfg.x & GI_F_HAZE_OCC) != 0u) g_haze_sky_k = clamp(2.0 * skyVis, clamp(gi.prm.y, 0.0, 1.0), 1.0);
            const uint so = (gi.cfg.x >> GI_SPECOCC_SHIFT) & 3u;
            const bool rtFrame = (g_draw_push.flags & DEFER_FLAG_RT_MARK) != 0u;
            const bool rtTraced = rtFrame && dsSpecRough(s) < float(g_draw_push.flags >> 24u) * (1.0 / 255.0);
            // RT RESIDUAL (GI_F_SPECOCC_RT_RES): an RT-marked pixel's words hold the traced radiance
            // (occluded already) PLUS the probe env its splice left -- a neighbour ray that missed, no
            // ray on its plane (thin / curved silhouettes: mane strands, ears), the roughness /
            // distance / strength fades. Only that residual takes the occlusion (the resolve wrote it
            // into the mark: pass 13). A pixel under the roughness threshold the mark passes did NOT
            // take (strength cutoff, far receiver) is plain probe + SSR: fully occluded. Off: the old
            // rule (every pixel under the threshold keeps its specular).
            bool rtRes = false, rtSkip = rtTraced;
            vec3 resS = vec3(0.0), resE = vec3(0.0);
            if ((gi.cfg.x & GI_F_SPECOCC_RT_RES) != 0u && rtFrame)
            {
                rtSkip = false;
                const ivec2 px = ivec2(CLEAN_FRAG_XY);
                if (rtt_words[rttTileId(uvec2(px >> 3))] != 0u)   // (unlisted: a stale mark; #1608: this view's tile)
                {
                    const uvec4 m = imageLoad(uReflRtMark, DS_TEXEL(px));
                    if (m.z != 0u)
                    {
                        rtRes = true;
                        resS = dsUnpackRGB9E5(m.x);
                        resE = dsUnpackRGB9E5(m.y);
                    }
                }
            }
            if (so != 0u && !rtSkip)
            {
                float occ = skyVis;
                if (so == 2u)
                {
                    const float pl = giLum(probeIrr);
                    occ = max(occ, pl > 1e-4 ? clamp(giLum(Ec) / pl, 0.0, 1.0) : 1.0);
                }
                occ = max(occ, clamp(gi.prm.y, 0.0, 1.0));   // (the minimum ambient floors it too)
                if (rtRes)
                {
                    r.spec = max(r.spec - (1.0 - occ) * resS, vec3(0.0));
                    r.env = max(r.env - (1.0 - occ) * resE, vec3(0.0));
                }
                else
                {
                    r.spec *= occ;
                    r.env *= occ;
                }
                resS *= occ;   // (gi-glass: the residual as it now stands in r.spec)
            }
            // (gi-glass) THE CACHE SPECULAR above the roughness cutoff c (xcfg.y; the RT reflections' threshold is
            // capped at c on the host, so their splice fades out over [0.75 c, c] -- rtrFade -- exactly where this
            // weight w fades in: one cross-fade). A plain pixel: mix(its probe / SSR specular, the cache's, w). An
            // RT-marked one: its probe residual (the splice's untraced share, resS) blends toward w x the cache's, the
            // traced part stays. No cell: unchanged (never black). The legacy shiny env (r.env) is left alone.
            const bool csOn = (gi.xcfg.x & GIX_CACHE_SPEC) != 0u && s.model != SURF_FULLBRIGHT;
            const uint csDbg = gi.xcfg.w;
            if (csOn)
            {
                const float c = uintBitsToFloat(gi.xcfg.y);
                const float rough = dsSpecRough(s);
                const float w = smoothstep(0.75 * c, c, rough);
                bool cok = false;
                const vec3 cs = (w > 0.0 || csDbg == GIX_DBG_SPEC) ? deferCacheSpec(s, g_ds_P, cok) : vec3(0.0);
                if (cok && w > 0.0)
                {
                    if (rtRes) r.spec = max(r.spec - resS, vec3(0.0)) + mix(resS, w * cs, w);
                    else       r.spec = mix(r.spec, cs, w);
                }
                if (csDbg == GIX_DBG_SOURCE)
                    g_cs_dbg = w <= 0.0 ? (rtTraced ? vec3(1.0, 0.0, 0.0) : vec3(0.0, 0.0, 1.0))
                             : (!cok ? vec3(0.0, 0.0, 1.0)
                             : (w < 1.0 ? mix(rtFrame ? vec3(1.0, 0.0, 0.0) : vec3(0.0, 0.0, 1.0), vec3(1.0, 1.0, 0.0), 0.5 + 0.5 * w)
                                        : vec3(0.0, 1.0, 0.0)));
                else if (csDbg == GIX_DBG_SPEC) g_cs_dbg = cs;
            }
        }
    }
    return r;
}
