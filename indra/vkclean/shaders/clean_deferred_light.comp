// (overlay true: org = emOvOrigin, a neighbour through emOvCell) -- normalized by the weights of the cells
// that exist (0: none). dropWeak: weak triangles met here are left out (the overlay blend carries them).
vec3 emLitBlend(vec3 P, vec3 N, vec4 org, bool overlay, bool dropWeak)
{
    const vec3 q = (P - org.xyz) / org.w - 0.5;   // (cell-centre lattice coordinates)
    const vec3 qb = floor(q);
    const vec3 qf = clamp(q - qb, 0.0, 1.0);
