layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer EmGenerationRef { uint words[]; };
uint emInputGeneration(uint id)
{
    return EmGenerationRef(g_draw_push.rtr3.xy).words[id];
}
uint emBudgetIdWord(uint bucket) { return REGIR_EM_BUDGET_BASE + bucket; }
uint emBudgetTicket(uint bucket) { return REGIR_EM_BUDGET_BASE + 2u * EM_BUDGET_OBJECTS + 10u * bucket; }
uint emBudgetOfferWord(uint bucket) { return REGIR_EM_BUDGET_BASE + EM_BUDGET_OBJECTS + bucket; }
void emDiscover()
{
    rt_anim_time = pc.u_cam_time.w;
    const uint lid = gl_LocalInvocationIndex;
    const uint size = min(floatBitsToUint(g_draw_push.rtr.x), min(uint(rt_instances.length()), uint(rt_geom.length())));
    const uint cursor = rg_cells[emCcHdr(10u)].x;
    const uint limit = cursor == 0u ? size : min(size,rg_cells[emCcHdr(10u)].y);
    const uint start = cursor < limit ? cursor : 0u;
    const uint end = ebDiscoveryEnd(start,limit);
    const uint nMat = uint(rt_materials.length());
    const float thr = max(rg.rs_em_params.x, 1e-4);
    uint found = 0u, evicted = 0u;
    for (uint id = start + lid; id < end; id += 64u)
    {
        if (emInputGeneration(id) == 0u) continue; // exhausted allocation identity: safe unavailable
        const uint fl = rt_instances[id].flags;
        if ((fl & (1u | 512u | 8192u | 32u | 2048u)) != 0u) continue;   // (rigged by flag too: the build below)
        const uvec4 geo = rtGeomEmRow(id, emClusterOn());
        if ((geo.w & 0x7FFFFFFFu) == 0u) continue;
        const uint mi = rt_instances[id].material_id;
        if (mi >= nMat) continue;
        vec3 F, Lavg; uint tex, ef;
        if (!(emMatEmission(id, fl, mi, F, Lavg, tex, ef) > thr)) continue;
        const uint bucket = emHashSlot(id), w = emBudgetOfferWord(bucket);
        const uint owner = rg_cells[emBudgetIdWord(bucket)].x <= limit ? rg_cells[emBudgetIdWord(bucket)].x : 0u;
        const uint old = rg_cells[w].x <= limit ? rg_cells[w].x : 0u;
        // One successor per bucket, selected over a COMPLETE frozen address sweep. ID-order
        // round robin, not first atomic winner. Each frame's contiguous span has unique buckets.
        const uint d = ebOfferDistance(id+1u,owner,limit);
        const uint od = ebOfferDistance(old,owner,limit);
        if (d < od || old == id + 1u)
        {
            rg_cells[w] = uvec2(id + 1u,emInputGeneration(id));
            ++found;
        }
    }
    memoryBarrierBuffer();
    barrier(); // every lane read the old cursor before its one writer advances it
    if (lid == 0u)
    {
        rg_cells[emCcHdr(10u)] = uvec2(end < limit ? end : 0u,limit);
        rg_cells[emCcHdr(49u)].y = end >= limit ? 1u : 0u;
        rg_cells[emCcHdr(48u)].x = end - start;
    }
    const uint nf = subgroupAdd(found), ne = subgroupAdd(evicted);
    if (subgroupElect())
    {
        atomicAdd(rg_cells[emCcHdr(48u)].y, nf);
        atomicAdd(rg_cells[emCcHdr(49u)].x, ne);
