#if CLEAN_GI_STAGE == GI_STAGE_HITLIGHT || CLEAN_RT_STAGE == RT_STAGE_LIGHT
// THE RESOLVE: rtHitSunShadow's value from the stored visibility x tint (its max is the visibility, the
// rest the tint), x the cloud layer's sun transmittance (#719) as the inline path multiplies it.
float vqHitSunVis(vec3 P, out vec3 tint)
{
    VqRegion r = vqRegion();
    const uvec4 v = r.q[vqResWord(r, vqDest(r, g_vq_dest, VQ_SLOT_SUN))];
    // A traced ray left the alpha-test cone at the hit's footprint (rtHitSunShadowCore): the hit's later rays
    // see it so -- M1's inline budget / occlusion / blend-layer rays (M2 queued them with it)
    if ((v.w & VQ_RES_WALKED) != 0u) { rt_cone_width0 = rt_surf_foot; rt_cone_spread = 0.0; }
    const vec3 vis = uintBitsToFloat(v.xyz);
    tint = vec3(1.0);
    const float sv = max(max(vis.r, vis.g), vis.b);
    if (sv > 1e-4) tint = vis / sv;
    return sv * cloudShadowMap(P);
}
#ifdef CLEAN_VIS_QUEUE_M2
// (M2) rtHitLocalLights' value: the producer's unshadowed sum minus the blocked parts of the budget's shares,
// in pick order, as the inline loop subtracts them (sum -= share x (1 - vis); the walk formed each product)
vec3 vqHitLocal()
{
    VqRegion r = vqRegion();
    const uint db = vqDest(r, g_vq_dest, 0u);
    const uvec4 sv = r.q[vqResWord(r, db + VQ_SLOT_SUM)];
    vec3 sum = uintBitsToFloat(sv.xyz);
    const uint n = min(sv.w, vqBudgetK(r));
    for (uint j = 0u; j < n; ++j)
