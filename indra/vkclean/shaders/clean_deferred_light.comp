    float len;
    if (ok && rtrStochastic(rough))
    {
        // (STOCHASTIC GLOSSY RAYS above: the long EMA, the loose box, no anti-lag; the variance kept current
        //  for a receiver that crosses RTR_STOCH_ROUGH)
        const vec3 sgL = 1.25 * sigma + 0.02 * max(mu, res) + 1e-4;
        const vec3 hc0 = clamp(h, min(mu, res) - 3.0 * sgL, 8.0 * max(mu, res) + 3.0 * sgL);
        const vec3 hc = rtrLowNGuard() ? mix(h, hc0, clamp((nEff - 1.0) / (RTR_GUARD_N - 1.0), 0.0, 1.0)) : hc0;
        const float a = rtrTemporalAlphaStoch(rough);
        outc = mix(hc, res, a);
        hv = rrtTemporalVar(aux.xyz, res, h);
        len = 1.0 / a;
    }
    else
        outc = rrtResolve(res, mu, sigma + 1e-4, nEff, h, aux.xyz, aux.w, ok, rtrHistFrames(rough), hv, len);
    imageStore(uRtHist, RTH_TEXEL(px, par), vec4(outc, vz));
    imageStore(uRtHist, RTH_TEXEL(px, 2u + par), vec4(hv, len));
