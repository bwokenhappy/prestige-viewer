// ---- (#1036) THE RT REFLECTION SPLIT (RenderVKRTReflectionsShadeSplit; LLCleanRendererVK::
//      recordRtReflect): the list trace's per-ray code (rtrTraceRay) as three kernels over the same
//      indirect dispatch (lane = list entry), handing each other per-ray RECORDS (below):
//   1 TRACE  the receiver + its ray (rtrRayBegin) + the walk (rtrReflWalk) -> the hit record; the
//            trace-cost counters
//   2 MAT    a hit (no back-face stop) -> its material (rtrReflMaterial: rtSurfaceEval, the lying snow
//            / the weather coat) -> the RT LIT RECORD over the hit record, the (snow) hit distance
//   3 LIGHT  every ray: the RT LIT RECORD lit (rtrReflShade), the blend layers + debug views
//            (rtrReflTail: after the material -- the lying snow may shorten the ray they composite
//            over), the store, the hit-shading / light grid counters
// The records hold the first push rtr3.x list entries; the rays past them (a frame over the budget the
// records were sized for) take the fused list kernel as a TAIL dispatch (same rays, same results).
// RT REFLECTION RECORDS (LLCleanRendererVK mRtRec; device address in push rtr3.zw): 7 uvec4 (112 B)
// per list entry:
//   TRACE writes q0 = R.xyz, flags (RTR_REC_*); q1 = t, instance, prim, bary.x (a hit);
//                q2 = bary.y, o2w[0]; q3 = o2w[1], o2w[2].x; q4 = o2w[2].yz, o2w[3].xy;
//                q5 = o2w[3].z, o.xyz; q6 = the ray cone (rt_cone_width0, _spread, _aniso), smallD
//   MAT writes   q1..q4 = the RT LIT RECORD, q5.x = the hit distance (the lying snow's when in front)
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference_uvec2 : require
layout(buffer_reference, std430, buffer_reference_align = 16) buffer RtrRecords { uvec4 q[]; };
#define RTR_REC_WORDS 7u
#define RTR_REC_HIT   1u   // the walk committed a surface
#define RTR_REC_BACK  2u   // ... a single-sided back face it stopped at (REFLECTION BACK-FACE STOP)
#define RTR_REC_FRONT 4u   // the hit's hardware front face (RtHit.front)
// (#1039 M1) the records' address / capacity: the push (rtr3.zw / x) -- or, in the visibility queue's stages
// (their push rtr3.zw names the queue's region), the region header the host wrote; RTR_REC_E0: the first
// entry of the dispatch (the fused LIGHT's tail past the queue's capacity: push rtr3.y; else 0).
#ifdef CLEAN_VIS_QUEUE
#define RTR_REC_ADDR vqRegion().q[2].xy
#define RTR_REC_CAP  vqRegion().q[2].z
#define RTR_REC_E0   0u
#else
#define RTR_REC_ADDR g_draw_push.rtr3.zw
#define RTR_REC_CAP  g_draw_push.rtr3.x
#define RTR_REC_E0   g_draw_push.rtr3.y
#endif
RtrRecords rtrRec() { return RtrRecords(RTR_REC_ADDR); }
// This lane's list entry i (the list trace's numbering) and its pixel; false past the list or past the
// records (their capacity: those are the fused tail's).
bool rtrRecLane(out uint i, out uint e, out ivec2 px)
{
    const uint rb = 2u * rtt_args[3] + 1u;
    i = RTR_REC_E0 + (gl_WorkGroupID.y * RTT_ROW + gl_WorkGroupID.x) * 64u + gl_LocalInvocationIndex;
    e = 0u;
    px = ivec2(0);
    if (i >= min(min(rtt_words[rb], rtt_words[rb + 4u]), RTR_REC_CAP)) return false;
    e = rtt_words[rb + 7u + i];
    px = rttRayPx(e);
    g_rt_view = rttRayView(e);   // (#1608: the entry's view -- every stage calls this first)
    return true;
}
#if CLEAN_RT_STAGE == RT_STAGE_TRACE
void DEFER_MAIN()
{
    uint i, e;
    ivec2 px;
    if (!rtrRecLane(i, e, px)) return;
    rtrQueryBudgetBegin();   // (#1049: the walk's share; LIGHT starts its own)
    vec3 P, o, R, env;
    rtrRayBegin(px, imageLoad(uReflRtMark, DS_TEXEL(px)), rtrGradScaleNow(), P, o, R, env);
