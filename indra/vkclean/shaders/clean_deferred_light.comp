            // length wrote no reflection, and the water FS took its own probe / sky there (rtFwdIn skips a <= 0) --
            // while the next texel's ray, its wave normal a little different, met the cliff 60 m away and spliced it.
            // On wavy water in front of anything near the ray's length the hits and the misses interleave at the
            // half-resolution grid: the resolve's 3 x 3 and its history average the hits only, the FS's bilinear
            // takes a hit texel at full weight wherever one is among the four -- hard-edged dark blocks of the far
            // shore over the probe's sky ("pixelated artifacts on water", RT reflections off: gone). Here a miss
            // takes the water FS's own fallback along the same R (rtWaterReflectDir = the FS's reflect of its
            // wave_ibl normal; sampleProbes at its roughness lod, else the sky), and a hit fades to it over the last
            // RFT_FAR_FADE of the length, so every traced texel is one sample of the same quantity and the resolve
            // blends the boundary instead of switching it. No extra ray: one probe walk per missing texel. Glass /
            // blend layers keep the FS fallback (their miss env goes through the FS's GI occlusion, blendHitEnv).
            // (the hit debug views -- rtrOpts bits 11 / 12 -- keep their colours: a miss shows there as such)
            // (RenderVKRTReflectionsWaterMissEnv, rtrOpts bit 15: off = the FS fallback on a miss, as before)
            const bool waterRecv = ls.model == RT_SURF_WATER && (rtrOpts() & 32768u) != 0u;
            const bool dbgView = (rtrOpts() & (2048u | 4096u)) != 0u;
            const float fe = (!waterRecv || dbgView) ? 0.0 : (t > 0.0 ? smoothstep(RFT_FAR_FADE * tmaxR, tmaxR, t) : 1.0);
            if (fe > 0.0)
            {
                vec3 env, env2, eirr;
                if (!sampleProbesEx(hitP, ngf, R, clamp(ssr.water[2].z, 0.0, 1.0) * phdr.info.y, 0.0, vec3(0.0),
                                    true, false, false, env, env2, eirr))
                    env = rtrRawSky(R, hitP);
                c = mix(c, max(env, vec3(0.0)), fe);
            }
            if (t > 0.0 || waterRecv)
            {
                outv = vec4(c, max(dot(hitP - linfo.cam_pos.xyz, linfo.cam_fwd.xyz), 1e-3));
                rftP = hitP; rftNg = ngf; rftDir = dir; rftT = t;
                // (the virtual image is one point only on a smooth, flat layer: the shading normal on the facet's)
                rftSmooth = rough < 0.25 && dot(nf, ngf) > 0.995 && ls.model != RT_SURF_WATER;
            }
        }
    }
    rtrStatsGuard();   // (#1049)
    }
    // ---- THE RESOLVE (clean_rt_fwd_temporal.h): the same-layer 3 x 3 of this tile, the history, the EMA ----
    const uint lid = gl_LocalInvocationIndex;
    s_rft[lid] = outv;
    s_rfg[lid] = giv;
    s_rfv[lid] = lv;
    s_rfz[lid] = layerZ;
    barrier();
    if (!inGrid) return;
    const ivec2 l = ivec2(gl_LocalInvocationID.xy);
    vec3 m1 = vec3(0.0), m2 = vec3(0.0);
    float n = 0.0;
    if (outv.a > 0.0)
        for (int dy = -1; dy <= 1; ++dy)
            for (int dx = -1; dx <= 1; ++dx)
            {
                const ivec2 q = l + ivec2(dx, dy);
                if (any(lessThan(q, ivec2(0))) || any(greaterThan(q, ivec2(7)))) continue;
                const vec4 s = s_rft[q.y * 8 + q.x];
                if (!rftSameLayer(s.a, outv.a)) continue;
                m1 += s.rgb; m2 += s.rgb * s.rgb; n += 1.0;
            }
    // (a half-resolution grid shorter than RFT_REGIONS regions -- the 1 x 1 placeholder -- keeps no history)
    const bool regions = imageSize(uRtFwd).y >= RFT_REGIONS * hsz.y;
    const uint par = rftFlags() & RFT_PUSH_PARITY;
    const int prevRefl = hsz.y * int(1u + (par ^ 1u)), prevMom = hsz.y * int(3u + (par ^ 1u));
    vec4 res = vec4(0.0);
    vec4 rmom = vec4(0.0);   // (the reflection's temporal variance rgb, length a)
    if (outv.a > 0.0)
    {
        const vec3 mu = m1 / max(n, 1.0);
        const vec3 sg = sqrt(max(m2 / max(n, 1.0) - mu * mu, vec3(0.0)));
        vec3 hist;
        ivec2 hq;
        const bool hok = regions && rftReproject(rftP, rftNg, rftDir, rftT, rftSmooth, hsz, prevRefl, hist, hq);
        const vec4 hm = hok ? imageLoad(uRtFwd, DS_TEXEL(hq + ivec2(0, prevMom))) : vec4(0.0);
        float wR;
        res = vec4(max(rftResolve(outv.rgb, mu, sg, n, hist, hm.rgb, hm.a, hok, rmom.rgb, rmom.a, wR), vec3(0.0)), outv.a);
    }
    else if (layerZ > 0.0)
        res.a = -layerZ;   // (THE LAYER'S GI: the layer's depth without a reflection; rtFwdIn reads a > 0 only)
    // THE LAYER'S GI (see s_rfg): the same resolve over the same-layer 3 x 3 of the reads; the cover wf follows the
    // irradiance's history weight
    vec4 gres = vec4(0.0, 0.0, 0.0, -1.0);   // (a < 0: no GI read here -- rtFwdGiIn skips it)
    vec4 gmom = vec4(0.0);                    // (its temporal variance rgb, length a)
    if (layerZ > 0.0 && regions && rfgOn())
    {
        vec3 g1 = vec3(0.0), g2 = vec3(0.0);
        float gw = 0.0, gn = 0.0;
        for (int dy = -1; dy <= 1; ++dy)
            for (int dx = -1; dx <= 1; ++dx)
            {
                const ivec2 q = l + ivec2(dx, dy);
                if (any(lessThan(q, ivec2(0))) || any(greaterThan(q, ivec2(7)))) continue;
                const int qi = q.y * 8 + q.x;
                if (!rftSameLayer(s_rfz[qi], layerZ)) continue;
                const vec4 s = s_rfg[qi];
                g1 += s.rgb; g2 += s.rgb * s.rgb; gw += s.a; gn += 1.0;
            }
        const vec3 mu = g1 / max(gn, 1.0);
        const vec3 sg = sqrt(max(g2 / max(gn, 1.0) - mu * mu, vec3(0.0)));
        ivec2 gq;
        const bool gok = rfgReproject(rfgP, hsz, prevRefl, gq);
        const vec4 gh = gok ? imageLoad(uRtFwd, DS_TEXEL(gq + ivec2(0, hsz.y * int(6u + (par ^ 1u))))) : vec4(0.0);
        const vec4 gm = gok ? imageLoad(uRtFwd, DS_TEXEL(gq + ivec2(0, hsz.y * int(8u + (par ^ 1u))))) : vec4(0.0);
        const bool ghok = gok && gh.a >= 0.0 && all(lessThan(abs(gh), vec4(60000.0)));
        float wG;
        const vec3 ge = max(rftResolve(giv.rgb, mu, sg, gn, gh.rgb, gm.rgb, gm.a, ghok, gmom.rgb, gmom.a, wG), vec3(0.0));
        const float wfS = gn > 1.5 ? mix(gw / gn, giv.a, RFT_SPATIAL_SELF) : giv.a;
        gres = vec4(ge, clamp(ghok ? mix(gh.a, giv.a, wG) : wfS, 0.0, 1.0));
    }
    imageStore(uRtFwd, DS_TEXEL(hp), res);
    if (regions)
    {
        imageStore(uRtFwd, DS_TEXEL(hp + ivec2(0, hsz.y * int(1u + par))), res);
        imageStore(uRtFwd, DS_TEXEL(hp + ivec2(0, hsz.y * int(3u + par))), min(rmom, vec4(60000.0)));
        imageStore(uRtFwd, DS_TEXEL(hp + ivec2(0, hsz.y * 5)), gres);
        imageStore(uRtFwd, DS_TEXEL(hp + ivec2(0, hsz.y * int(6u + par))), gres);
        imageStore(uRtFwd, DS_TEXEL(hp + ivec2(0, hsz.y * int(8u + par))), min(gmom, vec4(60000.0)));
    }
    // THE LAYER'S LIGHT (see rfvLight): the same resolve over the same-layer 3 x 3 of this frame's terms, the layer
    // point's history; a its alpha (this frame's)
    vec4 vres = vec4(0.0);   // (a 0: no record here -- the FS lights the layer itself)
    vec4 vmom = vec4(0.0);
    if (layerZ > 0.0 && regions && lv.a > 0.0)
    {
        vec3 v1 = vec3(0.0), v2 = vec3(0.0);
        float vn = 0.0;
        for (int dy = -1; dy <= 1; ++dy)
            for (int dx = -1; dx <= 1; ++dx)
            {
                const ivec2 q = l + ivec2(dx, dy);
                if (any(lessThan(q, ivec2(0))) || any(greaterThan(q, ivec2(7)))) continue;
                const int qi = q.y * 8 + q.x;
                if (!rftSameLayer(s_rfz[qi], layerZ) || !(s_rfv[qi].a > 0.0)) continue;
                const vec3 t = s_rfv[qi].rgb;
                v1 += t; v2 += t * t; vn += 1.0;
            }
        const vec3 mu = v1 / max(vn, 1.0);
        const vec3 sg = sqrt(max(v2 / max(vn, 1.0) - mu * mu, vec3(0.0)));
        ivec2 vq;
        const bool vok = rfgReproject(rfgP, hsz, prevRefl, vq);
        const vec4 vh = vok ? imageLoad(uRtFwd, DS_TEXEL(vq + ivec2(0, hsz.y * int(11u + (par ^ 1u))))) : vec4(0.0);
        const vec4 vm = vok ? imageLoad(uRtFwd, DS_TEXEL(vq + ivec2(0, hsz.y * int(13u + (par ^ 1u))))) : vec4(0.0);
        const bool vhok = vok && vh.a > 0.0 && all(lessThan(abs(vh), vec4(60000.0))) && !any(isnan(vh));
        float wV;
        const vec3 ve = clamp(rftResolve(lv.rgb, mu, sg, vn, vh.rgb, vm.rgb, vm.a, vhok, vmom.rgb, vmom.a, wV),
                              vec3(0.0), vec3(1.0));
        vres = vec4(ve, lv.a);
    }
    if (regions)
    {
        imageStore(uRtFwd, DS_TEXEL(hp + ivec2(0, hsz.y * 10)), vres);
        imageStore(uRtFwd, DS_TEXEL(hp + ivec2(0, hsz.y * int(11u + par))), vres);
        imageStore(uRtFwd, DS_TEXEL(hp + ivec2(0, hsz.y * int(13u + par))), min(vmom, vec4(60000.0)));
    }
}
