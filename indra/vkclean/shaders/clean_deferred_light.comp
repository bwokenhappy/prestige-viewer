// The pixel's slot ids (layer 0), loaded on the first shadowed projector the light loop
// asks about and kept for the rest of it (one load per pixel, not one per projector).
uint g_ds_proj_ids = 0u;
bool g_ds_proj_ids_ok = false;
#define PROJ_DEFER_REST_ID 0xFFu   // (clean_lights_common.glsl THE REST SLOT; included below)
vec3 deferProjVis(uint light)
{
    if ((g_draw_push.flags & DEFER_FLAG_PROJ) == 0u) return vec3(1.0);
    const ivec2 px = ivec2(CLEAN_FRAG_XY);
    if (!g_ds_proj_ids_ok)   // (no slot -- most pixels: the only load)
    {
        g_ds_proj_ids = imageLoad(uVisProj, DS_PROJ_TEXEL(px, 0)).x;
        g_ds_proj_ids_ok = true;
    }
    const uint ids = g_ds_proj_ids;
    if (ids == 0u) return vec3(1.0);
    // its own slot, else the REST slot (clean_lights_common.glsl THE REST SLOT; the shadow pass
    // listed every shadowed projector the combine lights here in one of them). Neither: the
    // shadow pass gated it off (no direct light here) -- unshadowed is exact.
    uint want = light + 1u;
    if (want >= PROJ_DEFER_REST_ID) want = PROJ_DEFER_REST_ID;   // (254 / 255: REST members)
    bool own = false;
    [[unroll]] for (uint k = 0u; k < 4u; ++k) own = own || ((ids >> (k * 8u)) & 0xFFu) == want;
    if (!own) want = PROJ_DEFER_REST_ID;
    [[unroll]] for (uint k = 0u; k < 4u; ++k)
        if (((ids >> (k * 8u)) & 0xFFu) == want)
        {
            const uint sh = k * 8u;
            vec3 e = vec3(float((imageLoad(uVisProj, DS_PROJ_TEXEL(px, 1)).x >> sh) & 0xFFu) / 255.0);
            if ((g_draw_push.flags & DEFER_FLAG_PROJ_RGB) != 0u)
            {
                e.g = float((imageLoad(uVisProj, DS_PROJ_TEXEL(px, 2)).x >> sh) & 0xFFu) / 255.0;
                e.b = float((imageLoad(uVisProj, DS_PROJ_TEXEL(px, 3)).x >> sh) & 0xFFu) / 255.0;
            }
            return e * e;   // (sqrt-encoded: finer steps in the penumbra's dark end)
        }
    return vec3(1.0);
}
