#ifdef CLEAN_GI_MOVER
// ---- (RenderVKGIMoverSamples) FULL-RESOLUTION GI ON MOVER PIXELS: LIST / TRACE (clean_gi_movers.glsl) ----
// push: the GI trace's (rtr.x the ray length, rtr.y the hit options, rtr.w the anisotropy, rtr2 the GI extent /
// frame / parity), rtr.z < 0 LIST, else TRACE -- |rtr.z| the list's cap; rtr3.zw the mover buffer.
#include "clean_receiver_motion.glsl"
#include "clean_gi_movers.glsl"
// A MOVER pixel: the skinned class, or a rigid surface whose motion vector departs from the camera-only
// reprojection of its point by more than half a pixel (a moving prim, flexi). Only with this frame's motion vectors.
bool giMovIsMover(ivec2 px, vec2 R2)
{
    if (!(ssr.taa_params.y > 0.5)) return false;
    const vec4 mo = texelFetch(uReuseMotion, ivec3(px, DEFER_LAYER), 0);
    const uint cls = receiverMotionClass(mo.w);
    if (cls == 2u) return true;
    if (cls != 1u || !(mo.z > 0.0)) return false;
    const vec3 P = deferPosition(px);
    const vec4 c = ssr.views[CLEAN_VIEW].taa_prev_vp * vec4(P - ssr.cam_origin.xyz, 1.0);
    if (!(c.w > 1e-4)) return false;
    const vec2 jit = ssr.taa_params.w > 0.5 ? ssr.taa_jitter.zw * 0.5 : vec2(0.0);
    const vec2 dpx = ((vec2(px) + 0.5) / R2 - jit - mo.xy - (c.xy / c.w * 0.5 + 0.5)) * R2;
    return dot(dpx, dpx) > 0.25;
}
void DEFER_MAIN()
{
    const vec2 R2 = vec2(float(g_draw_push.width), float(g_draw_push.height));
    const ivec2 Ri = ivec2(R2);
    GiMoverBuf mb = GiMoverBuf(g_draw_push.rtr3.zw);
    const uint cap = uint(abs(g_draw_push.rtr.z) + 0.5);
    if (g_draw_push.rtr.z < 0.0)
    {
        // LIST: one lane per render pixel
        const ivec2 px = ivec2(gl_GlobalInvocationID.xy);
        if (any(greaterThanEqual(px, Ri)) || !giMovIsMover(px, R2)) return;
        const uint i = atomicAdd(mb.e[0].x, 1u);
        if (i >= cap) { atomicAdd(mb.e[0].y, 1u); return; }
        mb.e[4u + (i >> 1u)][i & 1u] = uint(px.y) * uint(Ri.x) + uint(px.x);
        if ((i & 63u) == 0u) atomicAdd(mb.e[2].x, 1u);   // (the TRACE's workgroups: 64 entries each)
        return;
    }
    // TRACE: one lane per listed pixel
    const uint ent = gl_WorkGroupID.x * 64u + gl_LocalInvocationIndex;
    if (ent >= min(mb.e[0].x, cap)) return;
    const uint pix = mb.e[4u + (ent >> 1u)][ent & 1u];
    const ivec2 rp = ivec2(int(pix % uint(Ri.x)), int(pix / uint(Ri.x)));
    const ivec2 D = ivec2(g_draw_push.rtr2.xy + 0.5);
    const uint frame = uint(g_draw_push.rtr2.z + 0.5);
    const int par = int(uint(g_draw_push.rtr2.w + 0.5) & 1u);
    g_frag_xy = vec2(rp) + 0.5;
    const vec4 g2 = defTexel(uG2, rp);
    if (!deferHasSurface(g2)) return;   // (no entry: the reduced-extent GI)
    float glow;
    bool noFade;
    const SurfaceLit s = deferSurface(rp, g2, glow, noFade);
    if (s.model == SURF_FULLBRIGHT) return;
    const vec3 P = deferPosition(rp);
    const vec3 cam = pc.u_cam_time.xyz;
    const vec3 V = linfo.cam_fwd.w > 0.5 ? -linfo.cam_fwd.xyz : normalize(cam - P);
    const vec3 Ng = dot(s.Ng, V) < 0.0 ? -s.Ng : s.Ng;
    const vec3 N = dot(s.N, V) < 0.0 ? -s.N : s.N;
    GIR_PREC const float vz = dot(P - linfo.cam_pos.xyz, linfo.cam_fwd.xyz);
    const float camd = length(P - cam);
    // ---- the fresh sample: the pixel's own cosine ray (its footprint: one render pixel), shaded as the GI trace's ----
    vec3 d, o;
    bool traced;
    giFreshRay(rp + ivec2(40503, 9973), frame, vec2(1.0), P, N, Ng, V, camd, d, o, traced);   // (traced: always here)
    vec3 xs = P, ns = N;
    bool hit = false;
    float hdist = 0.0;
    g_gi_lamp_why = 0u;
    const vec3 L = giTrace(o, d, max(g_draw_push.rtr.x, 1.0), P, xs, ns, hit, hdist);
    float c0, q0;
    const float p0 = giFreshTarget(N, d, true, L, c0, q0);
    GiSample y0 = GiSample(xs, ns, L, hit ? hdist : 0.0, hit ? abs(dot(ns, -d)) : 1.0);
    GiSample y = y0;
    float wsum = p0 / q0, Msum = 1.0, py = p0;
    bool reused = false;
    // ---- the GI texels covering this pixel: this frame's reservoirs, reconnected (giTap: same surface only) ----
    if ((gi.cfg.x & GI_F_RES) != 0u)
    {
        uint rng = giPcg(uint(rp.x) * 7919u + uint(rp.y) * 104729u + frame * 15485863u + 0x9E3779B9u);
        const vec2 tc = (vec2(rp) + 0.5) * vec2(D) / R2 - 0.5 - giSampleJitter(D.x);
        const ivec2 b = ivec2(floor(tc));
        const float mcap = max(gi.prm2.x, 1.0);
        [[dont_unroll]] for (int k = 0; k < 4; ++k)
        {
            GiSample yt;
            float pt, Mt;
            uint tcg;
            const float wt = giTap(b + ivec2(k & 1, k >> 1), D, uint(par), vz, max(0.04 * vz, 0.03), P, N, mcap, yt, pt,
                                   Mt, tcg);
            if (!(Mt > 0.0)) continue;
            wsum += wt; Msum += Mt;
            if (giRand(rng) * wsum < wt) { y = yt; py = pt; reused = true; }
        }
    }
    float W = (py > 0.0 && wsum > 0.0) ? wsum / (py * Msum) : 0.0;
    if (reused)
    {
        // the reused pick's visibility from THIS pixel (one ray; blocked: the fresh sample alone)
        const vec3 v = y.xs - o;
        const float dl = length(v);
        const vec3 dv = v / max(dl, 1e-6);
        const float tm = y.dist > 0.0 ? rtReuseSegEnd(y.xs, dl, abs(dot(y.ns, dv))) : max(g_draw_push.rtr.x, 1.0);
        bool visOk = true;
        if (tm > 0.0)
        {
            giRayCone(rp, vec2(1.0), P);
            visOk = traceShadowRay(o, dv, 0.0, tm, RT_MASK_SHADOW & ~RT_MASK_BLEND) > 0.5;
        }
        if (!visOk)
        {
            y = y0; reused = false;
            W = p0 > 0.0 ? (p0 / q0) / p0 : 0.0;
        }
    }
    if (!(W > 0.0) || !(W < 3.0e38)) W = 0.0;
    // the estimate (giReuseFinish's): L x cos / pi x W -- the fresh sample's own cosine c0, a reused one's toward x_s
    GIR_PREC const float cyr = dot(N, giNormalize(y.xs - P));
    const float cy = reused ? max(cyr, 0.0) : c0;
    vec3 S = y.L * (cy * (1.0 / 3.14159265)) * W;
    if (any(isnan(S)) || any(isinf(S))) S = vec3(0.0);
    {
        const float clampR = gi.prm2.w, l = giLum(S);
        if (clampR > 0.0 && l > clampR) S *= clampR / l;
    }
    // ---- the pixel's HISTORY along its own motion: last frame's entry at the reprojected pixel (3 x 3 depth match) ----
    const uint WH = uint(Ri.x * Ri.y);
    const uint hb = giMovHistBase(cap);
    const uint stamp = frame & GI_MOV_STAMP_MASK, pstamp = (frame - 1u) & GI_MOV_STAMP_MASK;
    const vec4 mo = texelFetch(uReuseMotion, ivec3(rp, DEFER_LAYER), 0);
    vec3 E = S;
    float len = 1.0;
    if (ssr.taa_params.y > 0.5 && ssr.taa_params.z < 0.5 && mo.z > 0.0)
    {
        const vec2 jit = ssr.taa_params.w > 0.5 ? ssr.taa_jitter.zw * 0.5 : vec2(0.0);
        const ivec2 pc0 = ivec2(floor(((vec2(rp) + 0.5) / R2 - jit - mo.xy) * R2));
        const uint pbase = hb + ((frame - 1u) & 1u) * WH;
        const float tol = max(0.03 * mo.z, 0.03);
        float best = 1.0;
        vec3 hE = vec3(0.0);
        float hl = 0.0;
        for (int k = 0; k < 9; ++k)
        {
            const ivec2 q = pc0 + ivec2(k % 3 - 1, k / 3 - 1);
            if (any(lessThan(q, ivec2(0))) || any(greaterThanEqual(q, Ri))) continue;
            vec3 Eq; float zq, lq; uint sq;
            giMovUnpack(mb.e[pbase + uint(q.y * Ri.x + q.x)], Eq, zq, lq, sq);
            if (sq != pstamp || !(lq > 0.0)) continue;
            const float e = abs(zq - mo.z) / tol;
            if (e < best) { best = e; hE = Eq; hl = lq; }
        }
        if (hl > 0.0)
        {
            // (the GI denoiser's light-change rules, short: a change sphere at the receiver -- an emitter's light /
            //  geometry changed --, or its radiance-cache cell CHANGED (the sealed-room fade): at most 2 frames)
            float hcap = GI_MOV_HIST;
            if (giSphereHit(P, 0.0) != 0u) hcap = 2.0;
            else if ((gi.cfg.x & GI_F_CACHE) != 0u && giCacheSlots() != 0u)
            {
                float edge;
                const uint slot = giCacheFind(giCellKey(P, N, cam, edge));
                if (slot != 0xFFFFFFFFu && ((gi_data[3u * giCacheSlots() + slot].w >> 8u) & 0xFFu) != 0u) hcap = 2.0;
            }
            len = min(hl + 1.0, hcap);
            E = mix(hE, S, 1.0 / len);
        }
    }
    mb.e[hb + (frame & 1u) * WH + pix] = giMovPack(E, vz, len, stamp);
}
#elif defined(CLEAN_GI_LAYER)
// ---- (RenderVKGILayerFill) THE FRONT BLEND LAYER AS A GI RECEIVER: the radiance cache's cells on alpha-blend surfaces ----
// The cache is filled by the GI receivers only -- the opaque G-buffer texels (giReuseFinish) -- and keyed by the
// normal's dominant axis, so a surface that only an alpha-blend layer occupies (a cloud's underside, a window pane
// away from any wall) had no cell or a few stray ones from opaque geometry that happened to share the box: the
// layer's forward read (giForwardRefl / pass 14's THE LAYER'S GI) fell back cell by cell -- the static light / dark
// mosaic of #1499. This stage makes the FRONT layer a receiver: per frame one half-resolution texel in 8 (each 2 x 2
// group on its own hashed phase: every texel once in 8 frames) finds the front-most blend layer along its camera ray exactly as pass 14 does
// (the block's centre ray, RT_MASK_BLEND, alpha >= RTR_FWD_MIN_ALPHA; water and fullbright layers read no cache),
// traces ONE fresh cosine ray from it with the GI trace's own hit shading (giTrace) and adds that estimate
// (irradiance / pi: the fresh sample L) to the layer point's cell -- inserted if new -- as every receiver does. The
// cell then resolves, ages and invalidates like any other. Deeper layers read the same cells where they share them.
// push: the GI trace's (rtr.x the ray length, rtr.y the hit options, rtr.w the anisotropy, rtr2.z the frame).
// One lane per 2 x 2 group of half-resolution texels (8 x 8 workgroups over ((W + 1) / 2 + 1) / 2 x the same in y).
void DEFER_MAIN()
{
    if ((gi.cfg.x & GI_F_CACHE_FILL) == 0u || giCacheSlots() == 0u) return;   // (header words: uniform)
    const ivec2 full = ivec2(g_draw_push.width, g_draw_push.height);
    const ivec2 hsz = (full + 1) / 2;
    const uint frame = uint(g_draw_push.rtr2.z + 0.5);
    // (the budget) one half-resolution texel in 8 a frame: each 2 x 2 group on its OWN phase of 8 (a hash of the group and
    // the 8-frame cycle) -- active on the even phases, its texels in turn: every texel once in 8 frames. NOT a screen-wide
    // pattern (a checkerboard swapping every 4 frames, the texel of each group in step, until 2026-11-19): then every cell
    // took its samples from the same sub-positions the same frames -- a bias that follows the light's gradient across the
    // cell, the same sign in every cell of a region at once and for 4 frames running. The cache's change test sums its
    // cells' departures as independent (clean_gi_common.glsl THE CHANGE BINS): it read the correlated bias as a light
    // change, held the region CHANGED (one-frame means, re-armed every swap) -- a cloud's underside flickering in cell-sized
    // light and dark specks until the cache was reset. Hashed per group, each frame's subset of a cell is a random one.
    const ivec2 lane = ivec2(gl_GlobalInvocationID.xy);
    const uint ph = (frame + giPcg(uint(lane.x) ^ giPcg(uint(lane.y) ^ giPcg(frame >> 3u)))) & 7u;
    if ((ph & 1u) != 0u) return;
    const ivec2 hp = lane * 2 + ivec2(int((ph >> 1u) & 1u), int(ph >> 2u));
    if (any(greaterThanEqual(hp, hsz))) return;
    const ivec2 px = min(hp * 2 + 1, full - 1);   // (pass 14's block centre ray)
    const vec2 spx = vec2(hp * 2) + 1.0;
    g_frag_xy = vec2(px) + 0.5;
    const vec3 cam = pc.u_cam_time.xyz;
    const vec3 dir = rtrViewDir(spx);
    const float d = defTexel(uDepthG, px).r;
    const float tmaxCam = d > 0.0 ? length(rtrPositionAt(px) - cam) * 0.999 : 4096.0;
    const float pa = rtrPixelAngle(spx) * 2.0;
    rt_cone_width0 = 0.0;
    rt_cone_spread = pa;
    rt_cone_aniso  = max(g_draw_push.rtr.w, 1.0);
    rt_anim_time = pc.u_cam_time.w;
    rtrQueryBudgetBegin();
    const RtHit h = rtrClosest(cam, dir, 0.0, tmaxCam, RT_MASK_BLEND, RTR_FWD_MIN_ALPHA, gl_RayFlagsNoneEXT);
    if (!h.hit) return;
    const RtSurface ls = rtSurfaceEval(h, dir);
    if (ls.model == RT_SURF_WATER || ls.model == RT_SURF_FULLBRIGHT) return;
    const vec3 V = -dir;
    const vec3 P = ls.P;
    const vec3 N = dot(ls.N, V) < 0.0 ? -ls.N : ls.N;      // (the viewer's side: the forward read's normal)
    const vec3 Ng = dot(ls.Ng, V) < 0.0 ? -ls.Ng : ls.Ng;
    const float camd = length(P - cam);
    // ---- the fresh sample: a cosine ray off the layer's viewer side (footprint: the 2 x 2 block), shaded as the GI trace's ----
    vec3 rd, o;
    bool traced;
    giFreshRay(hp + ivec2(52711, 33331), frame, vec2(2.0), P, N, Ng, V, camd, rd, o, traced);   // (traced: ignored)
    vec3 xs = P, ns = N;
    bool hit = false;
    float hdist = 0.0;
    g_gi_lamp_why = 0u;
    vec3 S = giTrace(o, rd, max(g_draw_push.rtr.x, 1.0), P, xs, ns, hit, hdist);   // (cosine pdf: the estimate is L)
