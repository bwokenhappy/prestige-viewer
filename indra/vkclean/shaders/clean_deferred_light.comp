#ifdef DEFER_VIS_DEPTH
// The visibility reuse record of a lit surface pixel (uVisDepth above): the view depth, negative when the
// sun was not evaluated here, and the oct geometric normal; 0 for fullbright.
void visDepthStore(ivec2 px, const SurfaceLit s, vec3 P, bool sunWant)
{
    uint d = 0u;
    if (s.model != SURF_FULLBRIGHT)
    {
        const float vz = max(dot(P - linfo.cam_pos.xyz, linfo.cam_fwd.xyz), 1e-3);
        const uvec2 q = uvec2(clamp(gbOctEncode(s.Ng) * 0.5 + 0.5, vec2(0.0), vec2(1.0)) * 255.0 + 0.5);
        d = (packHalf2x16(vec2(sunWant ? vz : -vz, 0.0)) & 0xFFFFu) | (q.x << 16) | (q.y << 24);
    }
    imageStore(uVisDepth, DS_TEXEL(px), uvec4(d));
}
