    const uint w = b * LVC_TEXELS + t;
    return uintBitsToFloat(rg_cells[LVC_RAW_BASE + w / 2u][w & 1u]);
}
void lvcFinalize()
{
    const uint gid = gl_WorkGroupID.x * 64u + gl_LocalInvocationIndex;
    const uint b = gid / (LVC_TEXELS / 2u), t0 = (gid % (LVC_TEXELS / 2u)) * 2u;
    const uvec2 h = rg_cells[LVC_HDR_BASE];
    if (b >= min(h.y, LVC_BUILD_MAX)) return;
    const uint li = (rg_cells[LVC_HDR_BASE + 1u].x >> (8u * b)) & 0xFFu;
    const vec4 L = lights[li].pos_radius;
    const uint slot = rg_cells[LVC_LI_BASE + li].x & LVC_LI_SLOT;
    // (THE DISC'S PARALLAX: a real ray leaves a point of the light's disc -- up to rs_params.x off the centre -- so near
    //  an occluder at distance D it runs up to disc / D radians off the centre ray this map traced. The 3 x 3 window holds
    //  one texel (>= LVC_TEXEL_MIN rad anywhere on a face); where the nearest hit of the window is close enough for the
    //  disc to shift a ray by more, the window widens to cover it (up to 7 x 7), and past that the texel reads open.
    //  The first verify runs found the downstairs light's stairwell edge exactly there: rays through the opening from
    //  a disc point that the centre rays called blocked.)
    const float disc = rg.rs_params.x;
    vec2 v = vec2(L.w);
    for (uint k = 0u; k < 2u; ++k)
    {
        const uint t = t0 + k;
        const uint face = t / (LVC_FACE_RES * LVC_FACE_RES), r = t % (LVC_FACE_RES * LVC_FACE_RES);
        const int x = int(r % LVC_FACE_RES), y = int(r / LVC_FACE_RES);
        float m = 0.0, dmin = 1e30;
        int win = 1;
        bool open_ = false;
        [[dont_unroll]] for (int pass = 0; pass < 2 && !open_; ++pass)
        {
            if (x - win < 0 || y - win < 0 || x + win > int(LVC_FACE_RES) - 1 || y + win > int(LVC_FACE_RES) - 1)
            { open_ = true; break; }   // (the window leaves the face: open)
            m = 0.0; dmin = 1e30;
            for (int dy = -win; dy <= win; ++dy)
                for (int dx = -win; dx <= win; ++dx)
                {
                    const float h = lvcRawLoad(b, face * (LVC_FACE_RES * LVC_FACE_RES) + uint(y + dy) * LVC_FACE_RES + uint(x + dx));
                    m = max(m, h); dmin = min(dmin, h);
                }
            // (the texels the disc can shift a ray by at the window's nearest hit, + the texel itself)
            const int need = 1 + int(ceil(disc / max(dmin, 1e-3) / LVC_TEXEL_MIN));
            if (need <= win) break;
            if (need > 3) { open_ = true; break; }
            win = need;
        }
        v[k] = open_ ? L.w : min(m, L.w);
    }
    const uint w = slot * (LVC_TEXELS / 2u) + (t0 >> 1u);
    rg_cells[LVC_MAP_BASE + (w >> 1u)][w & 1u] = packHalf2x16(v);
    if (t0 == 0u)
    {   // (the slot's pose and build frame: usable from the next frame's PLAN unless marked dirty after)
        const uint sb = LVC_SLOT_BASE + slot * 4u;
        rg_cells[sb + 1u] = floatBitsToUint(L.xy);
        rg_cells[sb + 2u] = floatBitsToUint(vec2(L.z, L.w));
        rg_cells[sb + 3u].x = lvcFrame();
        rg_cells[sb].y = rg_cells[sb].y | LVC_ST_VALID;
        lvcStat(LVC_S_MAP_DONE, 1u);
    }
}
void DEFER_MAIN()
{
    const uint mode = g_draw_push.rtr3.z;
    if (mode == 0u) lvcAssign();
    else if (mode == 1u) lvcDirty();
    else if (mode == 2u) lvcPlan();
    else if (mode == 3u) lvcBuild();
    else if (mode == 4u) lvcFinalize();
}
