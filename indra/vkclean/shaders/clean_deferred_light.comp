// (#1031) The samples' receiver for VIS / SUNVIS -- the fused kernel's receiver section line for line:
// texel m's render pixel, surface, position, view depth, depth sample and the ShadowRecv (+ the self-
// shadow owner, the noise phase). False: no surface (SELECT stored the texel).
bool pdnVisRecv(ivec2 m, ivec2 D, uint frame, out SurfaceLit s, out vec3 P, out float vz, out float dR,
