uint g_vq_bn = 0u;
uint g_vq_bl[RT_SHADE_PROJ_MAXK];
vec3 g_vq_bs[RT_SHADE_PROJ_MAXK];
void vqBudgetOut(uint projK, float sc[RT_SHADE_PROJ_MAXK], uint li[RT_SHADE_PROJ_MAXK], vec3 sh[RT_SHADE_PROJ_MAXK])
{
    g_vq_bn = 0u;
    [[unroll]] for (uint j = 0u; j < RT_SHADE_PROJ_MAXK; ++j)
    {
        // (the inline loop's: j < projK, up to the first empty slot)
        if (g_vq_bn == j && j < projK && sc[j] > 0.0) g_vq_bn = j + 1u;
        g_vq_bl[j] = li[j];
        g_vq_bs[j] = sh[j];
    }
}
#define RT_SHADE_BUDGET_OUT(projK, kScore, kLight, kShare) vqBudgetOut(projK, kScore, kLight, kShare)
