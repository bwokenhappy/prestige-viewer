#ifdef REUSE_MV_BOUND
// (#1038) RESERVOIR REPROJECTION OF A MOVING SURFACE (the GI trace's GI_F_REUSE_MV, pass 15's
// RS_F_REUSE_MV): the reservoirs' temporal candidate was looked up at the CAMERA-ONLY previous point
// (giPrevDelta / pdnPrevDelta: this frame's P seen from last frame's camera) -- on a walking / dancing
// avatar that is where the body was NOT last frame, so its texels lost every temporal candidate (and the
// disocclusion taps around it found the background) for as long as it moved. dS (in: the camera-only
// delta of texel m, extent D, sampling render pixel rp) becomes the motion vectors' (the denoisers'
// reprojection, clean_dn_temporal.comp); returns the extra depth tolerance (m) for the camera-only
// expected depth pw: the surface's own sideways motion through last frame's projection (it moved toward /
// away from the camera by about as much), at most 25 % of pw. Static surfaces: dS unchanged, 0. Only
// while the frame info says the motion vectors were written this frame (taa_params.y).
float reuseMotionDelta(ivec2 m, ivec2 rp, vec2 D, float pw, inout vec2 dS)
{
    if (!(ssr.taa_params.y > 0.5) || !(pw > 0.0)) return 0.0;
    const vec2 R2 = vec2(float(g_draw_push.width), float(g_draw_push.height));
    const vec2 mv = texelFetch(uReuseMotion, ivec3(rp, DEFER_LAYER), 0).xy;
    const vec2 jit = ssr.taa_params.w > 0.5 ? ssr.taa_jitter.zw * 0.5 : vec2(0.0);
    const vec2 puv = (vec2(rp) + 0.5) / R2 - jit - mv;
    const vec2 dM = puv * D - 0.5 - vec2(m);
    if (any(isnan(dM)) || any(isinf(dM))) return 0.0;
    const vec2 dd = clamp(dM, vec2(-30000.0), vec2(30000.0)) - dS;
    dS += dd;
    const vec2 pk = vec2(abs(ssr.views[CLEAN_VIEW].prev_proj[0][0]), abs(ssr.views[CLEAN_VIEW].prev_proj[1][1]));
    if (!(length(dd) > 0.5) || !(pk.x > 0.05 && pk.y > 0.05)) return 0.0;
    return min(length(dd / D * 2.0 / pk) * pw, 0.25 * pw);
}
