// The lanes' one-sided CDFs at x profile mm (1/2 from SSS_RADIUS_MM on).
void sssCdf(float x, out vec3 c1, out vec3 c2)
{
    const float t = pow(clamp(x * (1.0 / SSS_RADIUS_MM), 0.0, 1.0), 1.0 / 3.0) * float(SSS_CDF_N);
    const int j = min(int(t), SSS_CDF_N - 1);
    const float f = t - float(j);
    c1 = mix(s_sssCdf1[j].xyz, s_sssCdf1[j + 1].xyz, f);
    c2 = mix(s_sssCdf2[j].xyz, s_sssCdf2[j + 1].xyz, f);
}
