void DEFER_MAIN()
{
    const int lx = int(gl_LocalInvocationID.x);
    const int across = int(gl_WorkGroupID.y);
    const int along0 = int(gl_WorkGroupID.x) * SSS_SEG;
    const ivec2 px = sssAt(along0 + lx, across);
    const bool inside = px.x < int(g_draw_push.width) && px.y < int(g_draw_push.height);
    g_frag_xy = vec2(px) + 0.5;
    if (gl_LocalInvocationIndex == 0u) { s_sssAny = 0u; s_sssReach = 0u; s_sssMax = 0u; }
    barrier();
    const vec4 g2 = inside ? defTexel(uG2, px) : vec4(0.0);
    const bool skin = inside && gbufferIsSkin(g2);
    const float scale = float(g_draw_push.flags & 0xFFFFu) * (1.0 / 1000.0);   // (the host clamps it > 0)
    // The angle one pixel subtends along the axis (the lateral step at distance d: theta d).
    const float theta = distance(normalize(sssPos(px, 0.5)), normalize(sssPos(px + SSS_AXIS, 0.5)));
    // 1. This pixel's reach (px): profile mm per px from its step along the surface.
    float reach = 0.0, stepRatio = 1.0;   // (stepRatio: screen step / surface step, the reach view)
    if (skin)
    {
        const float d0 = defTexel(uDepthG, px).r;
        const vec3 P0 = sssPos(px, d0);
        const float lat = distance(sssPos(px + SSS_AXIS, d0), P0);   // the screen step at this depth
        float best = SSS_TILT_MAX * lat, step = lat;
        for (int sd = -1; sd <= 1; sd += 2)
        {
            const ivec2 q = px + sd * SSS_AXIS;
            if (!sssIsSkin(q)) continue;
            const float l = distance(sssPos(q, defTexel(uDepthG, q).r), P0);
            if (l <= best) { best = l; step = max(l, lat); }
        }
        stepRatio = lat / max(step, 1e-12);
        reach = SSS_RADIUS_MM / max(step * 1000.0 / max(scale, 1e-6), 1e-9);
        if (!(reach < 1e6)) reach = 0.0;   // (NaN / inf: nothing scatters)
        atomicOr(s_sssAny, 1u);
        atomicMax(s_sssReach, floatBitsToUint(reach));
    }
    barrier();
    const uint debug = (g_draw_push.flags >> 16u) & 7u;
#ifdef CLEAN_SSS_VERTICAL
    if (s_sssAny == 0u)
    {
        if (inside && debug != 0u && debug != SSS_DBG_RULER) sssDebugStore(px, vec3(0.0));
        return;
    }
#else
    if (s_sssAny == 0u) return;
#endif
    // 2. The staging (uniform): the apron covers the widest reach + the interpolation's next texel;
    // B texels per entry so the run + aprons fit SSS_ENT_MAX entries.
    const int apronPx = int(ceil(uintBitsToFloat(s_sssReach))) + 2;
    int B = 1;
    while (B < SSS_BLOCK_MAX && SSS_SEG / B + 2 * ((apronPx + B - 1) / B) > SSS_ENT_MAX) B *= 2;
    const int apronE = min((apronPx + B - 1) / B, (SSS_ENT_MAX - SSS_SEG / B) / 2);
    const int L = SSS_SEG / B + 2 * apronE;           // entries
    const int K = (L + SSS_SEG - 1) / SSS_SEG;        // contiguous entries per thread (<= SSS_K_MAX)
    const int base = along0 - apronE * B;             // the first entry's first texel (along)
    vec3 e1[SSS_K_MAX], e2[SSS_K_MAX];
    int en[SSS_K_MAX];
    float vmax = 0.0;
    for (int j = 0; j < SSS_K_MAX; ++j)
    {
        e1[j] = vec3(0.0); e2[j] = vec3(0.0); en[j] = 0;
        const int e = lx * K + j;
        if (j >= K || e >= L) continue;
        float dsum = 0.0, dprev = -1.0;
        bool jump = false;
        for (int t = 0; t < B; ++t)
        {
            vec3 v1, v2;
            float d;
            if (!sssTexel(sssAt(base + e * B + t, across), v1, v2, d)) { dprev = -1.0; continue; }
            if (dprev >= 0.0 && abs(d - dprev) > SSS_TILT_MAX * theta * min(d, dprev)) jump = true;
            dprev = d;
            e1[j] += v1; e2[j] += v2; en[j] += 1; dsum += d;
        }
        vmax = max(vmax, max(max(e1[j].r, max(e1[j].g, e1[j].b)), max(e2[j].r, max(e2[j].g, e2[j].b))));
        s_sssQ[e] = ivec4(floatBitsToInt(en[j] > 0 ? dsum / float(en[j]) : -1.0), jump ? 1 : 0, 0, 0);
    }
    if (vmax > 0.0) atomicMax(s_sssMax, floatBitsToUint(vmax));
    if (gl_LocalInvocationIndex <= uint(SSS_CDF_N))
    {
        s_sssCdf1[gl_LocalInvocationIndex] = vec4(SSS_CDF1[gl_LocalInvocationIndex], 0.0);
        s_sssCdf2[gl_LocalInvocationIndex] = vec4(SSS_CDF2[gl_LocalInvocationIndex], 0.0);
    }
    barrier();
    // 3. Barriers and the fixed-point values; each thread's inclusive sums over its entries.
    // inv: SSS_QUANT over (entries x texels per entry x the brightest entry), so every prefix sum
    // and every centre x skin count product stays within 2^29.
    const float vtop = uintBitsToFloat(s_sssMax);
    const float inv = vtop > 0.0 ? SSS_QUANT / (float(L) * float(B) * vtop) : 0.0;
    ivec4 inc1[SSS_K_MAX];
#ifdef CLEAN_SSS_VERTICAL
    ivec4 inc2[SSS_K_MAX];
    ivec4 run2 = ivec4(0);
#else
    int inc2[SSS_K_MAX];
    int run2 = 0;
#endif
    ivec4 run1 = ivec4(0);
    for (int j = 0; j < SSS_K_MAX; ++j)
    {
        const int e = lx * K + j;
        int bar = 0;
        if (j < K && e < L && en[j] > 0)
        {
            const float d = intBitsToFloat(s_sssQ[e].x);
            bool cut = s_sssQ[e].y != 0 || (e > 0 && s_sssQ[e - 1].y != 0);
            if (!cut)
            {
                // The nearest skin entry before this one: a depth jump to it, or none within SSS_GAP.
                bool found = false;
                for (int g = 1; g <= SSS_GAP && e - g >= 0; ++g)
                {
                    const float dg = intBitsToFloat(s_sssQ[e - g].x);
                    if (dg < 0.0) continue;
                    found = true;
                    cut = abs(d - dg) > SSS_TILT_MAX * theta * float(g * B) * min(d, dg);
                    break;
                }
                if (!found && e > SSS_GAP) cut = true;
            }
            bar = cut ? 1 : 0;
        }
        run1 += ivec4(ivec3(floor(e1[j] * inv + 0.5)), en[j]);
#ifdef CLEAN_SSS_VERTICAL
        run2 += ivec4(ivec3(floor(e2[j] * inv + 0.5)), bar);
#else
        run2 += bar;
#endif
        inc1[j] = run1;
        inc2[j] = run2;
    }
    barrier();
    // 4. The scan across threads (Hillis-Steele over the per-thread totals), then each thread's
    // entries as prefix sums at index entry + 1 (index 0: zero).
    s_sssQ[lx] = run1;
    s_sssQ2[lx] = run2;
    barrier();
    for (int d = 1; d < SSS_SEG; d <<= 1)
    {
        const ivec4 a1 = lx >= d ? s_sssQ[lx - d] : ivec4(0);
#ifdef CLEAN_SSS_VERTICAL
        const ivec4 a2 = lx >= d ? s_sssQ2[lx - d] : ivec4(0);
#else
        const int a2 = lx >= d ? s_sssQ2[lx - d] : 0;
#endif
        barrier();
        s_sssQ[lx] += a1;
        s_sssQ2[lx] += a2;
        barrier();
    }
    const ivec4 off1 = lx > 0 ? s_sssQ[lx - 1] : ivec4(0);
#ifdef CLEAN_SSS_VERTICAL
    const ivec4 off2 = lx > 0 ? s_sssQ2[lx - 1] : ivec4(0);
#else
    const int off2 = lx > 0 ? s_sssQ2[lx - 1] : 0;
#endif
    barrier();
    for (int j = 0; j < SSS_K_MAX; ++j)
    {
        const int e = lx * K + j;
        if (j >= K || e >= L) continue;
        s_sssQ[e + 1] = off1 + inc1[j];
        s_sssQ2[e + 1] = off2 + inc2[j];
    }
    if (lx == 0)
    {
        s_sssQ[0] = ivec4(0);
#ifdef CLEAN_SSS_VERTICAL
        s_sssQ2[0] = ivec4(0);
#else
        s_sssQ2[0] = 0;
#endif
    }
    barrier();
    if (!skin)
    {
#ifdef CLEAN_SSS_VERTICAL
        if (inside && debug != 0u && debug != SSS_DBG_RULER) sssDebugStore(px, vec3(0.0));
#endif
        return;
    }
    // 5. This pixel: the centre's lane values, then the bins on both sides.
#ifdef CLEAN_SSS_VERTICAL
    const uint w1 = imageLoad(uSssTmp, sssTmpAt(px, 0)).x;
    const vec3 Sc1 = dsUnpackRGB9E5(w1), Sc2 = dsUnpackRGB9E5(imageLoad(uSssTmp, sssTmpAt(px, 1)).x);
    if (debug == 1u) { sssDebugStore(px, vec3(1.0)); return; }
    const vec3 S0 = dsUnpackRGB9E5(imageLoad(uSssDiff, DS_TEXEL(px)).x);
    if (debug == 3u) { sssDebugStore(px, S0); return; }
#else
    const uint w1 = imageLoad(uSssDiff, DS_TEXEL(px)).x;
    const vec3 Sc1 = dsUnpackRGB9E5(w1), Sc2 = Sc1.rrg;
#endif
    vec3 acc1 = vec3(0.0), acc2 = vec3(0.0);
    float barL = 1e9, barR = 1e9;   // px from the centre to the nearest barrier on each side (the reach view)
    // (the whole profile inside half a pixel: nothing scatters; past the widest staging the kernel
    // narrows to the apron -- SSS_BLOCK_MAX-texel entries, ~3400 px)
    const float reachPx = min(reach, float(apronE * B - 1));
    if (reachPx >= 0.5 && inv > 0.0)
    {
        const float mmPerPx = SSS_RADIUS_MM / reachPx;
        const ivec3 c1 = ivec3(floor(Sc1 * inv + 0.5)), c2 = ivec3(floor(Sc2 * inv + 0.5));
        const float iB = 1.0 / float(B);
        const float uc = (float(lx + apronE * B) + 0.5) * iB;   // the centre (entries)
        // The nearest barriers: boundaries limL <= the centre's entry < limR.
        int limL = 0, limR = L;
        if (SSS_BARS(L) != 0)
        {
            const int ce = min(int(uc), L - 1);
            const int f0 = SSS_BARS(ce + 1);   // barriers at boundaries <= ce
            if (SSS_BARS(L) != f0)
            {
                int lo = ce + 1, hi = L - 1;   // the first boundary b > ce with a barrier
                while (lo < hi) { const int mid = (lo + hi) >> 1; if (SSS_BARS(mid + 1) > f0) hi = mid; else lo = mid + 1; }
                limR = lo;
                barR = (float(limR) - uc) * float(B);
            }
            if (f0 != 0)
            {
                int lo = 0, hi = ce;           // the last boundary b <= ce with a barrier
                while (lo < hi) { const int mid = (lo + hi + 1) >> 1; if (SSS_BARS(mid) < f0) lo = mid; else hi = mid - 1; }
                limL = lo;
                barL = (uc - float(limL)) * float(B);
            }
        }
        const float uL = float(limL), uR = float(limR);
        SssPt pR = sssPt(clamp(uc + 0.5 * iB, uL, uR), L, c1, c2);
        SssPt pL = sssPt(clamp(uc - 0.5 * iB, uL, uR), L, c1, c2);
        vec3 lo1, lo2;
        sssCdf(0.5 * mmPerPx, lo1, lo2);                          // (the centre bin's end)
        const int dense = min(int(ceil(reachPx - 0.5)), SSS_DENSE_PX);
        const int nb = dense + (reachPx > float(dense) + 0.5 ? SSS_TAIL : 0);
        const float a0 = float(dense) + 0.5;
        float r0 = 0.5;
        for (int i = 1; i <= nb; ++i)
        {
            // Bin [r0, r] px on both sides: texel bins, then quadratic widths to the reach; the
            // last one's mass runs to infinity.
            const float tt = float(i - dense) * (1.0 / float(SSS_TAIL));
            const float r = i <= dense ? float(i) + 0.5 : a0 + (reachPx - a0) * tt * tt;
            vec3 hi1 = vec3(0.5), hi2 = vec3(0.5);
            if (i < nb) sssCdf(r * mmPerPx, hi1, hi2);
            const SssPt nR = sssPt(clamp(uc + r * iB, uL, uR), L, c1, c2);
            const SssPt nL = sssPt(clamp(uc - r * iB, uL, uR), L, c1, c2);
            vec3 sR1, sR2, sL1, sL2;
            sssSpan(pR, nR, sR1, sR2);
            sssSpan(nL, pL, sL1, sL2);
            const float iw = 1.0 / (r - r0);
            acc1 += (hi1 - lo1) * iw * (sR1 + sL1);
            acc2 += (hi2 - lo2) * iw * (sR2 + sL2);
            lo1 = hi1; lo2 = hi2; pR = nR; pL = nL; r0 = r;
        }
        acc1 /= inv;
        acc2 /= inv;
    }
    if (any(isnan(acc1)) || any(isinf(acc1)) || any(isnan(acc2)) || any(isinf(acc2))) { acc1 = vec3(0.0); acc2 = vec3(0.0); }
#ifndef CLEAN_SSS_VERTICAL
    // (the reach view: this pass's reach, step ratio and nearest barriers for the vertical pass to
    //  show -- word 0 the reach's float bits, word 1 the step ratio x 255 | the barrier px each side)
    if (debug == SSS_DBG_REACH)
    {
        imageStore(uSssTmp, sssTmpAt(px, 0), uvec4(floatBitsToUint(reachPx)));
        imageStore(uSssTmp, sssTmpAt(px, 1), uvec4(uint(clamp(stepRatio, 0.0, 1.0) * 255.0 + 0.5)
                                                   | (uint(min(barL, 4095.0)) << 8u) | (uint(min(barR, 4095.0)) << 20u)));
        return;
    }
    // Every skin pixel is written (the vertical pass reads any skin texel), at the centre's own
    // exponent: unchanged lanes pack back to the irradiance's exact values.
    const uint eMin = w1 >> 27u;
    imageStore(uSssTmp, sssTmpAt(px, 0), uvec4(sssPack(max(Sc1 + acc1, vec3(0.0)), eMin)));
    imageStore(uSssTmp, sssTmpAt(px, 1), uvec4(sssPack(max(Sc2 + acc2, vec3(0.0)), eMin)));
#else
    if (debug == SSS_DBG_REACH)
    {
        // The narrower axis's reach (hue band) and steeper step (brightness); either pass's barriers.
        const uint h1 = imageLoad(uSssTmp, sssTmpAt(px, 1)).x;
        const float reachH = uintBitsToFloat(imageLoad(uSssTmp, sssTmpAt(px, 0)).x);
        const float r = min(reachH, reachPx);
        const float ratio = min(float(h1 & 0xFFu) * (1.0 / 255.0), stepRatio);
        const float barH = min(float((h1 >> 8u) & 0xFFFu), float(h1 >> 20u)), barV = min(barL, barR);
        vec3 c = SSS_DBG_BAND[clamp(int(floor(log2(max(r, 1.0)))), 0, 10)] * (0.3 + 0.7 * ratio);
        if ((barH < reachH || barV < reachPx) && ((px.x + px.y) & 7) < 2) c *= 0.3;
        const float bar = min(barH, barV);
        if (sssGrid(px).y > 0.0) c = vec3(0.0);
        if (bar <= 1.0) c = vec3(1.0);
        sssDebugStore(px, c);
        return;
    }
    // sum_lane w (lane - irradiance): an unchanged pixel is exactly zero (the weights' float sum
    // never enters).
    const vec3 d1 = Sc1 + acc1 - S0, d2 = Sc2 + acc2 - S0.rrg;
    const vec3 delta = vec3(SSS_LANE_W1.r * d1.r + SSS_LANE_W2.x * d2.x + SSS_LANE_W2.y * d2.y,
                            SSS_LANE_W1.g * d1.g + SSS_LANE_W2.z * d2.z,
                            d1.b);
    float glow;
    bool noFade;
    const SurfaceLit s = gbufferUnpack(defTexel(uG0, px), vec4(0.0), g2, vec4(0.0), glow, noFade);
    const vec3 change = sssDiffuseColor(s) * delta;
    if (debug == 2u) { sssDebugStore(px, abs(change) * 16.0); return; }
    if (debug == SSS_DBG_RULER)
    {
        // The lit result with the world mm grid; magenta where this pass's barrier sits.
        const vec4 lit = imageLoad(uHdrOut, ivec3(px, DEFER_LAYER));
        vec3 c = max(lit.rgb + change, vec3(0.0));
        const vec3 g = sssGrid(px);
        if (g.x > 0.0 && g.z >= 4.0) c *= 0.55;
        if (g.y > 0.0) c = vec3(0.0, 1.0, 0.0);
        if (min(barL, barR) <= 1.0) c = vec3(1.0, 0.0, 1.0);
        sssDebugStore(px, c);
        return;
    }
    if (all(equal(delta, vec3(0.0)))) return;
    const vec4 lit = imageLoad(uHdrOut, ivec3(px, DEFER_LAYER));
    imageStore(uHdrOut, ivec3(px, DEFER_LAYER), vec4(max(lit.rgb + change, vec3(0.0)), lit.a));
#endif
}

#elif CLEAN_DEFER_PASS == 7
// ---- BASE (feature split, #827; see FEATURE SPLIT in the header): the combine without the local
// lights -- 8x8 (no tile mask, no shared state: finer occupancy steps), every pixel. Its output is
// final wherever LOCAL adds nothing (tiles the classification left out, pixels no light reaches).
void DEFER_MAIN()
{
    const ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if (px.x >= int(g_draw_push.width) || px.y >= int(g_draw_push.height)) return;
    CLK_INV();
    g_frag_xy = vec2(px) + 0.5;
    const vec4 g2 = defTexel(uG2, px);
    const bool visFill = (g_draw_push.flags & DEFER_FLAG_VIS_FILL) != 0u;   // (#823: no SHADOW pass wrote the record)
    if (!deferHasSurface(g2))
    {
        writeLitOutput(px, vec3(0.0), 0.0, false);   // pass 1's clear; the sky draws over it (no gain: LOCAL skips it)
        if (visFill) imageStore(uVisDepth, DS_TEXEL(px), uvec4(0u));
        CLK_MARK(STORE);
        return;
    }
    CLK_SURF();
    const vec3 P = deferPosition(px);
    float glow;
    bool noFade;
    const SurfaceLit s = deferSurface(px, g2, glow, noFade);
    g_ds_P = P;
    if (visFill) visDepthStore(px, s, P, false);
    g_sss_want = s.skin && sssFrameOn();   // (SKIN SUBSURFACE SCATTERING: lightSurface leaves its diffuse terms)
    CLK_MARK(GBUF);
    const vec4 lit = lightSurface(s, P, 1.0);   // (CLEAN_LOCAL_EXTERNAL: the local sum is an exact 0)
    CLK_MARK(SHADE);
    const vec3 color = surfacePost(s.model, noFade, lit.rgb, P);
    CLK_MARK(HAZE);
    writeLitOutput(px, color, glow, true);
    // The local gain of the lit models (fullbright takes no local light: LOCAL skips it unread).
    if (s.model != SURF_FULLBRIGHT)
    {
        const float gain = surfaceLocalGain(noFade, P);
        imageStore(uLocalGain, DS_TEXEL(px), vec4(gain, 0.0, 0.0, 0.0));
        if (g_sss_want) sssExport(px, s, gain);
    }

    CLK_MARK(STORE);
}

#elif CLEAN_DEFER_PASS == 8
// ---- LOCAL (feature split, #827; see FEATURE SPLIT in the header): one 16x16 workgroup per
// LISTED tile (vkCmdDispatchIndirect; workgroup i = tl_tiles[i]). The light set as the combine
// finds it -- the tile's grid mask (pass 9 built it, DEFER_FLAG_LIGHT_GRID) -> shared (+ the #815
// staging copy), or the pixel's froxel cell (_FROXEL) -- and the SAME localLights call with
// lightSurface's own arguments (its common tail: N = s.N, V, the PBR / legacy inputs, g_cel),
// projector visibility from the shadow pass's slots (deferProjVis). Then BASE's output + the
// sum x BASE's gain (FEATURE SPLIT: the affine tail's slope), glow from the new colour.
void DEFER_MAIN()
{
    const uint lid = gl_LocalInvocationIndex;
    const uint tilesX = (g_draw_push.width + TILE - 1u) / TILE;   // (the push width: no workgroup grid to read)
    g_tile = tl_tiles[gl_WorkGroupID.x];
    // (#1608 STEREO: the tile's view and its row within that view's grid -- deferTileIndex's numbering; one view:
    //  the row is the index's, as before)
    const uint tilesY = (g_draw_push.height + TILE - 1u) / TILE;
    const uint tileRow = g_tile / tilesX;
    g_local_view = kViewCount > 1 ? tileRow / tilesY : 0u;
    const uint tileY = kViewCount > 1 ? tileRow % tilesY : tileRow;
    const bool froxel = (g_draw_push.flags & DEFER_FLAG_LIGHT_FROXEL) != 0u;   // (uniform: push constant)
    const bool stage = lightStaged();   // (#815: implies !froxel)
    if (!froxel)
    {
        if (stage && lid < TILE_LIGHT_WORDS) s_lightProj[lid] = 0u;
        if (lid < TILE_LIGHT_WORDS) s_tileMask[lid] = light_grid[g_tile * TILE_LIGHT_WORDS + lid];
        barrier();
        if (stage) stageTileLights(lid);
        CLK_MARK(GRID);
    }
    const ivec2 px = ivec2(uvec2(g_tile % tilesX, tileY) * TILE + gl_LocalInvocationID.xy);
    if (px.x >= int(g_draw_push.width) || px.y >= int(g_draw_push.height)) return;
    CLK_INV();
    g_frag_xy = vec2(px) + 0.5;
    const vec4 g2 = defTexel(uG2, px);
    if (!deferHasSurface(g2)) { CLK_MARK(GBUF); return; }   // (sky / cleared: BASE's black stands)
    float glow;
    bool noFade;
    SurfaceLit s = deferSurface(px, g2, glow, noFade);
    if (s.model == SURF_FULLBRIGHT) { CLK_MARK(GBUF); return; }   // (unlit: no local lights)
    CLK_SURF();
    const vec3 P = deferPosition(px);
    const vec3 V = linfo.cam_fwd.w > 0.5 ? -linfo.cam_fwd.xyz : normalize(pc.u_cam_time.xyz - P);
    CLK_MARK(GBUF);
    // lightSurface's common tail inputs (clean_surface_light.glsl): cel as lightSurface sets it,
    // PBR base / metal / rough + no legacy specular, legacy base + metal 0 / rough 1 + its spec.
    s.cel = s.cel && specCelOn();
    g_cel = s.cel;
    const bool pbr = s.model == SURF_PBR;
    LegacySpec ls = legacySpecNone();
    float metal = 0.0, rough = 1.0;
    if (pbr) { metal = s.metal; rough = s.rough; }
    else { ls.spec = s.spec; ls.gloss = s.gloss; ls.env = s.env; }
    float glare;
    const vec3 local = localLights(P, s.N, V, pbr, s.albedo, metal, rough, ls, glare);   // (marks LOCAL / FROXEL)
    CLK_MARK(LOCAL);
    // No light reached this pixel: BASE's output is already this pixel's (an exact + 0).
    if (local.r == 0.0 && local.g == 0.0 && local.b == 0.0) return;
    // (BASE drew the overlay: the local light enters by the share of the lit colour it keeps --
    //  exact, the overlay is affine in the colour; a debug colour takes none)
    const float keep = overlayKeep(gbufferOverlay(g2));
    if (keep == 0.0) return;
    const float gain = imageLoad(uLocalGain, DS_TEXEL(px)).r;
    const vec3 base = imageLoad(uHdrOut, ivec3(px, DEFER_LAYER)).rgb;
    writeLitOutput(px, base + local * (gain * keep), glow, false);
    // (SKIN SUBSURFACE SCATTERING) BASE stored this skin pixel's diffuse irradiance; the local sum
    // joins it where it is all diffuse (a legacy face without specular or env: lightSurface's rule)
    if (s.skin && !pbr && ls.gloss <= 0.0 && ls.env <= 0.0 && sssFrameOn())
    {
        const vec3 e = dsUnpackRGB9E5(imageLoad(uSssDiff, DS_TEXEL(px)).x);
        imageStore(uSssDiff, DS_TEXEL(px), uvec4(packRGB9E5(e + sssDemod(local * (gain * keep), s))));
    }
    CLK_MARK(STORE);
}

#else   // CLEAN_DEFER_PASS 0 (uber) / 3 (combine)

void DEFER_MAIN()
{
    const uint lid = gl_LocalInvocationIndex;
    // The light set's source (push constant flags: every branch on them below is uniform -- the
    // barriers inside stay legal):
    //   FROXEL (DEFER_FLAG_LIGHT_FROXEL): the light pass's froxel masks, read per pixel inside
    //     localLights (tileLightBase / tileLightWord). Only the lit-guard cluster scan runs here
    //     (global atomics): no shared mask, no depth reduction, no barrier.
    //   LIGHT GRID (DEFER_FLAG_LIGHT_GRID): the tile's mask from pass 6 -> shared, its load
    //     overlapping the G-buffer fetch, one barrier.
    //   neither: the in-kernel tile test (depth reduction + light test, three barriers).
#ifdef CLEAN_DEFER_BASIC
    // #1411 placeholder tier (basicLight): no local lights, so no light set at all.
    const bool froxel = false, grid = false, tiled = false, stage = false;
    if (false)
#else
    const bool froxel = (g_draw_push.flags & DEFER_FLAG_LIGHT_FROXEL) != 0u;
    const bool grid = !froxel && (g_draw_push.flags & DEFER_FLAG_LIGHT_GRID) != 0u;
    const bool tiled = !froxel && !grid;
    const bool stage = lightStaged();   // (#815: implies !froxel)
    if (stage && lid < TILE_LIGHT_WORDS) s_lightProj[lid] = 0u;   // (published by the grid / tile barriers)
    if (grid)
    {
        if (lid < TILE_LIGHT_WORDS) s_tileMask[lid] = light_grid[deferTileIndex() * TILE_LIGHT_WORDS + lid];
    }
    else
#endif
    {
        lgClusterScan(lid);
        CLK_MARK(CLUSTER_SCAN);
        if (tiled)
        {
            if (lid < TILE_LIGHT_WORDS) s_tileMask[lid] = 0u;
            if (lid == 0u) { s_zmin = floatBitsToUint(3.0e38); s_zmax = 0u; }
            barrier();
        }
    }

    const ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    const bool inside = px.x < int(g_draw_push.width) && px.y < int(g_draw_push.height);
    g_frag_xy = vec2(px) + 0.5;

    vec4 g2 = vec4(0.0);
    vec3 P = vec3(0.0);
    bool surf = false;
    if (inside)
    {
        g2 = defTexel(uG2, px);
        surf = deferHasSurface(g2);
    }
    if (surf)
    {
        P = deferPosition(px);
        if (tiled)
        {
            // (> 0: a -0.0 would win the uint atomicMax and empty the tile's depth range)
            const float vz = max(dot(P - pc.u_cam_time.xyz, linfo.cam_fwd.xyz), 1e-4);
            atomicMin(s_zmin, floatBitsToUint(vz));
            atomicMax(s_zmax, floatBitsToUint(vz));
        }
    }
    if (grid)
    {
        barrier();
        if (stage) stageTileLights(lid);   // (charged to GRID)
        CLK_MARK(GRID);
    }
    else if (tiled)
    {
        barrier();
        CLK_MARK(TILE_DEPTH);
        // ---- the tile's light mask ----
        const uint count = min(uint(linfo.cam_pos.w), TILE_LIGHT_WORDS * 32u);
        const float z0 = uintBitsToFloat(s_zmin), z1 = uintBitsToFloat(s_zmax);
        if (count > 0u && z1 >= z0 && !litDbg(LDBG_NO_LOCAL))
        {
            vec3 rays[4], planes[4];
            tileFrustum(rays, planes);
            // A little slack on the depth range (reconstruction / interpolation differences).
            const float zs0 = z0 * 0.999 - 0.01, zs1 = z1 * 1.001 + 0.01;
            for (uint i = lid; i < count; i += TILE * TILE)
                if (tileLightTest(i, rays, planes, zs0, zs1, linfo.cam_fwd.xyz))
                    atomicOr(s_tileMask[i >> 5u], 1u << (i & 31u));
        }
        barrier();
        if (stage) stageTileLights(lid);   // (charged to TILE_LIGHTS)
        CLK_MARK(TILE_LIGHTS);
    }
    // (froxel: the G2 / depth load and the position are charged to GBUF below, with the decode)

    if (!inside) return;
    CLK_INV();
#if CLEAN_DEFER_PASS == 3
    const bool visFill = (g_draw_push.flags & DEFER_FLAG_VIS_FILL) != 0u;   // (#823: no SHADOW pass wrote the record)
#endif
    if (!surf)
    {
        writeLitOutput(px, vec3(0.0), 0.0, false);   // pass 1's clear; the sky draws over it
#if CLEAN_DEFER_PASS == 3
        if (visFill) imageStore(uVisDepth, DS_TEXEL(px), uvec4(0u));
#endif
        CLK_MARK(STORE);
        return;
    }
    CLK_SURF();
    float glow;
    bool noFade;
    const SurfaceLit s = deferSurface(px, g2, glow, noFade);
#if CLEAN_DEFER_PASS == 3
    g_ds_P = P;
    if (visFill) visDepthStore(px, s, P, false);
    g_sss_want = s.skin && sssFrameOn();   // (SKIN SUBSURFACE SCATTERING: lightSurface leaves its diffuse terms)
#endif
    CLK_MARK(GBUF);
#ifdef CLEAN_DEFER_BASIC
    const vec4 lit = basicLight(s, P, 1.0);   // #1411 placeholder tier
#else
    const vec4 lit = lightSurface(s, P, 1.0);   // (marks SUNVIS .. HAZE itself)
#endif
    CLK_MARK(SHADE);   // (fullbright lanes: their wait for the lit lanes of the subgroup)
#ifdef CLEAN_SURFACE_DEBUG
    // (a debug view shows its term unhazed, as the forward FS does)
    vec3 color = litDebugView() != 0 ? lit.rgb : surfacePost(s.model, noFade, lit.rgb, P);
#else
    vec3 color = surfacePost(s.model, noFade, lit.rgb, P);
#endif
#if CLEAN_DEFER_PASS == 3
    {   // (#85 phase 2) RenderVKDenoiseDebug
        const uint pdbg = (g_draw_push.flags & DEFER_FLAG_PSTOCH) != 0u ? (g_draw_push.flags >> DEFER_PSTOCH_DBG_SHIFT) & 7u : 0u;
        if (pdbg != 0u) color = deferPdnDebug(pdbg, P, color);
    }
    // MOVER FOLD VIEW (RenderVKLitDebugMask 32768, radiance packing): R = the diffuse mover factor the lighting
    // multiplied radD by (deferEmitterLight: the exact pixel fold), G = the specular one it multiplied radS by, B =
    // which fold the pixel took: 0 none (no slot at its taps), the explicit lights it read x 0.125 (4 = 0.5; the hit
    // lights -- a mover in front of them -- blocked or not), + 0.5 where the U set carried a mover-blocked light past
    // the slots (the N share: the one approximate case). Constant B along a shadow edge: the fold does not switch.
    // (The probe, RenderVKMoverProbePixel, logs the explicit / U light counts and the mask's plan.)
    if (litDbgMover(LDBG_MOVER_VIEW) && moverFoldAll())
    {
        const float kind = float(min(g_mv_fold_info & 15u, 4u)) * 0.125 + ((g_mv_fold_info & 256u) != 0u ? 0.5 : 0.0);
        const vec3 lw = vec3(0.2126, 0.7152, 0.0722);
        color = vec3(dot(g_mv_fold_d, lw), dot(g_mv_fold_s, lw), kind);
    }
    if (giFrameOn() && gi.xcfg.w != 0u) color = g_cs_dbg;   // (gi-glass) RenderVKGICacheSpecDebug
    if (giFrameOn() && gi.cfg.w != 0u)   // (#87) RenderVKGIDebug: the GI image itself (7: the sky visibility)
    {
        bool ok;
        float sv;
        color = deferGiFetch(P, s.N, ok, sv);
        // (RenderVKGIMoverSamples) view 1 shows what the combine uses: a mover pixel's own GI where it has one
        vec3 Em;
        if (gi.cfg.w == GI_DBG_FINAL && deferGiMoverRead(P, Em)) color = Em;
        // (magenta: a cache stand-in; under GI_F_LAG cyan: the reveal march's texel, red: no estimate at all)
        if (gi.cfg.w == GI_DBG_SKYVIS)
            color = sv < 0.0 ? vec3(1.0, 0.0, 1.0)
                  : ((gi.cfg.x & GI_F_LAG) != 0u && g_gi_lag_src == 1u) ? vec3(0.0, sv, sv)
                  : ((gi.cfg.x & GI_F_LAG) != 0u && g_gi_lag_src == 3u) ? vec3(1.0, 0.0, 0.0) : vec3(sv);
    }
#endif
    CLK_MARK(HAZE);
    writeLitOutput(px, color, glow, true);
#if CLEAN_DEFER_PASS == 3
    if (g_sss_want) sssExport(px, s, surfaceLocalGain(noFade, P));
#endif
    CLK_MARK(STORE);
}
#endif

#ifdef CLEAN_SHADER_CLOCK
// ---- SHADER CLOCK FLUSH (RenderVKShaderClockLighting; clean_shader_clock.glsl) ----
// Counters (set 2 binding 7; LLCleanRendererVK mClkCounter): per bucket x kernel x slot one
// 64-bit sum as (lo, hi) uint words -- word ((bucket * CLK_KERNELS + kernel) * CLK_SLOTS +
// slot) * 2. Slots: the stage cycle sums (CLK_S_*), then the invocation / surface counts.
// Buckets spread the atomics of a frame's ~10^5 subgroups over CLK_BUCKETS copies.
layout(std430, set = 2, binding = 7) buffer ShaderClockCounters { uint clk_words[]; };
void clkAdd(uint base, uint slot, uint v)
{
    const uint sum = subgroupAdd(v);   // (one stage's cycles of a subgroup: << 2^32)
    if (sum != 0u && subgroupElect())
    {
        const uint w = base + slot * 2u;
        const uint old = atomicAdd(clk_words[w], sum);
        if (old + sum < old) atomicAdd(clk_words[w + 1u], 1u);   // carry into the high word
    }
}
void main()
{
    g_clk_prev = clkNow();
    deferMain();
    CLK_MARK(TAIL);
    const uint bucket = (gl_WorkGroupID.x + gl_WorkGroupID.y * 5u + gl_SubgroupID) % CLK_BUCKETS;
    const uint base = (bucket * CLK_KERNELS + uint(CLEAN_DEFER_PASS)) * CLK_SLOTS * 2u;
    clkAdd(base, CLK_S_TAIL,         g_clk_TAIL);
    clkAdd(base, CLK_S_CLUSTER_SCAN, g_clk_CLUSTER_SCAN);
    clkAdd(base, CLK_S_TILE_DEPTH,   g_clk_TILE_DEPTH);
    clkAdd(base, CLK_S_TILE_LIGHTS,  g_clk_TILE_LIGHTS);
    clkAdd(base, CLK_S_GBUF,         g_clk_GBUF);
    clkAdd(base, CLK_S_SUNVIS,       g_clk_SUNVIS);
    clkAdd(base, CLK_S_PROJ,         g_clk_PROJ);
    clkAdd(base, CLK_S_ATMOS,        g_clk_ATMOS);
    clkAdd(base, CLK_S_PROBE,        g_clk_PROBE);
    clkAdd(base, CLK_S_SSR,          g_clk_SSR);
    clkAdd(base, CLK_S_MIRROR,       g_clk_MIRROR);
    clkAdd(base, CLK_S_SHADE,        g_clk_SHADE);
    clkAdd(base, CLK_S_LOCAL,        g_clk_LOCAL);
    clkAdd(base, CLK_S_HAZE,         g_clk_HAZE);
    clkAdd(base, CLK_S_STORE,        g_clk_STORE);
    clkAdd(base, CLK_S_GRID,         g_clk_GRID);
    clkAdd(base, CLK_S_FROXEL,       g_clk_FROXEL);
    clkAdd(base, CLK_SLOT_INV,       g_clk_inv ? 1u : 0u);
    clkAdd(base, CLK_SLOT_SURF,      g_clk_surf ? 1u : 0u);
}
#endif
