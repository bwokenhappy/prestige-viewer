uint g_gi_tap_why = 0u;
// (GI_DBG_SPATIAL) this receiver's spatial taps: 4-bit counts, nibble 0 the kept ones, nibble k the GI_TAP_k rejects
uint g_gi_sp_why = 0u;
// The view depth of the receiver's plane dz (its depth gradient x the offset) along the GI grid from its depth pw:
// 1 / z is affine in screen space over a plane, z is not. Extrapolating z linearly drifted off a slanted plane
// within the 16-texel spatial disc (a room's side walls seen at an angle -- every corner --, an object's flank at
// its silhouette): the taps failed the depth test there and those texels reused their temporal reservoir alone.
// -1: the plane does not reach that far (past its horizon). GI_F_SP_LINEAR (RenderVKGISpatialPlaneTaps 0, an
// A/B): the old linear extrapolation.
float giPlaneZ(float pw, float dz)
{
    if ((gi.cfg.x & GI_F_SP_LINEAR) != 0u) return pw + dz;
    const float inv = (1.0 - dz / pw) / pw;
    return inv > 1e-6 ? 1.0 / inv : -1.0;
}
float giTap(ivec2 q, ivec2 D, uint pl, float zExp, float ztol, vec3 P, vec3 N, float mcap,
            out GiSample y, out float py, out float Mq, out uint chg)
{
    y = GiSample(vec3(0.0), vec3(0.0), vec3(0.0), 0.0, 0.0);
    py = 0.0; Mq = 0.0; chg = 0u;
    g_gi_tap_why = GI_TAP_SURFACE;
    if (any(lessThan(q, ivec2(0))) || any(greaterThanEqual(q, D))) return 0.0;
    const uvec4 g = imageLoad(uGiGeom, ivec3(q, PDN_L(int(pl))));
    const float zq = uintBitsToFloat(g.x);
    if (!(zq > 0.0)) return 0.0;
    g_gi_tap_why = GI_TAP_DEPTH;
    if (!(abs(zq - zExp) <= ztol)) return 0.0;
    g_gi_tap_why = GI_TAP_NORMAL;
    if (dot(pdnUnpackN(g.y), N) < 0.9) return 0.0;
    g_gi_tap_why = GI_TAP_RES;
    const uint i = giResIndex(q, D, pl);
    const uvec4 r0 = gi_res[i], r1 = gi_res[i + 1u];
    const float W = uintBitsToFloat(r0.w);
    if (!(W >= 0.0) || !(W < 3.0e38)) return 0.0;
    y.xs = uintBitsToFloat(r0.xyz);
    // (#1406) its sample point in a HARD change sphere: wrong (dropped); in a SOFT one (an emitter's light
    // changed there): stale -- its confidence capped by how much the change matters against what it carries
    // (giSoftCap), so where it matters this frame's fresh samples take over within a few frames instead of
    // the reservoir restarting at M = 1, and far / brightly lit samples keep their history
    float sphS;
    const uint sph = giSphereHitS(y.xs, 0.0, sphS);
    if (sph == 2u) return 0.0;
    y.ns = giUnpackN(r1.x);
    const vec2 lrg = unpackHalf2x16(r1.y), lbm = unpackHalf2x16(r1.z), dc = unpackHalf2x16(r1.w);
    y.L = vec3(lrg, lbm.x);
    const float M = min(lbm.y, sph == 1u ? giSoftCap(sphS, giLum(y.L), mcap) : mcap);
    if (!(M > 0.0) || any(isnan(y.L)) || any(isinf(y.L))) return 0.0;
    // W=0, M>0, L=0 is an informative black reservoir. A positive-radiance sample
    // with W=0 was excluded from selection (e.g. its fresh grazing cosine), not black.
    if (W == 0.0 && giLum(y.L) > 0.0) return 0.0;
    g_gi_tap_why = GI_TAP_BEHIND;
    const vec3 v = y.xs - P;
    const float d2 = dot(v, v);
    if (!(d2 > 1e-8)) return 0.0;
    const float dn = sqrt(d2);
    const vec3 w = v / dn;
    const float cr = dot(N, w);
    if (!(cr >= giCosMin())) return 0.0;
    g_gi_tap_why = GI_TAP_JACOB;
    float J = 1.0;
    const bool sky = !(dc.x > 0.0);
    y.dist = sky ? 0.0 : dn;
    y.cosv = sky ? 1.0 : abs(dot(y.ns, w));
    if (!sky)
    {
        // |cos phi_now| / |cos phi_then| x |x_s - x_then|^2 / |x_s - x_now|^2 (Ouyang et al. 2021 eq. 11)
        J = (y.cosv / max(dc.y, 1e-3)) * (dc.x * dc.x) / d2;
        if (!(J > 0.2) || !(J < 5.0)) return 0.0;   // (a move the sample cannot stand for: a large J
                                                    //  amplifies one sample into a firefly)
    }
    g_gi_tap_why = GI_TAP_WEIGHT;
    py = giLum(y.L) * cr;
    if (!(py >= 0.0)) return 0.0;
    const float wt = py * W * M * J;
    if (!(wt >= 0.0) || !(wt < 3.0e38)) return 0.0;
    g_gi_tap_why = 0u;
    // Eligibility/count is independent of positive selection weight: dropping black
    // history from M conditions normalization on brightness and biases reuse upward.
    Mq = M;
#if CLEAN_GI_STAGE == GI_STAGE_REUSE
    // (#1039) CHG-TAG computed the two tests below for this reservoir (the same inputs: its stored point, normal and
    // radiance); without changed lights the tag is 0 as both tests are (giHotOn: the hot list is the changed
    // lights' header block)
    chg = (gi.cfg.x & GI_F_LIGHT_CHG) != 0u ? giChgTagAt(q, D) & 7u : 0u;
    if ((chg & 4u) != 0u)
    {
#else
    chg = (!sky && (gi.cfg.x & GI_F_LIGHT_CHG) != 0u) ? giChangedSig(y.xs, y.ns, y.L) : 0u;
    // (#1087) a light that moved within the hold is significant at its point: its radiance may be
    // shaded under the light's old position -- bit 2, and its confidence clamped (prm6.y) so this
    // frame's fresh samples take over in a few frames instead of the M cap's
    if (!sky && giHotOn() && (chg == 2u || giLightHot(y.xs, y.ns, y.L)))
    {
        chg |= 4u;
#endif
        const float mc = gi.prm6.y;
        if (mc > 0.0 && M > mc)
        {
            Mq = mc;
            return wt * (mc / M);
        }
    }
    return wt;
}

// The render pixel of GI texel m (its centre, D the GI extent): every stage's receiver. Below full resolution the
// sample lattice follows the TAA jitter (the RT mask's convention) -- unless GI_F_STABLE_SAMPLES (an A/B:
// RenderVKGIStableSamples): then texel m always samples floor((m + 0.5) r), see clean_gi_common.glsl.
vec2 giSampleJitter(int Dx)
{
    return (ssr.taa_params.w > 0.5 && Dx < int(g_draw_push.width) && (gi.cfg.x & GI_F_STABLE_SAMPLES) == 0u)
        ? ssr.taa_jitter.xy : vec2(0.0);
}
ivec2 giRenderPixel(ivec2 m, ivec2 D, out vec2 r)
{
    const vec2 R2 = vec2(float(g_draw_push.width), float(g_draw_push.height));
    r = R2 / vec2(D);
    const vec2 J = giSampleJitter(D.x);
    return clamp(ivec2((vec2(m) + 0.5 + J) * r), ivec2(0), ivec2(R2) - 1);
}
// (RenderVKGITraceEvery: 1 texel in 2 / 4 traces this frame -- a checkerboard / a 2 x 2 rotation;
//  the others take their reservoirs' reuse only, or hold the denoiser's history)
bool giTracesNow(ivec2 m, uint frame)
{
    const uint everyLog = (gi.cfg.x >> GI_EVERY_SHIFT) & 3u;
    bool traced = true;
    if (everyLog == 1u) traced = ((uint(m.x) + uint(m.y) + frame) & 1u) == 0u;
    else if (everyLog >= 2u) traced = ((uint(m.x) & 1u) + 2u * (uint(m.y) & 1u)) == (frame & 3u);
    return traced;
}
// The fresh sample's ray (GI-1: one cosine-weighted direction) from receiver P (N / Ng toward the eye
// V, camd from the camera; r render px per GI texel): its direction d, origin o and the walk's ray
// cone (rt_cone_* and the alpha test's, rtrMaskCone); traced: this texel traces this frame.
void giFreshRay(ivec2 m, uint frame, vec2 r, vec3 P, vec3 N, vec3 Ng, vec3 V, float camd,
                out vec3 d, out vec3 o, out bool traced)
{
    // A LOW-DISCREPANCY SEQUENCE PER TEXEL: the texel's own random rotation (fixed over the frames)
    // plus the R2 step per frame, in 32-bit fixed point (exact mod 1, no float precision loss at
    // high frame counts). Before, the rotation was hashed with the frame too, which made each
    // frame's direction independent white noise and the R2 term a no-op; now a texel's successive
    // rays cover its hemisphere evenly, so its history converges faster.
    const uint rx = giPcg(uint(m.x) * 1973u + uint(m.y) * 9277u);
    const uint ry = giPcg(rx);
    const uvec2 q = uvec2(rx, ry) + frame * uvec2(3242174889u, 2447445414u);   // R2: 2^32 x (0.7548776662, 0.5698402910)
    const vec2 u = vec2(q >> 8u) * (1.0 / 16777216.0);
    d = giCosDir(N, u);
    const float dn = dot(d, Ng);
    if (dn < 0.02) d = normalize(d + Ng * (0.02 - dn));   // (above the facet: a normal map leans N under it)
    // the hit's texture LOD: the receiver's pixel footprint, spreading as a diffuse lobe
    const float pa = rtrPixelAngle(g_frag_xy) * r.x;
    // THE ORIGIN'S LIFT: P is rebuilt from a reduced-resolution, jittered depth sample, so it lies
    // up to about half a GI texel's footprint off the true surface along the view ray -- growing with
    // the distance and, on a slanted surface, with 1 / cos (the depth slope). The depth-precision lift
    // alone (rtReceiverOrigin: camd x 2^-21) left far / grazing receivers just INSIDE their own
    // ray-traced surface: the back-face stop (GI_F_BACK_STOP) darkened them in jitter-moving patches.
    // Lifted by half the footprint over the facet's cosine (capped at 4x).
    const float lift = 0.5 * camd * pa / max(abs(dot(Ng, V)), 0.25);
    o = rtReceiverOrigin(P, Ng, camd, lift);
    rt_cone_width0 = camd * pa;
    rt_cone_spread = pa + 0.5;
    rt_cone_aniso = max(g_draw_push.rtr.w, 1.0);
    rtrMaskCone(camd * pa, pa);
    // A lighting invalidation is information loss, not a reason to hold checkerboard
    // history. At most one fresh ray per GI texel, including TraceEvery 2/4 frames.
    traced = giTracesNow(m, frame) || giSphereTrace(P);
}
// The walk's ray cone again for a stage that shades (or re-traces) what another one walked: the
// receiver P's footprint, as giFreshRay set it (the alpha test's stays at its defaults).
void giRayCone(ivec2 rp, vec2 r, vec3 P)
{
    g_frag_xy = vec2(rp) + 0.5;
    const float pa = rtrPixelAngle(g_frag_xy) * r.x;
    const float camd = length(P - pc.u_cam_time.xyz);
    rt_cone_width0 = camd * pa;
    rt_cone_spread = pa + 0.5;
    rt_cone_aniso = max(g_draw_push.rtr.w, 1.0);
}
#if CLEAN_GI_STAGE != GI_STAGE_FUSED
// ---- (#1031) GI RECORDS (binding 25: the layout at its declaration) ----
#define GI_REC_TRACED 1u   // a surface that traced its fresh ray this frame (else REUSE takes its defaults)
#define GI_REC_HIT    2u   // ... and hit something (else the sky)
#define GI_REC_BACK   4u   // ... a single-sided back face first (GI_F_BACK_STOP: dark, never shaded)
#define GI_REC_FRONT  8u   // the hit's hardware front face (RtHit.front)
#define GI_REC_OC_SHIFT 16u // (gi-glass) bits 16-23: the ray's outcome word so far (GIO_*: TRACE's class, HIT-MAT's
                            // fullbright / emission bits); the stage that writes the sample stores the final word in q3.w
// (#1036) the headers: [0] the re-shade list, [1] / [2] the HIT / MISS lists; the list from GI_REC_LIST
#define GI_HDR_HIT  1u
#define GI_HDR_MISS 2u
#define GI_REC_LIST 3u
#define GI_ROW 65535u   // (the HIT / MISS dispatch's row width: maxComputeWorkGroupCount's floor)
// (THE RT LIGHTING SCRATCH, LLCleanRendererVK::rtScratchLayout) the records come LAST: everything before them -- the
// headers, the list, the change tags -- is the KEPT PREFIX (written by the light prep or read across the lighting
// chain); the records are the transient tail the split shadow core's descriptors / visibilities share.
uint giRecIndex(ivec2 m, ivec2 D) { return GI_REC_LIST + 2u * ((giTexels(D) + 3u) / 4u) + 6u * giTexel(m, D); }
// (#1039) the CHANGE TAG of texel q (last frame's reservoir there): its uvec4 after the list (before the records), the
// component q & 3
uint giChgTagWord(ivec2 q, ivec2 D, out uint c)
{
    const uint n = giTexels(D), t = giTexel(q, D);   // (#1608: every view's)
    c = t & 3u;
    return GI_REC_LIST + (n + 3u) / 4u + (t >> 2u);
}
#if CLEAN_GI_STAGE == GI_STAGE_SHADE || CLEAN_GI_STAGE == GI_STAGE_HITLIGHT
// (#1039) the tag's BIT 3: giTap's two tests on texel m's FRESH hit (REUSE's changed share of the fresh candidate),
// set by the stage that writes the hit's sample (HIT-LIGHT; SHADE without the shade split) from the very L / xs / ns
// it stores -- the words the old CHG-TAG pass read back. Bits 0-2 (last frame's reservoir) were written over the
// whole word by the light prep's tag pass (stage 9) before this frame's GI; the host runs it on the frames whose
// header has GI_F_LIGHT_CHG and GI_F_RES (mGiHdrChg), the same gate as here. (A component store: the lanes of the
// other texels in the uvec4 write other components.)
void giChgTagFresh(ivec2 m, ivec2 D, vec3 xs, vec3 ns, vec3 L)
{
    if ((gi.cfg.x & (GI_F_LIGHT_CHG | GI_F_RES)) != (GI_F_LIGHT_CHG | GI_F_RES)) return;   // (a header word: uniform)
    if (giChangedSig(xs, ns, L) == 2u || (giHotOn() && giLightHot(xs, ns, L)))
    {
        uint c;
        const uint w = giChgTagWord(m, D, c);
        gi_hit[w][c] |= 8u;
    }
}
#endif
#if CLEAN_GI_STAGE == GI_STAGE_REUSE
uint giChgTagAt(ivec2 q, ivec2 D)
{
    uint c;
    const uint w = giChgTagWord(q, D, c);
    return gi_hit[w][c];
}
#endif
// The re-shade list (RESHADE / TAIL: one lane per entry, 64 per workgroup over x): this lane's entry,
// or ~0u past the count (clamped to the texels: Xid 109 hardening, as rttEntry).
uint giListLane(ivec2 D)
{
    const uint e = gl_WorkGroupID.x * 64u + gl_LocalInvocationIndex;
    return e < min(gi_hit[0].x, giTexels(D)) ? e : 0xFFFFFFFFu;
}
// (#1608: the entry's view-inclusive texel -- its view set first, g_gi_view; a view past N: the texel off the extent)
ivec2 giListTexel(uint e, ivec2 D)
{
    const uint t = gi_hit[GI_REC_LIST + (e >> 2u)][e & 3u];
    uint vw;
    const ivec2 m = giTexelAt(t, D, vw);
    g_gi_view = vw < uint(kViewCount) ? vw : 0u;
    return vw < uint(kViewCount) ? m : D;
}
// (#1036) TRACE: texel ti onto the HIT list (entries 0, 1, ...) or the MISS list (entries n - 1,
// n - 2, ...; n = the texels) -- one atomic per subgroup and list; the electing lane raises the list's
// indirect dispatch to cover its new end (64 entries per workgroup, GI_ROW-wide rows: monotone in the
// end, so the largest append's maxima stand). Every texel appends at most once: the two never meet.
void giShadeListGrow(uint hdr, uint end)
{
    const uint groups = (end + 63u) / 64u;
    atomicMax(gi_hit[hdr].y, min(groups, GI_ROW));
    atomicMax(gi_hit[hdr].z, (groups + GI_ROW - 1u) / GI_ROW);
}
void giShadeListAppend(bool hit, uint ti, uint n)
{
    const uvec4 bh = subgroupBallot(hit), bm = subgroupBallot(!hit);
    const uint nh = subgroupBallotBitCount(bh), nm = subgroupBallotBitCount(bm);
    uint baseH = 0u, baseM = 0u;
    if (subgroupElect())
    {
        if (nh != 0u) { baseH = atomicAdd(gi_hit[GI_HDR_HIT].x, nh); giShadeListGrow(GI_HDR_HIT, baseH + nh); }
        if (nm != 0u) { baseM = atomicAdd(gi_hit[GI_HDR_MISS].x, nm); giShadeListGrow(GI_HDR_MISS, baseM + nm); }
    }
    const uint eH = subgroupBroadcastFirst(baseH) + subgroupBallotExclusiveBitCount(bh);
    const uint eM = subgroupBroadcastFirst(baseM) + subgroupBallotExclusiveBitCount(bm);
    const uint slot = hit ? eH : n - 1u - eM;
    if (slot < n) gi_hit[GI_REC_LIST + (slot >> 2u)][slot & 3u] = ti;
}
// MISS / HIT-MAT / HIT-LIGHT: this lane's texel on list hdr (64 lanes per workgroup, GI_ROW-wide rows),
// false past the count (clamped to the texels: Xid 109 hardening). e0: the first entry this dispatch
// covers (#1039: the fused HIT-LIGHT's tail past the visibility queue's capacity; else 0); e: the entry.
bool giShadeListTexel(uint hdr, ivec2 D, uint e0, out ivec2 m, out uint e)
{
    const uint n = giTexels(D);   // (#1608: every view's texels)
    e = e0 + (gl_WorkGroupID.y * GI_ROW + gl_WorkGroupID.x) * 64u + gl_LocalInvocationIndex;
    m = ivec2(0);
    if (e >= min(gi_hit[hdr].x, n)) return false;
    const uint slot = hdr == GI_HDR_HIT ? e : n - 1u - e;
    const uint t = gi_hit[GI_REC_LIST + (slot >> 2u)][slot & 3u];
    if (t >= n) return false;
    uint vw;   // (#1608: the texel's view first -- every per-view read after it is that view's)
    m = giTexelAt(t, D, vw);
    g_gi_view = vw;
    return true;
}
// REUSE: texel ti onto the list -- one atomic per subgroup (its lanes take consecutive entries); the
// lane whose entry starts a 64-entry block adds the workgroup that will run it (the indirect x: the
// header's count rounded up to 64). Every texel appends at most once: the list never overflows.
void giListAppend(uint ti)
{
    const uvec4 b = subgroupBallot(true);
    uint base = 0u;
    if (subgroupElect()) base = atomicAdd(gi_hit[0].x, subgroupBallotBitCount(b));
    const uint e = subgroupBroadcastFirst(base) + subgroupBallotExclusiveBitCount(b);
    gi_hit[GI_REC_LIST + (e >> 2u)][e & 3u] = ti;
    if ((e & 63u) == 0u) atomicAdd(gi_hit[0].y, 1u);
}
// The shading stages' radiance-cache counters (giShadeHit's lookups at hits; GI_F_STATS)
void giShadeStats()
{
    if ((gi.cfg.x & GI_F_STATS) == 0u) return;   // (a header word: uniform)
    const uint sL = subgroupAdd(g_gi_lookups), sF = subgroupAdd(g_gi_found);
    if (subgroupElect() && sL != 0u)
    {
        atomicAdd(gi.stat3.x, sL);
        atomicAdd(gi.stat3.y, sF);
    }
}
#endif

#if CLEAN_GI_STAGE == GI_STAGE_TRACE
// ---- (#1031) STAGE 1, TRACE: the receiver and its fresh ray's closest-hit walk -> the hit record.
//      No hit shading in this kernel: the walk (rtrClosest's candidate alpha test, the back-face
//      re-traces) is all it holds. ----
void DEFER_MAIN()
{
    g_gi_view = CLEAN_VIEW_Z;   // (#1608: z = the views)
    const ivec2 m = ivec2(gl_GlobalInvocationID.xy);
    const ivec2 D = ivec2(g_draw_push.rtr2.xy + 0.5);
    if (any(greaterThanEqual(m, D))) return;
    // the re-shade list starts empty (REUSE appends two barriers later; last frame's RESHADE / TAIL
    // read it before recordGI's opening barrier) -- (#1608) once: texel 0 of view 0
    if (m == ivec2(0) && CLEAN_VIEW == 0u) gi_hit[0] = uvec4(0u, 0u, 1u, 1u);
    const uint frame = uint(g_draw_push.rtr2.z + 0.5);
    vec2 r;
    const ivec2 rp = giRenderPixel(m, D, r);
    g_frag_xy = vec2(rp) + 0.5;
    const uint ri = giRecIndex(m, D);
    const vec4 g2 = defTexel(uG2, rp);
    bool surf = deferHasSurface(g2);
    float glow;
    bool noFade;
    SurfaceLit s;
    if (surf)
    {
        s = deferSurface(rp, g2, glow, noFade);
        surf = s.model != SURF_FULLBRIGHT;
    }
    if (!surf)
    {
        gi_hit[ri] = uvec4(0u);
        return;
    }
    const vec3 P = deferPosition(rp);
    const vec3 cam = pc.u_cam_time.xyz;
    const vec3 V = linfo.cam_fwd.w > 0.5 ? -linfo.cam_fwd.xyz : normalize(cam - P);
    const vec3 Ng = dot(s.Ng, V) < 0.0 ? -s.Ng : s.Ng;
    const vec3 N = dot(s.N, V) < 0.0 ? -s.N : s.N;
    vec3 d, o;
    bool traced;
    giFreshRay(m, frame, r, P, N, Ng, V, length(P - cam), d, o, traced);
    if (!traced)
    {
        gi_hit[ri] = uvec4(floatBitsToUint(d), 0u);
        return;
    }
    const RtHit h = giTraceRay(o, d, max(g_draw_push.rtr.x, 1.0));
    const bool back = h.hit && g_gi_back;
    gi_hit[ri] = uvec4(floatBitsToUint(d), GI_REC_TRACED | (h.hit ? GI_REC_HIT : 0u) | (back ? GI_REC_BACK : 0u)
                                           | (h.hit && h.front ? GI_REC_FRONT : 0u) | (g_gi_outcome << GI_REC_OC_SHIFT));
    // (#1036) THE SHADE SPLIT (push rtr.z = 1: uniform): a back-face stop's sample is final here (SHADE's:
    // dark, its point, facing the ray -- no shading stage sees it); every other traced texel goes onto
    // the HIT or the MISS list
    if (g_draw_push.rtr.z > 0.5)
    {
        if (back)
        {
            gi_hit[ri + 1u] = uvec4(floatBitsToUint(vec3(0.0)), floatBitsToUint(h.dist));
            gi_hit[ri + 2u] = uvec4(floatBitsToUint(o + d * h.dist), floatBitsToUint(-d.x));
            gi_hit[ri + 3u] = uvec4(floatBitsToUint(-d.yz), 0u, g_gi_outcome);
            giOutcomeCount(g_gi_outcome);
            return;
        }
        giShadeListAppend(h.hit, giTexel(m, D), giTexels(D));   // (#1608: view-inclusive)
    }
    if (h.hit)
    {
        gi_hit[ri + 1u] = uvec4(floatBitsToUint(h.dist), h.instance, h.prim, floatBitsToUint(h.bary.x));
        gi_hit[ri + 2u] = uvec4(floatBitsToUint(h.bary.y), floatBitsToUint(h.o2w[0]));
        gi_hit[ri + 3u] = uvec4(floatBitsToUint(h.o2w[1]), floatBitsToUint(h.o2w[2].x));
        gi_hit[ri + 4u] = uvec4(floatBitsToUint(h.o2w[2].yz), floatBitsToUint(h.o2w[3].xy));
    }
    // (a back-face stop: its point, giTrace's -- SHADE has no o)
    gi_hit[ri + 5u] = uvec4(floatBitsToUint(h.hit ? h.o2w[3].z : 0.0), floatBitsToUint(back ? o + d * h.dist : P));
}
#elif CLEAN_GI_STAGE == GI_STAGE_SHADE
// ---- (#1031) STAGE 2, SHADE: the hit record -> the sample (the hit's material + lighting with its
//      sun / light shadow rays, or the sky + the probes' far field), written over the record ----
void DEFER_MAIN()
{
    g_gi_view = CLEAN_VIEW_Z;   // (#1608: z = the views)
    const ivec2 m = ivec2(gl_GlobalInvocationID.xy);
    const ivec2 D = ivec2(g_draw_push.rtr2.xy + 0.5);
    if (any(greaterThanEqual(m, D))) return;
    const uint ri = giRecIndex(m, D);
    const uvec4 q0 = gi_hit[ri];
    if ((q0.w & GI_REC_TRACED) == 0u) return;   // (no surface / not traced this frame: REUSE's defaults)
