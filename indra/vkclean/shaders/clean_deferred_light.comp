// (GI on, its cache on: the FS's giFwdOn / GI_FWD_CACHE_READ gates; header words: uniform)
bool rfgOn() { return giFrameOn() && (gi.cfg.x & GI_F_ON) != 0u && (gi.cfg.x & GI_F_CACHE) != 0u && giCacheSlots() != 0u; }
// push rtr2.w (an exact small integer; LLCleanRendererVK::rtReflPush): bit 0 the history parity (the RT tile list's,
// mRtReflParity: this frame writes region 1 + parity), bit 1 the frame keeps a previous camera (taa_prev_vp is the
// previous frame's: TAA / an upscaler on -- else no history is read)
#define RFT_PUSH_PARITY 1u
#define RFT_PUSH_PREV   2u
uint rftFlags() { return uint(max(g_draw_push.rtr2.w, 0.0) + 0.5); }
// THE HISTORY of the layer point Xr (camera-relative) -- or, on a smooth flat layer, of its reflection's virtual image
// Xv (the view ray continued past the layer by the reflection's hit distance: where the reflection appears to be, the
// point that moves with it as the camera moves) -- in the previous frame's resolved region, accepted on the stored
// view depth: the point's own previous depth (surface), or the depth where the previous camera's ray through that
// texel met this layer's plane (virtual image; ng its normal). False: no history.
bool rftHistTexel(vec3 Xr, ivec2 hsz, int prevRow, out vec4 h, out ivec2 q)
{
    h = vec4(0.0);
    q = ivec2(0);
    const vec4 c = ssr.views[CLEAN_VIEW].taa_prev_vp * vec4(Xr, 1.0);
    if (!(c.w > 1e-4)) return false;
    const vec2 puv = c.xy / c.w * 0.5 + 0.5;
    if (!(all(greaterThanEqual(puv, vec2(0.0))) && all(lessThan(puv, vec2(1.0))))) return false;
    // (the full-resolution pixel -> its block: texel hp's ray passes render pixel coordinate 2 hp + 1)
    const vec2 fpx = puv * vec2(float(g_draw_push.width), float(g_draw_push.height));
    q = clamp(ivec2(floor((fpx - 1.0) * 0.5 + 0.5)), ivec2(0), hsz - 1);
    h = imageLoad(uRtFwd, DS_TEXEL(q + ivec2(0, prevRow)));
