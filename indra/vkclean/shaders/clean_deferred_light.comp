#elif DEFER_GI_TRACE
// ---- (#87) THE GI TRACE (clean_gi_common.glsl): one GI texel per invocation ----
// (#1608) THE GI TEXELS OF EVERY VIEW: the per-texel buffers -- the reservoirs (gi_res), the records, the lists and the
// change tags (gi_hit) -- hold every view's texels, view v's rows after the first v views' (pass 15's numbering): texel
// m of view v at (v x D.y + m.y) x D.x + m.x (giTexel, at CLEAN_VIEW); a list entry carries that index (giTexelAt
// recovers the view). The host sizes them x N (llcleangivk.cpp: the extent's rows x N). One view: as before.
uint giTexels(ivec2 D) { return uint(D.x * D.y) * uint(kViewCount); }
uint giTexel(ivec2 m, ivec2 D) { return (CLEAN_VIEW * uint(D.y) + uint(m.y)) * uint(D.x) + uint(m.x); }
ivec2 giTexelAt(uint t, ivec2 D, out uint view)
{
    const uint row = t / uint(D.x);
    view = row / uint(D.y);
    return ivec2(int(t % uint(D.x)), int(row - view * uint(D.y)));
}
// push (VKRtReflPush, LLCleanRendererVK::recordGI): rtr.x the ray length (m), rtr.y the RT hit
// options (rtrOpts: the hit's projector shadow-ray budget, the light grid), rtr.w the sampler
// anisotropy; rtr2.xy the GI extent, z the frame index, w the GI denoiser's GEOM parity.
float giViewZ(ivec2 q)
{
    q = clamp(q, ivec2(0), ivec2(int(g_draw_push.width), int(g_draw_push.height)) - 1);
    const float d = defTexel(uDepthG, q).r;
    if (!(d > 0.0)) return -1.0;
    GIR_PREC const vec2 ndc = (vec2(q) + 0.5) / vec2(float(g_draw_push.width), float(g_draw_push.height)) * 2.0 - 1.0;
    GIR_PREC const vec4 h = GIR_MUL4(deferInvVP, vec4(ndc, d, 1.0));
    GIR_PREC const float z = dot(pc.u_cam_time.xyz + h.xyz / h.w - linfo.cam_pos.xyz, linfo.cam_fwd.xyz);
    return z;
}
float giGrad(ivec2 rp, ivec2 o, float vz)
{
    const float zp = giViewZ(rp + o), zn = giViewZ(rp - o);
    const float a = zp > 0.0 ? zp - vz : 1e30, b = zn > 0.0 ? vz - zn : 1e30;
    const float g = abs(a) <= abs(b) ? a : b;
    return abs(g) < 1e29 ? clamp(g, -0.5 * vz, 0.5 * vz) : 0.0;
}
vec2 giPrevDelta(vec3 X, ivec2 m, vec2 D, out float pw)
{
    GIR_PREC const vec4 c = GIR_MUL4(ssr.views[CLEAN_VIEW].taa_prev_vp, vec4(X - ssr.cam_origin.xyz, 1.0));
    pw = 0.0;
    if (!(c.w > 1e-4)) return vec2(0.0);
    pw = c.w;
    GIR_PREC const vec2 puv = c.xy / c.w * 0.5 + 0.5;
    GIR_PREC const vec2 dS = puv * D - 0.5 - vec2(m);
    return clamp(dS, vec2(-30000.0), vec2(30000.0));
}
float giRand(inout uint s) { s = giPcg(s); return float(s >> 8u) * (1.0 / 16777216.0); }
// Cosine-weighted direction around N (pdf cos / pi).
vec3 giCosDir(vec3 N, vec2 u)
{
    const vec3 t = normalize(abs(N.z) < 0.999 ? cross(N, vec3(0.0, 0.0, 1.0)) : cross(N, vec3(1.0, 0.0, 0.0)));
    const vec3 b = cross(N, t);
    const float r = sqrt(u.x), phi = 6.2831853 * u.y;
    return normalize(t * (r * cos(phi)) + b * (r * sin(phi)) + N * sqrt(max(1.0 - u.x, 0.0)));
}
// One GI path vertex: the closest hit along d from o (every class but alpha-blend), shaded as the RT
// reflections shade theirs, seen from the receiver P; a miss takes the sky. xs / ns: the vertex and
// its geometric normal toward the ray (a sky sample: P + d x GI_FAR, -d).
// (#1031) In two halves -- giTraceRay (the walk) and giShadeHit (the hit's or the sky's radiance) --
// so the split stages run them in separate kernels; giTrace is the two in a row (the fused kernel,
// the re-shade).
#define GI_FAR 1.0e4
bool g_gi_back = false;   // (GI_F_BACK_STOP) the last giTrace stopped at a single-sided back face
uint g_gi_outcome = 0u;   // (gi-glass) the last GI ray's outcome word (clean_gi_common.glsl GIO_*)
// The TLAS class of a committed GI hit (the walk's mask holds every class but alpha-blend).
uint giHitClass(uint id)
{
    if (!rtIdIn(id)) return GIO_OPAQUE;
    const uint fl = rt_instances[id].flags;
    if ((fl & (2048u | 32u)) != 0u) return GIO_GROUND;
    if ((rt_geom[id].z & 0x80000000u) != 0u || (fl & (512u | 8192u)) != 0u) return GIO_AVATAR;
    if ((fl & 4u) != 0u) return GIO_AMASK;
    return GIO_OPAQUE;
}
// The walk: the closest hit along d from o (every class but alpha-blend). The caller set the ray
// cone (rt_cone_*) and the alpha test's (rtrMaskCone); after it the alpha test's are back to the
// defaults (the hit shading's shadow walks take those). g_gi_back: the hit is a back-face stop.
RtHit giTraceRay(vec3 o, vec3 d, float tmax)
{
    rt_anim_time = pc.u_cam_time.w;
    // (GI_F_CULL_BACK: single-sided back faces culled in traversal -- the shader's own rule
    //  (rtrClosest skips them) without the candidate / re-trace; the reflections' HWCull convention)
    uint rfl = gl_RayFlagsNoneEXT;
    // (GI_F_BACK_STOP) the walk must SEE back faces to stop at them: no hardware culling then
    const bool backStop = (gi.cfg.x & GI_F_BACK_STOP) != 0u;
    if ((gi.cfg.x & GI_F_CULL_BACK) != 0u && !backStop)
        rfl = ((uint(ssr.foliage_rt.x + 0.5) & 4u) != 0u) ? gl_RayFlagsCullFrontFacingTrianglesEXT
                                                          : gl_RayFlagsCullBackFacingTrianglesEXT;
    g_rc_back_stop = backStop;
    const RtHit h = rtrClosest(o, d, 0.0, tmax, RT_MASK_ALL & ~RT_MASK_BLEND, RT_BLEND_CUTOFF, rfl);
    g_rc_back_stop = false;
    g_gi_back = g_rc_back;
    rt_mask_width0 = -1.0; rt_mask_lod_bias = 0.0; rt_mask_lod_max = 64.0; rt_mask_cov_k = 0.0;
    g_gi_outcome = !h.hit ? GIO_SKY : (g_gi_back ? GIO_BACK : giHitClass(h.instance));
    return h;
}
// (gi-glass) GI THROUGH GLASS (GIX_TRANSMIT; RenderVKGITransmit). The walk above never sees the alpha-blend
// class (RT_MASK_BLEND is out of its mask): before, a GI ray passed every alpha-blend surface as if it were not
// there -- no attenuation, no tint, and none of the layer's own light (a fullbright / lit stained-glass pane added
// nothing) -- while the RT reflection rays composite those layers over their hit (rtrReflTail -> rtrBlendLayers):
// the rough walls' wide reflection lobes saw the bright window, GI's diffuse rays the scene behind it unfiltered.
// Here a GI sample L arriving from tEnd along d (the hit's distance, or the ray length on a miss) is composited
// under the RTR_BLEND_LAYERS nearest blend layers on [0, tEnd] exactly as a reflection ray's (the same walk:
// alpha-tested texels at the ray cone, the layer lit by the sun through one shadow ray + the cache's ambient there,
// fullbright layers by their own colour): L' = layers' light + T x L. Tinted (GIX_TINT): T per channel the product
// of translucentTransmit(colour, alpha) -- the coloured shadow rays' rule -- else the grey product of (1 - alpha).
// Deterministic, one extra traversal over the blend class only per GI ray (at most RTR_BLEND_LAYERS layers kept,
// RT_CANDIDATE_BUDGET candidates), + one sun shadow ray per kept lit layer. The source clamp is applied again to
// the composite (a fullbright pane is an emitter like a lamp's glass). Counts the layers into g_gi_outcome.
vec3 giTransmit(vec3 P, vec3 d, float tEnd, vec3 L)
{
    if ((gi.xcfg.x & GIX_TRANSMIT) == 0u) return L;   // (a header word: uniform)
    const vec3 cam = pc.u_cam_time.xyz;
    const float eps = 1e-3 + 1e-5 * length(P - cam);   // (the receiver's own surface: never a layer of its ray)
    if (!(tEnd > 2.0 * eps)) return L;
    vec3 sunlit, amblit, additive, atten;
    atmosLightTerms(P - cam, vec3(0.0, 0.0, 1.0), sunlit, amblit, additive, atten);
    g_blend_rgb = (gi.xcfg.x & GIX_TINT) != 0u;
    uint layers;
    vec3 sum;
    float T;
    rtrBlendLayersT(P + d * eps, d, tEnd - eps, sunlit, amblit, 3.0e38, layers, sum, T);   // (3e38: no size skip)
    g_blend_rgb = false;
    if (layers == 0u) return L;
    g_gi_outcome |= min(layers, 7u) << GIO_LAYER_SHIFT;
    vec3 c = sum + g_blend_T3 * L;
    if (any(isnan(c)) || any(isinf(c))) return L;
    c = clamp(c, vec3(0.0), vec3(LG_MAX_VALUE));
    const float clampL = gi.prm2.w;
    if (clampL > 0.0)
    {
        const float l = giLum(c);
        if (l > clampL) c *= clampL / l;
    }
    return c;
}
// (gi-glass, GI_F_STATS) one finished GI ray's outcome (g_gi_outcome) into the header's stat5 .. stat7. Ballots:
// any convergence (each active lane is counted by its own invocation's elected lane).
void giOutcomeCount(uint oc)
{
    if ((gi.cfg.x & GI_F_STATS) == 0u) return;   // (a header word: uniform)
    const uint cls = oc & 7u, nl = oc >> GIO_LAYER_SHIFT;
    const uvec4 a = uvec4(subgroupBallotBitCount(subgroupBallot(cls == GIO_SKY)),
                          subgroupBallotBitCount(subgroupBallot(cls == GIO_OPAQUE)),
                          subgroupBallotBitCount(subgroupBallot(cls == GIO_AMASK)),
                          subgroupBallotBitCount(subgroupBallot(cls == GIO_GROUND)));
    const uvec4 b = uvec4(subgroupBallotBitCount(subgroupBallot(cls == GIO_AVATAR)),
                          subgroupBallotBitCount(subgroupBallot((oc & GIO_FB) != 0u)),
                          subgroupBallotBitCount(subgroupBallot((oc & GIO_EMDROP) != 0u)),
                          subgroupBallotBitCount(subgroupBallot(cls == GIO_BACK)));
    const uvec3 c = uvec3(subgroupBallotBitCount(subgroupBallot(nl != 0u)), subgroupAdd(nl),
                          (gi.xcfg.x & GIX_TRANSMIT) != 0u ? subgroupBallotBitCount(subgroupBallot(nl == 0u)) : 0u);
    if (subgroupElect())
    {
        if (a.x != 0u) atomicAdd(gi.stat5.x, a.x);
        if (a.y != 0u) atomicAdd(gi.stat5.y, a.y);
        if (a.z != 0u) atomicAdd(gi.stat5.z, a.z);
        if (a.w != 0u) atomicAdd(gi.stat5.w, a.w);
        if (b.x != 0u) atomicAdd(gi.stat6.x, b.x);
        if (b.y != 0u) atomicAdd(gi.stat6.y, b.y);
        if (b.z != 0u) atomicAdd(gi.stat6.z, b.z);
        if (b.w != 0u) atomicAdd(gi.stat6.w, b.w);
        if (c.x != 0u) atomicAdd(gi.stat7.x, c.x);
        if (c.y != 0u) atomicAdd(gi.stat7.y, c.y);
        if (c.z != 0u) atomicAdd(gi.stat7.z, c.z);
    }
}
// The radiance the walk's result brings to the receiver P: a miss the sky (+ the probes' far field),
// a hit its material shaded as the RT reflections shade theirs (never a back-face stop: the caller's).
// Needs the walk's ray cone (rt_cone_*: the hit's texture LOD).
// (#1036) In three parts -- the miss (giShadeMiss), the hit's material (giHitMaterial) and its lighting
// (giHitLight) -- so the shade split runs them in separate kernels (the material handed over as the
// RT LIT RECORD); giShadeHit is the three in a row (the fused kernel, SHADE, the re-shade).
vec3 giShadeMiss(vec3 d, vec3 P, out vec3 xs, out vec3 ns)
{
    xs = P + d * GI_FAR;
    ns = -d;
    vec3 sky = cmOn() ? physkyRolloff(cmBoundarySky(P,d)) : skyColor(d);
    if ((gi.cfg.x & GI_F_MISS_PROBES) != 0u)
    {
        // the far field: the probes along d (what lies past the ray length -- a far building, the
        // terrain beyond -- as the probes captured it; the sky where none covers P)
        vec3 pr, pr2, pirr;
        if (sampleProbesEx(P, d, d, 0.5 * phdr.info.y, 0.0, sky, true, false, false, pr, pr2, pirr)) sky = pr;
    }
    return (any(isnan(sky)) || any(isinf(sky))) ? vec3(0.0) : max(sky, vec3(0.0));
}
RtSurface giHitMaterial(RtHit h, vec3 d)
{
    RtSurface hs = rtSurfaceEval(h, d);
    rtWeatherHit(hs);   // #970: the weather coat at the GI hit (the lying-snow march is the reflections' only)
    if (hs.model == RT_SURF_FULLBRIGHT || any(greaterThan(hs.emissive, vec3(0.0)))) g_gi_outcome |= GIO_FB;
    // (#91) THE GI SPLIT (clean_regir.glsl EMISSIVE LIGHTS): an emitter ReSTIR DI samples this frame
    // (in the emitter hash: its triangle block was written) lights the receiver through DI -- its emission
    // is not GI's (no double light). Its reflected light stays; an emitter the caps dropped keeps its
    // emission here.
    // De-rez rows may remain visible for their effect after object death. They no
    // longer emit into GI; preserve any reflected fullbright-shiny environment term.
    // This is the existing dying flag, not a classification of live temporary objects.
    if ((hs.flags & 4194304u) != 0u
        || (rsFrameOn() && (rg.rs_em_cfg.z & EM_F_GI_SPLIT) != 0u
            && emLitOn() && emHashFind(h.instance) != REGIR_EM_NONE))
    {
        if ((g_gi_outcome & GIO_FB) != 0u) g_gi_outcome |= GIO_EMDROP;
        hs.emissive = vec3(0.0);
        if (hs.model == RT_SURF_FULLBRIGHT) hs.fb = vec3(0.0);
    }
    return hs;
}
vec3 giHitLight(RtLitSurface hs, vec3 d, vec3 P, out vec3 xs, out vec3 ns)
{
    vec3 c = rtShadeHit(hs, P, 0u, pc.u_cam_time.w).rgb;
    if (any(isnan(c)) || any(isinf(c))) c = vec3(0.0);
    xs = hs.P;
    ns = dot(hs.Ng, d) > 0.0 ? -hs.Ng : hs.Ng;
    c = clamp(c, vec3(0.0), vec3(LG_MAX_VALUE));
    // FIREFLY CLAMP AT THE SOURCE (RenderVKGIFireflyClamp): a GI ray that hits a small bright
    // emitter (a lamp's lantern glass -- fullbright / emissive -- or a surface right at a light)
    // returns a huge radiance from a tiny solid angle; the reservoirs then PREFER it (p ~ its
    // luminance), carry it for up to the M cap and spread it to neighbours: the blobs that fade in
    // and out around lamp posts. Clamped here, before the reservoirs see it (the sharp direct light
    // of such emitters is the DI / #91 path's job, not a diffuse bounce's).
    const float clampL = gi.prm2.w;
    if (clampL > 0.0)
    {
        const float l = giLum(c);
        if (l > clampL) c *= clampL / l;
    }
    return c;
}
vec3 giShadeHit(RtHit h, vec3 d, vec3 P, out vec3 xs, out vec3 ns)
{
    rt_anim_time = pc.u_cam_time.w;
    if (!h.hit) return giShadeMiss(d, P, xs, ns);
    return giHitLight(rtLitSurface(giHitMaterial(h, d)), d, P, xs, ns);
}
vec3 giTrace(vec3 o, vec3 d, float tmax, vec3 P, out vec3 xs, out vec3 ns, out bool hit, out float hdist)
{
    const RtHit h = giTraceRay(o, d, tmax);
    hit = h.hit;
    hdist = h.hit ? h.dist : 0.0;
    if (h.hit && g_gi_back)
    {
        // a single-sided BACK face first: the ray started inside geometry / slipped into a seam --
        // the surface's dark inside (no light), an occluder for the sky visibility; never shaded
        // (its "lit" side faces away from the receiver)
        xs = o + d * h.dist;
        ns = -d;
        giOutcomeCount(g_gi_outcome);
        return vec3(0.0);
    }
    vec3 L = giShadeHit(h, d, P, xs, ns);
    L = giTransmit(P, d, h.hit ? h.dist : tmax, L);
    giOutcomeCount(g_gi_outcome);
    return L;
}
#if defined(CLEAN_GI_RESOLVE)
// ---- (GI-4) THE RADIANCE CACHE'S RESOLVE (kWorldDeferGiResolveSpv; after the GI trace): one slot
//      per invocation -- this frame's accumulation into the cell's mean (an exponential window of
//      up to prm3.z frames), the accumulator cleared, the age; a cell untouched for prm3.w frames is
//      freed (GI_KEY_TOMB: lookups walk past it), one inside a change sphere takes a short mean
//      (GI_SPHERE_CACHE_FRAMES; #1438) or, unmeasured lately, restarts (its samples dropped: geometry /
//      an emitter changed there -- never the camera). A region whose light really changed (its bin's
//      verdict: clean_gi_common.glsl THE CHANGE TEST) has its cells CHANGED: one-frame means, the unmeasured
//      ones following the measured ones' ratio. ----
void DEFER_MAIN()
{
    const uint cap = giCacheSlots();
    const uint s = (gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x) * 64u + gl_LocalInvocationIndex;
    uint live = 0u, evicted = 0u, inval = 0u;
    // the change bins' banks: written this frame, read (last frame's), cleared (next frame's) -- by the frame
    const uint binBase = 4u * cap, frame = gi.cfg.y;
    const uint binW = binBase + giBinBank(frame) * GI_BIN_BANK;
    const uint binR = binBase + giBinBank(frame + 2u) * GI_BIN_BANK;
    const uint binC = binBase + giBinBank(frame + 1u) * GI_BIN_BANK;
    for (uint i = s; i < GI_BIN_BANK; i += max(cap, 1u)) gi_data[binC + i] = uvec4(0u);
    const float unit = GI_SPHERE_THR * max(gi.prm6.w, 1e-6);   // (no light below it counts as a change)
    if (s < cap)
    {
        const uvec4 c0 = gi_data[2u * s];
        if (c0.x != 0u && c0.x != GI_KEY_TOMB)
        {
            const uint a = 2u * cap + s;
            const uvec4 acc = gi_data[a];
            uvec4 c1 = gi_data[2u * s + 1u];
            vec2 ages = uintBitsToFloat(gi_data[3u * cap + s].xy) / HT_REF_MS;
            float n = ages.x, age = ages.y;
            vec3 E = vec3(unpackHalf2x16(c1.y), unpackHalf2x16(c1.z).x);
            // change spheres (the host's, this frame)
            const vec3 cc = vec3(uintBitsToFloat(c0.z), uintBitsToFloat(c0.w), uintBitsToFloat(c1.x));
            const float edge = uintBitsToFloat(c1.w);
            float sphS;
            const uint sphHit = giSphereHitS(cc, 0.87 * edge, sphS);
            float nWin = max(gi.prm3.z, 1.0);
            if (sphHit != 0u)
            {
                // (stat4.z: the cells a HARD sphere touched -- the only ones that may restart)
                if (sphHit == 2u) ++inval;
                // (#1438, GI_SPHERE_CACHE_FRAMES) measured now or lately, or in a SOFT sphere only (an
                // emitter's light changed: stale, not wrong): a short mean, its value kept; else a restart
                // (age: the frames since its last sample, before this frame's)
                if (sphHit == 1u || acc.w > 0u || age <= GI_SPHERE_CACHE_FRAMES)
                {
                    // (a soft sphere: the window shortened by how much the change matters against the cell's
                    // value -- giSoftCap's rule, at least GI_SPHERE_CACHE_FRAMES; flat A/B: that everywhere)
                    nWin = sphHit == 1u ? max(giSoftCap(sphS, giLum(E), nWin), min(nWin, GI_SPHERE_CACHE_FRAMES))
                                        : min(nWin, GI_SPHERE_CACHE_FRAMES);
                    if ((gi.cfg.x & GI_F_SPH_FLAT) != 0u) nWin = min(nWin, GI_SPHERE_CACHE_FRAMES);
                    n = min(n, nWin);
                }
                else { n = 0.0; E = vec3(0.0); }
            }
            // (#1087) a cell inside a recently moved light's old or new sphere: a short mean window
            // (prm6.z) -- it follows the moving light instead of averaging its path (a decay, its
            // samples kept: never the restart #980 removed for colour-cycling lights)
            if (gi.prm6.z > 0.0 && gi.prm6.x > 0.5)   // (header words: uniform)
            {
                const uint nh = min(uint(gi.prm6.x + 0.5), GI_HOT_MAX);
                for (uint k = 0u; k < nh; ++k)
                {
                    const vec4 so = gi.hot[4u * k], sn = gi.hot[4u * k + 2u];
                    const vec3 dO = cc - so.xyz, dN = cc - sn.xyz;
                    const float ro = abs(so.w) + 0.87 * edge, rn = sn.w + 0.87 * edge;
                    if (dot(dO, dO) < ro * ro || dot(dN, dN) < rn * rn)
                    {
                        nWin = min(nWin, max(gi.prm6.z, 1.0));
                        n = min(n, nWin);
                        break;
                    }
                }
            }
            // (the sealed-room fade, clean_gi_common.glsl THE CHANGE TEST) the change word: the episode's direction,
            // the CHANGED hold; the region's verdict -- last frame's bin record -- and its mean ratio
            const uvec2 cw = gi_data[3u * cap + s].zw;
            float vs = uintBitsToFloat(cw.x);
            uint hold = (cw.y >> 8u) & 0xFFu;
            hold = hold > 0u ? hold - 1u : 0u;
            const uint bkey = giBinKey(cc);
            const uint bslot = 2u * (giPcg(bkey) & (GI_BIN_N - 1u));
            uint binV = 0u;
            float binRat = 1.0;
            {
                const uvec4 b0 = gi_data[binR + bslot];
                if (b0.x == bkey && b0.y == frame)
                {
                    const uvec3 b1 = gi_data[binR + bslot + 1u].xyz;
                    binV = giBinVerdict(b0.z, float(int(b1.x)) / GI_BIN_RQ, float(b1.y) / GI_BIN_VQ);
                    binRat = giBinRatio(b0.z, b0.w, b1.z);
                }
            }
            const uint hst = giCellHold(binV, hold, cw.y & 15u);
            // CHANGED: this frame's fresh mean is the cell's (GI_CELL_HWIN)
            if (hold > 0u) { nWin = min(nWin, GI_CELL_HWIN); n = min(n, nWin); }
            if (acc.w > 0u)
            {
                const vec3 mean = vec3(acc.xyz) / (GI_ACC_SCALE * float(acc.w));
                const bool fresh = n <= 0.0;
                const float cnt = float(acc.w), m = giLum(mean), mu = giLum(E);
                float br, bv;
                const bool terms = !fresh && giBinTerms(m, mu, vs, cnt, n, unit, br, bv);
                n = htAdvance(n, nWin);
                const float aE = fresh ? 1.0 : htAlpha(1.0 / max(n, 1.0));
                vs = fresh ? 0.0 : giCellVar(vs, m, mu, cnt, aE, hold > 0u);
                E = mix(E, mean, aE);
                age = 0.0;
                gi_data[a] = uvec4(0u);
                // (gi-glass, GIX_CACHE_DIR) the mean direction: this frame's luminance-weighted direction sum over
                // its luminance sum (the same fixed point), into the cell's mean with the irradiance's own weight
                if ((gi.xcfg.x & GIX_CACHE_DIR) != 0u)
                {
                    const uint da = GI_DIR_BASE(cap) + s;
                    const uvec4 dw = gi_data[da];
                    const float lsum = giLum(vec3(acc.xyz));
                    vec3 vf = lsum > 0.0 ? vec3(ivec3(dw.xyz)) / (GI_DIR_Q * lsum) : vec3(0.0);
                    const float vl = length(vf);
                    if (!(vl <= 1.0)) vf = vl > 1.0 ? vf / vl : vec3(0.0);   // (NaN: none)
                    const bool had = !fresh && (dw.w & (1u << 30)) != 0u;
                    gi_data[da] = uvec4(0u, 0u, 0u, giPackDir(had ? mix(giUnpackDir(dw.w), vf, aE) : vf));
                }
                // its terms into its region's bin (next frame's verdict and ratio). A CHANGED cell (hold) adds its
                // means (the ratio the region's unmeasured cells follow) but NO departure: its stored mean is the
                // last frame's fresh mean (GI_CELL_HWIN), and (m - mu) / mu against one noisy frame is biased (mu
                // in the denominator) -- summed over the bin it re-armed the episode on its own noise every frame,
                // so a region that went CHANGED once stayed CHANGED (the latch, gi_sealed_fade.py (c)). The episode
                // now runs its GI_CELL_HOLD frames; a real change still going on fires again from settled cells.
                if (terms)
                {
                    const uint bi = binW + bslot;
                    uint k = gi_data[bi].x;
                    if (k == 0u) { k = atomicCompSwap(gi_data[bi].x, 0u, bkey); if (k == 0u) k = bkey; }
                    if (k == bkey)
                    {
                        gi_data[bi].y = frame + 1u;   // (the tag: every writer stores the same value)
                        atomicAdd(gi_data[bi].z, 1u);
                        atomicAdd(gi_data[bi].w, giBinQ(mu, unit));
                        if (hold == 0u)
                        {
                            atomicAdd(gi_data[bi + 1u].x, uint(int(round(br * GI_BIN_RQ))));
                            atomicAdd(gi_data[bi + 1u].y, uint(bv * GI_BIN_VQ + 0.5));
                        }
                        atomicAdd(gi_data[bi + 1u].z, giBinQ(giLum(E), unit));
                    }
                }
            }
            else
            {
                age = htAdvance(age, max(gi.prm3.w + htStep(), 1.0));
                // NOT MEASURED this frame (behind the camera, occluded) and CHANGED: the ratio its region's measured
                // cells changed by last frame -- GI hits read it, and nothing else updates it before eviction: a
                // sealed room's unseen walls fade with its seen ones instead of holding the room up. Settled light
                // never starts an episode: no random walk.
                if (n > 0.0 && hold > 0u) E *= binRat;
            }
            if (float(age) > gi.prm3.w)
            {
                gi_data[2u * s] = uvec4(GI_KEY_TOMB, 0u, 0u, 0u);
                ++evicted;
            }
            else
            {
                // Low word is only the reader's valid marker; clocks live in float32 ms.
                gi_data[2u * s].y = n > 0.0 ? 1u : 0u;
                gi_data[3u * cap + s] = uvec4(floatBitsToUint(vec2(n, age) * HT_REF_MS), floatBitsToUint(vs),
                                              hst | (hold << 8u));
                c1.y = packHalf2x16(E.rg);
                c1.z = packHalf2x16(vec2(E.b, 0.0));
                gi_data[2u * s + 1u] = c1;
                ++live;
            }
        }
    }
    if ((gi.cfg.x & GI_F_STATS) == 0u) return;   // (a header word: uniform)
    const uint sl = subgroupAdd(live), se = subgroupAdd(evicted), si = subgroupAdd(inval);
    if (subgroupElect())
    {
        if (sl != 0u) atomicAdd(gi.stat4.x, sl);
        if (se != 0u) atomicAdd(gi.stat4.y, se);
        if (si != 0u) atomicAdd(gi.stat4.z, si);
    }
}
