    if (visOut) visDepthStore(px, s, P, sunWant);
    CLK_MARK(STORE);
    if ((g_draw_push.flags & DEFER_FLAG_PROJ) != 0u)
    {
        const uvec4 o = s.model == SURF_FULLBRIGHT ? uvec4(0u) : deferResolveProjectors(s, P);
        CLK_MARK(PROJ);
        imageStore(uVisProj, DS_PROJ_TEXEL(px, 0), uvec4(o.x));
        if (o.x != 0u)   // (no slot: the combine reads layer 0 only)
        {
            imageStore(uVisProj, DS_PROJ_TEXEL(px, 1), uvec4(o.y));
            if ((g_draw_push.flags & DEFER_FLAG_PROJ_RGB) != 0u)
            {
                imageStore(uVisProj, DS_PROJ_TEXEL(px, 2), uvec4(o.z));
                imageStore(uVisProj, DS_PROJ_TEXEL(px, 3), uvec4(o.w));
            }
        }
        CLK_MARK(STORE);
    }
}

