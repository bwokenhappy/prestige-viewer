        //  mover-only sun, clean_shadow_mask_read.glsl rtMoverSun; 1 without the routing)
        const vec3 sst = clamp(deferPdnSunFetch(P, Ng), vec3(0.0), vec3(1.0));
        const vec3 vis = litDbgMover(LDBG_NO_MOVER) ? sst : sst * rtMoverSun(P);
        const float sv = max(max(vis.r, vis.g), vis.b);
        if (sv > 1e-4) tint = vis / sv;
        core = sv;
    }
    return core * cloudShadowMap(P);
}
