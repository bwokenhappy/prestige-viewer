    g_frag_xy = vec2(px) + 0.5;
    vec4 g2 = vec4(0.0);
    if (inside)
    {
        CLK_INV();
        g2 = defTexel(uG2, px);
    }
    const bool surf = inside && deferHasSurface(g2);
    vec3 P = vec3(0.0);
    if (surf) P = deferPosition(px);
    gridTileBuild(lid, surf, P);
    if (!inside) return;
#else
    const ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if (px.x >= int(g_draw_push.width) || px.y >= int(g_draw_push.height)) return;
    CLK_INV();
    g_frag_xy = vec2(px) + 0.5;
    const vec4 g2 = defTexel(uG2, px);
