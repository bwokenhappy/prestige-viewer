                pdnProbePutF(o + 1u, pdnLum(dt));
                pdnProbePutF(o + 2u, pdnLum(st));
                pdnProbePutF(o + 3u, pdnLum(vis));
                pdnProbePutF(o + 4u, unpackHalf2x16(jw >> 16u).x);
                pdnProbePut(o + 5u, (lit ? 1u : 0u) | (mvHit ? 2u : 0u) | (vis.r != vis.g || vis.g != vis.b ? 4u : 0u)
                                     | ((li + 1u) << 8u));
            }
            if (!lit) continue;
            numD += dt * vis; denD += dt;
            numS += st * vis; denS += st;
            evN += dt * vis; evD += dt;
            const float hl = pdnLum(st) + 1e-6;
            hitSum += pd * hl;
            hitW += hl;
            // (the sample loop's rules: the reservoir's visibility reuse, THE MOVER REPORT)
            const bool reached = max(max(vis.r, vis.g), vis.b) > 0.0;
            if (reached) rvVisLi = li;
            else if (!mvHit) rvOccLi = li;
            const uint lKey = radOn ? deferMotReportKey(li) : 0u;   // (li < nL: lit)
            if (lKey != 0u)
            {
                if (mvHit && !reached)
                {
                    if (!repMover) { repLight = lKey; repMover = true; }
                }
                else if (reached && !repMover && (repLight == 0u || ((frame + uint(m.x) + uint(m.y) + k) & 1u) != 0u))
                    repLight = lKey;
            }
        }
        if (prb)
        {
            pdnProbePutF(6u, pdnLum(numD));
            pdnProbePutF(7u, pdnLum(numS));
            pdnProbePut(9u, min(sel.u1, RTP_X_LIGHTS));
        }
    }
#endif
    CLK_MARK(PROJ);
#if CLEAN_SHADOW_STAGE == SH_STAGE_SHADE
    // (#1031) the descriptor's end-of-texel words
    const uvec4 sd2 = pdn_sel[sdi + 2u], sd3 = pdn_sel[sdi + 3u];
    nCand = uintBitsToFloat(pdn_sel[sdi + 1u].w);
    const float fMove = uintBitsToFloat(sd2.x);
    spId = uvec4(sd2.z & 0xFFFFu, sd2.z >> 16u, sd2.w & 0xFFFFu, sd2.w >> 16u);
    const uint rsYl = sd3.x;
    const float rsM = uintBitsToFloat(sd3.y);
    const float rsDom = uintBitsToFloat(sd3.w);   // (#1052: SELECT's strongest-candidate share)
#endif
    // (RS_F_VIS_REUSE, radiance mode) VISIBILITY REUSE: this texel's reservoir (SELECT / the selection above stored
    // it, this parity) holds a light whose sample here was fully blocked -- no sample of it reached it -- so
    // the reservoir is re-stored with W = 0, its M kept: next frame its texel counts its M at weight 0 (rsTap,
    // the temporal tap) and neither it nor its neighbours pick it. Without it an occluded pick (a projector of the next room, in the
    // same grid cell) kept its full weight for up to the M cap in frames and the spatial taps spread it: a
    // neighbourhood of exact zeros beside one of the visible light's over-weighted picks, held for many
    // frames -- blotches no denoiser history averages away. The light still lights P unshadowed, so the
    // fresh candidates keep proposing it (a light coming into view is found again at once). Bias: the
    // ReSTIR paper's biased variant (a blocked neighbour's zero counted here). A light sample without terms
    // here (a black gobo texel: no ray) says nothing: untouched.
    if (rsResOn && (rg.rs_cfg.z & RS_F_VIS_REUSE) != 0u && rvOccLi != 0xFFFFFFFFu && rvOccLi == rsYl
        && rvVisLi != rsYl)
        rs_res[rsResIndex(m, D, uint(par))] = rsResPack(rsYl, rsM, 0.0);
    // (#869 OCCLUSION CULL, THE POINT LIGHTS' SHARE above) every POINT light this texel's patch culls (its
    // draw: occCulled, the same g_occ_u that kept it out of the candidates, the reservoirs, the split and the
    // dense window) that the lit kernels shade with the ratio here (deferRsStoch: in the set, no record, a
    // ReSTIR frame; not taken over) joins the DENOMINATORS with its exact unshadowed terms -- weight 1, visibility
    // a known 0, no ray. The ratio stays over the whole light set whatever the cull did. Each one counts as an
    // evaluated candidate (a texel whose only lights are culled holds a real 0, not "no information").
    // (rsFrameOn, not "in the grid": past it the cluster walk takes the extended set too -- deferRsStoch)
    if (ocCull != OCC_NONE && projOn && rsFrameOn() && (rg.rs_cfg.z & RS_F_OCC_PT_DROP) == 0u)
    {
        float nPt = 0.0;
        [[dont_unroll]] for (uint ow = 0u; ow < 32u; ++ow)
        {
            const uint cw = occLoad(occWord(ocCull, OCC_W_CNT + ow));
            if (cw == 0u) continue;
            [[dont_unroll]] for (uint oq = 0u; oq < 8u; ++oq)
            {
                const uint li = ow * 8u + oq;
                if (!(occWeightOf((cw >> (oq * 4u)) & 15u) > g_occ_u)) continue;
                if (li >= count || !occKeepsShare(li) || !rsInSet(li) || rsRecordLight(li) || emTaken(li)
                    || pdnRestHas(spLi, li)) continue;
                vec3 xd = vec3(0.0), xs = vec3(0.0);
                float xp = 0.0;
                if (!projDirectTerms(li, P, s.N, V, pbr, base, diffuseColor, specularColor, rough, ls, false, xd, xs, xp))
                    continue;
                denD += xd;
                denS += xs;
                evD += xd;   // (a known 0: exact, the evidence's too)
                nPt += 1.0;
            }
        }
        nCand += nPt;
    }
    if (ocOn && pdnPassIdx() == 0u)   // (#869 OCCLUSION CULL stats: probes fired, patch claims refused; ocOn is uniform)
    {
        const uint sP = subgroupAdd(nOcP), sR = subgroupAdd(ocRefused);
        if (subgroupElect()) { occStatAdd(9u, sP); occStatAdd(10u, sR); }
    }
    if (emOn && pdnPassIdx() == 0u)   // (#91 stats: one atomic per subgroup; emOn is uniform)
    {
#if CLEAN_SHADOW_STAGE == SH_STAGE_SHADE
        const uint sE = 0u;   // (SELECT counted the texels with emitters)
#else
        const uint sE = subgroupAdd(nEm > 0u ? 1u : 0u);
#endif
        const uint sR = subgroupAdd(emRays);
        if (subgroupElect())
        {
            if (sE != 0u) atomicAdd(rg.rs_em_stat[2], sE);
            if (sR != 0u) atomicAdd(rg.rs_em_stat[3], sR);
        }
    }
    const float hitDist = hitW > 0.0 ? hitSum / hitW : 0.0;
    // layer 0 a: the candidate count (> 0 informative; pdnInfoA) -- with a reused reservoir
    // 1000 + its M (#85: the denoiser's converged-texel rule, clean_dn_temporal.comp DN_RS_M)
    float a0 = pdnInfoA(nCand, denD, infoFix);
    // (#91) not for a reused EMITTER: its sample is a new point on a (possibly metres-wide) triangle every
    // frame -- a binary visibility across the whole penumbra, not a converged value (full a-trous there)
    // (#1052) nor where several lights share the texel (RenderVKReSTIRConvMultiLight 0, the default): a reused
    // pick's M is the light SELECTION's confidence, not the visibility's -- the ratio is still ONE light's
    // binary visibility per frame, and with the M cap and the spatial reuse a whole neighbourhood keeps the
    // same pick, so its history converges to that light's shadow, not the mix. The shortcut's few a-trous
    // iterations then left those regions as organic blotches with a hard rim where the shortcut flag
    // toggled (the cull-off blotches). Where one light holds >= RS_CONV_DOM of the target the pick IS the
    // mix: the shortcut stays.
    const bool convOk = (rg.rs_cfg.z & RS_F_CONV_ANY) != 0u || rsDom >= RS_CONV_DOM;
    if (reused && a0 > 0.0 && pick0 < REGIR_EM_KEY && convOk) a0 = 1000.0 + rsM;
    vec3 l0 = pdnRatio(numD, denD);
    vec3 l1 = pdnRatio(numS, denS);
    float a1 = pdnInfoSpecA(hitDist, nCand, denS, infoFix);
    if (radOn)
    {   // (RADIANCE MODE, pdnRadOn above) the shadowed light itself, demodulated; a = the candidate count (no
        // no-information negation, no converged marker: the host runs the denoiser with radiance semantics)
        // and the hit distance
        l0 = pdnSane(numD / radDf);
        l1 = pdnSane(numS / radSf);
        a0 = nCand;
        a1 = hitDist;
    }
    if ((opts & PDN_OPT_DBG_RS) != 0u)   // (RenderVKDenoiseDebug 7: the ReSTIR view)
    {
        const uint yl = rsYl;
        const float mf = rsResOn ? clamp(rsM / float(max(rg.rs_cfg2.x, 1u)), 0.0, 1.0) : 1.0;
        // (#91) an EMITTING TRIANGLE pick: amber (its slot changes every build: no stable hue)
        l0 = rsCell == REGIR_NO_CELL ? vec3(0.25) : (yl == 0xFFFFFFFFu ? vec3(0.3, 0.0, 0.0)
                                                       : (yl >= REGIR_EM_KEY ? vec3(1.0, 0.55, 0.1) : rsHue(yl))
                                                         * (0.2 + 0.8 * mf));
        // (#869 RS_MOVE_ON) texels lit by a light that MOVED this frame: white diagonal stripes,
        // their brightness the moved lights' share (fMove: what the denoiser's history cap reads)
        if (fMove > 0.0 && ((m.x + m.y) & 7) < 2) l0 = vec3(fMove);
        a0 = 1.0;
    }
#if CLEAN_SHADOW_STAGE == SH_STAGE_SHADE
    // ---- (RenderVKProjStochasticPasses) pdnPassFold: AN EXTRA PASS p folds its K-pick estimate x into IN's running
    //      combination V (pdnPassBaseWeight: the N passes as one sample list) -- V += K (x - V) / (W0 + p K), rgb of
    //      layers 0 / 1 only (the radiance; alpha -- nCand, the hit distance -- and every other store stay pass 0's).
    //      Radiance mode only (the host's rule too: a ratio's mean is not the ratio of the means); never the ReSTIR
    //      view (its hues are a label, not an estimate). ----
    if (pdnPassIdx() != 0u)
    {
        if (radOn && (opts & PDN_OPT_DBG_RS) == 0u)
        {
            const float kx = float(K);
            // (q3.y of an extra pass: pass 0's weight; kx this pass's K -- RenderVKProjStochasticAdaptiveSamples may give
            //  the extra passes their own, every extra pass the same: the fold stays one list of W0 + p kx samples)
            const float w0 = rsM > 0.0 && rsM < 1.0e6 ? rsM : float(pdnPassK0(ctl, K));
            const float t = kx / (w0 + float(pdnPassIdx()) * kx);
            const vec4 v0 = imageLoad(uPdnIn, ivec3(m, PDN_L(0))), v1 = imageLoad(uPdnIn, ivec3(m, PDN_L(1)));
            imageStore(uPdnIn, ivec3(m, PDN_L(0)), vec4(mix(v0.rgb, l0, t), v0.a));
            imageStore(uPdnIn, ivec3(m, PDN_L(1)), vec4(mix(v1.rgb, l1, t), v1.a));
            // (RenderVKProjStochasticAdaptive) MOT w PDN_MOT_EXTRA_RAYS: this texel's estimate took the adaptive extra
            // passes -- the denoiser's adaptive mover history rule (clean_dn_temporal.comp) reads it; once, in pass 1
            if (pdnPassTiles() && pdnPassIdx() == 1u)
            {
                const uvec4 mo = imageLoad(uPdnMot, PDN_MOT(m));
                imageStore(uPdnMot, PDN_MOT(m), uvec4(mo.xyz, mo.w | PDN_MOT_EXTRA_RAYS));
            }
        }
        return;
    }
#endif
    if (pdnExactSpecular()) imageStore(uPdnIn, ivec3(m, PDN_L(PDN_LAYERS(uPdnIn) - 1)), vec4(exactSpecular, 0.0));
    imageStore(uPdnIn, ivec3(m, PDN_L(0)), vec4(l0, a0));
    imageStore(uPdnIn, ivec3(m, PDN_L(1)), vec4(l1, a1));
#if DEFER_SHADOW_MERGE
    if ((opts & PDN_OPT_SUN_SKIP) == 0u) imageStore(uPdnIn, ivec3(m, PDN_L(2)), vec4(sunOut, pdnSunEncA(srad, sdyn)));
    CLK_MARK(SUNVIS);
#endif
    // ---- guides ---- (grad: above; #1031 TRACE: SELECT stored the GEOM guide)
#if CLEAN_SHADOW_STAGE == SH_STAGE_FUSED
    imageStore(uPdnGeom, ivec3(m, PDN_L(par)), uvec4(floatBitsToUint(vz), pdnPackNR(s.N, specRough), packHalf2x16(grad),
                                             pdnPackMeta(0.0, 0.0, 0u, W0)));   // (W: the gobo-free light-set reference)
#endif
    // (#869 SPLIT) the split lights' ids + this frame's samples (clean_pdn_common.glsl SPLIT CHANNEL;
    // the temporal pass replaces z / w with their histories)
    if (spLayers)
    {
        uvec4 rw = uvec4(0u);
        [[unroll]] for (uint k = 0u; k < PDN_SPLIT_MAX; ++k)
            if (k < spN) rw[k] = pdnSplitRawPack(spV[k], spV[k] >= 0.0, spMv[k]);
        imageStore(uPdnGeom, ivec3(m, PDN_L(PDN_SPLIT_GEOM_PAR + par)), uvec4(pdnSplitPack4(spId), pdnSplitPack4(rw)));
    }
    float pw, pwv;
    const vec2 dS = pdnPrevDelta(P, m, vec2(D), pw);
    vec2 dV = dS;
    if (hitDist > 0.0) dV = pdnPrevDelta(P + normalize(P - pc.u_cam_time.xyz) * hitDist, m, vec2(D), pwv);
    // (RenderVKShadowMoverMask 2) THE MOVER COUNTDOWN (MOT w bits 14-17; the sun channel's moving-caster countdown for the
    // local radiance): a ray of this texel met a MOVING caster now (an exact job, or a local sample's -- every local ray
    // sees all casters) -> pdnMoverCountdownLen; else last frame's (SELECT read it: mover-exact texels) - 1. Read by the
    // denoiser's history cap (clean_dn_temporal.comp DN_T_MOVER_EXACT) and next frame's SELECT (the exact set's exit); bit
    // 18 the texel is mover-exact this frame (the a-trous: an exact centre takes exact taps only).
    uint mvCdW = 0u;
#if CLEAN_SHADOW_STAGE == SH_STAGE_SHADE
    if ((opts & PDN_OPT_MOVER_EXACT) != 0u)
    {
        const uint cdPrev = gateM >> PDN_GATE_CD_SHIFT;   // (every texel's: an exact one and one the list did not take)
        const uint cd = casterMoved ? pdnMoverCountdownLen() : (cdPrev > 0u ? cdPrev - 1u : 0u);
        mvCdW = (min(cd, 15u) << PDN_MOT_MOVER_CD_SHIFT) | (sel.allL ? PDN_MOT_EXACT_SET : 0u);
        if (sel.allL && pdnProbeAt(m, D))
        {
            rt_guard[RTP_X] |= min(cd, 15u) << 12u;
            pdnProbePutF(8u, pdnLum(l0));
        }
    }
#endif
    // (w: the moved lights' share x 255, clean_dn_temporal.comp's moving-light rule; 0 = none)
    imageStore(uPdnMot, PDN_MOT(m), uvec4(packHalf2x16(dS), packHalf2x16(dV), floatBitsToUint(pw),
                                 uint(clamp(fMove, 0.0, 1.0) * 255.0 + 0.5) | (casterMoved ? 256u : 0u) | mvCdW
                                 | (radOn ? (pdnSampleVisibility(evN, evD) << 9u)
                                          | (sel.exact || sel.allL ? PDN_MOT_EVIDENCE_EXACT : 0u)
                                          | pdnMotReportBits(repLight, !repMover) : 0u)));
    CLK_MARK(STORE);
#endif   // CLEAN_SHADOW_STAGE != SH_STAGE_SELECT
}
#endif   // CLEAN_SHADOW_STAGE == SH_STAGE_VIS / SUNVIS / else
#endif   // CLEAN_SHADOW_CORE

#elif DEFER_GRID_BUILD
// ---- LIGHT GRID BUILD (6) / TILE CLASSIFY (9): gridTileBuild above as the whole kernel ----
void DEFER_MAIN()
{
    const uint lid = gl_LocalInvocationIndex;
#if CLEAN_DEFER_PASS == 9
    // (#831) The lit-guard cluster scan: its own small dispatch on the host's sampled frames.
    if ((g_draw_push.flags & DEFER_FLAG_SCAN_ONLY) != 0u)   // (push constant: uniform)
    {
        lgClusterScan(lid);
        CLK_MARK(CLUSTER_SCAN);
        return;
