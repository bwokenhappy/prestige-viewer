#define RTT_ROW 65535u
float rttRecvDist() { return uintBitsToFloat(rtt_param.x); }
// (#1608 STEREO) THE TILE NUMBERING: every view's 8 px tiles in the ONE list, view v's grid after the first v --
// (view x tilesY + y) x tilesX + x (the feature split's deferTileIndex numbering); n = rtt_args[3] = the tiles x N (the
// host). The ONE header serves every view: one ray budget for the frame (the host's is per render pixel x N) and ONE
// gradient scale, so both eyes trace at the same density (eyes at different densities would show different noise).
// One view: y x tilesX + x, as before (kViewCount 1 folds the view term away).
uint rttTileId(uvec2 t)
{
    const uint tilesX = (g_draw_push.width + 7u) / 8u;
    if (kViewCount > 1) return (CLEAN_VIEW * ((g_draw_push.height + 7u) / 8u) + t.y) * tilesX + t.x;
    return t.y * tilesX + t.x;
}
// A listed tile -> its first pixel within its view, and that view (the list kernels set g_rt_view from it).
uvec2 rttTileOrg(uint tile, out uint view)
{
    const uint tilesX = (g_draw_push.width + 7u) / 8u;
    uint y = tile / tilesX;
    view = 0u;
    if (kViewCount > 1)
    {
        const uint tilesY = (g_draw_push.height + 7u) / 8u;
        view = y / tilesY;
        y -= view * tilesY;
    }
    return uvec2(tile % tilesX, y) * 8u;
}
// A RAY LIST entry: render pixel px.x | px.y << 15 | the view << 30 (one view: bits 30-31 zero, as before).
uint  rttRayEntry(uvec2 px) { return px.x | (px.y << 15) | (CLEAN_VIEW << 30); }
ivec2 rttRayPx(uint e) { return ivec2(e & 0x7FFFu, (e >> 15) & 0x7FFFu); }
uint  rttRayView(uint e) { return kViewCount > 1 ? e >> 30 : 0u; }
// ---- STRENGTH DENSITY (#859 perf; RenderVKRTReflectionsStrength*, rtt_param3; see the header) ----
// The mark's w word: bits 0-11 the trace roughness (unorm12; rtrMarkRough16 puts it back on the
// unorm16 scale the density code compares), 12-15 the CURVATURE DENSITY code (rtrCurvRho: the
// density the receiver's curvature needs, q / 15; 0 = none), 16-29 the reflection strength s
// (unorm14, clamped to 1), 30-31 the candidate type (RTR_TYPE_*). The roughness is only a density
// input (the trace and the resolve take the surface's own), so 12 bits lose nothing.
#define RTR_TYPE_PBR   1u
#define RTR_TYPE_ENV   2u   // legacy sharp env (shiny / env intensity)
