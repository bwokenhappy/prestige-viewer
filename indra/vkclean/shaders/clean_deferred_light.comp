    lvcNoiseAdd(1u, valid && tc == 0u, d, L);
    lvcNoiseAdd(2u, valid && listed, d, L);
    lvcNoiseAdd(3u, valid && tc != 0u && !listed, d, L);
    lvcNoiseAdd(4u, valid && tc != 0u && zb >= 10u, d, L);
    lvcNoiseAdd(5u, valid && tc != 0u && zb < 6u, d, L);
