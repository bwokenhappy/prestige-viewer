    {
        const RtSurface ls = rtSurfaceEval(h, dir);
        const vec3 V = -dir;
        vec3 ngf = dot(ls.Ng, V) < 0.0 ? -ls.Ng : ls.Ng;
        vec3 hitP = ls.P;   // (a water hit: moved onto the waves below)
        const vec3 nf = dot(ls.N, V) < 0.0 ? -ls.N : ls.N;
        if (ls.model != RT_SURF_WATER && (rfgOn() || rfvOn()))
        {
            // the layer's depth and point: THE LAYER'S GI and THE LAYER'S LIGHT are matched on it
            layerZ = max(dot(ls.P - linfo.cam_pos.xyz, linfo.cam_fwd.xyz), 1e-3);
            rfgP = ls.P;
            if (rfgOn())
            {
                // (THE LAYER'S GI) the FS's read (GI_FWD_CACHE_READ): the cells around the layer point, its normal on
                // the viewer's side, the camera's level
                float wf;
                bool inSph;
                const vec3 E = giCacheForward(ls.P, nf, linfo.cam_pos.xyz, wf, inSph);
                giv = all(lessThan(abs(E), vec3(60000.0))) ? vec4(max(E, vec3(0.0)) * wf, clamp(wf, 0.0, 1.0)) : vec4(0.0);
            }
            // (THE LAYER'S LIGHT) a lit layer's visibility terms (a fullbright one is unlit)
            // (its own #1049 query budget, and the reflection ray below a fresh one: the hang guard bounds each part)
            if (rfvOn() && ls.model != RT_SURF_FULLBRIGHT)
            {
                rtrQueryBudgetBegin();
                lv = rfvLight(ls, h.dist, dir, nf, ngf, pa);
                rtrQueryBudgetBegin();
            }
        }
        // (gi-glass) the user's threshold while the cache specular caps the push's (rtt_opts4 bits 24-31: the forward
        // layer has no cache reader -- its receivers keep their rays)
        const float thr = (rtt_opts4 >> 24u) != 0u ? float(rtt_opts4 >> 24u) * (1.0 / 255.0) : rtrRoughThr();
        float rough = 1.0;
        bool ok = false;
        vec3 R = reflect(dir, nf);
        if (ls.model == RT_SURF_WATER)
        {
            ok = cam.z >= waterHeight();   // (from below, the water FS shows no reflection)
            rough = 0.0;
            if (seaOn())
            {
                vec2 x0;
                hitP = seaRayHit(cam, dir, h.dist, x0);
                const SeaSurf ss = seaSurface(x0, -1.0, h.dist * pa);
                rt_water_slope = ss.slope;
                rt_water_detail = seaDetail();
                ngf = dot(ss.n, V) < 0.0 ? -ss.n : ss.n;
                ok = !camUnderwater();   // (the CPU's test on the displaced surface, as the water FS)
            }
            R = rtWaterReflectDir(hitP, cam, pc.u_cam_time.w);
            g_rtr_mask_drop = RT_MASK_WATER;   // (#1493: the flat plane is this surface's stand-in)
        }
        else if (ls.model == RT_SURF_PBR)
        {
            rough = ls.rough;
            ok = rough < thr;
        }
        else if (ls.model == RT_SURF_LEGACY)
        {
            rough = ls.env > 0.0 ? 0.0 : 1.0 - ls.gloss;
            ok = ls.env > 0.0 || (ls.gloss > 0.0 && rough < thr);
        }
        if (ok)
        {
            const float rn = dot(R, ngf);
            if (rn < 0.02) R = normalize(R + ngf * (0.02 - rn));
            const vec3 o = offsetRayOrigin(hitP, ngf);
            rt_cone_width0 = h.dist * pa;
            rt_cone_spread = pa + 0.25 * rough;
            rtrMaskCone(h.dist * pa * 0.5, pa * 0.5);   // (the alpha-mask test: one render pixel, not the 2 x 2 block)
            float t;
            const float tmaxR = max(g_draw_push.rtr.x, 1.0);
            vec3 c = rtrTraceRefl(o, R, tmaxR, hitP, vec3(0.0), false, t);
