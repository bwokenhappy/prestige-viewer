    bool visOk = true;     // (the picked reused sample is visible from this receiver)
    bool visSkip = false;  // (#985: ... kept without its ray)
    if ((gf & GI_F_RES) != 0u)
    {
        // the fresh candidate (the estimate L x cos / pi x (1 / (cos / pi)) = L: p / q, M 1; an untraced
        // texel: none, M 0)
        bool hit, bt;
        float hdist;
        const GiSample yf = giRecFresh(ri, traced, P, N, d, hit, hdist, bt);
        float c0, q0;
        const float p0 = giFreshTarget(N, d, traced, yf.L, c0, q0);
        float wsum = p0 / q0;
        Msum = traced ? 1.0 : 0.0;
        py = p0;
        wAll = wsum;
        // ((#1087) or a light moved within the hold is significant at the fresh hit: the share -- the
        //  GI denoiser's history cap -- holds for the whole motion, not only its flag frames; (#1039)
        //  the tag's bit 3: the two tests on this texel's fresh hit, from the words HIT-LIGHT / SHADE stored --
        //  giChgTagFresh)
        if ((gf & GI_F_LIGHT_CHG) != 0u && hit && wsum > 0.0 && (giChgTagAt(m, D) & 8u) != 0u)
            wChg = wsum;
        GiSample yr = yf;   // (the fused kernel's pick; REUSE rebuilds it from yq)
        giReusePick(m, D, par, frame, rp, P, N, grad, wsum, Msum, wAll, wChg, keptT, keptS, reuseTried, yr, py, src, yChg,
                    yq);
        W = (py > 0.0 && wsum > 0.0) ? wsum / (py * Msum) : 0.0;
    }
    GiSample y;   // (the pick: src != 0 here, else the fresh sample below)
    if (src != 0u)
    {
        // A REUSED sample: its visibility from THIS receiver, one ray (a neighbour's sample behind
        // a wall, or one a door / avatar now blocks, must not light this pixel) -- blocked: the
        // fresh sample alone stands. A pick a changed light reaches takes the RE-SHADE ray instead
        // (it is the visibility ray too).
        y = giResPick(ivec2(int(yq & 0xFFFFu), int(yq >> 16u)), D, uint(par) ^ 1u, P);
        const vec3 v = y.xs - o;
        const float dl = length(v);
        const vec3 dv = v / max(dl, 1e-6);
        if ((yChg & 3u) == 2u && y.dist > 0.0)
        {
            // (GI_F_LIGHT_CHG) RE-SHADE: a changed light reaches the picked point, so its stored
            // radiance is the old colour. One closest-hit ray toward it doubles as the visibility
            // ray: the surface found within the tolerance of the point is shaded with THIS frame's
            // lights (RESHADE: the fused kernel's hit shading + source clamp) and replaces the stored
            // L -- reuse kept (its W is a contribution weight: valid for the current radiance), colour
            // current. Anything nearer blocks it; nothing there (the surface moved / vanished)
            // rejects it as well. (#1031) This lane asks for it (the request + the list) and stops
            // here; its TAIL run comes back with the result.
            const float rsTol = max(0.02, 0.02 * dl);
            if (!tail)
            {
                gi_hit[ri + 4u] = uvec4(floatBitsToUint(o), floatBitsToUint(dl + rsTol));
                gi_hit[ri + 5u] = uvec4(floatBitsToUint(dv), 0u);
                giListAppend(giTexel(m, D));   // (#1608: view-inclusive)
                return;
            }
            // the result -- for THIS pick only (the request's direction, bit for bit; a different
            // one would be another sample's re-shade: rejected, as a surface not found)
            const uvec4 q4 = gi_hit[ri + 4u], q5 = gi_hit[ri + 5u];
            const float tt = uintBitsToFloat(q4.w);
            const bool ht = tt >= 0.0 && all(equal(q5.xyz, floatBitsToUint(dv)));
            const vec3 Lt = uintBitsToFloat(q4.xyz);
            visOk = false;
            if (ht && tt >= dl - rsTol)
            {
                // (RenderVKGIReshadeGain) W was resampled for the OLD radiance: a point whose light
                // went from dim to bright is multiplied by L_new / L_old -- the edge sparkles under
                // club lights. Brighter re-shades are capped at the gain (the light-change history
                // cap lets the fresh samples catch up); dimmer ones pass as they are.
                const float gmax = gi.prm4.y;
                const float ln = giLum(Lt), lo = giLum(y.L);
                y.L = (gmax > 0.0 && ln > gmax * lo) ? Lt * (gmax * lo / max(ln, 1e-8)) : Lt;
                visOk = true;
                ++chgRej;
            }
        }
        else
        {
            if ((yChg & 3u) == 1u) ++chgSkip;   // (#980: kept as stored -- the change is insignificant there)
            const float tm = y.dist > 0.0 ? rtReuseSegEnd(y.xs, dl, abs(dot(y.ns, dv))) : max(g_draw_push.rtr.x, 1.0);
            // (#985, GI_F_VIS_TSKIP) a temporal pick whose segment crosses no change sphere: no ray at all
            visSkip = tm > 0.0 && giVisSkip(src, o, dv, tm);
            if (!(tm > 0.0) || visSkip) visOk = true;
            else
            {
                giRayCone(rp, r, P);   // (the walk's cone: giFreshRay's)
                visOk = traceShadowRay(o, dv, 0.0, tm, RT_MASK_SHADOW & ~RT_MASK_BLEND) > 0.5;
            }
        }
    }
    // the fresh sample again (the same record words): the finish's y0, S (= L), hit, guides
    bool hit, bt;
    float hdist;
    d = uintBitsToFloat(gi_hit[ri].xyz);
    const GiSample y0 = giRecFresh(ri, traced, P, N, d, hit, hdist, bt);
    float c0, q0;
    const float p0 = giFreshTarget(N, d, traced, y0.L, c0, q0);
    if (src == 0u) y = y0;
    giReuseFinish(m, D, par, P, N, d, vz, grad, traced, hit, hdist, traced && bt, y0.L, y0, p0, q0, c0, y, src, visOk, W,
                  Msum, noInfo, keptT, keptS, chgRej, chgSkip, wAll > 0.0 ? clamp(wChg / wAll, 0.0, 1.0) : 0.0,
                  reuseTried, visSkip);
#else
    vec3 xs = P, ns = N;
    bool hit = false;
    float hdist = 0.0;
    vec3 L = vec3(0.0);
    bool freshBack = false;   // (debug view 9: the FRESH ray stopped at a back face)
    vec3 S = vec3(0.0);
    // the guides' depth gradient (also the spatial taps' plane)
    const int stp = max(int(r.x + 0.5), 1);
    const vec2 grad = vec2(giGrad(rp, ivec2(stp, 0), vz), giGrad(rp, ivec2(0, stp), vz));
    // ---- (GI-2 / GI-3) RESERVOIR REUSE ----
    const uint gf = gi.cfg.x;
    bool noInfo = !traced && (gf & GI_F_RES) == 0u;   // (an untraced texel without reservoirs)
    uint src = 0u;          // 0 fresh, 1 temporal, 2 spatial (debug view 5)
    uint keptT = 0u, keptS = 0u, chgRej = 0u;   // (chgRej: picks RE-SHADED for a changed light)
    uint chgSkip = 0u;   // (#980: a pick a changed light reaches, too weakly to re-shade)
    // (GI_F_LIGHT_CHG) the candidates' weight whose sample point changed lights are SIGNIFICANT at
    // (giChangedSig 2; #980: an insignificant reach keeps the full history), of all the candidates'
    // weight: the share the GI denoiser's moving-light history cap reads (MOT w)
    float wChg = 0.0, wAll = 0.0;
    bool reuseTried = false;   // (debug view 9: the reuse looked for candidates)
    // the reservoir across the trace loop: the fresh sample y0, the pick y (target py), its weight
    GiSample y0 = GiSample(vec3(0.0), vec3(0.0), vec3(0.0), 0.0, 0.0), y = y0;
    float py = 0.0, p0 = 0.0, q0 = 1.0, c0 = 1e-4, W = 0.0, Msum = 0.0;
    bool visOk = true;     // (the picked reused sample is visible from this receiver)
    bool visSkip = false;  // (#985: ... kept without its ray)
    bool rsWant = false;   // (GI_F_LIGHT_CHG: the pick is re-shaded by the loop's second pass)
    vec3 rsDir = d;
    float rsDl = 0.0, rsTol = 0.0;
    // THE TRACE LOOP: pass 0 the fresh ray + the reservoir reuse, pass 1 the RE-SHADE of the picked
    // reused sample (only the lanes that want one). ONE giTrace call site: the hit shading (material,
    // weather, the sun / light shadow rays, the cache / probes) is inlined once -- the re-shade's own
    // call site doubled the kernel (2.8 MB of SPIR-V against 1.5) and ran the re-shading lanes through
    // a second copy of all of it. Never unrolled (that would be the second copy again).
    [[dont_unroll]] for (uint pass = 0u; pass < 2u; ++pass)
    {
        vec3 Lt = vec3(0.0), xt = P, nt = N;
        bool ht = false;
        float tt = 0.0;
        g_gi_lamp_why = 0u;
        if (pass != 0u || traced)
            Lt = giTrace(o, pass == 0u ? d : rsDir, pass == 0u ? max(g_draw_push.rtr.x, 1.0) : rsDl + rsTol, P,
                         xt, nt, ht, tt);
        if (pass == 0u) { g_gi_fresh_why = g_gi_lamp_why; g_gi_fresh_oc = g_gi_outcome; }   // (RenderVKGIDebug 11 / 13)
        if (pass != 0u)
        {
            // (GI_F_LIGHT_CHG) RE-SHADE: a changed light reaches the picked point, so its stored
            // radiance is the old colour. One closest-hit ray toward it doubles as the visibility
            // ray: the surface found within the tolerance of the point is shaded with THIS frame's
            // lights (giTrace: the fresh hit's shading + source clamp) and replaces the stored L --
            // reuse kept (its W is a contribution weight: valid for the current radiance), colour
            // current. Anything nearer blocks it; nothing there (the surface moved / vanished)
            // rejects it as well.
            visOk = false;
            if (ht && tt >= rsDl - rsTol)
            {
                // (RenderVKGIReshadeGain) W was resampled for the OLD radiance: a point whose light
                // went from dim to bright is multiplied by L_new / L_old -- the edge sparkles under
                // club lights. Brighter re-shades are capped at the gain (the light-change history
                // cap lets the fresh samples catch up); dimmer ones pass as they are.
                const float gmax = gi.prm4.y;
                const float ln = giLum(Lt), lo = giLum(y.L);
                y.L = (gmax > 0.0 && ln > gmax * lo) ? Lt * (gmax * lo / max(ln, 1e-8)) : Lt;
                visOk = true;
                ++chgRej;
            }
            break;
        }
        L = Lt; xs = xt; ns = nt; hit = ht; hdist = tt;
        freshBack = traced && g_gi_back;
        // the estimate: L x cos / pi x (1 / (cos / pi)) = L (the cosine-weighted mean incoming radiance)
        S = L;
#ifdef CLEAN_GI_STEREO_TRACE
        break;   // (#1139: one bounce into the cache -- no reservoir reuse, no re-shade pass in the stereo trace)
#else
        if ((gf & GI_F_RES) == 0u) break;
#endif
        y0.xs = xs; y0.ns = ns; y0.L = L;
        y0.dist = hit ? hdist : 0.0;
        y0.cosv = hit ? abs(dot(ns, -d)) : 1.0;
        // (giCosMin: a grazing fresh direction is no candidate -- its W = pi / cos would be stored and
        //  re-weighed head-on by the neighbours: the firefly seeds of the spatial reuse)
        p0 = giFreshTarget(N, d, traced, L, c0, q0);
        float wsum = p0 / q0;   // (the fresh candidate: p / q, M 1; an untraced texel: none, M 0)
        Msum = traced ? 1.0 : 0.0;
        y = y0;
        py = p0;
        const bool chgOn = (gf & GI_F_LIGHT_CHG) != 0u;
        uint yChg = 0u;   // (the picked reused sample's giChangedSig)
        wAll = wsum;
        // ((#1087) or a light moved within the hold is significant at the fresh hit: the share -- the
        //  GI denoiser's history cap -- holds for the whole motion, not only its flag frames)
        if (chgOn && hit && wsum > 0.0 && (giChangedSig(xs, ns, L) == 2u || (giHotOn() && giLightHot(xs, ns, L))))
            wChg = wsum;
        uint yq = 0u;   // (REUSE's: unused here)
        giReusePick(m, D, par, frame, rp, P, N, grad, wsum, Msum, wAll, wChg, keptT, keptS, reuseTried, y, py, src, yChg, yq);
        W = (py > 0.0 && wsum > 0.0) ? wsum / (py * Msum) : 0.0;
        if (src != 0u)
        {
            // A REUSED sample: its visibility from THIS receiver, one ray (a neighbour's sample behind
            // a wall, or one a door / avatar now blocks, must not light this pixel) -- blocked: the
            // fresh sample alone stands. A pick a changed light reaches takes the RE-SHADE ray of the
            // loop's second pass instead (it is the visibility ray too).
            const vec3 v = y.xs - o;
            const float dl = length(v);
            const vec3 dv = v / max(dl, 1e-6);
            if ((yChg & 3u) == 2u && y.dist > 0.0)
            {
                rsWant = true;
                rsDir = dv;
                rsDl = dl;
                rsTol = max(0.02, 0.02 * dl);
            }
            else
            {
                if ((yChg & 3u) == 1u) ++chgSkip;   // (#980: kept as stored -- the change is insignificant there)
                const float tm = y.dist > 0.0 ? rtReuseSegEnd(y.xs, dl, abs(dot(y.ns, dv))) : max(g_draw_push.rtr.x, 1.0);
                visSkip = tm > 0.0 && giVisSkip(src, o, dv, tm);   // (#985, GI_F_VIS_TSKIP: REUSE's rule)
                visOk = (tm > 0.0 && !visSkip ? traceShadowRay(o, dv, 0.0, tm, RT_MASK_SHADOW & ~RT_MASK_BLEND) : 1.0) > 0.5;
            }
        }
        if (!rsWant) break;
    }
    // (GI_F_LIGHT_CHG) the changed lights' share of the candidates (MOT w; debug view 8)
    giReuseFinish(m, D, par, P, N, d, vz, grad, traced, hit, hdist, freshBack, S, y0, p0, q0, c0, y, src, visOk, W, Msum,
                  noInfo, keptT, keptS, chgRej, chgSkip, wAll > 0.0 ? clamp(wChg / wAll, 0.0, 1.0) : 0.0, reuseTried,
                  visSkip);
#endif
}
#endif   // CLEAN_GI_MOVER
#endif   // CLEAN_GI_STAGE
#endif   // CLEAN_GI_RESOLVE
#elif CLEAN_DEFER_PASS == 11 || CLEAN_DEFER_PASS == 16
// ---- RT TRACE (#859; see HYBRID RT REFLECTIONS in the header) ----
// Pass 11: one 8x8 workgroup per listed tile selects its rays and traces them in place, or
// (-DCLEAN_RT_LIST, RenderVKRTReflectionsRayList) one lane per ray of the RAY LIST that pass 16
// (RT RAY SELECT, one 8x8 workgroup per listed tile: the same selection, no trace) appended --
// the trace's warps full instead of a few rays per 64-lane tile workgroup. Same rays, same
// per-ray code (rtrTraceRay), same outputs.
// DENSITY GRADIENT: this frame's budget scale, from the header alone (every workgroup computes
// the same): the mark passes' rays at scale 1 (rtt_grays) against the budget, with a deadband --
// last frame's scale stays while it lies between the one fitting the budget
// ("tight") and the one fitting 80 % of it ("loose"). Never below RTR_GRAD_SCALE_MIN.
float rtrGradScale()
{
    const float n = float(rtt_grays);
    const float budget = rtt_param.z == 0xFFFFFFFFu ? 3.0e38 : float(rtt_param.z);
    const float tight = n > budget ? budget / n : 1.0;
    const float loose = n > 0.8 * budget ? 0.8 * budget / n : 1.0;
    float last = uintBitsToFloat(rtt_scale[((rtt_param.w >> 8) & 1u) ^ 1u]);
    if (!(last > 0.0 && last <= 1.0)) last = 1.0;
    return clamp(clamp(last, loose, tight), RTR_GRAD_SCALE_MIN, 1.0);
}
shared uint s_rtr_slot[64];   // the tile's rays, packed: the lane of the ray's pixel
shared uint s_rtr_n;          // rays in the tile
#if CLEAN_DEFER_PASS == 16 || !defined(CLEAN_RT_LIST)
// RAY SELECTION of a listed tile (every invocation of the 8x8 workgroup, uniform control flow; org:
// the tile's first pixel): the lane's mark (m), the frame's gradient budget scale (gs), s_rtr_slot /
// s_rtr_n filled (after a barrier), the non-ray pixels' trace -1, the deadband words (entry 0).
// Returns the tile's ray count (shared: uniform).
uint rtrSelectTile(uint lid, uint entry, uvec2 org, out uvec4 m, out float gs)
{
    const ivec2 px = ivec2(org + gl_LocalInvocationID.xy);
    const bool inside = px.x < int(g_draw_push.width) && px.y < int(g_draw_push.height);
    m = uvec4(0u);
    if (inside) m = imageLoad(uReflRtMark, DS_TEXEL(px));
    if (lid == 0u) s_rtr_n = 0u;
    barrier();
    // RAY DENSITY: this lane's pixel casts a ray (it takes a slot), or the resolve skips it (-1).
    // Slots in atomic order: each ray writes only its own pixel, so the order changes no output.
    // The candidate casts if its effective dither rank is below its density x the frame's budget
    // scale (rtrGradRay).
    rtrGradBuild(lid, org, m.z != 0u, m.w);
    gs = rtrGradScale();
    // (DENSE, rtrDense: every candidate, whatever its effective rank -- a rank handed to another candidate of
    //  its cell included)
    const bool ray = m.z != 0u && (rtrDense() || rtrGradRay(rtrGradRank(lid, org, m.w), rtrRhoEff(rtrRho(m.w), gs)));
    if (ray)
        s_rtr_slot[atomicAdd(s_rtr_n, 1u)] = lid;
    else if (inside)
        imageStore(uRtTrace, DS_TEXEL(px), vec4(0.0, 0.0, 0.0, -1.0));   // (not traced this frame)
    barrier();
    if (lid == 0u && entry == 0u)
    {
        rtt_scale[(rtt_param.w >> 8) & 1u] = floatBitsToUint(gs);  // (the deadband's memory; pass 13 + the list trace read it)
        rtt_dense[(rtt_param.w >> 8) & 1u] = rtrDense() ? 1u : 0u;   // (DENSE: this frame's state -- rtrDenseDecide)
        rtt_tiles = rtt_words[2u * rtt_args[3]];                   // (the stats: tiles listed this frame)
    }
    return s_rtr_n;
}
#endif
#if CLEAN_DEFER_PASS == 11
// The env the blend layers composite over on a miss: the mark's spec word's, else its env word's.
vec3 rtrMarkEnv(uvec4 m)
{
    const vec2 k = unpackHalf2x16(m.z);
    return k.x > 0.0 ? dsUnpackRGB9E5(m.x) / k.x : (k.y > 0.0 ? dsUnpackRGB9E5(m.y) / k.y : vec3(0.0));
}
// The reflection ray at render pixel px (m: its mark; gs: the frame's budget scale): the receiver P,
// the ray (o, R), the env; sets g_frag_xy and the ray cone (rt_cone_*, rtrMaskCone).
void rtrRayBegin(ivec2 px, uvec4 m, float gs, out vec3 P, out vec3 o, out vec3 R, out vec3 env)
{
    g_frag_xy = vec2(px) + 0.5;
    CLK_INV();
    CLK_SURF();
    const vec4 g2 = defTexel(uG2, px);
    float glow;
    bool noFade;
    const SurfaceLit s = deferSurface(px, g2, glow, noFade);
    P = deferPosition(px);
    const vec3 V = linfo.cam_fwd.w > 0.5 ? -linfo.cam_fwd.xyz : normalize(pc.u_cam_time.xyz - P);
    const vec3 Ng = dot(s.Ng, V) < 0.0 ? -s.Ng : s.Ng;
    CLK_MARK(GBUF);
    env = rtrMarkEnv(m);
    const float rough = s.model == SURF_PBR ? s.rough : (s.env > 0.0 ? 0.0 : 1.0 - s.gloss);
    {   // (gi-glass) the rays by receiver roughness (rtt_level, host-zeroed; the VKGpu "RT reflections" line): those
        // from roughness 0.25 (RTR_STOCH_ROUGH: the rough share the cache specular takes over), and the sum of x 255
        const uint nr = subgroupAdd(rough >= RTR_STOCH_ROUGH ? 1u : 0u);
        const uint sr = subgroupAdd(uint(clamp(rough, 0.0, 1.0) * 255.0 + 0.5));
        if (subgroupElect())
        {
            if (nr != 0u) atomicAdd(rtt_level[0], nr);
            if (sr != 0u) atomicAdd(rtt_level[1], sr);
        }
    }
    // (the cone of the 1 / rho pixels its ray stands for, 1 / sqrt(rho) wide)
    const float re = rtrRhoEff(rtrRho(m.w), gs);
    g_rc_rho = re;
    const float coneScale = clamp(inversesqrt(max(re, 1.0 / 256.0)), 1.0, 8.0);
    rtrReceiverRay(s, P, V, Ng, rough, coneScale, o, R);
    // LOBE FILTER (rtrLobeOn: a header word, uniform): the ray cone's CURVATURE term (ray cones,
    // Akenine-Moller et al. 2019/21: a reflection adds twice the normal's turn over the footprint)
    // -- the receiver's GEOMETRIC normal change per pixel (rtrNormalSpread .x; normal maps are the
    // resolve's specular AA: a bumpy floor's cone must not drop small objects from its
    // reflection through the size-class segments) x the pixels this ray stands for. A curved
    // receiver's hit then samples its textures at the mip its footprint covers instead of a
    // point sample that changes with every jitter offset.
    if (rtrLobeOn())
    {
        const float geo = rtrNormalSpread(px, P, s.N, s.Ng, length(P - pc.u_cam_time.xyz)).x;
        rt_cone_spread += min(2.0 * geo * coneScale, 0.5);
    }
}
// The per-ray counters -> the headers (subgroup sums; each stage of the #1036 split flushes the ones
// it counts -- the host only sums them):
// the hit-shading counters -> the header (rtt_hit; the VKGpu "RT reflections" line)
void rtrStatsHit()
{
    [[unroll]] for (int k = 0; k < RTR_HIT_WORDS; ++k)
    {
        const uint v = subgroupAdd(g_rtr_stat[k]);
        if (subgroupElect() && v != 0u) atomicAdd(rtt_hit[k], v);
    }
}
// TRACE COST (rtt_cost; the VKGpu "RT reflections" line's trace-cost part), while the host asks
// (GPU timers on: rtrOpts bit 7)
void rtrStatsCost()
{
    if ((rtrOpts() & 128u) != 0u)   // (push constant: uniform)
    {
        uint v[RTR_COST_WORDS];
        [[unroll]] for (int k = 0; k < RTR_COST_WORDS; ++k) v[k] = 0u;
        const bool hit = g_rc_hitd >= 0.0;
        const int bin = hit ? clamp(int(floor(log2(max(g_rc_hitd, 1e-3) * 0.5))) + 1, 0, 5) : -1;
        [[unroll]] for (int k = 0; k < 6; ++k) v[RTR_COST_HIST + k] = bin == k ? 1u : 0u;
        v[RTR_COST_MISS]      = hit ? 0u : 1u;
        v[RTR_COST_TRAV]      = g_rc_trav;
        v[RTR_COST_RETR]      = g_rc_retr;
        v[RTR_COST_RETRACED]  = (g_rc_flags & RC_RETRACED) != 0u ? 1u : 0u;
        v[RTR_COST_CAND]      = g_rc_cand;
        v[RTR_COST_BUDGET]    = (g_rc_flags & RC_BUDGET) != 0u ? 1u : 0u;
        v[RTR_COST_SEGMENTED] = (g_rc_flags & RC_SEGMENTED) != 0u ? 1u : 0u;
        v[RTR_COST_SEG2]      = (g_rc_flags & RC_SEG2) != 0u ? 1u : 0u;
        v[RTR_COST_HIT1]      = (g_rc_flags & RC_HIT1) != 0u ? 1u : 0u;
        v[RTR_COST_HIT2]      = (g_rc_flags & RC_HIT2) != 0u ? 1u : 0u;
        v[RTR_COST_SEGD]      = (g_rc_flags & RC_SEGMENTED) != 0u ? uint(clamp(g_rc_segd * 4.0, 0.0, 4095.0)) : 0u;
        if (g_rc_rho >= 0.0)
        {
            const float r = g_rc_rho;
            v[RTR_COST_RHO + 0] = r >= 0.5 ? 1u : 0u;
            v[RTR_COST_RHO + 1] = (r < 0.5 && r >= 0.125) ? 1u : 0u;
            v[RTR_COST_RHO + 2] = (r < 0.125 && r >= 1.0 / 32.0) ? 1u : 0u;
            v[RTR_COST_RHO + 3] = r < 1.0 / 32.0 ? 1u : 0u;
            v[RTR_COST_RHOSUM]  = uint(clamp(r, 0.0, 1.0) * 256.0 + 0.5);
        }
        v[RTR_COST_AMTEST] = g_rc_amtest;
        v[RTR_COST_AMREJ]  = g_rc_amrej;
        [[unroll]] for (int k = 0; k < RTR_COST_WORDS; ++k)
        {
            const uint t = subgroupAdd(v[k]);
            if (subgroupElect() && t != 0u) atomicAdd(rtt_cost[k], t);
        }
        {
            const uint t = subgroupAdd(g_rc_amresc);
            if (subgroupElect() && t != 0u) atomicAdd(rtt_amresc, t);
        }
    }
}
// (#869) the light grid's hit counters -> its header's stat[3 .. 9] (bytes / halves unpacked
// first: a subgroup sum would carry across the packed fields)
void rtrStatsRegir()
{
    if (rtrRegirOn())   // (push constant: uniform)
    {
        const uint a5 = g_rtr_stat[5], a6 = g_rtr_stat[6];
        const uint v[7] = uint[7](a5 & 0xFFu, (a5 >> 8) & 0xFFu, (a5 >> 16) & 0xFFu, a5 >> 24,
                                  a6 & 0xFFFFu, g_rtr_stat[7], a6 >> 16);
        [[unroll]] for (int k = 0; k < 7; ++k)
        {
            const uint t = subgroupAdd(v[k]);
            if (subgroupElect() && t != 0u) atomicAdd(rg.stat[3 + k], t);
        }
    }
}
// One reflection ray at render pixel px (rtrRayBegin's arguments) -> uRtTrace + the stats. The
// in-tile trace and the (fused) list trace run exactly this per ray.
void rtrTraceRay(ivec2 px, uvec4 m, float gs)
{
    rtrQueryBudgetBegin();   // (#1049)
    vec3 P, o, R, env;
    rtrRayBegin(px, m, gs, P, o, R, env);
    float t;
    const vec3 c = rtrTraceRefl(o, R, max(g_draw_push.rtr.x, 1.0), P, env, (rtrOpts() & 1u) != 0u, t);
    imageStore(uRtTrace, DS_TEXEL(px), vec4(t > 0.0 ? c : vec3(0.0), t));
    rtrStatsHit();
    rtrStatsCost();
    rtrStatsRegir();
    rtrStatsGuard();   // (#1049)
    CLK_MARK(STORE);
}
