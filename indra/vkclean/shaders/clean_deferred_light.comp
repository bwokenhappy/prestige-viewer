    // that distance: fd reaches 0 there).
    // (STRENGTH DENSITY) x the strength fade: 0 at the cutoff, where the mark stops (no edge).
    const float fd = rtrDistFade(camd, rttRecvDist()) * rtrStrengthFade(m.w);
    // (#87) the env share each splice LEAVES in its word (1 = none replaced): the GI specular
    // occlusion scales exactly that (deferReflIn, GI_F_SPECOCC_RT_RES) -- written back into the mark
    float remS = 1.0, remE = 1.0;
    // TEMPORAL (rtrTemporal): the spec word's result, else (a legacy sharp env face alone) the env
    // word's; not under #870 raw routing of an own ray (the network accumulates it).
    bool temporal = rtrTemporalOn() && !rawOwn;
    // (a raw own ray with the history still allocated -- before the dense release, or sparse raw: this pixel's history
    //  layer says "none" (view depth 0), so a later filtered frame never reprojects a stale one)
    if (rawOwn && rtrTemporalOn()) imageStore(uRtHist, RTH_TEXEL(px, (rtt_param.w >> 8) & 1u), vec4(0.0));
    // The virtual-image candidate up to RTR_STOCH_ROUGH, also on normal-mapped / curved receivers
    // (aa): rtrTemporal keeps it only where it beats the surface's history. (Before, any aa > 0.02
    // took the surface's motion alone, and a bumpy near-mirror's reflection swam with the camera.)
    const bool tSurf = rough > RTR_STOCH_ROUGH;
    // the glossy gather's effective sample count (the standard error of its mean: rrtResolve)
    const float nEff = w2B > 1e-12 ? wB * wB / w2B : 1.0;
    // (#1606 EMPTY CELLS, see rtrEmptyHold) the word this pixel splices found no traced sample: its reprojected
    // history (if any) stands in, drifting toward the env
    const bool specWord = k.x > 0.0, envWord = !specWord && k.y > 0.0 && !halfRefl;
    const bool empty = (specWord && (specSharp ? wS : wB) <= 1e-6) || (envWord && wS <= 1e-6);
    bool emptyHist = false;
    if (empty && temporal)
    {
        vec3 hh;
        vec4 aux;
        emptyHist = rtrHistPeek(P, hh, aux);
        // (the holds so far: the length word's RTR_HOLD_AGE multiple -- bilinear taps blend it, so rounded)
        const float held = floor(max(aux.w, 0.0) / RTR_HOLD_AGE + 0.25);
        if (emptyHist && rtrEmptyHold() && held < RTR_HOLD_MAX)
        {
            const vec3 res = hh;
            const uint par = (rtt_param.w >> 8) & 1u;
            imageStore(uRtHist, RTH_TEXEL(px, par), vec4(res, vz));
            imageStore(uRtHist, RTH_TEXEL(px, 2u + par),
                       vec4(aux.xyz, (held + 1.0) * RTR_HOLD_AGE + clamp(aux.w - held * RTR_HOLD_AGE, 1.0, RTR_HOLD_AGE - 1.0)));
            temporal = false;   // (written)
            if (specWord)
            {
                const float f = rtrFade(rough) * fd;
                remS = 1.0 - f;
                vec3 word = max(dsUnpackRGB9E5(imageLoad(uReflSpec, DS_TEXEL(px)).x) + f * (k.x * res - xS), vec3(0.0));
                if (s.model == SURF_LEGACY && !specSharp) word = min(word, vec3(10.0));   // (glossenv's clamp)
                imageStore(uReflSpec, DS_TEXEL(px), uvec4(dsPackRGB9E5(word)));
            }
            else
            {
                const vec3 word = max(dsUnpackRGB9E5(imageLoad(uReflEnv, DS_TEXEL(px)).x) + fd * (k.y * res - xE), vec3(0.0));
                imageStore(uReflEnv, DS_TEXEL(px), uvec4(dsPackRGB9E5(word)));
                remE = 1.0 - fd;
            }
        }
    }
    vec3 resOut = vec3(-1.0);   // (the spliced result, for the dark-flip counter; -1 none)
    g_rtr_hist_lum = -1.0;
    if (k.x > 0.0)
    {
        const bool sharp = specSharp;
        const float w = sharp ? wS : wB;
        if (w > 1e-6)
        {
            vec3 res = sharp ? (hS + mS * envS) / wS : (hB + mB * envS) / wB;
            if (temporal)
            {
                vec3 mu = res, sg = vec3(0.0);
                if (wB > 1e-6)
                {
                    mu = (hB + mB * envS) / wB;
                    sg = sqrt(max((qB + mB * envS * envS) / wB - mu * mu, vec3(0.0)));
                }
                res = rtrTemporal(px, res, mu, sg, wB > 1e-6 ? nEff : 1.0, P, Ng, V, tMean, vz, tSurf, rough);
                temporal = false;   // (written)
                resOut = res;
            }
            const float f = rtrFade(rough) * fd;
            remS = (1.0 - f) + f * (sharp ? mS : mB) / w;
            vec3 word = max(dsUnpackRGB9E5(imageLoad(uReflSpec, DS_TEXEL(px)).x) + f * (k.x * res - xS), vec3(0.0));
            if (s.model == SURF_LEGACY && !sharp) word = min(word, vec3(10.0));   // (glossenv's clamp)
            imageStore(uReflSpec, DS_TEXEL(px), uvec4(dsPackRGB9E5(word)));
        }
    }
    if (k.y > 0.0 && !halfRefl && wS > 1e-6)   // the legacy sharp env word (lod 0: no roughness fade)
    {
        vec3 res = (hS + mS * envE) / wS;
        if (temporal && k.x <= 0.0)
        {
            vec3 mu = res, sg = vec3(0.0);
            if (wB > 1e-6)
            {
                mu = (hB + mB * envE) / wB;
                sg = sqrt(max((qB + mB * envE * envE) / wB - mu * mu, vec3(0.0)));
            }
            res = rtrTemporal(px, res, mu, sg, wB > 1e-6 ? nEff : 1.0, P, Ng, V, tMean, vz, tSurf, rough);
            temporal = false;
            resOut = res;
        }
        const vec3 word = max(dsUnpackRGB9E5(imageLoad(uReflEnv, DS_TEXEL(px)).x) + fd * (k.y * res - xE), vec3(0.0));
        imageStore(uReflEnv, DS_TEXEL(px), uvec4(dsPackRGB9E5(word)));
        remE = (1.0 - fd) + fd * mS / wS;
    }
    // (TEMPORAL on, nothing spliced or accumulated here: no history for this pixel)
    if (temporal) imageStore(uRtHist, RTH_TEXEL(px, (rtt_param.w >> 8) & 1u), vec4(0.0));
    rtrResolveCount(empty, emptyHist, g_rtr_hist_lum > 1e-3 && resOut.x >= 0.0 && rrtLum(resOut) < 0.25 * g_rtr_hist_lum);
    // (#1606 GUIDE) a pixel the trace did not cast: its gather's hit distance for the RR guide (rtrGuideEncode;
    // nothing accepted: -1 stays)
    if (!(own.a >= 0.0) && (wB > 1e-6 || wS > 1e-6))
        imageStore(uRtTrace, DS_TEXEL(px), vec4(0.0, 0.0, 0.0, rtrGuideEncode(tGW > 1e-6 ? tG / tGW : RTR_GUIDE_MISS)));
    if (remS < 1.0 || remE < 1.0)
        imageStore(uReflRtMark, DS_TEXEL(px), uvec4(dsPackRGB9E5(xS * clamp(remS, 0.0, 1.0)),
                                          dsPackRGB9E5(xE * clamp(remE, 0.0, 1.0)), m.z, m.w));
    CLK_MARK(STORE);
}

