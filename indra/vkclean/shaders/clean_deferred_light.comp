    float occVis = 1.0;
    bool want = true;
    // (#87 x #859) RT REFLECTION HITS UNDER GI: the HALL-OF-MIRRORS fix. Before, a reflection hit's
    // environment was ALWAYS the probes (or the sky where none covers it) -- never occlusion-tested.
    // A smooth metal hit has ~no diffuse (base x (1 - metal)), so its whole colour is that radiance
    // x its F0: inside a closed gold box every wall seen in a wall came back as sky / probe-lit gold
    // (the probe captures shade their own hits with the sky too), while GI darkened everything else.
    // With GI on this frame:
    //   * ONE OCCLUSION RAY along R from the hit (every world blocker -- opaque, terrain, alpha-mask
    //     cut-outs alpha-tested, alpha-blend faces by their transmittance, as the shadow rays walk them
    //     -- over the reflection length): its visibility v mixes ESCAPED (the probes / sky along R: they
    //     hold the far field -- open metal outdoors unchanged) and BLOCKED (R sees another surface,
    //     whose light the probes / sky do not know: the radiance cache at the hit -- occlusion-aware, a
    //     sealed room's cells are dark -- where it has a cell, else nothing). This is the secondary
    //     reflection's cut-off value. (The first version tested opaque + terrain only: a wall built
    //     from alpha-mask / alpha-blend faces let every hit facing it see the sky -- a bright patch.)
    //   * the hit's IRRADIANCE follows RenderVKGIHitAmbient as the GI hits do: 0 none, 1 the probes,
    //     2 the cache else the probes, 3 the cache else none.
    // GI off: unchanged.
    if (occ)
    {
        const uint amb = uint(gi.prm.w + 0.5);
        const float gk = max(gi.prm.x, 0.0);   // (RenderVKGIIntensity, as the receivers' GI)
        // the cache at the hit (one lookup serves both terms)
        vec3 E = vec3(0.0);
        bool found = false;
        if (giCacheSlots() != 0u)
        {
            float edge;
            found = giCacheRead(giCacheFind(giCellKey(P, N, pc.u_cam_time.xyz, edge)), E);
            E = max(E, vec3(0.0)) * gk;
        }
        // The occlusion ray, lifted off the GEOMETRIC plane on the side the reflection ray ARRIVED
        // from (g_rtr_hit_ng is turned that way). A shading normal that departs from the face's (smooth
        // / averaged vertex normals near a box's edges, normal maps) can tilt R = reflect(-V, N) to
        // graze or cross that plane: R is then bent back onto the arrival side (pass 14's receiver
        // rule), never traced from the far side. The first versions turned the plane toward R
        // instead -- for such an R the ray started BEHIND the wall and left the room: "escaped" (GREEN,
        // probes / sky) in curved bands wherever the shading normal tipped R through the wall.
        // The ray is TWO-SIDED (traceShadowRay outside a sun / moon trace: no facing cull; opaque prims
        // are CULL_DISABLE in the TLAS): an origin the 1 cm lift puts inside a neighbouring solid (a hit
        // beside a room's corner) is blocked by that solid's own faces -- it cannot leave through it.
        // So the green lines along the gold cube's corner seams were NOT this ray: their REFLECTION ray
        // had already left the room through a wall (a seam receiver a hair inside the neighbouring prim,
        // its back faces skipped) and hit the world outside, where this ray rightly escaped. That is
        // closed at the source -- rtrTraceRefl's REFLECTION BACK-FACE STOP (RenderVKRTReflectionsBackFaceStop).
        float vis = 1.0;
        vec3 o, Ro;
        rtrOccRay(P, R, o, Ro);
        {
            // FAR (RTR_OCC_FAR), not the reflection length: an occlusion ray is a first-hit query, cheap
            // to run long, and only a TRUE miss is an escape to the sky. Capped at the reflection
            // length (64 m default), every hit in a room larger than that "escaped" -- the arc-shaped
            // green regions of the debug view and the bright wall rectangle in the owner's gold cube.
#if defined(CLEAN_VIS_QUEUE_M2) && CLEAN_RT_STAGE == RT_STAGE_LIGHT
            // (#1039 M2) the producer queued this ray (rtrOccRay on the same record): its result
            float bt;
            vqHitOcc(vis, bt);
            rt_block_t = bt;
#else
            rt_block_t = 1e30;
            vis = traceShadowRay(o, Ro, 0.0, RTR_OCC_FAR, RT_MASK_WORLD_BLOCK);
#endif
            vis = clamp(vis, 0.0, 1.0);
            g_rtr_occ = vis;
            g_rtr_occ_far = rt_block_t < 1e29 && rt_block_t > max(g_draw_push.rtr.x, 1.0);
        }
        want = amb == GI_HIT_AMB_PROBES || amb == GI_HIT_AMB_CACHE || vis > 0.0;
        occAmb = amb; occE = E; occFound = found; occVis = vis;
    }
#endif
    // THE PROBE WALK + the sky fallback (one call site)
    vec3 pirr = amblit;
    bool have = false;
    rad = vec3(0.0); rad2 = vec3(0.0);
#if !DEFER_GI_TRACE && (CLEAN_DEFER_PASS == 11 || CLEAN_DEFER_PASS == 14)
    if (want)
#endif
        have = rtrHitProbes(P, N, R, rough, legacy, amblit, rad, rad2, pirr);
#if !DEFER_GI_TRACE && (CLEAN_DEFER_PASS == 11 || CLEAN_DEFER_PASS == 14)
    if (occ)
    {
        const uint amb = occAmb;
        const vec3 E = occE;
        const bool found = occFound;
        const float vis = occVis;
        if (vis < 1.0)
        {
            const vec3 bv = found ? E : vec3(0.0);
            rad = mix(bv, rad, vis); rad2 = mix(bv, rad2, vis);
        }
        // the hit's irradiance per the GI hit-ambient mode (classic atmospherics take it as sRGB, as
        // deferReflIn's GI)
        const vec3 Ec = atmosClassic() ? atmosLinearToSrgb(E) : E;
        const vec3 probeIrr = (have && !(legacy && atmosClassic())) ? pirr : amblit;
        if (amb == GI_HIT_AMB_NONE) irr = vec3(0.0);
        else if (amb == GI_HIT_AMB_PROBES) irr = probeIrr;
        else if (found) irr = Ec;
        else irr = (amb == GI_HIT_AMB_CACHE) ? probeIrr : vec3(0.0);
        // (RenderVKGIMinAmbient: the receivers' floor, x the probe ambient -- 0 by default)
        if (gi.prm.y > 0.0 && (have || amb == GI_HIT_AMB_PROBES || amb == GI_HIT_AMB_CACHE))
            irr = max(irr, probeIrr * clamp(gi.prm.y, 0.0, 1.0));
        return;
    }
#endif
    irr = (have && !(legacy && atmosClassic())) ? pirr : amblit;
}
