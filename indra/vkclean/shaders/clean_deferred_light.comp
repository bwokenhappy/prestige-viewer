        const vec3 lw = vec3(0.2126, 0.7152, 0.0722);
        mprxPut(1u, nl | (min(nU_l, 255u) << 8u) | (hasN ? 0x10000u : 0u) | (hasD ? 0x20000u : 0u) | 0x40000u | (3u << 20u));
