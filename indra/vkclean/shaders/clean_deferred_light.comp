#include "clean_rt_shade.glsl"
#include "clean_rt_weather.glsl"   // #970 weather at hits: rtWeatherHit (the coat) / rtSnowField (the lying snow)
// (#1036) RT LIT RECORD: a hit's RtLitSurface (clean_rt_shade.glsl) + its footprint (rt_surf_foot) in
// 4 uvec4 (64 B) -- what the split hit shading's MATERIAL stage hands its LIGHTING stage (the GI's
// HIT-MAT -> HIT-LIGHT, the RT reflections' MAT -> LIGHT):
//   r0 = P.xyz, rt_surf_foot                                        (f32)
//   r1 = oct N, oct Ng, oct Nv (snorm 16 + 16 each), the model (bits 0-1)
//   r2 = the terminator lift's height along Ng, tw (f32), base.rg (half), base.b | ao (half; PBR)
//   r3 = PBR       rough, metal (f32), emissive.rg, emissive.b | 0 (half)
//        legacy    gloss, env (f32), spec_lin.rgb
//        fullbright fb_env, 0 (f32), fb.rgb                         (water: nothing past r1)
// The lift: rtTerminatorTri lifts along the facet normal only (ng x min(height, cap), ng = Ng: both the
// hit triangle's normal on the side the ray arrived from), so its height says it all. Bit-exact: P,
// the footprint, the lift height, tw and the f32 scalars. Rounded: the normals (oct 2 x 16 bits,
// ~4e-5 rad), the colours and ao (fp16: 2^-11 relative, clamped to 65504). base.a = 1 (no caller of
// the split paths reads rtShadeHit's alpha).
uint rtLitOct(vec3 n) { return packSnorm2x16(gbOctEncode(n)); }
vec3 rtLitUnoct(uint w) { return gbOctDecode(unpackSnorm2x16(w)); }
uvec2 rtLitHalf3(vec3 c, float x)
{
    const vec3 h = min(c, vec3(65504.0));
    return uvec2(packHalf2x16(h.rg), packHalf2x16(vec2(h.b, min(x, 65504.0))));
}
void rtLitPack(RtLitSurface s, out uvec4 r0, out uvec4 r1, out uvec4 r2, out uvec4 r3)
{
    const bool pbr = s.model == RT_SURF_PBR, fb = s.model == RT_SURF_FULLBRIGHT;
    r0 = uvec4(floatBitsToUint(s.P), floatBitsToUint(rt_surf_foot));
    r1 = uvec4(rtLitOct(s.N), rtLitOct(s.Ng), rtLitOct(s.Nv), s.model);
    r2 = uvec4(floatBitsToUint(dot(s.tlift, s.Ng)), floatBitsToUint(s.tw), rtLitHalf3(s.base.rgb, pbr ? s.ao : 0.0));
    r3 = uvec4(floatBitsToUint(pbr ? s.rough : (fb ? s.fb_env : s.gloss)), floatBitsToUint(pbr ? s.metal : (fb ? 0.0 : s.env)),
               rtLitHalf3(pbr ? s.emissive : (fb ? s.fb : s.spec_lin), 0.0));
}
// The record back (rtSurfaceEval's defaults in the fields its model leaves alone); sets rt_surf_foot.
RtLitSurface rtLitUnpack(uvec4 r0, uvec4 r1, uvec4 r2, uvec4 r3)
{
    RtLitSurface s;
    s.P = uintBitsToFloat(r0.xyz);
    rt_surf_foot = uintBitsToFloat(r0.w);
    s.N = rtLitUnoct(r1.x);
    s.Ng = rtLitUnoct(r1.y);
    s.Nv = rtLitUnoct(r1.z);
    s.model = r1.w & 3u;
    const float lh = uintBitsToFloat(r2.x);
    s.tlift = lh != 0.0 ? s.Ng * lh : vec3(0.0);
    s.tw = uintBitsToFloat(r2.y);
    const vec2 b2 = unpackHalf2x16(r2.w);
    s.base = vec4(unpackHalf2x16(r2.z), b2.x, 1.0);
    const vec3 c = vec3(unpackHalf2x16(r3.z), unpackHalf2x16(r3.w).x);
    const float s0 = uintBitsToFloat(r3.x), s1 = uintBitsToFloat(r3.y);
    const bool pbr = s.model == RT_SURF_PBR, fb = s.model == RT_SURF_FULLBRIGHT, lg = s.model == RT_SURF_LEGACY;
    s.rough = pbr ? s0 : 1.0;
    s.metal = pbr ? s1 : 0.0;
    s.ao = pbr ? b2.y : 1.0;
    s.emissive = pbr ? c : vec3(0.0);
    s.spec_lin = lg ? c : vec3(0.0);
    s.gloss = lg ? s0 : 0.0;
    s.env = lg ? s1 : 0.0;
    s.fb = fb ? c : vec3(0.0);
    s.fb_env = fb ? s0 : 0.0;
    return s;
}
