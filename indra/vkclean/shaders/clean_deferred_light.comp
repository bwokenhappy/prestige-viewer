// uSssTmp holds a pixel's two words side by side (w 0: lanes 1, w 1: lanes 2).
// (#1608: the view's layer, as every skin-scattering image -- a layer per view)
ivec3 sssTmpAt(ivec2 q, int w) { return ivec3(2 * q.x + w, q.y, DEFER_LAYER); }
// Eye-relative world position of a pixel (deferPosition without the eye; distances only).
vec3 sssPos(ivec2 q, float d)
{
    const vec2 ndc = (vec2(q) + 0.5) / vec2(float(g_draw_push.width), float(g_draw_push.height)) * 2.0 - 1.0;
    const vec4 h = deferInvVP * vec4(ndc, d, 1.0);
    return h.xyz / h.w;
}
bool sssIsSkin(ivec2 q)
{
    return all(greaterThanEqual(q, ivec2(0))) && q.x < int(g_draw_push.width) && q.y < int(g_draw_push.height)
        && gbufferIsSkin(defTexel(uG2, q));
}
// One staged texel: false off the skin; else its lane values (horizontal: the irradiance in v1;
// vertical: the row pass's two words) and its eye distance.
bool sssTexel(ivec2 q, out vec3 v1, out vec3 v2, out float dist)
{
    v1 = vec3(0.0); v2 = vec3(0.0); dist = 0.0;
    if (!sssIsSkin(q)) return false;
#ifdef CLEAN_SSS_VERTICAL
    v1 = dsUnpackRGB9E5(imageLoad(uSssTmp, sssTmpAt(q, 0)).x);
    v2 = dsUnpackRGB9E5(imageLoad(uSssTmp, sssTmpAt(q, 1)).x);
#else
    v1 = dsUnpackRGB9E5(imageLoad(uSssDiff, DS_TEXEL(q)).x);
#endif
    dist = length(sssPos(q, defTexel(uDepthG, q).r));
    return true;
}
// A point u (entries) of the staged run, relative to the centre's quantised lane values c1 / c2:
// b = (sum - c x skin count) at entry boundary floor(u), s = the same over that entry, f = the
// fraction into it. Integers: exact differences (|b| <= 2^29 by the SSS_QUANT budget).
struct SssPt { ivec3 b1; ivec3 s1; ivec3 b2; ivec3 s2; float f; };
SssPt sssPt(float u, int L, ivec3 c1, ivec3 c2)
{
    const int i = min(int(u), L - 1);
    SssPt p;
    p.f = u - float(i);
    const ivec4 q = s_sssQ[i];
    p.b1 = q.xyz - c1 * q.w;
    p.s1 = ivec3(0);
#ifdef CLEAN_SSS_VERTICAL
    const ivec4 q2 = s_sssQ2[i];
    p.b2 = q2.xyz - c2 * q.w;
    p.s2 = ivec3(0);
#else
    p.b2 = ivec3(0);
    p.s2 = ivec3(0);
#endif
    if (p.f > 0.0)
    {
        const ivec4 n = s_sssQ[i + 1];
        p.s1 = (n.xyz - q.xyz) - c1 * (n.w - q.w);
#ifdef CLEAN_SSS_VERTICAL
        p.s2 = (s_sssQ2[i + 1].xyz - q2.xyz) - c2 * (n.w - q.w);
#endif
    }
    return p;
}
// The difference-from-centre integral between two points a <= b (fixed-point units, per lane).
void sssSpan(SssPt a, SssPt b, out vec3 v1, out vec3 v2)
{
    v1 = vec3(b.b1 - a.b1) + b.f * vec3(b.s1) - a.f * vec3(a.s1);
#ifdef CLEAN_SSS_VERTICAL
    v2 = vec3(b.b2 - a.b2) + b.f * vec3(b.s2) - a.f * vec3(a.s2);
#else
    v2 = v1.rrg;   // (B.r, C.r, B.g all gather the irradiance's own r, r, g)
#endif
}
// packRGB9E5 with the shared exponent at least eMin (the centre's own: an unchanged value
// packs back to the identical word).
uint sssPack(vec3 c, uint eMin)
{
    const float r = rgb9e5Clamp(c.r), g = rgb9e5Clamp(c.g), b = rgb9e5Clamp(c.b);
    const float maxc = max(r, max(g, b));
    const int e2 = maxc > 0.0 ? int((floatBitsToUint(maxc) >> 23) & 0xFFu) - 127 : -127;
    int es = max(max(-16, e2) + 16, int(eMin));
    float scale = exp2(float(es - 15 - 9));
    if (floor(maxc / scale + 0.5) >= 512.0) { es += 1; scale *= 2.0; }
    const uint rm = uint(floor(r / scale + 0.5)), gm = uint(floor(g / scale + 0.5)), bm = uint(floor(b / scale + 0.5));
    return min(rm, 511u) | (min(gm, 511u) << 9) | (min(bm, 511u) << 18) | (uint(min(es, 31)) << 27);
}
