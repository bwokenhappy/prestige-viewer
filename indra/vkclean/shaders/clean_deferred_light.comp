// direction d's cube texel (face = axis x 2 + negative; 32 x 32 per face)
uint lvcTexel(vec3 d)
{
    const vec3 a = abs(d);
    uint face;
    vec2 uv;
    float ma;
    if (a.x >= a.y && a.x >= a.z) { face = d.x < 0.0 ? 1u : 0u; uv = d.yz; ma = a.x; }
    else if (a.y >= a.z)          { face = d.y < 0.0 ? 3u : 2u; uv = d.xz; ma = a.y; }
    else                          { face = d.z < 0.0 ? 5u : 4u; uv = d.xy; ma = a.z; }
    const vec2 t = clamp((uv / max(ma, 1e-20)) * 0.5 + 0.5, vec2(0.0), vec2(0.99999));
    const uvec2 q = uvec2(t * float(LVC_FACE_RES));
    return face * (LVC_FACE_RES * LVC_FACE_RES) + q.y * LVC_FACE_RES + q.x;
}
// texel t's direction at the in-texel point jit (0..1)
vec3 lvcTexelDir(uint t, vec2 jit)
{
    const uint face = t / (LVC_FACE_RES * LVC_FACE_RES), r = t % (LVC_FACE_RES * LVC_FACE_RES);
    const vec2 uv = (vec2(float(r % LVC_FACE_RES), float(r / LVC_FACE_RES)) + jit) / float(LVC_FACE_RES) * 2.0 - 1.0;
    const float s = (face & 1u) != 0u ? -1.0 : 1.0;
    const uint ax = face >> 1u;
    return normalize(ax == 0u ? vec3(s, uv.x, uv.y) : (ax == 1u ? vec3(uv.x, s, uv.y) : vec3(uv.x, uv.y, s)));
}
