    }
    rt_hit_ng = ngf;    // (rtrProjRay: the walk's shadow rays leave from the layer's plane, its viewer side)
    rt_hit_err = 0.0;   // (a ray-traced point: barycentric on its triangle)
    const vec3 sh = rtHitLocalLights(P, nf, V, false, vec3(1.0), 0.0, 1.0, legacySpecNone(), 0u);
    g_rtr_novis = true;   // (clean_rt_light_ray.glsl rtrProjRay: every visibility 1, no ray)
    const vec3 un = rtHitLocalLights(P, nf, V, false, vec3(1.0), 0.0, 1.0, legacySpecNone(), 0u);
    g_rtr_novis = false;
    const float lu = rtsLum(un);
    const float ratio = lu > 1e-6 ? clamp(rtsLum(sh) / lu, 0.0, 1.0) : 1.0;
    float ov = 1.0;
    if (rtrOccOn())
    {
        const vec3 nv = dot(ls.Nv, V) < 0.0 ? -ls.Nv : ls.Nv;   // (the smooth normal on the viewer's side)
        const vec3 R = reflect(dir, nv);
