}
int rtrLattice(float rhoEff)
{
    const float inv = inversesqrt(max(rhoEff, 1.0 / 256.0));
    int L = 1;
    for (int k = 0; k < 4 && float(L) < inv - 1e-3; ++k) L *= 2;
    return L;
}
// (#1606) EMPTY CELLS (RenderVKRTReflectionsEmptyHold, rtt_opts4 bit 4): a candidate whose gather accepts NO traced
// sample this frame -- its lattice cell's ray went to another surface / plane, a neighbour cast at a lower density,
// the cell lost its candidate pixel to the jitter -- used to keep the bare env AND clear its history. Under GI the env
// share is the specular occlusion's (deferReflIn: the mark's residual, all of it on such a pixel), which in a closed
// room is ~black: the whole cell flipped between properly lit (a frame with a sample) and black (one without), with
// no history to smooth it (the owner's "squares flipping dark / lit"). Now such a pixel holds its reprojected
// history (surface motion, depth-validated: rtrHistFetch) as it is -- pure traced radiance, so the splice replaces
// the whole env share and leaves no residual for the GI occlusion (remS = 1 - f; mixing env into a held value would
// carry UNOCCLUDED env forward frame after frame: the sealed-room leak #87 closed) -- for at most RTR_HOLD_MAX
// consecutive empty frames: the hold count rides in the history length word (len + holds x RTR_HOLD_AGE; a sampled
// frame writes a plain length and so resets it). A cell that stops being sampled for good falls back to the env
// after that; one sampled every few frames never does. No history (a disocclusion, a camera cut): the env.
#define RTR_HOLD_MAX 8.0
#define RTR_HOLD_AGE 1024.0
bool rtrEmptyHold() { return (rtt_opts4 & 16u) != 0u; }   // (a header word: uniform)
// The reprojected history of pixel px (P, vz: its receiver) for an empty gather -> h; aux: its variance / length.
bool rtrHistPeek(vec3 P, out vec3 h, out vec4 aux)
{
    const uint prev = ((rtt_param.w >> 8) & 1u) ^ 1u;
    h = vec3(0.0);
    aux = vec4(0.0);
    if (ssr.taa_params.z >= 0.5) return false;
    vec2 fp;
    float pw;
    ivec2 i0;
    vec4 w;
    if (!(rtrPrevPos(P - ssr.cam_origin.xyz, fp, pw) && rtrHistFetch(fp, pw, prev, h, i0, w))) return false;
    [[unroll]] for (int k = 0; k < 4; ++k)
        if (w[k] > 0.0) aux += w[k] * imageLoad(uRtHist, RTH_TEXEL(i0 + ivec2(k & 1, k >> 1), 2u + prev));
    return true;
}
// (#1606) RESOLVE COUNTERS (the header's spare words rtt_rays[0..2], host-zeroed every frame; the VKGpu "RT
// reflections" line's "resolve:" part): [0] candidates with no traced sample in their gather, [1] of those the ones
// with a valid history (with EmptyHold off: the pixels that flipped to the env this frame), [2] spliced pixels whose
// result fell below a quarter of their own history (a sample-driven dark flip: a black back-face stop, a dark gather).
void rtrResolveCount(bool empty, bool emptyHist, bool darkFlip)
{
    const uvec3 v = subgroupAdd(uvec3(empty ? 1u : 0u, emptyHist ? 1u : 0u, darkFlip ? 1u : 0u));
    if (subgroupElect())
    {
        if (v.x != 0u) atomicAdd(rtt_rays[0], v.x);
        if (v.y != 0u) atomicAdd(rtt_rays[1], v.y);
        if (v.z != 0u) atomicAdd(rtt_rays[2], v.z);
    }
}
