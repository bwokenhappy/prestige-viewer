        }
        if (!take) e = min(rg.rs_em_take_cfg.x, REGIR_EM_TAKE_N) + bucket;
        const uvec2 revision = rtGeomEmRevision(id);
        const uint tagWord = emEntryTagWord(par,e);
        rg_cells[tagWord] = uvec2(emInputGeneration(id), revision.x);
        rg_cells[tagWord + 1u] = uvec2(revision.y, rg.cfg.w);
        atomicAdd(rg.rs_em_cfg.y, nTri);
