// ---- RT FORWARD SELECT (-DCLEAN_RT_FWD_SEL; before RT FORWARD, behind the barrier that orders it before the
// forward's indirect read): one 8 x 8 workgroup per HALF-resolution tile of the whole grid, a thin kernel (no
// shading, no resolve: its registers are the ray query's). Per texel the forward pass's camera ray (the same
// origin, direction and pixel) over the same classes (RT_MASK_BLEND | RT_MASK_WATER) on a slightly LONGER interval,
// stopping at the first candidate or committed hit of any kind -- no alpha test, no facing, no re-trace: every ray
// on which RT FORWARD's closest-hit walk (rtrClosest, its first traversal and any re-trace past a back face, all on
// [0, its tmax]) can find a layer meets at least one such intersection here. So the list is a SUPERSET of the tiles
// with a forward layer (a candidate the walk rejects -- alpha < RTR_FWD_MIN_ALPHA, a back face -- only lists a tile
// that then writes "no layer"), and every tile left out is exactly one where the full-grid kernel found nothing.
//   * a tile with a hit: listed (RT FORWARD runs its whole body there, as before);
//   * a tile without one: its texels get the values RT FORWARD's no-layer branch wrote -- row 0 (the resolved
//     reflection the FSs read: rtFwdIn) and this parity's reflection history row 1 + parity both vec4(0), the layer
//     GI row 5 (rtFwdGiIn) vec4(0, 0, 0, -1). THE HISTORY CONTRACT: every history read (rftReproject, rfgReproject)
//     is accepted only on a depth match in the reflection history row 1 + (parity ^ 1) at that texel (rftSameLayer
//     needs a > 0), and the variance rows 3 / 4, the GI history rows 6 / 7 and the GI variance rows 8 / 9 are read
//     only at a texel accepted there -- so the zero in row 1 + parity kills every history read of an unlisted
//     texel next frame, and a tile ENTERING the list starts clean (its texels' previous-parity row is that zero);
//     a tile that drops out never leaves stale history behind (rows 3 / 6 / 8 keep old values nobody reads).
// The tmax margin: RT FORWARD stops at 0.999 x the opaque depth; this kernel at 0.9992 x (a separately compiled
// kernel's rounding of the same expressions is ~1e-6 relative: never shorter) -- tight, so a blend decal lying on
// a wall (SL posters, signs) is not listed for a hit just behind the opaque surface the forward ray never reaches.
shared uint s_rfs_hit;   // any texel of the tile hit
void DEFER_MAIN()
{
    const uint lid = gl_LocalInvocationIndex;
    const ivec2 hp = ivec2(gl_GlobalInvocationID.xy);
    const ivec2 full = ivec2(g_draw_push.width, g_draw_push.height);
    const ivec2 hsz = (full + 1) / 2;
    const bool inGrid = hp.x < hsz.x && hp.y < hsz.y;   // (no early return: the barriers below)
    if (lid == 0u) s_rfs_hit = 0u;
    barrier();
    bool hit = false;
    if (inGrid)
    {
        const ivec2 px = min(hp * 2 + 1, full - 1);   // (RT FORWARD's: the block's centre ray passes its corner pixel)
#ifdef CLEAN_RT_HANG_BEACON
        rtBcLane(uint(hp.y) * uint(hsz.x) + uint(hp.x), px);   // (#1128: the beacon names the render pixel)
#endif
        const vec2 spx = vec2(hp * 2) + 1.0;
        g_frag_xy = vec2(px) + 0.5;
        vec3 o = pc.u_cam_time.xyz;
        vec3 dir = rtrViewDir(spx);
        const float d = defTexel(uDepthG, px).r;
        float tmax = d > 0.0 ? length(rtrPositionAt(px) - o) * 0.9992 : 4096.0;
        float tmin = 0.0;
        RT_BC_SITE(RT_BC_SITE_CLOSEST | RT_MASK_BLEND | RT_MASK_WATER);   // (#1128 hang beacon variants only)
        if (rtRaySane(o, tmin, dir, tmax))
        {
            rayQueryEXT rq;
            rayQueryInitializeEXT(rq, uTLAS, gl_RayFlagsTerminateOnFirstHitEXT, RT_MASK_BLEND | RT_MASK_WATER, o, tmin,
                                  dir, tmax);
            // (any candidate -- triangle or not -- is a hit: no confirm needed, the query ends here)
            if (rayQueryProceedEXT(rq))
            {
                hit = true;
                rayQueryTerminateEXT(rq);
            }
            else if (rayQueryGetIntersectionTypeEXT(rq, true) != gl_RayQueryCommittedIntersectionNoneEXT)
                hit = true;   // (an opaque-flagged instance committed without a candidate)
        }
    }
    if (hit) s_rfs_hit = 1u;   // (every writer writes 1)
    barrier();
    if (s_rfs_hit != 0u)
    {
        if (lid == 0u)
        {
            const uint fb = rftListBase();
            const uint i = atomicAdd(rtt_words[fb], 1u);
            // (Xid 109 hardening) never past the capacity; the dispatch rows / width only for a stored entry
            if (i < rtt_words[fb + 4u])
            {
                // (#1608: z = the view -- its rows after the first views', rftTilesY; one view: the row itself)
                const uint row = kViewCount > 1 ? CLEAN_VIEW * rftTilesY() + gl_WorkGroupID.y : gl_WorkGroupID.y;
                rtt_words[fb + 8u + i] = gl_WorkGroupID.x | (row << 16);
                if (i % RTT_ROW == 0u) atomicAdd(rtt_words[fb + 2u], 1u);
                atomicMax(rtt_words[fb + 1u], min(i + 1u, RTT_ROW));
            }
        }
        return;
    }
    if (!inGrid) return;
    // (unlisted: RT FORWARD's no-layer values -- see THE HISTORY CONTRACT above)
    imageStore(uRtFwd, DS_TEXEL(hp), vec4(0.0));
    if (imageSize(uRtFwd).y >= RFT_REGIONS * hsz.y)
    {
        const uint par = rftFlags() & RFT_PUSH_PARITY;
        imageStore(uRtFwd, DS_TEXEL(hp + ivec2(0, hsz.y * int(1u + par))), vec4(0.0));
        imageStore(uRtFwd, DS_TEXEL(hp + ivec2(0, hsz.y * 5)), vec4(0.0, 0.0, 0.0, -1.0));
        imageStore(uRtFwd, DS_TEXEL(hp + ivec2(0, hsz.y * 10)), vec4(0.0));   // (THE LAYER'S LIGHT: none)
        imageStore(uRtFwd, DS_TEXEL(hp + ivec2(0, hsz.y * int(11u + par))), vec4(0.0));
    }
}
