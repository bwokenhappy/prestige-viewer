        if ((idx & 1u) == 0u) rg_cells[LVC_NOISE_BASE + (idx >> 1u)].x = v; else rg_cells[LVC_NOISE_BASE + (idx >> 1u)].y = v;
    }
}
void DEFER_MAIN()
{
    g_pdn_view = CLEAN_VIEW_Z;   // (#1608: MASK / NOISE z = the views; LIST runs over every view's tiles)
    const ivec2 D = ivec2(g_draw_push.rtr.xy + 0.5);
    const uint lid = gl_LocalInvocationIndex;
    const bool on = pdnAdaptOn(D);   // (uniform: the push and the binding's length)
    const uint b = pdnAdaptBase(D), T = pdnAdaptTileCount(D);
    const uint tilesX = uint((D.x + 7) / 8);
    if ((g_draw_push.rtr3.z & 0x1000000u) != 0u) { if (on) lvcNoisePhase(D, b, T, tilesX); return; }   // (NOISE)
    if ((g_draw_push.rtr3.z & 0x100000u) == 0u)
    {
        // ---- MASK ----
        if (lid < 4u) s_adCnt[lid] = 0u;
        if (lid < 3u) s_adPen[lid] = 0u;
        if (lid == 0u) s_adZ = 0x7F7FFFFFu;
        barrier();
        const uint par = (uint(g_draw_push.rtr.w + 0.5) >> 4u) & 1u;
        uint pen = 0u;
        const uint c = on ? pdnAdaptTexelClass(ivec2(gl_GlobalInvocationID.xy), D, par,
                                              (g_draw_push.rtr3.z & 0x200000u) != 0u, pen) : 0u;
        if (c != 0u) atomicAdd(s_adCnt[c], 1u);
        if (c != 0u)   // (LVC stage 1: the tile's nearest flagged surface -- its depth bucket ranks the cap's admission)
        {
            const float z = uintBitsToFloat(imageLoad(uPdnGeom, ivec3(ivec2(gl_GlobalInvocationID.xy), PDN_L(int(par)))).x);
            if (z > 0.0) atomicMin(s_adZ, floatBitsToUint(z));
        }
        if (occStatsOnly())   // (uniform; LVC STATS counter 4: the class-3 texels' attribution, one atomic per subgroup)
        {
            const uint sN = subgroupAdd(g_lvc_mask & 1u), sC = subgroupAdd((g_lvc_mask >> 1u) & 1u);
            const uint sR = subgroupAdd((g_lvc_mask >> 2u) & 1u);
            if (subgroupElect()) { lvcStatAdd(LVC_S_C3_NOW, sN); lvcStatAdd(LVC_S_C3_CARRY, sC); lvcStatAdd(LVC_S_C3_RED, sR); }
        }
        [[unroll]] for (uint k = 0u; k < 3u; ++k)
            if ((pen & (1u << k)) != 0u) atomicAdd(s_adPen[k], 1u);
        barrier();
        if (lid == 0u && on)
        {
            // (at least PDN_AD_MIN texels of the class or above)
            const uint n3 = s_adCnt[3], n2 = n3 + s_adCnt[2], n1 = n2 + s_adCnt[1];
            const uint tc = n3 >= PDN_AD_MIN ? 3u : (n2 >= PDN_AD_MIN ? 2u : (n1 >= PDN_AD_MIN ? 1u : 0u));
            const uint t = pdnAdaptTile(gl_WorkGroupID.xy, D);   // (#1608: the view's tiles)
            if (t < T)
            {
                // (the class in bits 0-1, the depth bucket in bits 4-7: the LIST phase reads both)
                const uint zb = pdnAdaptZBucket(uintBitsToFloat(s_adZ));
                pdn_vis[b + PDN_AD_HDR + T + t] = tc | (zb << 4u);
                if (tc != 0u) atomicAdd(pdn_vis[b + 4u + tc], 1u);
                if (tc != 0u) atomicAdd(pdn_vis[pdnAdaptZBase(D) + (tc - 1u) * PDN_AD_ZB + zb], 1u);
                // (the before / after diagnostics: a penumbra tile under each rule -- no higher class listed it)
                if (n2 < PDN_AD_MIN)
                {
                    if (n2 + s_adPen[0] >= PDN_AD_MIN) atomicAdd(pdn_vis[b + PDN_AD_W_OLD_PEN], 1u);
                    if (n2 + s_adPen[1] >= PDN_AD_MIN) atomicAdd(pdn_vis[b + PDN_AD_W_NEW_PEN], 1u);
                    if (n2 + s_adPen[2] >= PDN_AD_MIN) atomicAdd(pdn_vis[b + PDN_AD_W_SPREAD], 1u);
                }
            }
        }
        return;
    }
    // ---- LIST ----
    const uint t = gl_WorkGroupID.x * 64u + lid;
    if (!on || t >= T) return;
    const uint tw = pdn_vis[b + PDN_AD_HDR + T + t];
    const uint tc = tw & 15u, zb = min((tw >> 4u) & 15u, PDN_AD_ZB - 1u);
    if (tc == 0u || tc > 3u) return;
    const uint B = min(uint(max(g_draw_push.rtr2.w, 0.0) + 0.5), T);
    const uint h3 = pdn_vis[b + 7u], h2 = pdn_vis[b + 6u];
    const uint thr = h3 >= B ? 3u : (h3 + h2 >= B ? 2u : 1u);
    if (tc < thr) return;
    if (tc == thr)
    {
        const uint above = thr == 3u ? 0u : (thr == 2u ? h3 : h3 + h2);   // (< B: every tile above is admitted)
        // (LVC stage 1) NEAR TO FAR within the threshold class: the class's tiles in nearer buckets come first, then
        // this bucket's own first come -- the cap leaves the FAR tiles' small shadows a little noisy, not random ones
        const uint zbase = pdnAdaptZBase(D) + (thr - 1u) * PDN_AD_ZB;
        uint nearer = 0u;
        [[dont_unroll]] for (uint k = 0u; k < zb; ++k) nearer += pdn_vis[zbase + k];
        if (nearer >= B - above) return;
        if (atomicAdd(pdn_vis[pdnAdaptZBase(D) + 3u * PDN_AD_ZB + zb], 1u) >= B - above - nearer) return;
        atomicAdd(pdn_vis[b + 8u], 1u);   // (the admitted count of the threshold class: the VKShadow line's cap)
    }
    atomicOr(pdn_vis[b + PDN_AD_HDR + T + t], PDN_AD_LISTED);   // (the NOISE phase's group: admitted)
    const uint i = atomicAdd(pdn_vis[b], 1u);
    if (i >= T) return;   // (never: i < B <= T)
    pdn_vis[b + PDN_AD_HDR + i] = (t % tilesX) | ((t / tilesX) << 16u);
    // the dispatch arguments: a new PDN_AD_ROW-wide row per PDN_AD_ROW entries, x the widest row
    if (i % PDN_AD_ROW == 0u) atomicAdd(pdn_vis[b + 2u], 1u);
    atomicMax(pdn_vis[b + 1u], min(i + 1u, PDN_AD_ROW));
}
#else

#if CLEAN_SHADOW_STAGE == SH_STAGE_SHADE
// (RenderVKShadowMoverMask 2) the mover buffer for THE OVERFLOW RULE's demand histogram only (SHADE zeroes the parity
// this frame's SELECT read: pdnExactHistDone)
layout(std430, set = RT_SET, binding = 17) coherent buffer MoverBuf { uint mv[]; };
#include "clean_rt_movers.glsl"
void pdnExactHistDone(ivec2 m, ivec2 D, uint par)
{
    // (#1608: texel 0 of view 0 -- once a frame)
    if (any(notEqual(m, ivec2(0))) || CLEAN_VIEW != 0u || !pdnExactOn(D) || !(uint(mv.length()) > MV_HOLD)) return;
    for (uint b = 0u; b < MV_X_BINS; ++b) mv[MV_X_HIST + (par ^ 1u) * MV_X_BINS + b] = 0u;
    // (no valid last frame: SELECT did not read; what this parity held before this frame's counts is stale -- dropped
    //  with them, the next frame admits everything once)
    if (!pdnMoverCdValid())
        for (uint b = 0u; b < MV_X_BINS; ++b) mv[MV_X_HIST + par * MV_X_BINS + b] = 0u;
}
#endif
#if CLEAN_SHADOW_STAGE == SH_STAGE_SELECT
// ---- (RenderVKShadowMoverMask 2) THE MOVER-EXACT SELECTION: the mover bounds (LLCleanRTVK's mover buffer, RT set binding
//      17) and THE SHARED MOVER CULL -- the RT shadow mask's own bodies (clean_rt_movers.glsl MV_CULL_BODIES: one body,
//      no copy); its subgroup counts go to header words 28 / 29 ----
layout(std430, set = RT_SET, binding = 17) coherent buffer MoverBuf { uint mv[]; };
#define MV_CULL_STAT 28u
#define MV_CULL_BODIES
#include "clean_rt_movers.glsl"
// header words of the mover-exact selection (clean_rt_movers.glsl; the VKMoverShadow line): [24] texels exact by a light
// segment, [25] ... held by the mover countdown alone, [26] exact jobs (rays), [27] texels that wanted the exact list
// but found it full (stochastic this frame), [28] / [29] SELECT's cull subgroups / with a candidate (mvCullBuild),
// [30] / [31] WHICH MOVER (the top mover's count and code / the objects' share, the overflow threshold, the race bit)
#define MV_X_SEG   24u
#define MV_X_CD    25u
#define MV_X_JOBS  26u
#define MV_X_OVF   27u
#define MV_X_WHO   30u
// THE EXACT TEXEL'S LIGHT WALK -- ONE function, SELECT's three walks (the reach, the segment test, the jobs; VIS and
// SHADE read the jobs it wrote): every light of pass 15's set that reaches P (pdnTargetL > 0: range + attenuation, the
// projector's frustum, N.l; not taken over by its own emitting faces), in the pixel cluster's fixed order -- the whole
// light table where the cluster overflowed (clusterWalkAll): exactly the past-grid candidate walk's set (rsInSet + the
// ray-traced records). Bounded by the light table (256); no budget, no cap.
struct PdnExWalk { uint c, n, count; bool cAll, rsExt; };
PdnExWalk pdnExactWalkBegin(vec3 P, uint count)
{
    PdnExWalk w;
    w.c = mainClusterFrag(P);
    const uint craw = cluster_count[w.c];
    w.rsExt = rsFrameOn();
    w.cAll = w.rsExt ? clusterWalkAll(craw) : clusterShadowedWalkAll(craw);
    w.count = min(min(count, uint(lights.length())), 256u);
    w.n = w.cAll ? w.count : (w.rsExt ? clusterLen(craw) : clusterShadowedLen(craw));
    return w;
}
uint pdnExactNext(PdnExWalk w, vec3 P, vec3 N, inout uint cur)
{
    while (cur < w.n)
    {
        const uint i = cur++;
        const uint li = w.cAll ? i : cluster_index[w.c * CLUSTER_CAP + i];
        if (li >= w.count || (w.rsExt && emTaken(li))) continue;
        if (pdnTargetL(li, P, N, w.rsExt && rsInSet(li)) > 0.0) return li;
    }
    return 0xFFFFFFFFu;
}
// the point a light's rays aim at, and the disc they sample (the cull grows the segment by it: a penumbra blocker kept)
vec3 pdnLightAim(uint li) { return lights[li].proj_origin.w > 0.5 ? lights[li].proj_origin.xyz : lights[li].pos_radius.xyz; }
// (the own-fixture rule's box limit for light li's rays, VIS's rt_fix_max: point lights take it -- pdnProjSample's
//  SH_FIXTURE -- projectors do not; mvOwnFixture passes over the light's own moving shade / flame)
float pdnExactFixMax(uint li) { return lights[li].proj_origin.w < 0.5 ? rg.rs_params.y : 0.0; }
float pdnExactDisc(uint li) { return max(pdnSampleDisc(li), mvLightRadius(lights[li])); }
// Texel m (receiver P, shading normal N) -- every surface lane of the subgroup calls this (the cull is cooperative):
// MOVER-EXACT when a light reaching it has a mover candidate on its segment (mvSegHitFirst: the sphere AND the avatar's
// joint clusters / attachment box, grown by the disc; the tile's candidates, every mover past MV_CAND) -- GEOMETRY ONLY,
// never this frame's visibility -- or its mover countdown (last frame's MOT w at the reprojected texel, motion vectors
// for a moving surface) still runs. Then, admitted by THE OVERFLOW RULE (par: the GEOM parity -- its demand histogram's),
// it reserves one job per light reaching it (all or none) and writes them. exN / exBase: its jobs (0: stochastic);
// prevCd: the countdown it read (every texel carries it on: pdn_sel gate word bits 28-31).
bool pdnMoverExactPlan(ivec2 m, ivec2 D, ivec2 rp, vec3 P, vec3 N, uint count, uint par, out uint exN, out uint exBase,
                       out uint prevCd)
{
    exN = 0u; exBase = 0u; prevCd = 0u;
    if (pdnMoverCdValid())
    {
        float pw;
        vec2 dS = pdnPrevDelta(P, m, vec2(D), pw);
#ifdef REUSE_MV_BOUND
        reuseMotionDelta(m, rp, vec2(D), pw, dS);   // (a moving surface -- an avatar's skin -- carries its countdown)
#endif
        const ivec2 q = ivec2(floor(vec2(m) + dS + 0.5));
        if (pw > 0.0 && all(greaterThanEqual(q, ivec2(0))) && all(lessThan(q, D)))
            prevCd = pdnMotMoverCd(imageLoad(uPdnMot, PDN_MOT(q)).w);
    }
    // (1) the lights and the reach (the farthest light + its disc: no mover farther away lies on a segment)
    const PdnExWalk w = pdnExactWalkBegin(P, count);
    float reach = 0.0;
    uint n = 0u, cur = 0u;
    [[dont_unroll]] for (uint i = 0u; i < 256u; ++i)
    {
        const uint li = pdnExactNext(w, P, N, cur);
        if (li == 0xFFFFFFFFu) break;
        ++n;
        reach = max(reach, length(pdnLightAim(li) - P) + pdnExactDisc(li));
    }
    // (2) the cull: the subgroup's candidate movers, then this texel's segments
    mvCullBuild(P, vec3(0.0, 0.0, 1.0), false, 0.0, reach > 0.0, reach);
    bool seg = false;
    uint segLi = 0xFFFFFFFFu, segM = MV_SEG_NONE;
    if (n > 0u && (g_mv_nloc > 0u || g_mv_loc_all))
    {
        cur = 0u;
        [[dont_unroll]] for (uint i = 0u; i < 256u; ++i)
        {
            const uint li = pdnExactNext(w, P, N, cur);
            if (li == 0xFFFFFFFFu) break;
            g_mv_fix_max = pdnExactFixMax(li);
            segM = mvSegHitFirst(P, pdnLightAim(li), pdnExactDisc(li));
            if (segM != MV_SEG_NONE) { seg = true; segLi = li; break; }
        }
    }
    const bool want = n > 0u && (seg || prevCd > 0u);
    // (3) THE OVERFLOW RULE (2026-11-14). The list holds cap jobs; which wanting texels get them must not depend on the
    // order the subgroups reach the atomic (that gave the owner's frame-varying staircase of blocks, the top rows of the
    // screen exact, the floor under the avatar -- the real shadows -- left over). So every wanting texel has a PRIORITY
    // bin, its distance to the mover its segment met in MV_X_BIN_M steps (a texel held by the countdown alone: bin 0),
    // and is admitted when its bin is <= the frame's THRESHOLD: the largest bin whose cumulative demand (jobs) LAST frame
    // fit 7/8 of the list (MV_X_HIST, parity par ^ 1; everything while last frame's demand fit, or without a valid last
    // frame). The admitted set is a distance contour around the movers -- deterministic, smooth, nearest first; this
    // frame's demand by bin goes to MV_X_HIST (parity par) for the next frame. Only a demand jump of more than 1/8 of
    // the list in one frame can still overflow it: those texels stay stochastic (all casters, normal history), counted
    // (header word 31 bit 28).
    const bool mvBuf = uint(mv.length()) > MV_HOLD;
    uint bin = 0u;
    if (seg && segM < MV_SEG_LIST)
        bin = min(uint(length(P - mvSphere(segM).xyz) / MV_X_BIN_M), MV_X_BINS - 1u);
    const uint XB = pdnExactBase(D), cap = pdnExactCap(D);
    uint thr = MV_X_BINS - 1u;
    if (mvBuf && pdnMoverCdValid())
    {
        const uint hb = MV_X_HIST + (par ^ 1u) * MV_X_BINS, budget = cap - cap / 8u;
        uint acc = 0u;
        [[dont_unroll]] for (uint b = 0u; b < MV_X_BINS; ++b)
        {
            acc += mv[hb + b];
            if (acc > budget) { thr = b == 0u ? 0u : b - 1u; break; }
        }
    }
    if (mvBuf)   // (this frame's demand by bin: one reduction per bin, one atomic per subgroup and bin)
    {
        [[dont_unroll]] for (uint b = 0u; b < MV_X_BINS; ++b)
        {
            const uint sb = subgroupAdd(want && bin == b ? n : 0u);
            if (subgroupElect() && sb != 0u) atomicAdd(mv[MV_X_HIST + par * MV_X_BINS + b], sb);
        }
    }
    const bool admit = want && bin <= thr;
    // the reservation: one atomic per subgroup, a texel all of its jobs or none
    const uint nJ = admit ? n : 0u;
    const uint ex = subgroupExclusiveAdd(nJ), tot = subgroupAdd(nJ);
    uint jb = 0u;
    if (subgroupElect() && tot != 0u)
    {
        jb = atomicAdd(pdn_vis[XB], tot);
        const uint lo = min(jb, cap), hi = min(jb + tot, cap);
        const uint g = (hi + 63u) / 64u - (lo + 63u) / 64u;   // (the dispatch covers the list, never past it)
        if (g != 0u) atomicAdd(pdn_vis[XB + 1u], g);
    }
    jb = subgroupBroadcastFirst(jb) + ex;
    const bool fits = admit && jb <= cap && n <= cap - jb;
    const uint tex = pdnTexel(m, D);   // (#1608: view-inclusive -- VIS recovers the view)
    if (fits)
    {
        cur = 0u;
        [[dont_unroll]] for (uint k = 0u; k < n; ++k)
        {
            const uint li = pdnExactNext(w, P, N, cur);
            if (li == 0xFFFFFFFFu) break;   // (never: the same walk)
            pdn_vis[pdnExactJob(D, jb + k)] = (tex << 8u) | li;
        }
        exN = n; exBase = jb;
    }
    else if (admit && jb < cap)
    {   // (the run that crossed the cap: its slots below it are in VIS's dispatch -- marked, never traced)
        [[dont_unroll]] for (uint k = 0u; k < cap - jb; ++k) pdn_vis[pdnExactJob(D, jb + k)] = PDN_EXACT_GAP;
    }
    // stats (the VKMoverShadow line; only with the mover buffer bound -- never into the dummy)
    if (mvBuf)
    {
        const uint sS = subgroupAdd(fits && seg ? 1u : 0u), sC = subgroupAdd(fits && !seg ? 1u : 0u);
        const uint sJ = subgroupAdd(fits ? n : 0u), sO = subgroupAdd(want && !fits ? 1u : 0u);
        const bool raced = subgroupAny(admit && !fits);
        if (subgroupElect())
        {
            if (sS != 0u) atomicAdd(mv[MV_X_SEG], sS);
            if (sC != 0u) atomicAdd(mv[MV_X_CD], sC);
            if (sJ != 0u) atomicAdd(mv[MV_X_JOBS], sJ);
            if (sO != 0u) atomicAdd(mv[MV_X_OVF], sO);
            atomicOr(mv[MV_X_WHO + 1u], (thr << 24u) | (raced ? 0x10000000u : 0u));
        }
        // WHICH MOVER: the texels that went exact by a segment, per the mover their first hit segment met (MV_HIT; one
        // reduction per distinct mover of the subgroup), the top one in word 30, the objects' share in word 31
        uint code = fits && seg && segM < MV_SEG_LIST ? mvMoverCode(segM) : MV_SEG_NONE;
        [[dont_unroll]] for (uint it = 0u; it < 64u; ++it)
        {
            if (!subgroupAny(code != MV_SEG_NONE)) break;
            const uint c0 = subgroupMin(code);
            const uint cnt = subgroupAdd(code == c0 ? 1u : 0u);
            if (subgroupElect())
            {
                const uint tot0 = atomicAdd(mv[MV_HIT + c0], cnt) + cnt;
                atomicMax(mv[MV_X_WHO], (min(tot0, 0x1FFFFFu) << 11u) | c0);
                if (c0 >= MV_AV_CAP) atomicAdd(mv[MV_X_WHO + 1u], cnt);
            }
            if (code == c0) code = MV_SEG_NONE;
        }
    }
    // (RenderVKMoverProbePixel) the probed texel: why it is exact or not, light by light -- which light's segment meets
    // which mover (instrumentation only: the selection above is final)
    if (pdnProbeAt(m, D))
    {
        pdnProbePut(0u, 1u | (fits ? 2u : 0u) | (seg ? 4u : 0u) | (prevCd > 0u ? 8u : 0u) | (want && !fits ? 16u : 0u)
                        | (g_mv_loc_all ? 32u : 0u) | (uint(mv.length()) > MV_HOLD && mv[2] != 0u ? 64u : 0u)
                        | (min(prevCd, 15u) << 8u) | (min(n, 511u) << 16u));
        pdnProbePut(1u, uint(m.x) | (uint(m.y) << 16u));
        pdnProbePut(2u, segLi == 0xFFFFFFFFu ? 0u : segLi + 1u);
        pdnProbePut(3u, g_mv_nloc | (g_mv_loc_all ? 0x80000000u : 0u));
        pdnProbePutF(4u, reach);
        pdnProbePut(5u, jb);
        cur = 0u;
        const uint nm = mvAvCount() + mvObjCount();
        [[dont_unroll]] for (uint q = 0u; q < min(n, RTP_X_LIGHTS); ++q)
        {
            const uint li = pdnExactNext(w, P, N, cur);
            if (li == 0xFFFFFFFFu) break;
            const vec3 X = pdnLightAim(li);
            const float rl = pdnExactDisc(li);
            g_mv_fix_max = pdnExactFixMax(li);
            const bool hit = mvSegHitAny(P, X, rl);
            uint which = 0x7FFFu;   // (the first mover of the frame's list whose sphere AND box meet the segment)
            for (uint mi = 0u; hit && mi < nm; ++mi)
            {
                const vec4 sp = mvSphere(mi);
                if (sp.w > 0.0 && !mvOwnFixture(mi, sp, X) && mvSegHit(P, X, sp.xyz, sp.w + rl) && mvBoxSeg(mi, P, X, rl)) { which = min(mi, 0x7FFEu); break; }
            }
            pdnProbePut(RTP_X_L + RTP_X_LW * q, (li + 1u) | (hit ? 0x10000u : 0u) | (which << 17u));
        }
    }
    return fits;
}
#endif

// THE MOVER REPORT's light key for light li (0 = not reported): RenderVKShadowFixLightTag bit 0 (fwd.z LIGHT_TAG_REPORT)
// the light's TAG (clean_pdn_common.glsl pdnMotReportTag: stable across the per-frame importance re-sort), else
// light index + 1 for li < 255 (the index-keyed report: a reorder renames the record's light)
uint deferMotReportKey(uint li)
{
    if ((linfo.fwd.z & LIGHT_TAG_REPORT) != 0u)
        return li < uint(lights.length()) ? pdnMotReportTag(lights[li].tex.w & 0xFFFFu) : 0u;
    return li < 255u ? li + 1u : 0u;
}

#if CLEAN_SHADOW_STAGE == SH_STAGE_SELECT && defined(PDN_HIGH_K)
// ---- (2026-11-15, RenderVKProjStochasticSamples / RenderVKProjStochasticAdaptiveSamples 5-16) THE HIGH-K SELECT
//      (its own variant: the K <= 4 SELECT keeps its registers and no shared memory). Streams 4..K-1 of the same
//      streaming reservoirs as picks 0-3 (the next K - 4 draws of the candidate's seed, in stream order: K <= 4 draws
//      exactly as before) and the exact list's candidates 5..16, per lane in shared memory (one lane's slots, no
//      barrier), packed into the second extension (pdnSelE2Word's layout) before the gate loop. 9 KB per 64 lanes. ----
shared uint  s_hkLi[64u * PDN_SEL_E2_N];   // stream k's pick
shared float s_hkP[64u * PDN_SEL_E2_N];    // ... its target
shared uint  s_hkX[64u * PDN_SEL_E2_N];    // exact candidate k: light | run index << 16
uint pdnHkLane() { return gl_LocalInvocationIndex * PDN_SEL_E2_N; }
void pdnHkInit()
{
    const uint L = pdnHkLane();
    for (uint k = 0u; k < PDN_SEL_E2_N; ++k) { s_hkLi[L + k] = 0xFFFFFFFFu; s_hkP[L + k] = 0.0; s_hkX[L + k] = 0xFFFFFFFFu; }
}
void pdnHkStreams(inout uint seed, uint K, float Wsum, float w, uint li, float p)
{
    const uint L = pdnHkLane();
    for (uint k = 4u; k < K; ++k)
        if (pdnRand(seed) * Wsum < w) { s_hkLi[L + k - 4u] = li; s_hkP[L + k - 4u] = p; }
}
void pdnHkExact(float nCand, uint li, uint exi)
{
    if (nCand >= 5.0 && nCand <= float(4u + PDN_SEL_E2_N))
        s_hkX[pdnHkLane() + uint(nCand) - 5u] = (li & 0xFFFFu) | (exi << 16u);
}
// The second extension of texel index si (exact: the candidates; else the picks, targets x sc -- radK's Wsum / WsumF)
void pdnHkStore(uint e2, bool exact, float sc)
{
    const uint L = pdnHkLane();
    [[unroll]] for (uint q = 0u; q < PDN_SEL_E2_WORDS / 4u; ++q)
    {
        uvec4 v = uvec4(0u);
        [[unroll]] for (uint c = 0u; c < 4u; ++c)
        {
            const uint w = 4u * q + c;
            uint x = 0u;
            if (exact)
                x = w < PDN_SEL_E2_N ? s_hkX[L + w] : 0u;
            else if (w < PDN_SEL_E2_N / 2u)
            {
                const uint a = s_hkLi[L + 2u * w], b = s_hkLi[L + 2u * w + 1u];
                x = (a == 0xFFFFFFFFu ? 0xFFFFu : (a & 0xFFFFu)) | ((b == 0xFFFFFFFFu ? 0xFFFFu : (b & 0xFFFFu)) << 16u);
            }
            else if (w < PDN_SEL_E2_N / 2u + PDN_SEL_E2_N)
                x = floatBitsToUint(s_hkP[L + w - PDN_SEL_E2_N / 2u] * sc);
            v[c] = x;
        }
        pdn_sel[e2 + q] = v;
    }
}
#define PDN_HK_INIT()                      pdnHkInit()
#define PDN_HK_STREAMS(seed, Wsum, w, li, p) pdnHkStreams(seed, K, Wsum, w, li, p)
#define PDN_HK_EXACT(nCand, li, exi)       pdnHkExact(nCand, li, exi)
#else
#define PDN_HK_INIT()
#define PDN_HK_STREAMS(seed, Wsum, w, li, p)
#define PDN_HK_EXACT(nCand, li, exi)
#endif

void DEFER_MAIN()
{
    g_pdn_view = CLEAN_VIEW_Z;   // (#1608: z = the views; an adaptive extra pass takes its tile's -- pdnAdaptTexel)
    const ivec2 D = ivec2(g_draw_push.rtr.xy + 0.5);
#if CLEAN_SHADOW_STAGE == SH_STAGE_SELECT || CLEAN_SHADOW_STAGE == SH_STAGE_SHADE
    // (RenderVKProjStochasticAdaptive) an adaptive extra pass runs over the MASK's tile list: workgroup i = listed tile i
    ivec2 m = ivec2(gl_GlobalInvocationID.xy);
    if (pdnPassTiles() && !pdnAdaptTexel(D, m)) return;   // (past the listed count: the whole workgroup)
#else
    const ivec2 m = ivec2(gl_GlobalInvocationID.xy);
#endif
    if (any(greaterThanEqual(m, D))) return;
#if CLEAN_SHADOW_STAGE == SH_STAGE_SHADE
    pdnExactHistDone(m, D, (uint(g_draw_push.rtr.w + 0.5) >> 4u) & 1u);   // (texel 0 -- before any early return)
    const uint sdi = pdnSelIndex(m, D);
    const uvec4 sd0 = pdn_sel[sdi];
    if ((sd0.x & PDN_SEL_SURF) == 0u) return;   // (no surface: SELECT stored the empty texel)
#endif
    const uint ctl = uint(g_draw_push.rtr.w + 0.5);
    const uint K = pdnSamplesK(ctl, D);
    const int par = int((ctl >> 4u) & 1u);
    const uint frame = uint(g_draw_push.rtr.z + 0.5);
    const uint opts = pdnOpts();
    const vec2 R2 = vec2(float(g_draw_push.width), float(g_draw_push.height));
    const vec2 r = R2 / vec2(D);   // render px per denoiser texel
    const vec2 J = (ssr.taa_params.w > 0.5 && D.x < int(g_draw_push.width)) ? ssr.taa_jitter.xy : vec2(0.0);
    const ivec2 rp = clamp(ivec2((vec2(m) + 0.5 + J) * r), ivec2(0), ivec2(R2) - 1);
    g_frag_xy = vec2(rp) + 0.5;
    CLK_INV();
    const vec4 g2 = defTexel(uG2, rp);
    bool surf = deferHasSurface(g2);
    float glow;
    bool noFade;
    SurfaceLit s;
    if (surf)
    {
        s = deferSurface(rp, g2, glow, noFade);
        surf = s.model != SURF_FULLBRIGHT;
    }
    if (!surf)
    {
#if CLEAN_SHADOW_STAGE == SH_STAGE_SELECT
        // (an extra pass: the empty texel's images are pass 0's -- only the descriptor, so VIS / SHADE skip it)
        if (pdnPassIdx() != 0u) { pdn_sel[pdnSelIndex(m, D)] = uvec4(0u); return; }
#endif
#if CLEAN_SHADOW_STAGE != SH_STAGE_SHADE   // (SHADE: never -- SELECT stored the empty texel)
        imageStore(uPdnIn, ivec3(m, PDN_L(0)), vec4(0.0));
        imageStore(uPdnIn, ivec3(m, PDN_L(1)), vec4(0.0));
#if DEFER_SHADOW_MERGE
        if ((opts & PDN_OPT_SUN_SKIP) == 0u)
            imageStore(uPdnIn, ivec3(m, PDN_L(2)), vec4(1.0, 1.0, 1.0, -1.0));   // (sun: lit, no caster)
#endif
        imageStore(uPdnGeom, ivec3(m, PDN_L(par)), uvec4(floatBitsToUint(-1.0), 0u, 0u, 0u));
        imageStore(uPdnMot, PDN_MOT(m), uvec4(0u));
        if (pdnExactSpecular()) imageStore(uPdnIn, ivec3(m, PDN_L(PDN_LAYERS(uPdnIn) - 1)), vec4(0.0));
        if (PDN_LAYERS(uPdnGeom) >= PDN_SPLIT_GEOM_LAYERS)   // (#869: no split light here)
            imageStore(uPdnGeom, ivec3(m, PDN_L(PDN_SPLIT_GEOM_PAR + par)), uvec4(0u));
#if CLEAN_SHADOW_STAGE == SH_STAGE_SELECT
        pdn_sel[pdnSelIndex(m, D)] = uvec4(0u);   // (TRACE skips it)
#endif
#endif
        return;
    }
    CLK_SURF();
    const vec3 P = deferPosition(rp);
    const vec3 V = linfo.cam_fwd.w > 0.5 ? -linfo.cam_fwd.xyz : normalize(pc.u_cam_time.xyz - P);
    const vec3 Ng = dot(s.Ng, V) < 0.0 ? -s.Ng : s.Ng;
    GIR_PREC const float vz = dot(P - linfo.cam_pos.xyz, linfo.cam_fwd.xyz);
    // The LOCAL pass's own localLights inputs (lightSurface's common tail).
    s.cel = s.cel && specCelOn();
    g_cel = s.cel;
    const bool pbr = s.model == SURF_PBR;
    LegacySpec ls = legacySpecNone();
    float metal = 0.0, rough = 1.0;
    if (pbr) { metal = s.metal; rough = s.rough; }
    else { ls.spec = s.spec; ls.gloss = s.gloss; ls.env = s.env; }
    const vec3 base = s.albedo;
    const vec3 diffuseColor  = base * (1.0 - 0.04) * (1.0 - metal);
    const vec3 specularColor = mix(vec3(0.04), base, metal);
    const float specRough = pbr ? rough : clamp(1.0 - ls.gloss, 0.0, 1.0);   // (dsSpecRough)
    // (RADIANCE MODE, pdnRadOn: SHADE / the fused kernel store num alone, demodulated by these)
    const bool radOn = pdnRadOn();
    const vec3 radDf = pdnRadDiff(pbr, base, diffuseColor), radSf = pdnRadSpec(pbr, specularColor, ls);
    CLK_MARK(GBUF);

    // ---- THE RECEIVER (light-independent, once per texel): position, visible-side normal,
    //      pixel footprint, view-slope offset; the self-shadow owner, the noise phase ----
    const vec3 cam = CL_VIEW_EYE(linfo, P, pc.u_cam_time.xyz);
    const float time = pc.u_cam_time.w;
    const float dR = defTexel(uDepthG, rp).r;
#if CLEAN_SHADOW_STAGE == SH_STAGE_FUSED   // (#1031: the walks' receiver -- VIS / SUNVIS build their own)
    ShadowRecv Rv;
    // the FACET normal (pdnFacetNormal: the mask's receiver normal, not the G-buffer's smooth
    // vertex normal) -- every light's receiver rules (shadowRecvLight: the terminator band /
    // probe, the facing measure from the probe's smooth normal) are the mask's on it
    bool ngOnPlane;
    const vec3 Nf = pdnFacetNormal(rp, P, cam, Ng, ngOnPlane);
    Rv.P = P; Rv.Ng = Nf; Rv.cam = cam; Rv.rp = rp;
    Rv.pxw = max(length(pdnWorldAt(vec2(rp) + 0.5 + vec2(1.0, 0.0), dR) - P), 1e-6);
    {
        const vec3 Vc = P - cam;
        const float vcl = length(Vc);
        Rv.slope = vcl > 1e-4 ? g_draw_push.rtr2.y * Rv.pxw * length(cross(Nf, Vc / vcl)) : 0.0;
    }
    rtSelfBegin(P);
    rt_noise_shift = fract(float(frame) * vec2(0.7548776662, 0.5698402910));
    rt_vis_hint = -1.0;
#endif
    const bool gate = (opts & PDN_OPT_FACING) != 0u;
    const bool infoFix = (opts & PDN_OPT_BLEED) != 0u;

    // RATIO ESTIMATOR (Heitz et al. 2018): the same picks estimate the SHADOWED (num) and the
    // UNSHADOWED (den) projector light with the same weights; their per-channel ratio is the
    // pixel's visibility -- what the denoiser filters. No candidate: visibility 1.
    vec3 numD = vec3(0.0), denD = vec3(0.0), numS = vec3(0.0), denS = vec3(0.0);
    // (radiance) the caster-change EVIDENCE (MOT w): the diffuse sums over the spatially independent
    // samples only (pdnEvidenceWeight) -- the denoiser's 3x3 test treats its texels as independent
    vec3 evN = vec3(0.0), evD = vec3(0.0);
    float Wsum = 0.0, W0 = 0.0, nCand = 0.0, hitSum = 0.0, hitW = 0.0;
    const uint count = uint(linfo.cam_pos.w);
    const bool projOn = count > 0u && !litDbg(LDBG_NO_LOCAL);
    // (#869) THE SPLIT (pdnSplitSelect above; clean_pdn_common.glsl SPLIT CHANNEL): this texel's K
    // strongest lights each get their own sample below (one ray, their own visibility); the RATIO
    // ESTIMATOR that follows -- candidates, reused reservoirs, the dense evaluation, num and den --
    // runs over the REST (every check pdnSplitHas). The images without the split layers: K = 0.
    const bool spLayers = PDN_LAYERS(uPdnGeom) >= PDN_SPLIT_GEOM_LAYERS;   // (uniform)
    const uint spK = spLayers && projOn ? (pdnExactSpecular() ? (!s.cel && pdnGlossySpecular(pbr, rough, ls) ? 1u : 0u)
                                  : min(g_draw_push.rtr3.z & 7u, PDN_SPLIT_MAX)) : 0u;
    uvec4 spLi = uvec4(0xFFFFFFFFu), spId = uvec4(0u);
    uint spN = 0u;
    vec3 exactSpecular = vec3(0.0);
    vec4 spV = vec4(-1.0);   // the samples' visibility (< 0: no information)
    bvec4 spMv = bvec4(false);
    // (#869 OCCLUSION CULL, the block above DEFER_MAIN's helpers) P's cell and its culled list (fixed for
    // the frame: the resolve ran before this pass); this texel's notes go to the same cell
    const bool ocOn = projOn && occFrameOn();   // (uniform)
    uint ocTag = 0u, ocSlot0 = 0u, ocCell = OCC_NONE;
    uint ocCull = OCC_NONE;   // (the patch while it culls anything: the tests' handle)
    uint ocRefused = 0u;
#if CLEAN_SHADOW_STAGE == SH_STAGE_SELECT
    if (ocOn && !occStatsOnly())   // (LVC stage 0: statistics only -- SELECT never culls, only SHADE notes)
#else
    if (ocOn)
#endif
    {
        ocTag = occKeyTexel(P, s.N, m, frame, ocSlot0);   // (#1052: jittered under the soft cull; sets g_occ_u)
        ocCell = occFind(ocTag, ocSlot0);
        if (occAny(ocCell) && occCullOn()) ocCull = ocCell;
    }
    uint ocProbe = 0xFFFFFFFFu;
#if CLEAN_SHADOW_STAGE != SH_STAGE_SHADE
    // ==== THE SELECTION (#1031: SELECT's whole job; the fused kernel's too) ====
    // (the probe pick: a uniform reservoir over every culled light that reaches P -- the split walk's
    //  cluster list, then the grid window's slots: the cluster list is capped at CLUSTER_CAP, and with a
    //  hundred projectors a culled light may only be met in the grid, the list that culled it)
    uint pseed = pdnPcg(uint(m.x) * 6833u + uint(m.y) * 2909u + frame * 4241u + 5u);
    float nProbe = 0.0;
    if (spK > 0u || ocCull != OCC_NONE)
    {
        // last frame's split ids at the reprojected texel (the hysteresis)
        uvec2 prevIds = uvec2(0u);
        if (!pdnExactSpecular() && (g_draw_push.rtr3.z & 8u) != 0u)
        {
            float ppw;
            const vec2 pd = pdnPrevDelta(P, m, vec2(D), ppw);
            const ivec2 pq = ivec2(floor(vec2(m) + pd + 0.5));
            if (ppw > 0.0 && all(greaterThanEqual(pq, ivec2(0))) && all(lessThan(pq, D)))
                prevIds = imageLoad(uPdnGeom, ivec3(pq, PDN_L(PDN_SPLIT_GEOM_PAR + (par ^ 1)))).xy;
        }
        // (the extended set is the lighting set's wherever the frame is a ReSTIR frame -- deferRsStoch;
        //  no longer only inside the light grid: past it point lights lost their shadows)
        const bool spGrid = rsFrameOn();
        spN = pdnSplitSelect(P, s.N, spK, spGrid, prevIds, ocCull, pseed, spLi, spId, ocProbe, nProbe, V, pbr, base, diffuseColor, specularColor, rough, ls);
    }
    // (#869) THE MOVING-LIGHT RULE (clean_regir.glsl RS_MOVE_*): Wmov = the candidates' target of
    // lights that moved since last frame (their share of Wsum: MOT w, the denoiser's history cap)
    const bool mvOn = rsFrameOn() && rsMoveOn();   // (uniform)
    float Wmov = 0.0;
    // (#869 rsFlick) Wflk = the candidates' weight of lights whose RADIANCE changed this frame
    // (without moving), wMax the largest single candidate weight: the flickering-light rule
    float Wflk = 0.0, wMax = 0.0;
    // the K reservoirs' picks, and the first two candidates in cluster order with their run
    // index (the exact mode's list: no second pdnTarget pass) -- named scalars, no arrays
    // (RenderVKProjStochasticSamples 3-4: picks 2-3 and the 3rd / 4th candidate -- the descriptor's extension)
    uint pick0 = 0xFFFFFFFFu, pick1 = 0xFFFFFFFFu, pick2 = 0xFFFFFFFFu, pick3 = 0xFFFFFFFFu;
    float pp0 = 0.0, pp1 = 0.0, pp2 = 0.0, pp3 = 0.0;
    uint ex0 = 0xFFFFFFFFu, ex1 = 0xFFFFFFFFu, exi0 = 0u, exi1 = 0u;
    uint ex2 = 0xFFFFFFFFu, ex3 = 0xFFFFFFFFu, exi2 = 0u, exi3 = 0u;
    // (K > 4: the high-K SELECT's streams 4..K-1 and candidates 5..16 -- shared memory, pdnHkStreams / pdnHkExact)
    const uint K4 = min(K, 4u);
    PDN_HK_INIT();
    // (#869 Phase 5a) ReSTIR DI CANDIDATES (the frame info's rsFrameOn): at a P
    // inside the light grid the candidates are its cell's population-1 slots (clean_regir.glsl) --
    // every light of pass 15's set that can reach the cell has q > 0 there, so the candidate set
    // still equals the lighting set; past the grid, the cluster walk below (the whole set too, from
    // the pixel cluster's full list -- the lit kernels give the extended set the ratio everywhere on a
    // ReSTIR frame, deferRsStoch).
    //   * an EXACT cell (its whole list fits the slots) with every slot taken: the cluster walk's
    //     exact RIS on a tighter list (<= K candidates at P: no noise at all);
    //   * else RIS over a window of the slots (rs_cfg.y of them, a random start; 0 = all):
    //     w = p(x) x (1 / q(x)) / window, the pick's weight W / p as before -- unbiased.
    //   * the denoiser's light-set reference W0 = the cell's target sum (deterministic: it moves
    //     only when the cell's lights change -- never with the window's noise).
    bool exactOk = true;
    uint rsCell = REGIR_NO_CELL;
    // (LVC stage 3, RenderVKShadowReachMap 1; radiance mode) a light the reach map calls STATICALLY BLOCKED at P leaves
    // P's candidates -- the window walk (exact lists included), the cluster walk, the reused reservoirs (rsTap): its
    // contribution here is exactly 0, so no ray is spent on it. W0 (the denoiser's light-set reference) is untouched.
    const bool lvcSkip = lvcSkipOn() && pdnRadOn();   // (uniform)
    // (stage 2, RenderVKShadowReachMap 3: SOFT) such a light stays a candidate at its target x the floor -- the RIS picks
    // move to the lights that reach P, and a wrong map costs variance, never light
    const bool lvcSoft = lvcSkip && (rg.rs_cfg.z & RS_F_LVC_SOFT) != 0u;
    const float lvcFloor = rg.rs_em_params2.z > 0.0 ? rg.rs_em_params2.z : 0.15;
    float lvcW = 1.0;
    uint lvcSkips = 0u;
    // (#869 RS_MOVE_LIGHTS) the window this texel's grid candidates came from (the dense evaluation
    // below re-reads its slots): cell word, start slot, slots, window length, the window's scale
    uint dCw = 0u, dStart = 0u, dSlots = 0u, dWin = 0u;
    float dScale = 0.0;
    // (#91) EMITTERS (clean_regir.glsl EMISSIVE LIGHTS): the cell's population-2 emitters join the same
    // candidate stream (keys REGIR_EM_KEY + slot); pickE / ppE / WsumE: an emitter-only reservoir over
    // the same candidates (the dense evaluation's emitter stratum), nEm their count
    const bool emOn = rsFrameOn() && emLitOn() && !litDbg(LDBG_NO_LOCAL);   // (uniform)
    uint pickE = 0xFFFFFFFFu, nEm = 0u, emRays = 0u;
    float ppE = 0.0, WsumE = 0.0;
    // Conditional proposal: pick ONE cell, then use THAT cell's header, stored
    // q-weights, exact/window normalization and the target at the original P.
    const uint emitterCell = emOn ? regirCell(P) : REGIR_NO_CELL;
    if ((projOn || emOn) && rsFrameOn()) rsCell = rsPrimaryLookupCell(P, Ng, rp, frame);
    if (rsCell != REGIR_NO_CELL)
    {
        rt_fix_max = rg.rs_params.y;
        const uint cw = rsCellWord(rsCell);
        const uvec2 h = rg_cells[cw];
        const uint Mc = h.x & REGIR_COUNT_MASK;
        const bool cellExact = (h.x & REGIR_CELL_EXACT) != 0u;
        const uint nSlots = cellExact ? min(Mc, rsSlots()) : rsSlots();
        if (Mc > 0u && nSlots > 0u)
        {
            uint seed = pdnPcg(uint(m.x) * 1973u + uint(m.y) * 9277u + frame * 26699u);
            const uint want = rg.rs_cfg.y;
            const uint nWin = want == 0u ? nSlots : min(want, nSlots);
            const uint start = nWin < nSlots ? min(uint(pdnRand(seed) * float(nSlots)), nSlots - 1u) : 0u;
            const float scale = (cellExact ? float(nSlots) : 1.0) / float(nWin);
            exactOk = cellExact && nWin == nSlots;
            dCw = cw; dStart = start; dSlots = nSlots; dWin = nWin; dScale = scale;
            W0 = uintBitsToFloat(h.y);
            [[dont_unroll]] for (uint i = 0u; i < nWin; ++i)
            {
                const uint j = rsWinSlot(start, i, nWin, nSlots);   // (RS_F_STRIDE: evenly spaced)
                const uvec2 sl = rg_cells[cw + 1u + j];
                const uint li = sl.x;
                if (li >= count || pdnRestHas(spLi, li)) continue;   // (#869: the rest only)
                lvcW = 1.0;
                if (lvcSkip && lvcBlocked(li, P)) { ++lvcSkips; if (!lvcSoft) continue; lvcW = lvcFloor; }   // (LVC stage 3 / 2)
                if (occCulled(ocCull, li))
                {   // (#869 OCCLUSION CULL) culled here: out of the rest -- a probe candidate if it reaches P
                    if (pdnTargetL(li, P, s.N, true) > 0.0)
                    {
                        nProbe += 1.0;
                        if (pdnRand(pseed) * nProbe < 1.0) ocProbe = li;
                    }
                    continue;
                }
                float p0;
                const float p = pdnTargetGoboL(li, P, s.N, true, p0) * lvcW;
                if (!(p > 0.0)) continue;
                const float w = p * uintBitsToFloat(sl.y) * scale;
                if (!(w > 0.0) || !(w < 3.0e38)) continue;
                Wsum += w;
                if (mvOn && rsMoved(li)) Wmov += w;
                if (mvOn && rsFlick(li)) Wflk += w;
                wMax = max(wMax, w);
                nCand += 1.0;
                if (nCand == 1.0) { ex0 = li; exi0 = j; }
                else if (nCand == 2.0) { ex1 = li; exi1 = j; }
                else if (nCand == 3.0) { ex2 = li; exi2 = j; }
                else if (nCand == 4.0) { ex3 = li; exi3 = j; }
                else PDN_HK_EXACT(nCand, li, j);
                for (uint k = 0u; k < K4; ++k)
                    if (pdnRand(seed) * Wsum < w)
                    {
                        if (k == 0u)      { pick0 = li; pp0 = p; }
                        else if (k == 1u) { pick1 = li; pp1 = p; }
                        else if (k == 2u) { pick2 = li; pp2 = p; }
                        else              { pick3 = li; pp3 = p; }
                    }
                PDN_HK_STREAMS(seed, Wsum, w, li, p);
            }
            if (!(W0 > 0.0)) W0 = Wsum;   // (a degenerate header: never 0 with candidates)
            if ((rg.rs_cfg.z & RS_F_WCUT) == 0u) W0 = 1.0;   // (no light-set cut: see RS_F_WCUT)
        }
        // (#91) THE CELL'S EMITTING TRIANGLES (population 2): every filled slot (<= R_e <= 8: no window),
        // weight p x the slot's 1 / q -- 1 in an exact cell and for its strongest triangles, the stratified
        // rest's W_rest / (p_cell R_s) -- in the SAME streaming reservoirs as the lights (one RIS over lights
        // + triangles: unbiased for both, the lit kernels add exactly this cell's slots), + the
        // emitter-only reservoir. (#1006 WEAK OVERLAY, clean_regir.glsl) at a point of level 0 the overlay cell
        // holding P adds the weak emitters' slots (level 0's cell never lists them; the two sets are disjoint)
        if (emOn)
        {
            const uint ovCell = (emitterCell < REGIR_CELLS_PER_LEVEL && emOvLive()) ? emOvCell(P) : REGIR_NO_CELL;
            uint seed = pdnPcg(uint(m.x) * 4513u + uint(m.y) * 7411u + frame * 30011u);
            [[dont_unroll]] for (uint ec = 0u; ec < 2u; ++ec)
            {
                const uint eCell = ec == 0u ? emitterCell : ovCell;
                if (eCell == REGIR_NO_CELL) break;
                const uint ecw = emCellWord(eCell);
                const uvec2 eh = rg_cells[ecw];
                const uint ne = min(eh.x & REGIR_COUNT_MASK, REGIR_EM_SLOTS_MAX);
                if (ne > 0u)
                {
                    const bool eEx = (eh.x & REGIR_CELL_EXACT) != 0u;
                    if (!eEx) exactOk = false;
                    const uint ecnt = emCount();
                    [[dont_unroll]] for (uint j = 0u; j < ne; ++j)
                    {
                        const uvec2 sl = rg_cells[ecw + 1u + j];
                        if (sl.x >= ecnt) continue;
                        const float p = rsEmTarget(sl.x, P, s.N);
                        if (!(p > 0.0)) continue;
                        const float w = p * uintBitsToFloat(sl.y);
                        if (!(w > 0.0) || !(w < 3.0e38)) continue;
                        const uint li = REGIR_EM_KEY + sl.x;
                        Wsum += w;
                        wMax = max(wMax, w);
                        nCand += 1.0;
                        ++nEm;
                        if (nCand == 1.0) { ex0 = li; exi0 = 32u + ec * 8u + j; }
                        else if (nCand == 2.0) { ex1 = li; exi1 = 32u + ec * 8u + j; }
                        else if (nCand == 3.0) { ex2 = li; exi2 = 32u + ec * 8u + j; }
                        else if (nCand == 4.0) { ex3 = li; exi3 = 32u + ec * 8u + j; }
                        else PDN_HK_EXACT(nCand, li, 32u + ec * 8u + j);
                        for (uint k = 0u; k < K4; ++k)
                            if (pdnRand(seed) * Wsum < w)
                            {
                                if (k == 0u)      { pick0 = li; pp0 = p; }
                                else if (k == 1u) { pick1 = li; pp1 = p; }
                                else if (k == 2u) { pick2 = li; pp2 = p; }
                                else              { pick3 = li; pp3 = p; }
                            }
                        PDN_HK_STREAMS(seed, Wsum, w, li, p);
                        WsumE += w;
                        if (pdnRand(seed) * WsumE < w) { pickE = li; ppE = p; }
                    }
                    if ((rg.rs_cfg.z & RS_F_WCUT) != 0u) W0 += uintBitsToFloat(eh.y);
                }
            }
            // the denoiser's light-set reference: > 0 with any candidate (nCand > 0 <=> W > 0)
            if (nEm > 0u && !(W0 > 0.0)) W0 = (rg.rs_cfg.z & RS_F_WCUT) != 0u ? Wsum : 1.0;
        }
        CLK_MARK(LOCAL);
    }
    else if (projOn)
    {
        // PAST THE LIGHT GRID (2026-11-13, light / shadow dropout): the grid is a camera-centred clipmap
        // (+-128 m across, +-64 m up / down at the defaults; snapped to its 8 m outer cells), and this walk
        // used to take the ray-traced projector RECORDS only -- deferRsStoch gave the extended set (every
        // point light, record-less projectors) the stochastic shadow only inside the grid, so past its edge
        // they were lit UNSHADOWED. An overhead camera ~70 m up put the ground right at the bottom face: a
        // small camera move snapped the face 8 m and whole scenes popped between shadowed and washed out,
        // with a line across the screen where the terrain crossed it. Now on a ReSTIR frame the walk takes
        // the whole lighting set (rsInSet, the grid's population-1 rule) from the pixel cluster's full list
        // -- the whole light table where it overflowed (clusterWalkAll) -- so the candidate set is the
        // lighting set everywhere; no reservoir reuse past the grid (the cells' history), more noise there.
        // Off a ReSTIR frame: the records' shadowed run as before (the table where it overflowed).
        const uint c = mainClusterFrag(P);
        const uint craw = cluster_count[c];
        const bool rsExt = rsFrameOn();   // (uniform)
        const bool cAll = rsExt ? clusterWalkAll(craw) : clusterShadowedWalkAll(craw);
        const uint n = cAll ? min(count, 256u) : (rsExt ? clusterLen(craw) : clusterShadowedLen(craw));
        if (rsExt) rt_fix_max = rg.rs_params.y;   // (the own-fixture rule, as the grid's candidates)
        uint seed = pdnPcg(uint(m.x) * 1973u + uint(m.y) * 9277u + frame * 26699u);
        // ---- pass 1: the targets (pdnTargetGobo: ALU + record loads + the gobo texel, no BRDF),
        //      K streaming reservoirs ----
        [[dont_unroll]] for (uint i = 0u; i < n; ++i)
        {
            const uint li = cAll ? i : cluster_index[c * CLUSTER_CAP + i];
            if (li >= count || pdnRestHas(spLi, li)) continue;   // (#869: the rest only)
            lvcW = 1.0;
                if (lvcSkip && lvcBlocked(li, P)) { ++lvcSkips; if (!lvcSoft) continue; lvcW = lvcFloor; }   // (LVC stage 3 / 2)
            const bool ext = rsExt && rsInSet(li);   // (in the set: no record test -- pdnTargetL anyLight)
            if (occCulled(ocCull, li))
            {   // (#869 OCCLUSION CULL) culled here: out of the rest -- a probe candidate if it reaches P (the grid's rule)
                if (pdnTargetL(li, P, s.N, ext) > 0.0)
                {
                    nProbe += 1.0;
                    if (pdnRand(pseed) * nProbe < 1.0) ocProbe = li;
                }
                continue;
            }
            float p0;
            const float p = pdnTargetGoboL(li, P, s.N, ext, p0) * lvcW;
            if (!(p > 0.0)) continue;
            Wsum += p;
            if (mvOn && rsMoved(li)) Wmov += p;
            if (mvOn && rsFlick(li)) Wflk += p;
            wMax = max(wMax, p);
            W0 += p0;
            nCand += 1.0;
            if (nCand == 1.0) { ex0 = li; exi0 = i; }
            else if (nCand == 2.0) { ex1 = li; exi1 = i; }
            else if (nCand == 3.0) { ex2 = li; exi2 = i; }
            else if (nCand == 4.0) { ex3 = li; exi3 = i; }
            else PDN_HK_EXACT(nCand, li, i);
            for (uint k = 0u; k < K4; ++k)
                if (pdnRand(seed) * Wsum < p)
                {
                    if (k == 0u)      { pick0 = li; pp0 = p; }
                    else if (k == 1u) { pick1 = li; pp1 = p; }
                    else if (k == 2u) { pick2 = li; pp2 = p; }
                    else              { pick3 = li; pp3 = p; }
                }
            PDN_HK_STREAMS(seed, Wsum, p, li, p);
        }
        CLK_MARK(LOCAL);
    }
    if (radOn && nCand == 0.0) W0 = 0.0;
    // (#869) the moved lights' share of this texel's unshadowed target (before the reuse below
    // replaces Wsum with the reused sample's weight): MOT w, the denoiser's moving-light history cap
    const float fMoveL = (Wmov > 0.0 && Wsum > 0.0) ? clamp(Wmov / Wsum, 0.0, 1.0) : 0.0;
    // (#869 rsFlick) THE FLICKERING-LIGHT SHARE: how much of the ratio's light mix can shift when the
    // flickering lights' radiance changes -- min(their share, the share NOT held by the strongest
    // single candidate): 0 for a lone light (a one-light ratio is its visibility, whatever its
    // intensity), 0 where a flickering light is negligible or utterly dominant, 0.5 for a fire
    // beside an equal lamp or two equal fires. x2: such a texel takes the full moving-light history
    // cap (clean_dn_temporal.comp kMv = 2 MOT w) -- a 50 / 50 mix keeps RenderVKReSTIRMoveHistory
    // frames, a 80 / 20 one ~10. The flickering light's shadow did not move: its rays stay one
    // (RS_MOVE_RAYS is for rsMoved lights only).
    const float fFlk = (Wflk > 0.0 && Wsum > 0.0)
                     ? (radOn ? clamp(Wflk / Wsum, 0.0, 1.0)
                              : clamp(2.0 * min(Wflk / Wsum, 1.0 - wMax / Wsum), 0.0, 1.0)) : 0.0;
    // the share the denoiser's moving-light rule and the dense evaluation read (MOT w)
    const float fMove = max(fMoveL, fFlk);
    // (#1052) THE STRONGEST CANDIDATE'S SHARE of this texel's target (before the reuse replaces Wsum): the
    // denoiser's converged shortcut (RS_CONV_DOM below) is only honest where one light dominates
    const float rsDom = Wsum > 0.0 ? clamp(wMax / Wsum, 0.0, 1.0) : 0.0;
    // ---- pass 2: the SAMPLE LIST through the one core -- sample 0 the sun / moon (merged), then
    //      the projector evaluations: every candidate when they all fit (exact: no noise), else
    //      the K picks weighted W / (K p) ----
    if (rsFrameOn() && pdnPassIdx() == 0u)   // (stats, clean_regir.glsl RS_STATS: one atomic per subgroup; a uniform test)
    {
        const uint gT = subgroupAdd(rsCell != REGIR_NO_CELL ? 1u : 0u);
        const uint wT = subgroupAdd(rsCell == REGIR_NO_CELL && projOn ? 1u : 0u);
        if (subgroupElect())
        {
            if (gT != 0u) atomicAdd(rg.rs_stat[3], gT);
            if (wT != 0u) atomicAdd(rg.rs_stat[4], wT);
        }
    }
    // the guides' depth gradient (also the spatial taps' plane)
    const int stp = max(int(r.x + 0.5), 1);
    const vec2 grad = vec2(pdnGrad(rp, ivec2(stp, 0), vz), pdnGrad(rp, ivec2(0, stp), vz));
    // ---- (#869 Phase 5b / 5c) RESERVOIR REUSE (rsTap above): this frame's candidates' reservoir
    //      (the K = 1 stream's pick, W = Wsum / p, M = 1) + last frame's at the reprojected texel +
    //      its neighbours'; the final sample replaces the pick (weight W, one ray). Written for every
    //      texel with a surface (the cluster walk's too: in-grid neighbours may reuse a record).
    const uint rsf = rsResFlags();
    const bool rsResOn = rsFrameOn() && (rsf & RS_RES_ON) != 0u && pdnPassIdx() == 0u;   // (uniform; an extra pass: none)
    const float WsumF = Wsum;   // (this frame's candidates' sum, before the reuse replaces Wsum: RADIANCE K = 2 below)
    uint rsY = 0xFFFFFFFFu;
    float rsM = 0.0;
    bool reused = false;
    if (rsResOn)
    {
        float py = pp0;
        rsY = (pick0 != 0xFFFFFFFFu && pp0 > 0.0) ? pick0 : 0xFFFFFFFFu;
        float wsumC = rsY != 0xFFFFFFFFu ? Wsum : 0.0;   // p(y0) W0 M0 = p Wsum / p x 1
        float Msum = 1.0;
        uint keptT = 0u, keptS = 0u;
        // (RS_F_VIS_REUSE, radiance mode) the TEMPORAL tap whose reservoir's pick was found blocked last frame
        // (W 0): its M joins Msum at weight 0 -- the combination counts those samples as the zeros they were
        const bool visReuse = (rg.rs_cfg.z & RS_F_VIS_REUSE) != 0u;   // (a header word: uniform)
        uint keptZ = 0u;
        const bool canReuse = rsCell != REGIR_NO_CELL && (rsf & RS_RES_PREV) != 0u && ssr.taa_params.z < 0.5
                           && !(exactOk && nCand <= float(K));
        if (canReuse)
        {
            const float mcap = float(max(rg.rs_cfg2.x, 1u));
            uint rng = pdnPcg(uint(m.x) * 7919u + uint(m.y) * 104729u + frame * 15485863u);
            float pw;
            vec2 dS = pdnPrevDelta(P, m, vec2(D), pw);
            float zx = 0.0;   // (#1038) the extra depth tolerance of a surface that moved on its own (m)
#ifdef REUSE_MV_BOUND
            // (#1038, RS_F_REUSE_MV) a MOVING surface (an avatar): last frame's reservoir of this point is
            // along the motion vectors, not at the camera-only point (reuseMotionDelta)
            if ((rg.rs_cfg.z & RS_F_REUSE_MV) != 0u) zx = reuseMotionDelta(m, rp, vec2(D), pw, dS);
#endif
            const ivec2 qt = ivec2(floor(vec2(m) + dS + 0.5));
            const uint pl = uint(par) ^ 1u;
            uint ly; float lp, lM;
            if (pw > 0.0)
            {
                // TEMPORAL (5b)
                const float wt = rsTap(qt, D, pl, pw, max(0.04 * pw, 0.03) + zx, P, s.N, min(W0, 60000.0), mcap, count, spLi,
                                       ocCull, ly, lp, lM);
                if (wt > 0.0)
                {
                    wsumC += wt; Msum += lM; ++keptT;
                    if (pdnRand(rng) * wsumC < wt) { rsY = ly; py = lp; }
                }
                else if (visReuse && lM > 0.0) { Msum += lM; ++keptZ; }
                // SPATIAL (5c): last frame's rs_cfg2.y neighbours of the reprojected texel, on this plane
                const uint taps = min(rg.rs_cfg2.y, 5u);
                const float rad = float(max(rg.rs_cfg2.z, 1u));
                [[dont_unroll]] for (uint t = 0u; t < taps; ++t)
                {
                    const float a = 6.2831853 * pdnRand(rng);
                    const float rr = rad * sqrt(max(pdnRand(rng), 0.02));
                    const ivec2 q = qt + ivec2(round(vec2(cos(a), sin(a)) * rr));
                    if (q == qt) continue;
                    const float dz = dot(grad, vec2(q - qt));
                    const float ws = rsTap(q, D, pl, pw + dz, max(0.05 * pw, 0.05) + 0.25 * abs(dz) + zx, P, s.N, -1.0, mcap,
                                           count, spLi, ocCull, ly, lp, lM);
                    if (ws > 0.0)
                    {
                        wsumC += ws; Msum += lM; ++keptS;
                        if (pdnRand(rng) * wsumC < ws) { rsY = ly; py = lp; }
                    }
                    // (RS_F_VIS_REUSE) a NEIGHBOUR's blocked pick counts its M at weight 0, like the temporal tap's.
                    // Skipped (2026-11-14 and before), the selection was correlated with visibility: blocked picks
                    // left the pool, visible ones entered with their full W and M, so W ~ the UNSHADOWED sum and a
                    // texel whose lights were partly blocked read brighter than its exact value (toy model of this
                    // loop: +18 % at half the target blocked, +53 % at three quarters -- through the 1 / K mean;
                    // the reservoir alone +63 / +185 %). That bias is also what kept the reservoir from carrying
                    // more of the estimate (pdnSampleLight THE CONFIDENCE WEIGHTS). Counted, a neighbour across a
                    // shadow edge of ONE light lowers W on the lit side within the reuse radius: the same model gives
                    // -3 to -6 % there through the 1 / K mean, -6 to -12 % with the confidence weights -- the
                    // spatial reuse's own edge bias (taking the neighbour's pre-zero W instead measures the same).
                    else if (visReuse && lM > 0.0 && (linfo.fwd.z & LIGHT_KPICK_PLAIN) == 0u) { Msum += lM; ++keptZ; }
                }
            }
        }
        float rsW = (rsY != 0xFFFFFFFFu && py > 0.0 && wsumC > 0.0) ? wsumC / (py * Msum) : 0.0;
        if (!(rsW > 0.0) || !(rsW < 3.0e38)) { rsY = 0xFFFFFFFFu; rsW = 0.0; }
        rsM = min(Msum, float(max(rg.rs_cfg2.x, 1u)));
        // (RS_F_VIS_REUSE: a zero-weight tap counts -- the pick is shaded with the combination's W, Msum included,
        //  exactly the reservoir stored below)
        if (canReuse && rsY != 0xFFFFFFFFu && keptT + keptS + keptZ > 0u)
        {
            reused = true;
            pick0 = rsY; pp0 = py;
            Wsum = rsW * py;   // (the evaluation's weight Wsum / (1 x p) = W)
            nCand = max(nCand, 1.0);
        }
        rs_res[rsResIndex(m, D, uint(par))] = rsResPack(rsY, rsM, rsW);
        // stats (clean_regir.glsl RS_STATS 5-7; rsResOn is uniform: every surface lane is here)
        const uint sM = subgroupAdd(uint(rsM + 0.5));
        const uint sT = subgroupAdd(keptT);
        const uint sS = subgroupAdd(keptS);
        if (subgroupElect())
        {
            if (sM != 0u) atomicAdd(rg.rs_stat[5], sM);
            if (sT != 0u) atomicAdd(rg.rs_stat[6], sT);
            if (sS != 0u) atomicAdd(rg.rs_stat[7], sS);
        }
    }
    // (#869 RS_MOVE_LIGHTS) DENSE EVALUATION where lights that MOVED light the texel (fMove >= 5 %):
    // one RIS pick (or a reused reservoir's) is a binary visibility of ONE light per texel, and the
    // spatial reuse hands the same pick to a ~rs_cfg2.z-texel neighbourhood -- with the moving
    // light's history cut short, that correlated one-light noise is what the a-trous smears into
    // crawling low-frequency blotches ("water"). Here the texel instead evaluates c = min(cap,
    // window) of its window's candidate slots, each with a shadow ray, at its RIS-free weight
    // u = q-weight x scale x window / c (a random contiguous sub-window of the random window:
    // unbiased for num and den alike) -- the ratio becomes the target-weighted mean visibility of c
    // lights, not one light's 0 / 1. The reservoir is still written (above); the evaluation does not
    // use it (no spatially shared pick). Cost: up to c rays instead of 1 on these texels only (a
    // candidate without light at P -- projDirectTerms 0 -- traces nothing).
    uint dC = 0u, dOff = 0u;
    if (mvOn && dWin > 0u && fMove >= 0.05)
    {
        dC = min(rsMoveLights(), dWin);
        if (dC != 0u) reused = false;
        // the sub-window's random start INSIDE the window (cyclic over its dWin slots): every
        // window slot is evaluated with probability c / window -- also in an exact cell, whose
        // window always starts at slot 0 (a fixed first-c subset would drop the others)
        if (dC < dWin)
        {
            uint ds = pdnPcg(uint(m.x) * 3571u + uint(m.y) * 6007u + frame * 7919u + 17u);
            dOff = min(uint(pdnRand(ds) * float(dWin)), dWin - 1u);
        }
    }
    // (RADIANCE MODE, RenderVKProjStochasticSamples 2-4) A FIXED K-RAY BUDGET with a reused reservoir: the
    // reservoir's pick (weight W / K) AND this frame's K - 1 further fresh RIS picks (weight Wsum / (K p) each, their
    // own candidates' sum WsumF) -- K unbiased estimates of the same shadowed light, averaged (the mean of unbiased
    // estimates is unbiased). For the ratio one reused pick was the whole sample (its num / den cancel the weight); in
    // radiance mode each further ray cuts the variance wherever the lights are many, at a constant K rays per texel.
    // (Weighed by confidence, not 1 / K: pdnSampleLight THE CONFIDENCE WEIGHTS.)
    // (The fresh picks come or go together: every stream picks its first positive candidate, so pick1 valid <=> all.)
    const bool radK = radOn && reused && K >= 2u && pick1 != 0xFFFFFFFFu && pp1 > 0.0 && WsumF > 0.0
                   && WsumF < 3.0e38
                   && (K < 3u || (pick2 != 0xFFFFFFFFu && pp2 > 0.0)) && (K < 4u || (pick3 != 0xFFFFFFFFu && pp3 > 0.0));
    const uint Ke = (reused && !radK) ? 1u : K;   // (a reused reservoir: ONE final sample -- RADIANCE: K)
    const bool exact = exactOk && nCand <= float(K) && !reused;
    if (exact) dC = 0u;   // (every candidate is evaluated already: no noise to remove)
    const bool dense = dC != 0u;
    // (#91) dense: + the emitter stratum's one pick (the dense window covers the lights only)
    uint nProj = !(projOn || nEm > 0u) ? 0u
               : (dense ? dC + (pickE != 0xFFFFFFFFu ? 1u : 0u) : (exact ? uint(nCand) : Ke));
    // (#869 SPLIT) + the split lights' samples, last: one each, their own visibility (spV)
    // (#869 OCCLUSION CULL) + the probe, last: detection only (occNote), never in an estimate
    // the probe, with probability clamp(n / 8, 1/8, 1) for n culled lights reaching P: a patch culling a
    // hundred projectors probes from every texel every frame (each light re-tested every few frames)
    // (RenderVKProjStochasticPasses: an extra pass probes nothing -- detection is pass 0's, once a frame)
    if (ocProbe != 0xFFFFFFFFu && (pdnPassIdx() != 0u || pdnRand(pseed) >= clamp(nProbe * 0.125, 0.125, 1.0)))
        ocProbe = 0xFFFFFFFFu;
    const uint nOcP = ocProbe != 0xFFFFFFFFu ? 1u : 0u;
    // (2026-11-16, RenderVKProjStochasticAdaptiveSamples) A MULTI-RAY EXACT LIST (pdnNiRay's block): an adaptive extra
    // pass's exact list (never reused there) with budget to spare -- nCand < K -- takes K rays over its nL = nCand lights
    // instead of one each. Capped at the rest's visibility slots (the slots past the split / probe samples; the host sizes
    // >= the largest K there, pdnVisSlotsWanted) and the gate word's bits: never a job or a visibility past the texel's
    // range. exL: the distinct lights (0 = one ray each -- every other list, every other pass: unchanged)
    uint exL = 0u;
#if CLEAN_SHADOW_STAGE == SH_STAGE_SELECT
    if (exact && nProj > 0u && nProj < K && nOcP == 0u && pdnPassMultiRay())
    {
        const uint vs = min(pdnVisSlots(), PDN_GATE_CD_SHIFT);
        const uint rays = min(K, vs - min(vs, spN + nOcP));
        if (rays > nProj) { exL = nProj; nProj = rays; }
    }
#endif
    // (the ReSTIR view's light: the reservoir's, else the first pick)
    const uint rsYl = rsResOn ? rsY : (pp0 > 0.0 ? pick0 : 0xFFFFFFFFu);
    // (#1031) the evaluation list as one record (pdnSampleLight: the fused loop, SELECT's gate, VIS, SHADE)
    PdnSelD sel;
    sel.nProj = nProj; sel.spN = spN; sel.ocProbe = nOcP != 0u ? ocProbe : 0xFFFFFFFFu; sel.Ke = Ke; sel.dOff = dOff;
    sel.dense = dense; sel.exact = exact; sel.spLi = spLi; sel.allL = false;
    sel.u0 = 0u; sel.u1 = 0u; sel.u2 = 0u; sel.f0 = 0.0; sel.f1 = 0.0; sel.f2 = 0.0;
    sel.x = uvec4(0xFFFFFFFFu, 0xFFFFFFFFu, 0u, 0u);
    sel.e2 = 0xFFFFFFFFu;   // (K > 4: SELECT's second extension, stored before its gate loop -- pdnHkStore)
    sel.nL = exL != 0u ? exL : nProj;
    if (dense)
    {
        sel.u0 = dCw; sel.u1 = dStart | (dSlots << 8u) | (dWin << 16u) | (dC << 24u); sel.u2 = pickE;
        sel.f0 = dScale; sel.f1 = ppE; sel.f2 = WsumE;
    }
    else if (exact)
    {
        sel.u0 = ex0; sel.u1 = ex1; sel.u2 = (exi0 & 0xFFFFu) | (exi1 << 16u);
        if (nProj > 2u) sel.x = uvec4(ex2, ex3, (exi2 & 0xFFFFu) | (exi3 << 16u), 0u);   // (K > 2: 3-4 candidates)
    }
    else
    {
        sel.u0 = pick0; sel.u1 = pick1; sel.f0 = pp0; sel.f1 = pp1; sel.f2 = Wsum;
        if (Ke > 2u) sel.x = uvec4(pick2, pick3, floatBitsToUint(pp2), floatBitsToUint(pp3));
        // (radK above) pdnSampleLight weighs pick j by f2 / (Ke p_j) with f2 the reservoir's W p(y): each fresh
        // pick's p is stored scaled by f2 / WsumF so its weight comes out WsumF / (K p_j). (The radiance firefly
        // clamp then compares it against that scaled target: the two sums estimate the same light set, O(1).)
        if (radK)
        {
            sel.f1 = pp1 * (Wsum / WsumF);
            if (Ke > 2u) sel.x.zw = floatBitsToUint(vec2(pp2, pp3) * (Wsum / WsumF));
            // (pdnSampleLight THE CONFIDENCE WEIGHTS) the reservoir's confidence, capped at the fresh picks' count:
            // u2 is free in a pick list (dense / exact / mover-exact lists use it, never this branch); rsM >= 1 here.
            // (K > 4, 2026-11-15) capped at 3 as at K = 4, never Ke - 1: one K-pick pass then weighs exactly as
            // RenderVKProjStochasticPasses' K / 4 passes of 4 (c / (c + K - 1)) -- capped at Ke - 1 a converged
            // reservoir kept HALF the estimate at any K, and the 12 extra rays of K = 16 cut the variance by ~20 %
            // where the same rays as passes cut it by ~4x (scripts/check pstoch-samples-4's replay)
            sel.u2 = floatBitsToUint(clamp(rsM, 1.0, float(min(Ke, 4u) - 1u)));
        }
    }
#if CLEAN_SHADOW_STAGE == SH_STAGE_SELECT
    // ---- (#1031) SELECT's outputs: the descriptor (the others regenerate the sample list from it) with
    //      the GATE -- which light samples have light at P (the fused loop's terms test before its ray:
    //      VIS traces exactly those) --, the GEOM guide (W0: the gobo-free light-set reference), the
    //      emitter count stat ----
    {
        // (RenderVKShadowMoverMask 2) THE MOVER-EXACT SELECTION (pdnMoverExactPlan; PDN_OPT_MOVER_EXACT: uniform). A
        // mover-exact texel keeps its reservoir (stored above: its neighbours' reuse and its own survive its time here) but
        // traces no RIS pick: every light reaching it is an exact job; its sample list keeps only the emitter stratum's pick
        // (#91: emitters stay out of the exact sum, handled as before) and the split slot(s); no occlusion probe.
        uint exN = 0u, exBase = 0u, exPrevCd = 0u;
        bool exAll = false;
        if (pdnExactOn(D)) exAll = pdnMoverExactPlan(m, D, rp, P, s.N, count, uint(par), exN, exBase, exPrevCd);
        if (exAll)
        {
            const bool em1 = pickE != 0xFFFFFFFFu && ppE > 0.0 && WsumE > 0.0;
            sel.nProj = em1 ? 1u : 0u; sel.Ke = 1u; sel.dOff = 0u; sel.ocProbe = 0xFFFFFFFFu;
            sel.dense = false; sel.exact = false; sel.allL = true; sel.nL = sel.nProj;
            sel.u0 = em1 ? pickE : 0xFFFFFFFFu; sel.u1 = exN; sel.u2 = exBase;
            sel.f0 = em1 ? ppE : 0.0; sel.f1 = 0.0; sel.f2 = em1 ? WsumE : 0.0;
        }
#ifdef PDN_HIGH_K
        // (K > 4) samples 4..15 into the second extension BEFORE the gate loop: its pdnSampleLight reads them back (the
        // same invocation's store; VIS / SHADE / the MASK read the same words through pdnSelLoad's e2)
        if (!exAll && !dense && nProj > 4u)
        {
            sel.e2 = pdnSelExt2Index(pdnSelIndex(m, D), D);
            pdnHkStore(sel.e2, exact, radK ? Wsum / WsumF : 1.0);
        }
#endif
        uint gateM = 0u;
        const uint nS = min(min(pdnSelSamples(sel), pdnVisSlots()), 32u);   // gateM is one 32-bit word
        [[dont_unroll]] for (uint j = 0u; j < nS; ++j)
        {
            uint ni;
            float wgt;
            int spT;
            bool ocP;
            const uint li = pdnSampleLight(sel, j, count, ocCull, ni, wgt, spT, ocP);
            if (li == 0xFFFFFFFFu) continue;
            // (RenderVKProjStochasticPasses: an extra pass traces the rest's picks only -- the split lights' own
            //  visibility is pass 0's; listed, so the rest still leaves them out)
            if (pdnPassIdx() != 0u && (spT >= 0 || ocP)) continue;
            vec3 dt = vec3(0.0), st = vec3(0.0);
            float pd = 0.0;
            if (li >= REGIR_EM_KEY)
            {
