            imageStore(uReflIrr, DS_TEXEL(px), uvec4(dsPackRGB9E5(r.irr)));
            imageStore(uReflSpec, DS_TEXEL(px), uvec4(dsPackRGB9E5(r.spec)));
            if (dsEnvUsed(s)) imageStore(uReflEnv, DS_TEXEL(px), uvec4(dsPackRGB9E5(r.env)));
            if (rtMark) mark = dsRtMark(s, V, false, length(camPos - P), px, P);
            CLK_MARK(STORE);
        }
    }
    if (rtMark) dsRtMarkTile(px, inside, mark);
}

#elif CLEAN_DEFER_PASS == 4
// ---- REFLECT HALF: one 2 x 2 block per invocation (see the header) ----
void DEFER_MAIN()
{
    const ivec2 hp = ivec2(gl_GlobalInvocationID.xy);
    const ivec2 full = ivec2(g_draw_push.width, g_draw_push.height);
    if (hp.x * 2 >= full.x || hp.y * 2 >= full.y) return;
    CLK_INV();   // (one invocation per 2 x 2 block)
    // The representative: the lowest dsHalfRank, the first in scan order on a tie.
    uint best = 4u;
    int rep = 0;
    [[unroll]] for (int k = 0; k < 4; ++k)
    {
        const ivec2 px = hp * 2 + ivec2(k & 1, k >> 1);
        if (px.x >= full.x || px.y >= full.y) continue;
        const vec4 g2 = defTexel(uG2, px);
        if (!deferHasSurface(g2)) continue;
        g_frag_xy = vec2(px) + 0.5;
        float glow;
        bool noFade;
        const SurfaceLit s = deferSurface(px, g2, glow, noFade);
        const uint rank = dsHalfRank(s, dsSharpKind(s, deferPosition(px)));
        if (rank < best) { best = rank; rep = k; }
    }
    if (best >= 3u)   // sky / cleared / fullbright only: nothing any lit pixel may use
    {
        CLK_MARK(GBUF);
        imageStore(uReflHalf, DS_TEXEL(hp), uvec4(0u));
        CLK_MARK(STORE);
        return;
    }
    CLK_SURF();
    const ivec2 px = hp * 2 + ivec2(rep & 1, rep >> 1);
    g_frag_xy = vec2(px) + 0.5;
    const vec4 g2 = defTexel(uG2, px);
    const vec3 P = deferPosition(px);
    float glow;
    bool noFade;
    const SurfaceLit s = deferSurface(px, g2, glow, noFade);
    const vec3 camPos = pc.u_cam_time.xyz;
    const vec3 V = linfo.cam_fwd.w > 0.5 ? -linfo.cam_fwd.xyz : normalize(camPos - P);
    CLK_MARK(GBUF);   // (the four decodes + classification, and the representative's)
    vec3 sunlit = vec3(0.0), amblit = vec3(0.0), additive = vec3(0.0), atten = vec3(1.0);
    atmosLightTerms(P - camPos, s.N, sunlit, amblit, additive, atten);   // (lit: rank < 3)
    CLK_MARK(ATMOS);
    // A sharp representative (rank 2: the whole block is sharp) serves irradiance only.
    const bool specOk = best < 2u;
    const SurfaceRefl r = surfaceReflectionsW(s, P, V, amblit, false, SR_IRR | (specOk ? SR_SPEC : 0u));
    const uvec2 q = uvec2(clamp(gbOctEncode(s.Ng) * 0.5 + 0.5, vec2(0.0), vec2(1.0)) * 1023.0 + 0.5);
    const uint meta = q.x | (q.y << 10) | (uint(rep) << 20) | DS_HALF_SURF | (specOk ? DS_HALF_SPEC : 0u)
                    | (uint(clamp(dsSpecRough(s), 0.0, 1.0) * 255.0 + 0.5) << 24);
    imageStore(uReflHalf, DS_TEXEL(hp), uvec4(dsPackRGB9E5(r.irr), specOk ? dsPackRGB9E5(r.spec) : 0u, meta,
                                    floatBitsToUint(dot(s.Ng, P - camPos))));
    CLK_MARK(STORE);
}

