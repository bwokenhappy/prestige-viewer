#endif

// ---- (#91) EMITTING TRIANGLES as light samples (clean_regir.glsl EMISSIVE LIGHTS): record slot es of this
//      build ----
// The RIS target: the triangle's average luminance x its unshadowed form factor at (P, N) -- > 0 exactly
// where its term is (no texture fetch: the term's texel only changes the colour).
float rsEmTarget(uint es, vec3 P, vec3 N)
{
    if (es >= emCount()) return 0.0;
    const EmTri t = emLoad(emParity(), es);
    vec3 Rd;
    return t.lum * emTriFF(t, P, N, Rd);
}
// The pick's terms (projDirectTerms' role): diffuse only -- diffuseColor x L(P) x FF, the lit kernels'
// term exactly (deferEmitterLight).
bool rsEmTerms(uint es, vec3 P, vec3 N, vec3 diffuseColor, out vec3 dt)
{
    dt = vec3(0.0);
    if (es >= emCount()) return false;
    const EmTri t = emLoad(emParity(), es);
    vec3 Rd;
    const float F = emTriFF(t, P, N, Rd);
    if (!(F > 0.0)) return false;
    dt = diffuseColor * emTriRadiance(t, P, Rd) * F;
    return max(max(dt.r, dt.g), dt.b) > 0.0;
}
// The pick's light sample: ONE point of the triangle's part above P's horizon, uniform in its solid angle
// (emTriSample) -- so the ratio's visibility is the visible share of the light as P sees it. Hard ray
// (radius 0: the per-frame point is the soft shadow), stopping just short of the point (SH_SPHERE's
// nearClip: the emitter never shadows itself).
// xi: three [0, 1) numbers -- the caller's per-texel R3 sequence over the frames, so a texel's penumbra
// converges instead of churning.
void rsEmSample(uint es, vec3 P, vec3 N, vec3 xi, out ShadowSample S)
{
    const EmTri t = emLoad(emParity(), es);
    const vec3 T = emTriSample(t, P, N, xi);
    S.pos = T;
    S.radius = 0.0;
    S.axis = vec3(0.0);
    S.nearClip = clamp(0.002 * length(T - P), 0.005, 0.05);
    S.bias = rg.rs_params.w;
    S.flags = SH_POSITIONAL | SH_SPHERE | (rtSplitOn() ? SH_SPLIT : 0u);
    // (LIGHT TAKEOVER) a taken-over lamp's glass keeps its point light's OWN-FIXTURE rule around the sampled
    // point (rt_fix_P = S.pos): the shade, frame or outer glass whose small box holds the point does not
    // shadow its own light -- without it a random share of the rays ended on the lamp itself (constant
    // crawling noise on everything the lamp lights)
    if ((t.flags & EM_R_TAKE) != 0u) S.flags |= SH_FIXTURE;
    S.tmax = 0.0;
    S.nRays = 1u;
    S.noise = vec2(0.0);
}

// ---- (#869 Phase 5b / 5c) ReSTIR DI RESERVOIR REUSE (Bitterli et al. 2020; the 1/M combine) ----
// Each texel keeps a reservoir {light y, its contribution weight W, its confidence M in frames} in
// rs_res (this frame's GEOM parity). Next frame a texel on the same surface resamples ITS fresh
// candidates' reservoir together with
//   * TEMPORAL (5b): last frame's reservoir at its reprojected texel, and
//   * SPATIAL (5c): last frame's reservoirs of rs_cfg2.y neighbours of that texel
//     (radius rs_cfg2.z, the same surface: depth plane + normal) -- spatiotemporal reuse from the
//     previous frame's buffer: one pass, no extra dispatch and no split of the merged kernel,
// each weighed with the CURRENT target p(y) at THIS texel (a club light that moved or recoloured
// is weighed as it is now; one switched off has p = 0 and drops out this frame: light-off
// anti-lag 0 frames), M capped at rs_cfg2.x frames, and the temporal one faded out by the
// light-set change the denoiser cuts its history on (the cell's target sum vs last frame's W:
// a light switched ON gets the fresh candidates' full say at once). Light indices follow the
// per-frame re-sort through the host's remap (rsRemap). ONE visibility ray for the final sample
// (the generic core); the ratio estimator's num / den are that sample's, as before.
#define RS_RES_ON   1u   // push rtr2.w: the reservoir buffer is bound at this extent (write this parity)
#define RS_RES_PREV 2u   //   ... and last frame's parity holds this extent's reservoirs
uint rsResFlags() { return uint(max(g_draw_push.rtr2.w, 0.0) + 0.5); }
#define RS_CONV_DOM 0.9   // (#1052) the strongest candidate's target share from which a reused pick may mark the
                          // texel converged (the denoiser's RenderVKReSTIRDenoiseIters shortcut; RS_F_CONV_ANY: any)
uint rsResIndex(ivec2 q, ivec2 D, uint layer) { return layer * pdnTexels(D) + pdnTexel(q, D); }   // (#1608: every view's)
uvec2 rsResPack(uint li, float M, float W)
{
    const uint y = li < 0xFFFFu ? li : 0xFFFFu;
    return uvec2(y | (packHalf2x16(vec2(clamp(M, 0.0, 60000.0), 0.0)) << 16u), floatBitsToUint(max(W, 0.0)));
}
// One of last frame's reservoirs (texel q of layer pl) as a candidate here: on this surface
// (expected view depth zExp +- ztol, normal within ~25 deg), its light remapped, in this frame's
// light set and lit at P now. Returns its resampling weight p(y) W M (0 = rejected); y / py / Mq
// its light, target here and (capped, faded) confidence. wRef >= 0: the light-set change rule.
// (#869 SPLIT) spLi: this texel's split lights -- a reservoir holding one of them is rejected (the rest
// leaves them out of its candidates, its numerator and its denominator: re-injected here, a reused
// pick would hand the split light's visibility to the rest again).
bool lvcBlocked(uint li, vec3 P);   // (LVC stage 3: after pdnSampleDisc)
float rsTap(ivec2 q, ivec2 D, uint pl, float zExp, float ztol, vec3 P, vec3 N, float wRef, float mcap, uint count,
            uvec4 spLi, uint ocCull, out uint y, out float py, out float Mq)
{
    y = 0xFFFFFFFFu; py = 0.0; Mq = 0.0;
    if (any(lessThan(q, ivec2(0))) || any(greaterThanEqual(q, D))) return 0.0;
    const uvec4 g = imageLoad(uPdnGeom, ivec3(q, PDN_L(int(pl))));
    const float zq = uintBitsToFloat(g.x);
    if (!(zq > 0.0) || !(abs(zq - zExp) <= ztol)) return 0.0;
    if (dot(pdnUnpackN(g.y), N) < 0.9) return 0.0;
    const uvec2 r = rs_res[rsResIndex(q, D, pl)];
    const uint lp = r.x & 0xFFFFu;
    if (lp == 0xFFFFu) return 0.0;
    // (#91) an EMITTING TRIANGLE key: last build's record (the other parity) -> its (instance, triangle)
    // -> this build's slot (emRemap; gone / dropped / out of this frame's subset / emitters off: rejected)
    const bool em = lp >= REGIR_EM_KEY;
    uint li = 0xFFFFFFFFu;
    float tapW = 1.0;   // (stage 2: the reach map's soft weight on this tap's target)
    if (em)
    {
        if (!emLitOn()) return 0.0;
        const uint ns = emRemap(lp - REGIR_EM_KEY);
        if (ns == REGIR_EM_NONE) return 0.0;
        li = REGIR_EM_KEY + ns;
    }
    else
    {
        li = rsRemap(lp);
        if (li >= count || !rsInSet(li) || pdnRestHas(spLi, li) || occCulled(ocCull, li)) return 0.0;   // (#869: the rest only)
        // (LVC stage 3) a light the reach map calls statically blocked at P: its target here is 0 (exact), the tap gone
        if (lvcSkipOn() && pdnRadOn() && lvcBlocked(li, P))
        {
            if ((rg.rs_cfg.z & RS_F_LVC_SOFT) == 0u) return 0.0;
            tapW = rg.rs_em_params2.z > 0.0 ? rg.rs_em_params2.z : 0.15;   // (stage 2: the soft weight)
        }
    }
    const float W = uintBitsToFloat(r.y);
    // (RS_F_VIS_REUSE, radiance mode) W exactly 0 with a light: last frame's own ray found that pick blocked --
    // the reservoir still holds M samples' worth of evidence (that their pick carried no light), so its M joins
    // the combination at weight 0 (never picked: y stays none; the temporal and the spatial callers both add Mq).
    // Without the flag such a
    // reservoir is never written (W > 0 or no light), so the ratio path reads exactly as before.
    const bool zeroW = W == 0.0 && !em && (rg.rs_cfg.z & RS_F_VIS_REUSE) != 0u;
    if (!zeroW && (!(W > 0.0) || !(W < 3.0e38))) return 0.0;
    float M = min(unpackHalf2x16(r.x >> 16u).x, mcap);
    if (wRef >= 0.0)
    {
        const float Wq = pdnMetaW(g.w);
        const float c = float(rg.rs_cfg2.w) * 0.001;
        if (c > 0.0) M *= 1.0 - smoothstep(c, 2.0 * c, abs(wRef - Wq) / max(max(wRef, Wq), 1e-4));
    }
    if (!(M > 0.0)) return 0.0;
    float p0;
    const float p = (em ? rsEmTarget(li - REGIR_EM_KEY, P, N) : pdnTargetGoboL(li, P, N, true, p0)) * tapW;
    if (!(p > 0.0)) return 0.0;
    if (zeroW) { Mq = M; return 0.0; }   // (RS_F_VIS_REUSE: its M only -- the light still reaches P unshadowed)
    y = li; py = p; Mq = M;
    const float w = p * W * M;
    return w < 3.0e38 ? w : 0.0;
}
// The ReSTIR debug view's colour of light li (a stable hue per index).
vec3 rsHue(uint li)
{
    const float h = fract(float(li) * 0.61803399);
    return clamp(abs(fract(vec3(h) + vec3(0.0, 2.0, 1.0) / 3.0) * 6.0 - 3.0) - 1.0, 0.0, 1.0);
}

// ---- (#869) THE SPLIT: PER-LIGHT VISIBILITY OF THE DOMINANT LIGHTS (clean_pdn_common.glsl SPLIT
//      CHANNEL; push rtr3.z bits 0-2 K = RenderVKProjStochasticSplitK, bit 3 last frame's split ids
//      are valid at this extent) ----
// A light the lit kernels shade with the stochastic ratio at a P (grid: the extended set is stochastic
// -- a ReSTIR frame; since 2026-11-13 inside the light grid AND past it, deferRsStoch) -- localLight's
// rule exactly (projStochEligible, or deferRsStoch's extended set), minus a taken-over light (both sides
// leave it out): only such a light may be split, so the split set is a subset of the lighting set and
// the rest is the lighting set minus it.
bool pdnSplitEligible(uint li, bool grid)
{
    if (rsFrameOn() && emTaken(li)) return false;
    const uint rec = lights[li].tex.z;
    if (rec != 0u)
    {
        const vec4 sp = pshadow[rec - 1u].params;
        if (!(sp.w < 0.5) && sp.z > 1.5) return true;   // (projStochEligible)
    }
    return grid && rsFrameOn() && rsInSet(li) && !rsRecordLight(li);
}
// The hysteresis an incumbent (split at this point last frame) gets in the ranking: two lights of
// near-equal strength never swap slots frame to frame -- a challenger must be this much stronger.
#define PDN_SPLIT_HYST 1.5
// THE SELECTION: the K strongest eligible lights at (P, N) by the GOBO-FREE unshadowed target
// (pdnTargetL: range, attenuation, the cutoff fade, the frustum, N.L -- no texture): smooth in
// space, so a projector's whole footprint splits it, stripes and all (a gobo-weighted rank would
// drop it in its dark stripes and hand those to the rest). Over a DETERMINISTIC list -- the pixel
// cluster's (<= CLUSTER_CAP, every frame the same -- the whole light table where it overflowed; the
// shadowed run alone off a ReSTIR frame, where only the records are stochastic), never the RIS
// window (a random start: the rank would flicker)
// -- x PDN_SPLIT_HYST for last frame's ids at the reprojected texel, ties to the lower id.
// li: the lights (0xFFFFFFFF empty), id: their split ids (0 empty); returns the count.
// (#869 OCCLUSION CULL) ocCell: P's patch (OCC_NONE: none / culling nothing) -- a culled light is never
// split (it is out of the lighting set here); among the culled lights that reach P (target > 0) one is
// picked uniformly as this texel's PROBE candidate (probe; 0xFFFFFFFF none; nProbe: how many there
// were). K = 0: the walk only picks the probe.
uint pdnSplitSelect(vec3 P, vec3 N, uint K, bool grid, uvec2 prevIds, uint ocCell, inout uint seed,
                    out uvec4 li, out uvec4 id, out uint probe, out float nProbe,
                    vec3 V, bool pbr, vec3 base, vec3 diffuseColor, vec3 specularColor, float rough, LegacySpec ls)
{
    li = uvec4(0xFFFFFFFFu);
    id = uvec4(0u);
    probe = 0xFFFFFFFFu;
    nProbe = 0.0;
    vec4 sc = vec4(0.0);
    uint ns = 0u;
    const uint count = uint(linfo.cam_pos.w);
    const uint c = mainClusterFrag(P);
    const uint raw = cluster_count[c];
    // (an overflowed list: every light -- pdnSplitEligible keeps the lighting set's)
    const bool all = grid ? clusterWalkAll(raw) : clusterShadowedWalkAll(raw);
    const uint n = all ? min(count, 256u) : min(grid ? clusterLen(raw) : clusterShadowedLen(raw), uint(CLUSTER_CAP));
    [[dont_unroll]] for (uint i = 0u; i < n; ++i)
    {
        const uint l = all ? i : cluster_index[c * CLUSTER_CAP + i];
        if (l >= count) continue;
        const uint d = lights[l].tex.w & 0xFFFFu;
        if (d == 0u || !pdnSplitEligible(l, grid)) continue;
        float s;
        if (pdnExactSpecular() && K > 0u)
        {
            vec3 dt, st; float distanceToLight;
            if (!projDirectTerms(l, P, N, V, pbr, base, diffuseColor, specularColor, rough, ls, false, dt, st, distanceToLight)) continue;
            s = pdnLum(st);
        }
        else s = pdnTargetL(l, P, N, true);
        if (!(s > 0.0) || !(s < 3.0e38)) continue;
        if (occCulled(ocCell, l))
        {   // (culled here: a probe candidate, never split)
            nProbe += 1.0;
            if (pdnRand(seed) * nProbe < 1.0) probe = l;
            continue;
        }
        if (K == 0u) continue;
        if (!pdnExactSpecular() && pdnSplitFind(prevIds, d) >= 0) s *= PDN_SPLIT_HYST;
        // its rank: the entries ahead of it (sorted: a prefix)
        uint r = 0u;
        [[unroll]] for (uint k = 0u; k < PDN_SPLIT_MAX; ++k)
            if (k < ns && (sc[k] > s || (sc[k] == s && id[k] < d))) ++r;
        if (r >= K) continue;
        [[unroll]] for (uint k = PDN_SPLIT_MAX - 1u; k > 0u; --k)
            if (k > r && k < K) { sc[k] = sc[k - 1u]; li[k] = li[k - 1u]; id[k] = id[k - 1u]; }
        sc[r] = s; li[r] = l; id[r] = d;
        ns = min(ns + 1u, K);
    }
    return ns;
}

// ---- (#869 OCCLUSION CULL) pass 15's notes into the cache (the block above DEFER_MAIN's helpers) ----
void occOr(uint w, uint v)
{
    if ((w & 1u) == 0u) atomicOr(rg_cells[w >> 1u].x, v);
    else                atomicOr(rg_cells[w >> 1u].y, v);
}
// The patch for tag, claimed if absent (a free slot of its chain); OCC_NONE: the chain is full.
uint occClaim(uint tag, uint slot0)
{
    const uint f = occFind(tag, slot0);
    if (f != OCC_NONE) return f;
    for (uint j = 0u; j < OCC_PROBES; ++j)
    {
        const uint c = (slot0 + j) & (OCC_CELLS - 1u);
        const uint old = atomicCompSwap(rg_cells[occBase(c)].x, 0u, tag);
        if (old == 0u || old == tag) return c;
    }
    return OCC_NONE;
}
// One traced ray toward light li from P's patch: blocked -> its B bit (claiming the patch), visible -> its
// V bit where it has a count (none: nothing to re-admit). One atomicOr at most, skipped when the bit is
// already set (most of a patch's texels agree). refused: the chain was full (stats).
void occNote(uint tag, uint slot0, inout uint cell, uint li, bool visible, inout uint refused)
{
    if (li >= 256u) return;
    if (cell == OCC_NONE)
    {
        if (visible) return;
        cell = occClaim(tag, slot0);
        if (cell == OCC_NONE) { ++refused; return; }
    }
    if (visible && occCount(cell, li) == 0u) return;
    const uint w = occWord(cell, (visible ? OCC_W_V : OCC_W_B) + (li >> 5u));
    const uint bit = 1u << (li & 31u);
    if ((occLoad(w) & bit) == 0u) occOr(w, bit);
}
// (#1052 SOFT CULL, cause 1) A light sample is occlusion EVIDENCE for P's patch: it was traced, and its
// ray(s) either reached the light (visible) or met an opaque caster at least the patch edge away -- not
// the receiver's own surface / terminator at P, which a patch-wide verdict cannot represent (rt_block_t:
// the walk's nearest opaque caster; a translucent-only block leaves it unset: no evidence). The hard
// rules: every sample (untraced ones counted as blocked, as before).
bool occEvidence(bool traced, vec3 vis, vec3 P)
{
    if (!occSoft()) return true;
    if (!traced) return false;
    if (max(max(vis.r, vis.g), vis.b) > OCC_VIS_MIN) return true;
    // (the patch edge, capped at OCC_BLOCK_MAX: self-shadow hits are centimetres; a far patch's metres-wide
    //  edge would stop a floor near the shared wall from ever noting the wall)
    return rt_block_t < 1e29 && rt_block_t >= clamp(occEdge(occLevel(P)), OCC_BLOCK_MIN, OCC_BLOCK_MAX);
}

// ---- (#1031) THE TEXEL'S LIGHT-SAMPLE LIST: the evaluation list (the fused kernel's locals, or
//      SELECT's descriptor) and its j-th LIGHT sample (the sun is not one of them) -- ONE definition
//      for the fused loop, SELECT's gate, VIS and SHADE, so they all see the same samples ----
struct PdnSelD {
    uint  nProj, spN, ocProbe, Ke, dOff;
    bool  dense, exact;
    bool  allL;         // (RenderVKShadowMoverMask 2) MOVER-EXACT: u1 the exact job count, u2 the first job (PDN_SEL_ALL_LIGHTS)
    uint  u0, u1, u2;   // pick0 / ex0 / dCw; pick1 / ex1 / dStart | dSlots << 8 | dWin << 16 | dC << 24;
                        // exi0 | exi1 << 16 / pickE
    float f0, f1, f2;   // pp0 / dScale, pp1 / ppE, Wsum / WsumE
    uvec4 spLi;         // the split lights (0xFFFFFFFF past spN)
    // (RenderVKProjStochasticSamples 3-4) samples 2-3 of a pick list or an exact list (the descriptor's extension,
    // pdnSelExtIndex): picks -- pick2, pick3, float bits of pp2, pp3; exact -- ex2, ex3, exi2 | exi3 << 16
    uvec4 x;
    // (2026-11-15, RenderVKProjStochasticSamples 5-16) samples 4..15 of a pick / exact list: the first uvec4 of the
    // texel's SECOND extension (pdnSelExt2Index; 0xFFFFFFFF: none -- K <= 4), read word by word on demand (pdnSelE2Word)
    uint e2;
    // (2026-11-16, an adaptive extra pass's MULTI-RAY EXACT LIST: pdnNiRay's block) an exact list's distinct lights -- nProj
    // when every light takes one ray (every list but that one), < nProj when its nProj samples are rays of nL lights
    uint nL;
};
// ---- (2026-11-16, RenderVKProjStochasticAdaptiveSamples) A MULTI-RAY EXACT LIST: an adaptive extra pass whose exact list
//      (every candidate evaluated, nL <= K lights) has spare budget traces K rays over its nL lights instead of nL --
//      sample j is ray r = j / nL of light l = j % nL, so light l takes R_l = (K - 1 - l) / nL + 1 rays (floor(K / nL),
//      the remainder K mod nL to the first lights in list order: every slot of the budget traced, a fixed rule -- never
//      a function of any visibility), weight 1 / R_l each: light l's term x its MEAN visibility over its own rays, an
//      unbiased estimate of each light (each ray uniform over the light), the pass still K rays (the fold's kx).
//      A hard light (pdnSampleDisc 0: every ray the same segment) keeps one ray at weight 1 -- its rays r > 0 are no
//      samples (no gate bit, no job). Ray r > 0 carries r and R_l in its noise index's bits 16-19 / 20-24 (pdnNiRay):
//      VIS stratifies the disc / triangle sample over the R_l rays (r / R_l on the first axis, r x golden ratio on the
//      second -- a rank-1 lattice over the base sample, each ray on its own still uniform over the light). Run indices
//      (bits 0-15) never reach bit 16. Ray 0 is exactly the one-ray sample. ----
uint pdnNiRay(uint ni)  { return (ni >> 16u) & 15u; }
uint pdnNiRays(uint ni) { return (ni >> 20u) & 31u; }
vec2 pdnNiRayShift(uint ni)   // (ray 0: none -- callers test pdnNiRay first)
{
    return vec2(float(pdnNiRay(ni)) / float(max(pdnNiRays(ni), 1u)), fract(float(pdnNiRay(ni)) * 0.6180339887));
}
// ---- (RenderVKProjStochasticSamples 5-16) THE SECOND EXTENSION: 5 uvec4 (20 words) per texel past the first extension,
//      only while the host's K reaches 5 (pdnSelExt2On). Sample j >= 4 of the list is entry k = j - 4 (< 12):
//   a pick list   words 0-5    the picks' lights, two per word (k even: bits 0-15, odd: 16-31; 0xFFFF none)
//                 words 6-17   float bits of pick k's target (stored scaled as sel.f1: radK's Wsum / WsumF)
//   an exact list words 0-11   candidate k's light | its run index << 16 (0xFFFF light: none)
//   SELECT writes it before its gate loop (that same invocation's pdnSampleLight reads it back), VIS / SHADE / the MASK
//   read it. Lights fit 16 bits: 0..255 + REGIR_EM_KEY + < REGIR_EM_CAP triangle slots. ----
#define PDN_SEL_E2_WORDS 20u
#define PDN_SEL_E2_N     12u   // samples 4..15
uint pdnSelE2Word(PdnSelD d, uint w)
{
#if CLEAN_SHADOW_STAGE != SH_STAGE_FUSED
    if (d.e2 == 0xFFFFFFFFu || w >= PDN_SEL_E2_WORDS) return 0xFFFFFFFFu;
    return pdn_sel[d.e2 + (w >> 2u)][w & 3u];
#else
    return 0xFFFFFFFFu;   // (the fused kernels: K <= 4)
#endif
}
uint pdnSelE2Light(uint w16) { return w16 == 0xFFFFu ? 0xFFFFFFFFu : w16; }
// A pick list's sample j: its target p (the firefly clamp's and the weight's)
float pdnSelPickP(PdnSelD d, uint j)
{
    if (j >= 4u) return uintBitsToFloat(pdnSelE2Word(d, 6u + (j - 4u)));
    return j == 0u ? d.f0 : (j == 1u ? d.f1 : uintBitsToFloat(j == 2u ? d.x.z : d.x.w));
}
// A pick list's sample j: its light (0xFFFFFFFF: none)
uint pdnSelPickLi(PdnSelD d, uint j)
{
    if (j >= 4u) return pdnSelE2Light((pdnSelE2Word(d, (j - 4u) >> 1u) >> (16u * ((j - 4u) & 1u))) & 0xFFFFu);
    return j == 0u ? d.u0 : (j == 1u ? d.u1 : (j == 2u ? d.x.x : d.x.y));
}
// Sample j < nProj + spN (+ 1 with the probe): its light (0xFFFFFFFF: none -- skipped), noise index ni,
// weight, split slot (-1: the rest's), probe. count: the frame's lights; ocCull: P's culling patch.
uint pdnSampleLight(PdnSelD d, uint j, uint count, uint ocCull, out uint ni, out float wgt, out int spT, out bool ocP)
{
    ni = 0u; wgt = 1.0; spT = -1; ocP = false;
    if (j >= d.nProj + d.spN)
    {   // (#869 OCCLUSION CULL) the PROBE: a culled light that reaches P, one ray
        ocP = true;
        ni = 72u;
        return d.ocProbe;
    }
    if (j >= d.nProj)
    {   // (#869) a SPLIT light: weight 1, its own noise phase
        spT = int(j - d.nProj);
        ni = 64u + uint(spT);
        return d.spLi[spT];
    }
    if (d.dense)
    {
        const uint dC = d.u1 >> 24u;
        if (j >= dC)
        {   // (#91) the emitter stratum: its own RIS pick over the cell's emitters, W_E / p
            wgt = d.f1 > 0.0 ? d.f2 / d.f1 : 0.0;
            if (!(wgt > 0.0) || !(wgt < 3.0e38)) return 0xFFFFFFFFu;
            ni = j;
            return d.u2;
        }
        // (RS_F_STRIDE) the sub-window's c positions evenly spaced over the window's, and
        // the window's over the cell's slots: c DIFFERENT stretches of the stratified CDF.
        // (Contiguous, a cell whose fire holds 10 of 16 slots evaluated the fire 4 times --
        // four rays of ONE light, the binary one-light ratio the dense evaluation exists to
        // replace: blotches under a flickering fire beside other lights.)
        const uint dWin = (d.u1 >> 16u) & 255u;
        const uint k = rsWinSlot(d.dOff, j, dC, dWin);
        const uint jj = rsWinSlot(d.u1 & 255u, k, dWin, (d.u1 >> 8u) & 255u);
        const uvec2 sl = rg_cells[d.u0 + 1u + jj];
        const uint li = sl.x;
        if (li >= count || emTaken(li)) return 0xFFFFFFFFu;   // (#91: a taken-over light has no light here)
        if (pdnRestHas(d.spLi, li) || occCulled(ocCull, li)) return 0xFFFFFFFFu;   // (#869: split: its own sample; culled: none)
        wgt = uintBitsToFloat(sl.y) * d.f0 * float(dWin) / float(dC);
        if (!(wgt > 0.0) || !(wgt < 3.0e38)) return 0xFFFFFFFFu;
        ni = jj;
        return li;
    }
    if (d.exact && d.nL != 0u && d.nL < d.nProj)
    {   // (2026-11-16) A MULTI-RAY EXACT LIST (the block above pdnNiRay): ray r of light l, weight 1 / R_l
        const uint l = j % d.nL, ray = j / d.nL;
        const uint Rl = (d.nProj - 1u - l) / d.nL + 1u;
        // (light l and its run index: the one-ray list's sample l, below)
        uint li;
        if (l >= 4u)
        {
            const uint w = pdnSelE2Word(d, l - 4u);
            li = pdnSelE2Light(w & 0xFFFFu); ni = w >> 16u;
        }
        else if (l >= 2u) { li = l == 2u ? d.x.x : d.x.y; ni = l == 2u ? (d.x.z & 0xFFFFu) : (d.x.z >> 16u); }
        else              { li = l == 0u ? d.u0 : d.u1;   ni = l == 0u ? (d.u2 & 0xFFFFu) : (d.u2 >> 16u); }
        if (li == 0xFFFFFFFFu) return li;
        if (li < REGIR_EM_KEY && !(pdnSampleDisc(li) > 0.0))
        {   // a hard light: one ray (its rays would all trace the same segment)
            if (ray != 0u) return 0xFFFFFFFFu;
            return li;
        }
        wgt = 1.0 / float(Rl);
        if (ray != 0u) ni |= (ray << 16u) | (Rl << 20u);
        return li;
    }
    if (d.exact)
    {
        if (j >= 4u)
        {   // (K > 4) candidates 5..16 (the second extension: light | run index << 16)
            const uint w = pdnSelE2Word(d, j - 4u);
            ni = w >> 16u;
            return pdnSelE2Light(w & 0xFFFFu);
        }
        if (j >= 2u)
        {   // (K > 2) the 3rd / 4th candidate (the extension)
            ni = j == 2u ? (d.x.z & 0xFFFFu) : (d.x.z >> 16u);
            return j == 2u ? d.x.x : d.x.y;
        }
        ni = j == 0u ? (d.u2 & 0xFFFFu) : (d.u2 >> 16u);
        return j == 0u ? d.u0 : d.u1;
    }
    // the K picks: pick j weighted f2 / (Ke p_j) -- the mean of Ke unbiased one-sample estimates (each its own RIS
    // pick, weight Wsum / p; a reused reservoir's pick W p(y) / p(y) = W -- RADIANCE K >= 2 below SELECT's radK)
    const uint li = pdnSelPickLi(d, j);
    const float pp = pdnSelPickP(d, j);
    if (li == 0xFFFFFFFFu || !(pp > 0.0)) return 0xFFFFFFFFu;
    // (RADIANCE radK, SELECT: u2 = the reservoir's confidence c = min(M, Ke - 1), float bits, > 0) THE CONFIDENCE
    // WEIGHTS: the reservoir's pick (j 0) takes c / (c + Ke - 1) of the estimate, each fresh pick 1 / (c + Ke - 1) --
    // a convex combination of estimates of the same light (no new bias). A converged reservoir (c = Ke - 1) carries
    // half, the Ke - 1 visibility-blind fresh picks the other half; a young one (M 1) weighs as one fresh pick (the
    // plain mean). With the plain 1 / Ke mean three of four rays -- 3/4 of the estimate -- were RIS picks over the
    // UNSHADOWED target: lamps behind walls picked in proportion to their unshadowed share, a 0 / 1 sample whose
    // spread grows with the blocked share of the cell's lights (the noise under many lights). Ke = 2: c = 1, unchanged.
    float share = 1.0 / float(d.Ke);
    if (!d.allL && d.u2 != 0u && (linfo.fwd.z & LIGHT_KPICK_PLAIN) == 0u)
    {
        const float c = uintBitsToFloat(d.u2);
        if (c > 0.0 && c < 64.0) share = (j == 0u ? c : 1.0) / (c + float(d.Ke) - 1.0);
    }
    wgt = d.f2 * share / pp;
    ni = j;
    return li;
}

#if CLEAN_SHADOW_STAGE != SH_STAGE_FUSED
// ---- (#1031) THE SELECTION DESCRIPTOR (binding 26: the layout at its declaration) ----
#define PDN_SEL_SURF   0x0200u   // a surface (else SELECT stored the empty texel; the others skip it)
#define PDN_SEL_NOCP   0x0100u   // the occlusion probe fires (its light: bits 16-23)
#define PDN_SEL_DENSE  0x0400u   // the dense evaluation (the window in q0.y / q0.z, dOff in bits 24-31)
#define PDN_SEL_EXACT  0x0800u   // every candidate evaluated (ex0 / ex1)
#define PDN_SEL_REUSED 0x1000u   // a reused reservoir is the one final sample
#define PDN_SEL_KE2    0x2000u   // two or more picks (else one): Ke = nProj in a pick list (pdnSelLoad)
#define PDN_SEL_CELL   0x4000u   // P lies in the light grid (rsCell != REGIR_NO_CELL)
#define PDN_SEL_SUN_LIT 0x8000u  // SELECT stored lit sun: pdnSunGate rejected this receiver
// (RenderVKShadowMoverMask 2) MOVER-EXACT: DENSE and EXACT together (a combination no other list makes: an exact list
// has no dense window) -- every light reaching P is evaluated from the exact job list (q0.z its job count, q0.w its first
// job; bits 16-19 last frame's mover countdown); the sample list is only the emitter stratum's pick (q0.y, ppE, WsumE)
// and the split slot(s)
#define PDN_SEL_ALL_LIGHTS (PDN_SEL_DENSE | PDN_SEL_EXACT)
// (2026-11-16, an adaptive extra pass) A MULTI-RAY EXACT LIST (pdnNiRay's block): q0.x bits 16-20 its distinct lights nL
// (nProj its rays) -- only an EXACT list without the probe (bits 16-23 are the probe's light with PDN_SEL_NOCP; an extra
// pass never probes) and only while nL < nProj: every other descriptor keeps those bits 0, exactly as before
#define PDN_SEL_EXL_SHIFT 16u
// (RenderVKShadowMoverMask 2) the gate word (q3.z) bits 28-31: last frame's mover countdown, every texel (SHADE's THE MOVER
// COUNTDOWN); its bits 0-27 stay the gate (a bit per light sample: < 22 slots)
#define PDN_GATE_CD_SHIFT 28u
uint pdnSelIndex(ivec2 m, ivec2 D) { return 4u * pdnTexel(m, D); }   // (#1608: every view's texels -- pdnTexel)
// (RenderVKProjStochasticSamples 3-4) the texel's extension uvec4 (sdi: its pdnSelIndex), past every descriptor
uint pdnSelExtIndex(uint sdi, ivec2 D) { return 4u * pdnTexels(D) + (sdi >> 2u); }
// the binding (its range: the host's mPdnSelBytes) holds the extension -- else SELECT runs K = 2 (pdnSamplesK)
bool pdnSelExtOn(ivec2 D) { return uint(pdn_sel.length()) >= 5u * pdnTexels(D); }
// (RenderVKProjStochasticSamples 5-16) the texel's SECOND extension (PDN_SEL_E2_WORDS / 4 uvec4), past the first
// extension; bound (the host's pdnSelBytesWanted: 160 B per texel) only while the host's K reaches 5
uint pdnSelExt2Index(uint sdi, ivec2 D) { return 5u * pdnTexels(D) + (PDN_SEL_E2_WORDS / 4u) * (sdi >> 2u); }
bool pdnSelExt2On(ivec2 D) { return uint(pdn_sel.length()) >= (5u + PDN_SEL_E2_WORDS / 4u) * pdnTexels(D); }
// The evaluation list of the descriptor at sdi (q0 = sd0 already loaded)
PdnSelD pdnSelLoad(uint sdi, uvec4 sd0)
{
    const uvec4 sd1 = pdn_sel[sdi + 1u];
    const uint li4 = pdn_sel[sdi + 2u].y;
    PdnSelD d;
    d.nProj = sd0.x & 31u;
    d.spN = (sd0.x >> 5u) & 7u;
    d.ocProbe = (sd0.x & PDN_SEL_NOCP) != 0u ? (sd0.x >> 16u) & 255u : 0xFFFFFFFFu;
    d.allL = (sd0.x & PDN_SEL_ALL_LIGHTS) == PDN_SEL_ALL_LIGHTS;
    d.dOff = d.allL ? 0u : sd0.x >> 24u;
    d.dense = !d.allL && (sd0.x & PDN_SEL_DENSE) != 0u;
    d.exact = !d.allL && (sd0.x & PDN_SEL_EXACT) != 0u;
    // (a pick list holds exactly Ke samples: nProj = Ke; Ke > 2 only there -- dense / exact lists do not weigh by it)
    const bool picks = !d.allL && !d.dense && !d.exact;
    d.Ke = (sd0.x & PDN_SEL_KE2) == 0u ? 1u : (picks && d.nProj > 2u ? d.nProj : 2u);
    d.u0 = sd0.y; d.u1 = sd0.z; d.u2 = sd0.w;
    d.f0 = uintBitsToFloat(sd1.x); d.f1 = uintBitsToFloat(sd1.y); d.f2 = uintBitsToFloat(sd1.z);
    // (K > 2) a pick or exact list past two samples: SELECT wrote the extension (pdnSamplesK: only with it bound)
    d.x = uvec4(0xFFFFFFFFu, 0xFFFFFFFFu, 0u, 0u);
    if (!d.allL && !d.dense && d.nProj > 2u)
        d.x = pdn_sel[pdnSelExtIndex(sdi, ivec2(g_draw_push.rtr.xy + 0.5))];
    // (K > 4) samples 4..15: the second extension, read on demand (pdnSelE2Word)
    d.e2 = (!d.allL && !d.dense && d.nProj > 4u) ? pdnSelExt2Index(sdi, ivec2(g_draw_push.rtr.xy + 0.5)) : 0xFFFFFFFFu;
    // (2026-11-16) a MULTI-RAY EXACT LIST's distinct lights: q0.x bits 16-20 (PDN_SEL_EXL_SHIFT; 0 = one ray per light)
    d.nL = d.nProj;
    if (d.exact && (sd0.x & PDN_SEL_NOCP) == 0u && ((sd0.x >> PDN_SEL_EXL_SHIFT) & 31u) != 0u)
        d.nL = min((sd0.x >> PDN_SEL_EXL_SHIFT) & 31u, d.nProj);
    d.spLi = uvec4(0xFFFFFFFFu);
    [[unroll]] for (uint k = 0u; k < PDN_SPLIT_MAX; ++k)
        if (k < d.spN) d.spLi[k] = (li4 >> (8u * k)) & 255u;
    return d;
}
// The light samples (SELECT's gate, VIS, SHADE): nProj + spN + the probe
uint pdnSelSamples(PdnSelD d) { return d.nProj + d.spN + (d.ocProbe != 0xFFFFFFFFu ? 1u : 0u); }
// (RenderVKProjStochasticPasses) THE PASSES AS ONE SAMPLE LIST: pass 0's estimate counts as W0 one-sample estimates and
// every extra pass's K fresh picks as K more, so the N passes combine exactly as one list of c + N K - 1 samples weighed
// by pdnSampleLight's CONFIDENCE WEIGHTS -- the reservoir's pick (pass 0 only: an extra pass reuses nothing) keeps its
// confidence c ONCE, against all N K - 1 fresh picks (c / (c + N K - 1)), never N copies of it as if independent. W0 of
// pass 0's descriptor at si (an extra SELECT reads it before its own store): a radK list c + Ke - 1 (its u2 = c), a lone
// reused pick 1, a fresh pick list Ke; an exact / dense list K (no pick weights: the plain mean). Pass 1 derives it, the
// later passes carry it in q3.y (an extra pass's rsM word: nothing reads that there). Convex, sample-independent weights
// of unbiased estimates: the combination is unbiased (scripts/check pstoch-passes replays it).
// (2026-11-16) multi: pass 1's own list is a MULTI-RAY EXACT LIST (pdnNiRay's block: its K rays over nL lights, kx in the
// fold -- the rays it traced). Pass 0's exact list then weighs ITS rays too, one per light: nProj (<= K0), not K0 -- light
// for light the combination is then pass 0's one ray against pass 1's ~K / nL, by their count (K0 for a 2-light list
// made pass 0's single ray 2 / K0 of pass 1's whole pass). Only then: every other list keeps K0, bit for bit.
float pdnPassBaseWeight(uint si, uint K, bool multi)
{
    if (pdnPassIdx() > 1u) return uintBitsToFloat(pdn_sel[si + 3u].y);
    const uvec4 q0 = pdn_sel[si];
    const bool picks = (q0.x & PDN_SEL_SURF) != 0u && (q0.x & (PDN_SEL_DENSE | PDN_SEL_EXACT)) == 0u;
    if (multi && (q0.x & PDN_SEL_SURF) != 0u && (q0.x & PDN_SEL_ALL_LIGHTS) == PDN_SEL_EXACT && (q0.x & 31u) != 0u)
        return float(min(q0.x & 31u, K));
    if (!picks) return float(K);
    const uint nProj = q0.x & 31u;
    const uint Ke = (q0.x & PDN_SEL_KE2) == 0u ? 1u : (nProj > 2u ? nProj : 2u);
    const float c = uintBitsToFloat(q0.w);
    if (q0.w != 0u && c > 0.0 && c < 64.0) return c + float(Ke) - 1.0;   // (radK: pdnSampleLight's test)
    return (q0.x & PDN_SEL_REUSED) != 0u ? 1.0 : float(Ke);
}
#endif
// RenderVKProjStochasticSamples (push rtr.w bits 0-2, 1-4): the split core's SELECT takes K > 2 only with the
// descriptors' extension bound (the host reallocates on the change; until then K = 2 -- never a write past the range)
// (2026-11-15, RenderVKProjStochasticSamples / RenderVKProjStochasticAdaptiveSamples 5-16) push rtr.w bits 8-12: THIS
// DISPATCH's K when it is above 4 (0 = bits 0-2, which then hold min(K, 4) for every reader that stops at 4: the fused /
// per-light-type kernels) -- taken only by the split core with the second extension bound, and in SELECT only by the
// high-K variant (-DPDN_HIGH_K: the streams 4..15 in shared memory, pdnHkStreams); else 4
uint pdnSamplesK(uint ctl, ivec2 D)
{
    const uint K = clamp(ctl & 7u, 1u, 4u);
#if CLEAN_SHADOW_STAGE != SH_STAGE_FUSED
    if (K > 2u && !pdnSelExtOn(D)) return 2u;
#if CLEAN_SHADOW_STAGE != SH_STAGE_SELECT || defined(PDN_HIGH_K)
    const uint Kh = (ctl >> 8u) & 31u;
    if (Kh > 4u && pdnSelExt2On(D)) return min(Kh, 4u + PDN_SEL_E2_N);
#endif
#endif
    return K;
}
// (an extra pass: RenderVKProjStochasticPasses / Adaptive) push rtr.w bits 13-17: PASS 0's K when the extra passes take
// their own (RenderVKProjStochasticAdaptiveSamples) -- pdnPassBaseWeight's exact / dense W0; 0 = this dispatch's K
uint pdnPassK0(uint ctl, uint K) { const uint k0 = (ctl >> 13u) & 31u; return k0 != 0u ? k0 : K; }
#if CLEAN_SHADOW_STAGE == SH_STAGE_SELECT || CLEAN_SHADOW_STAGE == SH_STAGE_VIS || CLEAN_SHADOW_STAGE == SH_STAGE_SHADE \
    || CLEAN_SHADOW_STAGE == SH_STAGE_MASK   // (the mask: the visibility range's layout -- the tile list is past it)
#include "clean_rt_mover_probe.glsl"   // (RTP_X: the mover-exact record -- defines only)
// ---- (#1031) A LIGHT SAMPLE'S VISIBILITY (binding 27): bit 31 coloured; mono (r = g = b, every opaque
//      / grey-translucent / budget result): bits 0-23 the value as unorm24 (exact in a float; unorm30 was
//      not: 1.0 * (2^30 - 1) rounds to 2^30 in fp32, which overflowed into bit 30 and read back 0 -- fully
//      lit samples went dark and only penumbrae lit, the 'only the edges of a light' bug); coloured (#735
//      foliage / RGB translucency): unorm10 r, g, b. Bit 30 (#1052): the sample is occlusion EVIDENCE
//      (occEvidence: VIS's verdict for SHADE's note; always set under the hard rules) ----
uint pdnVisSlots() { return g_draw_push.rtr3.w & 0x7FFFFFFFu; }   // (push: the slots per texel, uniform)
// (RenderVKShadowMoverMask 2) bit 31: this VIS dispatch runs THE MOVER-EXACT JOBS (the host's second dispatch)
bool pdnVisExactPass() { return (g_draw_push.rtr3.w & 0x80000000u) != 0u; }
// The visibilities' first word (past the header and the job list)
uint pdnVisBase(ivec2 D) { return 4u + pdnTexels(D) * pdnVisSlots(); }   // (#1608: every view's texels' jobs)
#define PDN_JOB_SLOT_BITS 5u   // a job: texel << 5 | slot (slots <= 22)
#define PDN_VIS_EVIDENCE 0x40000000u
// (RenderVKReSTIRRadiance, RS_F_VIS_REUSE) bit 29 of a MONO word (bits 24-29 are free there; a coloured word uses
// them): the sample's rays met a MOVING caster (rtNoteBlocker: an avatar, an attachment, a moved / spinning prim)
// -- carried on monochrome samples in radiance mode (pdnVisMover): SHADE's
// visibility reuse does not zero a reservoir for a blocker that will have moved by the next frames
#define PDN_VIS_MOVER 0x20000000u
uint pdnVisMover(vec3 v, bool mover)
{
    return (mover && pdnRadOn() && v.r == v.g && v.g == v.b) ? PDN_VIS_MOVER : 0u;
}
bool pdnVisMoverOf(uint w) { return (w & (0x80000000u | PDN_VIS_MOVER)) == PDN_VIS_MOVER; }
uint pdnVisPack(vec3 v, bool evidence)
{
    v = clamp(v, vec3(0.0), vec3(1.0));
    const uint ev = evidence ? PDN_VIS_EVIDENCE : 0u;
    if (v.r == v.g && v.g == v.b) return ev | uint(round(v.r * 16777215.0));
    const uvec3 q = uvec3(round(v * 1023.0));
    return 0x80000000u | ev | q.r | (q.g << 10u) | (q.b << 20u);
}
vec3 pdnVisUnpack(uint w)
{
    if ((w & 0x80000000u) == 0u) return vec3(float(w & 0x00FFFFFFu) * (1.0 / 16777215.0));
    return vec3(float(w & 1023u), float((w >> 10u) & 1023u), float((w >> 20u) & 1023u)) * (1.0 / 1023.0);
}
// ---- (RenderVKShadowMoverMask 2) THE MOVER-EXACT JOBS (PDN_OPT_MOVER_EXACT; LLCleanRendererVK mPdnVisExact): past the
//      light-sample visibilities, cap = N (the denoiser extent's w x h -- the render extent, never grown) jobs:
//   [base]                 the header: the job count, then the second VIS dispatch's (ceil(min(count, cap) / 64), 1, 1)
//                          (the host resets it with the first list's)
//   [base + 4 + e]         job e: texel << 8 | light index (SELECT) -- VIS then rewrites it as its RESULT: light index |
//                          256 the ray met a MOVING caster (rt_block_dyn) | half(the nearest blocker's distance) << 16
//   [base + 4 + cap + e]   its visibility (pdnVisPack)
//   A texel is MOVER-EXACT (pdnMoverExactPlan) when a light it takes has a mover candidate on its segment -- the shared
//   mover cull, geometry only -- or its mover countdown (MOT w) runs; it reserves one job per light reaching it, all or
//   none: past cap it stays stochastic this frame (counted, the VKMoverShadow line). SHADE sums its lights' own terms x
//   these visibilities (THE EXACT SUM): sum t_i V_i, no sampling, no ratio. ----
uint pdnExactCap(ivec2 D)  { return pdnTexels(D); }   // (#1608: every view's texels; the job word's texel is view-inclusive)
uint pdnExactBase(ivec2 D) { return pdnVisBase(D) + pdnTexels(D) * pdnVisSlots(); }
uint pdnExactJob(ivec2 D, uint e) { return pdnExactBase(D) + 4u + e; }
uint pdnExactVisW(ivec2 D, uint e) { return pdnExactBase(D) + 4u + pdnExactCap(D) + e; }
bool pdnExactOn(ivec2 D)
{
    const uint cap = pdnExactCap(D);
    return (pdnOpts() & PDN_OPT_MOVER_EXACT) != 0u && cap < (1u << 24u)   // (the job word's texel: 24 bits)
        && uint(pdn_vis.length()) >= pdnExactBase(D) + 4u + 2u * cap;
}
// ---- (RenderVKProjStochasticAdaptive) THE ADAPTIVE TILE LIST (LLCleanRendererVK mPdnVisTiles): in the mover-exact list's
//      place past the visibilities (the host never allocates both -- the adaptive passes refuse to run beside the exact
//      list), T = ceil(D / 8) tiles of 8 x 8 denoiser texels (SELECT / SHADE's workgroup):
//   [base + 0..3]          the listed count, then SELECT / SHADE's indirect dispatch (min(n, PDN_AD_ROW), rows, 1)
//   [base + 5..7]          the MASK's tile counts per class 1..3 (penumbra / young history / moving caster)
//   [base + 8]             the threshold class's admission counter (the cap: higher classes first)
//   [base + 9..11]         the mask's penumbra diagnostics; [base + 12..14] the extra SELECTs' multi-ray counts
//                          (PDN_AD_W_EXACT / MULTI / XRAYS -- the VKShadow line only)
//   [base + 16 + i]        listed tile i: x | y << 16 (tile coordinates)
//   [base + 16 + T + t]    tile t's class (the MASK's first phase; the LIST phase reads it)
//   The host resets words 0..15 before the MASK, every adaptive frame (nothing carries across frames: the RT lighting
//   scratch's GI records overwrite the range later in the frame). ----
#define PDN_AD_ROW 65535u
#define PDN_AD_HDR 16u
// (#1608) every view's tiles, view v's tile rows after the first v views' (pdnTexel's numbering): tile t = (v x tilesY +
// ty) x tilesX + tx, a listed tile x | row << 16 with that row (pdnAdaptTexel recovers the view). One view: as before.
uint pdnAdaptTileCount(ivec2 D) { return uint((D.x + 7) / 8) * uint((D.y + 7) / 8) * uint(kViewCount); }
