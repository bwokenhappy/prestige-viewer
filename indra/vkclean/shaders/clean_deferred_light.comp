}
void emAdmitOffers()
{
    const uint bucket = gl_GlobalInvocationID.x;
    if (bucket >= EM_BUDGET_OBJECTS || rg_cells[emCcHdr(49u)].y == 0u) return;
    const uint iw = emBudgetIdWord(bucket), ow = emBudgetOfferWord(bucket), tw = emBudgetTicket(bucket);
    const uvec2 offer = rg_cells[ow], owner = rg_cells[iw];
    if (offer.x == 0u) return;
    // Stable eligible cohorts receive up to eight builds of service-before-replacement.
    // A malformed/now-ineligible owner cannot lock a colliding new light indefinitely.
    const uvec2 tenure = rg_cells[tw+9u];
    if (owner.x != 0u && owner.x != offer.x && tenure.x == owner.x
        && rg_cells[emCcHdr(0u)].x - tenure.y < 8u
        && (rg_cells[tw+7u].y & 0x80000000u) == 0u) return;
    const uint size = min(floatBitsToUint(g_draw_push.rtr.x),min(uint(rt_instances.length()),uint(rt_geom.length())));
    if (offer.x - 1u < size && offer.y != 0u && offer.y == emInputGeneration(offer.x - 1u))
    {
        rg_cells[iw] = offer;
        if (any(notEqual(owner,offer)))
        {
            rg_cells[tw+9u] = uvec2(offer.x,rg_cells[emCcHdr(0u)].x);
            rg_cells[tw+7u].y = 0u;
        }
        if (owner.x != 0u && owner.x != offer.x) atomicAdd(rg_cells[emCcHdr(49u)].x,1u);
    }
