//   * below RTR_STOCH_ROUGH (clean_rt_refl_temporal.h rrtResolve, its header says why the old
//     box + anti-lag reset made the reflection "dance"): clamped by the gather's spread and the
//     pixel's own temporal deviation (a per-channel log variance it keeps), reset toward this
//     frame only where the history is RRT_TEST such deviations off the gather mean, else a
//     running mean of up to rtrHistFrames frames (RTR_HIST_SMOOTH on a mirror, RTR_HIST_ROUGH
//     on a rough lobe; RTR_HIST_RR while DLSS RR accumulates on top: rtt_opts4 bit 2);
//   * -> the history layers of this frame's parity: par (rgb, a = the receiver's view depth;
//     0 = none) and 2 + par (rgb the temporal variance, a the history length in frames).
// Layers ping-pong with the tile list header's parity (rtt_param.w bit 8).
#include "clean_rt_refl_temporal.h"
// (#1608 STEREO) 4 x N layers: history layer k of view v at k x N + v (the projector slots' interleave, DS_PROJ_TEXEL);
// each view reprojects only its own layers through its own previous camera (ssr.views[CLEAN_VIEW].taa_prev_vp). One
// view: layer k, as before.
layout(set = 3, binding = 24, rgba16f) uniform image2DArray uRtHist;
#define RTH_TEXEL(p, k) ivec3((p), int(k) * kViewCount + DEFER_LAYER)
#define RTR_HIST_SMOOTH 8.0    // frames: a mirror-smooth lobe
#define RTR_HIST_ROUGH 16.0    // ... a rough lobe (roughness 0.6 and up)
// DLSS RR (rtt_opts4 bit 2: it reconstructs with #870 raw routing on, RenderVKDlssRawSignals != 0):
// the network accumulates the lit result over its own history (its specular reprojection by the
// guide's hit distance). Ours only has to break up the sparse ray lattice it cannot denoise; a full
// length on top stacked two histories -- twice the lag on a moving reflection.
#define RTR_HIST_RR 4.0
float rtrHistFrames(float rough)
{
    // (frame-based histories on this branch: the timing contract is frames, not history_time)
    const float n = mix(RTR_HIST_SMOOTH, RTR_HIST_ROUGH, smoothstep(0.05, 0.6, rough));
    return (rtt_opts4 & 4u) != 0u ? min(n, RTR_HIST_RR) : n;
}
bool rtrTemporalOn() { return (rtt_opts4 & 2u) != 0u; }   // (a header word: uniform)
float g_rtr_hist_lum = -1.0;   // (rtrTemporal: the reprojected history's luminance, -1 none -- the dark-flip counter)
// (#1606) LOW-SAMPLE GUARD (RenderVKRTReflectionsLowSampleGuard, rtt_opts4 bit 5): the stochastic glossy box below
// clamps the history to [.., 8 x max(mu, res) + 3 x spread]. A gather of ONE effective sample has no spread, so a
// single black lobe sample -- a back-face stop at a concave contact edge (rtrTraceRefl: black by design), a hit in an
// unlit corner -- put that bound at ~0 and wiped the whole history: the pixel went black and climbed back at the EMA
// rate (the owner's native clip: wall cells near its edges dropping ~40 % and ramping back over ~10 frames, again
// and again as the rotating lattice put a bad site under them). The box only exists to drop gross changes; it is
// trusted in proportion to the gather's effective sample count: none at nEff <= 1, fully from RTR_GUARD_N (2: a
// full-density 3 x 3 gather holds ~4 effective samples -- only near-single-sample gathers, the edge cells, relax).
#define RTR_GUARD_N 2.0
bool rtrLowNGuard() { return (rtt_opts4 & 32u) != 0u; }   // (a header word: uniform)
// STOCHASTIC GLOSSY RAYS (rtrStochastic: the trace samples the GGX lobe): each frame's gather holds a few
// lobe samples, and a small bright emitter is in only some of them -- the per-frame estimate is unbiased
// but noisy. The mirror path's box (this frame's mean +- 1.25 sigma) and its anti-lag cut every frame
// that happened to miss the emitter back to the floor colour (the reflection flickered and averaged ~70 %
// too dark: indra/newview/tests/rtrefl_rough_emitter_fixture.py). Here the history follows a longer EMA (8 frames at
