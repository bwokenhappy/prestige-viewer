    const bool visOut = (g_draw_push.flags & DEFER_FLAG_VIS_REUSE) != 0u;
    if (!deferHasSurface(g2))   // (the combine never reads sky pixels; the forward reuse does)
    {
        CLK_MARK(GBUF);
        if (visOut) imageStore(uVisDepth, DS_TEXEL(px), uvec4(0u));
        CLK_MARK(STORE);
        return;
    }
    CLK_SURF();
#if CLEAN_DEFER_PASS != 10
    const vec3 P = deferPosition(px);
#endif
    float glow;
    bool noFade;
    const SurfaceLit s = deferSurface(px, g2, glow, noFade);
    CLK_MARK(GBUF);
    // Sun / moon: exactly lightSurface's evaluation (same pixels, same call).
    vec3 tint = vec3(1.0);
    float vis = 1.0;
    const bool sunWant = surfaceSunWant(s, atmosLightDir());
    if (sunWant) vis = deferSunMerged() ? deferMergedSunT(P, s.Ng, tint) : sunShadowT(P, s.Ng, tint);
