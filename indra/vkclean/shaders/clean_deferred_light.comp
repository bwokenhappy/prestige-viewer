// ---- (RenderVKProjStochasticAdaptive) THE NEEDS-RAYS MASK -> THE ADAPTIVE TILE LIST. After pass 0's SHADE, before the
//      extra passes; two phases of one kernel (push rtr3.z bit 20), no CPU readback, nothing carried across frames.
//   MASK (bit 20 clear; one 8 x 8 workgroup per tile, the extra passes' workgroup): each surface texel's CLASS from what
//   pass 0 and last frame's denoiser already wrote --
//     3 MOVING CASTER: a ray of pass 0 met a moving caster (MOT w bit 8) or last frame's denoiser still counts the
//       texel moving-caster affected (its MOVER CARRY, GEOM w of the other parity at the reprojected texel)
//     2 YOUNG HISTORY: no history to reproject (camera-only reprojection outside the extent / onto another depth --
//       last frame's GEOM depth against MOT z, the denoiser's 4 % tolerance; a whole new history: push rtr3.z bit 21
//       clear), a caster deviation still pending (GEOM w bits 16-17), or a light that moved this frame (MOT w bits 0-7)
//     1 PENUMBRA (NOISE): THIS FRAME'S PICKS DISAGREE -- pass 0's pick list holds one light at least twice (the
//       reservoir's pick and a fresh one, or two fresh streams) and one of its rays reached that light while another was
//       blocked: that light's own visibility is strictly between 0 and 1 at the texel (a soft penumbra, a caster edge
//       inside the disc) -- the variance more rays reduce (pdnAdaptPicksDisagree). Read from pass 0's descriptors and
//       visibilities, still intact here (the extra passes overwrite them after the mask).
//       (2026-11-15) THE OLD RULE (RenderVKProjStochasticAdaptiveRule 1, push rtr3.z bit 22) instead: the AGGREGATE
//       visibility MIXED -- pass 0's evidence (MOT w bits 9-13: the picks' light-weighted visible share) or last frame's
//       accumulated prior (GEOM w bits 0-9) strictly between 3 % and 97 %, or the evidence 25 % off the prior. Under
//       many lights a mixed aggregate (one lamp blocked, the next one not) is the normal state of a texel, not noise:
//       it flagged 74 % of the tiles (owner, 2026-11-15, Adaptive 3). Both rules are counted every frame (the header's
//       diagnostic words) so the VKShadow line shows the before / after shares whichever one drives the list.
//   A tile takes the highest class at least PDN_AD_MIN of its texels reach (one stray texel lists nothing); its class
//   goes to the tile array, its count to the class histogram.
//   LIST (bit 20 set; one thread per tile, 64 per workgroup): the budget B (push rtr2.w, tiles: RenderVKProjStochastic-
//   AdaptiveCap of the extent, else all) admits the classes from 3 down -- the threshold class (the lowest one admitted)
//   only up to what is left of B, first come -- and appends each admitted tile with its dispatch rows (the forward tile
//   list's pattern). Radiance mode only (the host's rule): the MOT evidence and the GEOM prior are radiance words. ----
#define PDN_AD_MIN 2u
#define PDN_AD_OLD_RULE 0x400000u   // (push rtr3.z bit 22: RenderVKProjStochasticAdaptiveRule 1, the mixed-visibility rule)
// the tile list header's DIAGNOSTIC words (the VKShadow line only): the tiles the old mixed-visibility rule / the
// picks-disagree rule list as penumbra (no higher class there), and those the old rule's spread test alone flags
#define PDN_AD_W_OLD_PEN  9u
#define PDN_AD_W_NEW_PEN 10u
#define PDN_AD_W_SPREAD  11u
shared uint s_adCnt[4];
shared uint s_adPen[3];   // the tile's texels: [0] the old rule's penumbra, [1] the picks disagree, [2] spread alone
shared uint s_adZ;        // (LVC stage 1) the tile's nearest surface view depth (float bits: positive, ordered as uint)
// THE NOISE TEST: pass 0's pick list at texel m holds a light twice or more, one of its rays reaching it (visibility
// > 0.5) and another blocked. Exact / dense / mover-exact lists evaluate every light once (no such pair); a lone reused
// pick has nothing to disagree with.
bool pdnAdaptPicksDisagree(ivec2 m, ivec2 D)
{
    const uint sdi = pdnSelIndex(m, D);
    const uvec4 sd0 = pdn_sel[sdi];
    if ((sd0.x & PDN_SEL_SURF) == 0u || (sd0.x & (PDN_SEL_DENSE | PDN_SEL_EXACT)) != 0u) return false;
    const PdnSelD d = pdnSelLoad(sdi, sd0);
    if (d.Ke < 2u) return false;
    const uint slots = pdnVisSlots();
    const uint gate = pdn_sel[sdi + 3u].z;
    const uint n = min(min(d.nProj, d.Ke), min(slots, PDN_GATE_CD_SHIFT));
    const uint vb = pdnVisBase(D) + pdnTexel(m, D) * slots;
    [[dont_unroll]] for (uint j = 1u; j < n; ++j)
    {
        if (((gate >> j) & 1u) == 0u) continue;
        const uint lj = pdnSelPickLi(d, j);
        if (lj == 0xFFFFFFFFu) continue;
        const vec3 vj = pdnVisUnpack(pdn_vis[vb + j]);
        const bool hj = max(max(vj.r, vj.g), vj.b) > 0.5;
        [[dont_unroll]] for (uint k = 0u; k < j; ++k)
        {
            if (((gate >> k) & 1u) == 0u || pdnSelPickLi(d, k) != lj) continue;
            const vec3 vk = pdnVisUnpack(pdn_vis[vb + k]);
            if ((max(max(vk.r, vk.g), vk.b) > 0.5) != hj) return true;
        }
    }
    return false;
}
// (LVC STATS counter 4) a texel pass 0's rays flagged moving-caster: counted, and counted REDUNDANT when every mover-
// flagged light sample in its list also met a static blocker (VIS's static-only walk: PDN_VIS_LVC_RED) -- the texel
// rule 4.1 ("a mover matters only where it is the blocker") would leave unflagged. g_lvc_mask: the texel's bits for the
// MASK's subgroup sums (1 pass 0's mover bit, 2 the carry alone, 4 redundant).
uint g_lvc_mask = 0u;
bool lvcMaskRedundant(ivec2 m, ivec2 D)
{
    const uint sdi = pdnSelIndex(m, D);
    const uvec4 sd0 = pdn_sel[sdi];
    if ((sd0.x & PDN_SEL_SURF) == 0u) return false;
    const PdnSelD d = pdnSelLoad(sdi, sd0);
    const uint slots = pdnVisSlots();
    const uint gate = pdn_sel[sdi + 3u].z;
    const uint n = min(min(pdnSelSamples(d), slots), PDN_GATE_CD_SHIFT);
    const uint vb = pdnVisBase(D) + pdnTexel(m, D) * slots;
    uint nMv = 0u, nRed = 0u;
    [[dont_unroll]] for (uint j = 0u; j < n; ++j)
    {
        if (((gate >> j) & 1u) == 0u) continue;
        const uint w = pdn_vis[vb + j];
        if ((w & 0x80000000u) != 0u || ((w >> 24u) & 15u) == 0u) continue;   // (mono words with a mover kind only)
        ++nMv;
        if ((w & 0x10000000u) != 0u) ++nRed;
    }
    return nMv > 0u && nRed == nMv;
}
// The texel's class (0 none, 1 penumbra, 2 young history, 3 moving caster) under the rule the push names. pen (the
// diagnostics): bit 0 the old rule's penumbra, bit 1 the picks disagree, bit 2 the old rule's spread test alone
uint pdnAdaptTexelClass(ivec2 m, ivec2 D, uint par, bool histOk, out uint pen)
{
    pen = 0u;
    if (any(greaterThanEqual(m, D))) return 0u;
    const uvec4 g = imageLoad(uPdnGeom, ivec3(m, PDN_L(int(par))));
    if (!(uintBitsToFloat(g.x) > 0.0)) return 0u;   // (no surface: SELECT stored -1)
    const uvec4 mo = imageLoad(uPdnMot, PDN_MOT(m));
    if ((mo.w & 256u) != 0u)
    {   // (pass 0's rays met a moving caster)
        if (occStatsOnly()) g_lvc_mask = 1u | (lvcMaskRedundant(m, D) ? 4u : 0u);   // (LVC STATS counter 4)
        return 3u;
    }
    // last frame's denoiser verdict at the camera-only reprojection (MOT x: the previous texel's delta, z its view depth)
    bool young = !histOk;
    float prior = -1.0;
    if (histOk)
    {
        const float pw = uintBitsToFloat(mo.z);
        const ivec2 q = ivec2(floor(vec2(m) + unpackHalf2x16(mo.x) + 0.5));
        young = true;
        if (pw > 0.0 && all(greaterThanEqual(q, ivec2(0))) && all(lessThan(q, D)))
        {
            const uvec4 h = imageLoad(uPdnGeom, ivec3(q, PDN_L(int(par ^ 1u))));
            const float pz = uintBitsToFloat(h.x);
            if (pz > 0.0 && abs(pz - pw) <= 0.04 * pw)
            {
                if (pdnMetaCarry(h.w) > 0u)   // (THE MOVER CARRY: moving-caster affected last frame)
                {
                    g_lvc_mask = 2u;   // (LVC STATS counter 4)
                    return 3u;
                }
                young = pdnMetaPending(h.w) != 0u;       // (a caster deviation pending / the drop mark)
                prior = pdnMetaVisibility(h.w);
            }
        }
    }
    if (young || (mo.w & 255u) >= 64u) return 2u;   // (a quarter of the weight from lights that moved this frame)
    const float now = pdnVisibilityValue(mo.w >> 9u);
    const bool mixedNow = now > 0.03 && now < 0.97;
    const bool mixedPrior = prior > 0.03 && prior < 0.97;
    const bool spread = now >= 0.0 && prior >= 0.0 && abs(now - prior) > 0.25;
    const bool oldPen = mixedNow || mixedPrior || spread;
    const bool newPen = pdnAdaptPicksDisagree(m, D);
    pen = (oldPen ? 1u : 0u) | (newPen ? 2u : 0u) | (spread && !mixedNow && !mixedPrior ? 4u : 0u);
    return ((g_draw_push.rtr3.z & PDN_AD_OLD_RULE) != 0u ? oldPen : newPen) ? 1u : 0u;
}
// ---- (LVC NOISE, RenderVKShadowNoiseStats; push rtr3.z bit 24) THE NOISE PHASE: after the last extra pass, one 8 x 8
//      workgroup per tile, each surface texel's luminance of pass 15's final estimate (IN layers 0 + 1: diffuse +
//      specular radiance) against the same texel's last frame (LVC_NOISE_BASE; a still camera: no reprojection), summed
//      per group (LVC_S_NOISE: all, unflagged, listed, cut by the cap, far / near flagged tiles) -- the temporal noise
//      the denoiser gets, and where the cap's cut lands. Statistics only: nothing reads it back on the GPU. ----
void lvcNoiseAdd(uint g, bool in_, float d, float L)
{
    const uint n = subgroupAdd(in_ ? 1u : 0u);
    const float sd = subgroupAdd(in_ ? d : 0.0), sl = subgroupAdd(in_ ? L : 0.0);
    if (subgroupElect() && n != 0u)
    {
        lvcStatAdd(LVC_S_NOISE + 3u * g, n);
        lvcStatAdd(LVC_S_NOISE + 3u * g + 1u, uint(min(sd * 64.0, 4.0e9)));
        lvcStatAdd(LVC_S_NOISE + 3u * g + 2u, uint(min(sl * 64.0, 4.0e9)));
    }
}
void lvcNoisePhase(ivec2 D, uint b, uint T, uint tilesX)
{
    const ivec2 m = ivec2(gl_GlobalInvocationID.xy);
    const bool inD = all(lessThan(m, D));
    const uint par = (uint(g_draw_push.rtr.w + 0.5) >> 4u) & 1u;
    bool surf = false;
    float L = 0.0;
    if (inD)
    {
        surf = uintBitsToFloat(imageLoad(uPdnGeom, ivec3(m, PDN_L(int(par)))).x) > 0.0;
        const vec3 c = imageLoad(uPdnIn, ivec3(m, PDN_L(0))).rgb + imageLoad(uPdnIn, ivec3(m, PDN_L(1))).rgb;
        L = max(dot(c, vec3(0.2126, 0.7152, 0.0722)), 0.0);
