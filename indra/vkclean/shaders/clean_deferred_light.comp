// The staged run as prefix sums (index i: the sum over entries < i), fixed point: x y z = lane
// values, w = the skin count (texels); the second array's w (horizontal: the int itself) = the
// barrier count (boundaries < i ... see sssBarrier). Before the scan, s_sssQ[e].xy holds entry e's
// mean eye distance (float bits; -1: no skin) and whether a depth jump lies inside it.
shared ivec4 s_sssQ[SSS_ENT_MAX + 1];
#ifdef CLEAN_SSS_VERTICAL
