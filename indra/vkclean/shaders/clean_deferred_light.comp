        vec3 o, Ro;
        rtrOccRay(P, R, o, Ro);
        ov = clamp(traceShadowRay(o, Ro, 0.0, RTR_OCC_FAR, RT_MASK_WORLD_BLOCK), 0.0, 1.0);
    }
    const vec4 r = vec4(sv, ratio, ov, clamp(ls.base.a, 1e-3, 1.0));
    return any(isnan(r)) || any(isinf(r)) ? vec4(1.0, 1.0, 1.0, 1e-3) : r;
}
