        rec.q[b + 3u] = uvec4(floatBitsToUint(h.o2w[1]), floatBitsToUint(h.o2w[2].x));
        rec.q[b + 4u] = uvec4(floatBitsToUint(h.o2w[2].yz), floatBitsToUint(h.o2w[3].xy));
    }
    rec.q[b + 5u] = uvec4(floatBitsToUint(h.hit ? h.o2w[3].z : 0.0), floatBitsToUint(o));
