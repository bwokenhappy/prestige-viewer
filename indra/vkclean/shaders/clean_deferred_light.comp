const vec3 SSS_DBG_BAND[11] = vec3[11](vec3(0.25, 0.25, 0.25), vec3(0.55, 0.0, 0.55), vec3(0.35, 0.0, 0.95),
                                       vec3(0.0, 0.3, 1.0), vec3(0.0, 0.8, 0.9), vec3(0.0, 0.8, 0.2),
