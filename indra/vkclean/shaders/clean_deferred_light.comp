// The denoised sun / moon visibility x tint at this pixel (layer 2 of the final image): its own
// texel at the render extent, else the depth-aware 4-tap upsample (the final a-trous iteration
// wrote each texel's view depth into alpha) -- PLANE-AWARE as the RT shadow mask's (rt_mask.x 2,
// clean_shadow_mask_read.glsl): each tap's depth is compared with the depth THIS pixel's receiver
// plane (P, its G-buffer geometric normal Ng) has at the render pixel that tap sampled, so a
// sloped receiver (ground at a grazing view) keeps all four taps instead of collapsing to the
// closest one (stair-stepped, swimming shadow edges).
vec3 deferPdnSunFetch(vec3 P, vec3 Ng)
{
    // (push constant / frame info: uniform; #1660 a stale frame takes the identity from the frame info)
    const bool stale = (g_draw_push.flags & DEFER_FLAG_PSTOCH) == 0u;
    const bool fin = stale ? ssr.rt_mask.z < -1.5 : (g_draw_push.flags & DEFER_FLAG_PSTOCH_IN) != 0u;
    const bool halfExt = stale ? ssr.rt_mask.w > 0.5 : (g_draw_push.flags & DEFER_FLAG_PSTOCH_HALF) != 0u;
    const ivec2 dims = fin ? imageSize(uPdnIn).xy : imageSize(uPdnOut).xy;
    const ivec2 mx = dims - 1;
    if (!halfExt)
    {
        const ivec2 q = clamp(ivec2(CLEAN_FRAG_XY), ivec2(0), mx);
        return fin ? imageLoad(uPdnIn, ivec3(q, PDN_L(2))).rgb : imageLoad(uPdnOut, ivec3(q, PDN_L(2))).rgb;
    }
    const vec2 R = vec2(float(g_draw_push.width), float(g_draw_push.height));
    const vec2 r = vec2(dims) / R;
    const vec2 j = ssr.taa_params.w > 0.5 ? ssr.taa_jitter.xy : vec2(0.0);
    const vec2 f = (linfo.fwd.z & 4u) != 0u
        ? pdnSampleGridHc(CLEAN_FRAG_XY, 1.0 / r, j)
        : CLEAN_FRAG_XY * r - 0.5 - j;
    const ivec2 b = ivec2(floor(f));
    const vec2 fr = f - vec2(b);
    GIR_PREC const float vz = dot(P - linfo.cam_pos.xyz, linfo.cam_fwd.xyz);
    const vec3 Pe = P - pc.u_cam_time.xyz;   // (eye-relative: inv_vp_rel's space)
    const float pn = dot(Pe, Ng);
    vec4 bw, e;
    vec4 t[4];
    [[unroll]] for (int k = 0; k < 4; ++k)
    {
        const ivec2 o = ivec2(k & 1, k >> 1);
        const ivec2 tp = clamp(b + o, ivec2(0), mx);
        bw[k] = (o.x == 1 ? fr.x : 1.0 - fr.x) * (o.y == 1 ? fr.y : 1.0 - fr.y);
        t[k] = fin ? imageLoad(uPdnIn, ivec3(tp, PDN_L(2))) : imageLoad(uPdnOut, ivec3(tp, PDN_L(2)));
        // the render pixel texel tp sampled (pass 15: floor((tp + 0.5 + J) / r)) through this
        // pixel's receiver plane; bounded (a broken plane cannot pass)
        float zp = vz;
        {
            const vec2 spx = floor((vec2(tp) + 0.5 + j) / r) + 0.5;
            const vec4 h = deferInvVP * vec4(spx / R * 2.0 - 1.0, 1.0, 1.0);
            const vec3 dir = h.xyz / h.w;
            const float dn = dot(dir, Ng);
            if (abs(dn) > 1e-6 * length(dir))
            {
                const vec3 Pt = dir * (pn / dn) + pc.u_cam_time.xyz;
                zp = clamp(dot(Pt - linfo.cam_pos.xyz, linfo.cam_fwd.xyz), 0.75 * vz, 1.25 * vz);
            }
        }
        const float tol = max(zp * 0.015, 0.03);
        e[k] = t[k].a > 0.0 ? abs(t[k].a - zp) / tol : 1e30;
    }
    const vec4 w = upsampleWeights4(bw, e, vec4(1.0));
    vec3 v = vec3(0.0);
    [[unroll]] for (int k = 0; k < 4; ++k) v += w[k] * t[k].rgb;
    return v;
}
// sunShadowT's contract on the merged channel: the same early-outs (sun shadows off, the debug
// switch, past the shadowed range: lit), visibility = the channel's max, tint = rgb / max (the
// RT mask path of sunShadowTCore), x the volumetric cloud shadow (applied at the consumer, never
// in a history).
float deferMergedSunT(vec3 P, vec3 Ng, out vec3 tint)
{
    tint = vec3(1.0);
    float core = 1.0;
    GIR_PREC const float vz = dot(P - linfo.cam_pos.xyz, linfo.cam_fwd.xyz);
    // rt_mask.x = -2: the weak-sun gate traced no sun / moon ray this frame and the denoiser
    // skipped the sun channel (its image is stale): lit, as every texel's raw value would be
    if (specSunOn() && !litDbg(LDBG_NO_SUN_SHADOW) && vz < ssr.shadow_clip.w && !(ssr.rt_mask.x < -1.5))
    {
