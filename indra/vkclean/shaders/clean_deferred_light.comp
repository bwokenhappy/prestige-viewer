        while (rayQueryProceedEXT(q)) {}
        if (rayQueryGetIntersectionTypeEXT(q, true) == gl_RayQueryCommittedIntersectionNoneEXT) return tmax;
        const float t = rayQueryGetIntersectionTEXT(q, true);
        const uint id = rtHitInstance(uint(rayQueryGetIntersectionInstanceCustomIndexEXT(q, true)),
                                      uint(rayQueryGetIntersectionGeometryIndexEXT(q, true)));
        vec3 fa = vec3(0.0), fb = vec3(0.0);
        if (rtMoverKind(id) != 0u || lvcInstDynamic(id) || rtFixtureBox(id, q, true, fa, fb)) { t0 = t + 0.002; continue; }
        return t;
