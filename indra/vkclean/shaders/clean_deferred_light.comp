#ifdef CLEAN_RT_HANG_BEACON
// ---- (#1128) THE HANG BEACON (RenderVKRTHangBeacon; LLCleanRendererVK mRtBc, rtHangBeaconReport) ----
// A GPU hang in a ray-query kernel leaves no trace of WHICH ray: every shader loop is bounded, so a lane that
// never finishes is inside one ray query's traversal (or the driver's code around it). The beacon twins of the
// ray-query kernels (CLEAN_RT_BC_KERNEL = LLCleanRendererVK kRtBcKernel*) write each lane's query into
// HOST-VISIBLE memory before it starts (clean_rt_common.glsl rtRaySane -> rtBeaconQuery) and DONE when the lane's
// body returns (the main() wrapper at the end of this file); the device-lost report lists the slots left IN QUERY.
// No push word: the address sits in the lit guard buffer, lg_words[LG_BC_WORD .. + 1], [+ 2] = RTBC_MAGIC (or
// RTBC_SELFTEST) -- written by the host every frame while the beacon is on (rtBcFrameBegin).
// The buffer, in uvec4:
//   [0]       host, every frame: x the frame tag (24 bits, non-zero), y the slot count, w RTBC_MAGIC
//   [1], [2]  the list trace's first lane (kernel 1): the ray list's count / dispatch x y z, capacity / tile count /
//             gl_NumWorkGroups.xy; [3] x the tag it read, y gl_NumWorkGroups.z, z push rtr3.x
//   [15]      x: the self test spins until it equals RTBC_SELFTEST (the host never writes it)
//   [16 + k]  kernel k's first lane, every dispatch: x the tag it read, yzw gl_NumWorkGroups
//   [64 + 3 s ..] slot s (a lane claims (its id + k x 0x9E3779B1) mod the slot count at its FIRST query and never
//             overwrites a slot still in a query -- a hung lane keeps its record):
//             .0 x = tag << 8 | state (2 in a query, 3 done), y the lane id (list entry / global index), z its pixel
//                (x | y << 15; else gl_GlobalInvocationID.xy), w = site (RT_BC_SITE_*) | query ordinal << 16 | bit 24
//                the guard's verdict ok | bit 25 folded (float ok, bits refused) | bit 26 the query budget refused it |
//                kernel << 27
//             .1 the query's origin bits, tmin bits   .2 its direction bits, tmax bits (as the caller passed them)
#ifndef CLEAN_RT_BC_KERNEL
#error "CLEAN_RT_HANG_BEACON needs CLEAN_RT_BC_KERNEL (LLCleanRendererVK kRtBcKernel*)"
#endif
#ifdef CLEAN_SHADER_CLOCK
#error "CLEAN_RT_HANG_BEACON and CLEAN_SHADER_CLOCK both wrap main()"
#endif
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference_uvec2 : require
#define LG_BC_WORD      60u   // = LLCleanRendererVK::kLgBcWord
#define RTBC_HDR        64u
#define RTBC_SLOT_MASK  ((1u << 21) - 1u)   // = LLCleanRendererVK::kRtBcSlots - 1
#define RTBC_MAGIC      0x1128BEACu
#define RTBC_SELFTEST   0x1128DEADu
#define RTBC_QUERY      2u
#define RTBC_DONE       3u
layout(buffer_reference, std430, buffer_reference_align = 16) coherent buffer RtBcBuf { uvec4 q[]; };
uint  g_bc_slot = 0xFFFFFFFFu;   // the claimed slot (its first uvec4), ~0 = none
bool  g_bc_tried = false;        // the claim ran (a busy slot: this lane records nothing)
uint  g_bc_id = 0xFFFFFFFFu;     // the lane's identity (rtBcLane), ~0 = its flattened global index
uvec2 g_bc_px = uvec2(0u);
uint  g_bc_tag = 0u;             // the frame tag << 8
uint  g_bc_n = 0u;               // queries started
bool rtBcOn()
{
    const uint m = lg_words[LG_BC_WORD + 2u];
    return m == RTBC_MAGIC || m == RTBC_SELFTEST;
}
RtBcBuf rtBc() { return RtBcBuf(uvec2(lg_words[LG_BC_WORD], lg_words[LG_BC_WORD + 1u])); }
// A kernel that knows a better identity than its global index (the list trace: the entry, its pixel).
void rtBcLane(uint id, ivec2 px) { g_bc_id = id; g_bc_px = uvec2(px); }
// (clean_rt_common.glsl rtRaySane, before every ray query of the lane: the inputs as passed)
void rtBeaconQuery(vec3 o, float tmin, vec3 d, float tmax, bool ok, bool folded)
{
    const uint site = rt_bc_site;
    rt_bc_site = 0u;
    if (g_bc_slot == 0xFFFFFFFFu)
    {
        if (g_bc_tried || !rtBcOn()) return;
        g_bc_tried = true;
        if (g_bc_id == 0xFFFFFFFFu)
        {
            const uvec3 n = gl_NumWorkGroups * gl_WorkGroupSize;
            g_bc_id = (gl_GlobalInvocationID.z * n.y + gl_GlobalInvocationID.y) * n.x + gl_GlobalInvocationID.x;
            g_bc_px = gl_GlobalInvocationID.xy;
        }
        RtBcBuf b = rtBc();
        const uint s = RTBC_HDR + 3u * ((g_bc_id + uint(CLEAN_RT_BC_KERNEL) * 0x9E3779B1u) & RTBC_SLOT_MASK);
        if ((b.q[s].x & 0xFFu) == RTBC_QUERY) return;   // (another lane is in a query there: it may be the hung one)
        g_bc_slot = s;
        g_bc_tag = b.q[0].x << 8;
    }
    g_bc_n = min(g_bc_n + 1u, 255u);
    RtBcBuf b = rtBc();
    b.q[g_bc_slot + 1u] = uvec4(floatBitsToUint(o), floatBitsToUint(tmin));
    b.q[g_bc_slot + 2u] = uvec4(floatBitsToUint(d), floatBitsToUint(tmax));
    memoryBarrierBuffer();   // (the ray before the state that names it)
    b.q[g_bc_slot] = uvec4(g_bc_tag | RTBC_QUERY, g_bc_id, (g_bc_px.x & 0x7FFFu) | ((g_bc_px.y & 0x7FFFu) << 15),
                           (site & 0xFFFFu) | (g_bc_n << 16) | (ok ? 1u << 24 : 0u) | (folded ? 1u << 25 : 0u)
                           | (ok && rt_query_left == 0u ? 1u << 26 : 0u) | (uint(CLEAN_RT_BC_KERNEL) << 27));
    memoryBarrierBuffer();
}
// The wrapper's head: the kernel's start stamp; the deliberate-hang self test (RenderVKRTHangBeaconSelfTest: the
// first beacon kernel to run with it set records a known query and never finishes -- validates the instrument).
void rtBcHead()
{
    if (!all(equal(gl_GlobalInvocationID, uvec3(0u))) || !rtBcOn()) return;
    RtBcBuf b = rtBc();
    b.q[16u + uint(CLEAN_RT_BC_KERNEL)] = uvec4(b.q[0].x, gl_NumWorkGroups);
    memoryBarrierBuffer();
    if (lg_words[LG_BC_WORD + 2u] == RTBC_SELFTEST)
    {
        RT_BC_SITE(0xF000u);
        rtBeaconQuery(vec3(1.0, 2.0, 3.0), 0.0, vec3(0.0, 0.0, 1.0), 4.0, true, false);
        [[dont_unroll]] while (b.q[15].x != RTBC_SELFTEST) {}
    }
}
void rtBcDone()
{
    if (g_bc_slot == 0xFFFFFFFFu) return;
    rtBc().q[g_bc_slot].x = g_bc_tag | RTBC_DONE;
    g_bc_slot = 0xFFFFFFFFu;
}
