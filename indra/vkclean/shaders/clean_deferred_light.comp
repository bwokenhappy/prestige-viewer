// The world mm grid at a skin pixel: x = a 1 mm line, y = a 10 mm line -- an axis plane x / y / z
// = k cells crosses between this pixel and its +x or +y skin neighbour, for the axes the skin's
// geometric normal is within ~53 deg of perpendicular to (|n_a| < 0.6: cells <= 1.25 x their size).
// z = the 1 mm cell's size in px (the smaller neighbour step), to thin the 1 mm lines out. World mm
// relative to the eye snapped down to 10 m (exact in float: the grid stays on the world's lines and
// float precision holds 0.01 mm at a 4 km skybox's height).
vec3 sssGrid(ivec2 px)
{
    const float d0 = defTexel(uDepthG, px).r;
    const vec3 E0 = sssPos(px, d0);
    const vec3 eye = pc.u_cam_time.xyz;
    const vec3 P = (E0 + (eye - floor(eye * 0.1) * 10.0)) * 1000.0;
    const vec3 n = abs(gbOctDecode(defTexel(uG1, px).zw));
    vec3 g = vec3(0.0, 0.0, 1e9);
    for (int k = 0; k < 2; ++k)
    {
        const ivec2 q = px + (k == 0 ? ivec2(1, 0) : ivec2(0, 1));
        if (!sssIsSkin(q)) continue;
        const vec3 Q = P + (sssPos(q, defTexel(uDepthG, q).r) - E0) * 1000.0;
        g.z = min(g.z, 1.0 / max(distance(Q, P), 1e-6));
        for (int a = 0; a < 3; ++a)
        {
            if (!(n[a] < 0.6)) continue;
            if (floor(P[a]) != floor(Q[a])) g.x = 1.0;
            if (floor(P[a] * 0.1) != floor(Q[a] * 0.1)) g.y = 1.0;
        }
    }
    return g;
}
