uint  rtrMarkW(float rough, float s, uint type, uint curvQ)
{
    return uint(clamp(rough, 0.0, 1.0) * 4095.0 + 0.5) | (min(curvQ, 15u) << 12)
         | (uint(clamp(s, 0.0, 1.0) * 16383.0 + 0.5) << 16) | (type << 30);
}
uint  rtrMarkRough16(uint w) { return (w & 0xFFFu) * 16u + ((w & 0xFFFu) >> 8); }   // (4095 -> 65535)
float rtrMarkCurvRho(uint w) { return float((w >> 12) & 15u) * (1.0 / 15.0); }
bool  rtrLobeOn() { return (rtt_opts4 & 1u) != 0u; }   // (a header word: uniform)
float rtrMarkStrength(uint w) { return float((w >> 16) & 0x3FFFu) * (1.0 / 16383.0); }
uint  rtrMarkType(uint w) { return w >> 30; }
float rtrStrengthFull() { return uintBitsToFloat(rtt_param3.y); }
float rtrStrengthMin()  { return uintBitsToFloat(rtt_param3.z); }
float rtrStrengthCut()  { return uintBitsToFloat(rtt_param3.w); }
// The splice's fade over the bottom of the strength range (the roughness fade's pattern): 0 at the
// cutoff (where the mark stops: no edge), 1 from the minimum-density strength up (the host keeps
// cut < min; a degenerate range falls back to a quarter of the cutoff).
float rtrStrengthFade(uint w)
{
    const float cut = rtrStrengthCut();
    const float top = max(rtrStrengthMin(), cut * 1.25 + 1e-4);
    return smoothstep(cut, top, rtrMarkStrength(w));
}
// ---- DENSITY GRADIENT (#859 perf; rtt_param2; see the header) ----
// The lowest scale the budget may set: a pixel at full density never drops below one ray per
// 2 x 2 -- so a mirror never turns sparse.
#define RTR_GRAD_SCALE_MIN 0.25
// A candidate's ray density before the budget, from its mark roughness (unorm16): rho_max at the
// sharp roughness -- the floor's density there (RenderVKRTReflectionsScale 0: 1; 1 and 2: 1/4, but
// floor 1 keeps 1 below the sharp roughness) -- falling to rho_min at the
// roughness cutoff, linearly in rho for curve 1 (rho = mix(rho_max, rho_min, t^curve)).
float rtrRhoRough(uint rough16)
{
    const uint floorL = min(rtt_param.w & 0xFFu, RTR_LEVELS - 1u);
    const float rough = float(rough16) * (1.0 / 65535.0);
    const float sharp = clamp(uintBitsToFloat(rtt_param.y), 0.0, 1.0);
    if (floorL == 1u && rough < sharp) return 1.0;
    const float rmax = floorL == 0u ? 1.0 : 0.25;
    const float rmin = clamp(uintBitsToFloat(rtt_param2.y), 1.0 / 256.0, rmax);
    const float cut = uintBitsToFloat(rtt_param2.w);
    const float t = clamp((rough - sharp) / max(cut - sharp, 1e-4), 0.0, 1.0);
    const float c = clamp(uintBitsToFloat(rtt_param2.z), 0.1, 10.0);
    return mix(rmax, rmin, pow(t, c));
}
// A candidate's ray density before the budget, from its whole mark word (rtrMarkW): the roughness
// ramp rho_r (rtrRhoRough) x the STRENGTH term -- rho = mix(min(rho_r, rho_min), rho_r, u),
// u = (s - strength min) / (strength full - strength min) clamped to [0, 1]: full roughness
// density from the full strength up, falling linearly in rho to rho_min at the minimum-density
// strength (flat below it, down to the cutoff where the mark stops). Never above rho_r (never
// more rays than the roughness ramp alone); a pixel the roughness already put at rho_min stays
// there.
// CURVATURE DENSITY (rtrCurvRho, the mark's code): never below what the receiver's curvature needs,
// whatever the floor, the roughness or the strength gave it.
// DENSE RAYS UNDER DLSS RR (rtt_param3.x bit 3, LLCleanRendererVK kRrRawReflDense; RenderVKDlssReflDense): every
// candidate casts its own ray this frame -- density 1 everywhere, no budget scale, no lattice -- and the resolve
// splices that ray raw (bit 2 is set with it), so the network gets one per-pixel sample per candidate instead of a
// sparse lattice next to filtered pixels (a screen-space pattern it cannot denoise). Host-set only while DLSS Ray
// Reconstruction reconstructs: every other frame keeps the density gradient exactly.
// THE CAP (never half dense): the frame goes dense only while its candidates fit the ray budget the sparse path
// already allows (rtt_param3.x bits 8-31 x 256 rays, host: RenderVKRTReflectionsRayBudget x the render pixels;
// 0xFFFFFF none), with a deadband
// (back in below 80 % of it). Over it the WHOLE frame stands down to the density gradient and our filtered resolve
// (no raw splice), so dense never costs more rays than the budget. Decided by the selection (passes 11 / 16: every
// workgroup computes the same answer from the header -- the mark passes' final candidate count and last frame's
// state, rtt_dense[parity ^ 1]; the entry-0 workgroup stores this frame's in rtt_dense[parity]), read back by the
// resolve (pass 13) and clean_rr_guides.comp. The mark passes count the gradient's rays (false there).
bool rtrDenseDecide()
{
    const uint cap = rtt_param3.x >> 8u;
    if (cap == 0xFFFFFFu) return true;
    const bool last = rtt_dense[((rtt_param.w >> 8) & 1u) ^ 1u] != 0u;
    return float(rtt_cand) <= (last ? 1.0 : 0.8) * float(cap) * 256.0;
}
bool rtrDense()
{
    if ((rtt_param3.x & 8u) == 0u) return false;
#if CLEAN_DEFER_PASS == 11 || CLEAN_DEFER_PASS == 16
    return rtrDenseDecide();
#elif CLEAN_DEFER_PASS == 13
    return rtt_dense[(rtt_param.w >> 8) & 1u] != 0u;
#else
    return false;
#endif
}
float rtrRho(uint w)
{
    if (rtrDense()) return 1.0;
    const float rr = rtrRhoRough(rtrMarkRough16(w));
    const float rc = rtrMarkCurvRho(w);
    const float rmin = clamp(uintBitsToFloat(rtt_param2.y), 1.0 / 256.0, 1.0);
    const float lo = rtrStrengthMin(), hi = rtrStrengthFull();
    const float u = clamp((rtrMarkStrength(w) - lo) / max(hi - lo, 1e-4), 0.0, 1.0);
    return max(max(mix(min(rr, rmin), rr, u), 1.0 / 256.0), rc);
}
// After the budget scale s: rho x s, but never below rho_min for a pixel the ramp put above it.
float rtrRhoEff(float rho, float s)
{
    if (rtrDense()) return 1.0;   // (no budget thinning: one ray per candidate)
    const float rmin = clamp(uintBitsToFloat(rtt_param2.y), 1.0 / 256.0, 1.0);
    return max(rho * s, min(rho, rmin));
}
// This frame's budget scale as pass 11 chose it (pass 13, after the trace: rtt_scale[parity]).
float rtrGradScaleNow()
{
    const float s = uintBitsToFloat(rtt_scale[(rtt_param.w >> 8) & 1u]);
    return (s > 0.0 && s <= 1.0) ? s : 1.0;
}
// LATTICE ROTATION (#1606; RenderVKRTReflectionsLatticeRotate, rtt_opts4 bit 3): the sparse ray lattice's
// PHASE this frame. The dither rank (rtrRank) is a fixed screen pattern, so at density 1 / L^2 the same pixel of
// every aligned L x L cell cast the ray every frame: the resolve (pass 13) rebuilt every other pixel from those
// fixed sites. A rough wall at the minimum density (L = 8) showed the lattice in its CONVERGED image -- 8 px
// squares and a bright dot on every lattice pixel that no history length averages away (it is the same each
// frame), and the per-frame noise of each site spread over its whole cell: the "pixelated" rough reflections.
// The phase moves the lattice by (ox, oy) in 0..15: the selection ranks p + phase, the resolve finds the lattice
// at the same phase. Frame f's phase takes f's bits two at a time, the FINEST position bits first (the rank's
// order reversed): every 4 consecutive frames visit the 4 phases of a 2 x 2 cell, every 16 the 16 of a 4 x 4, every
// 64 the 64 of an 8 x 8 -- so each pixel is a lattice site once per L^2 frames and the temporal history averages
// the cells' rays over every position. Same rays per cell, same count, same cost (no extra ray, no extra tap).
// Off: phase 0 -- the fixed lattice, as before.
// ONLY THE STOCHASTIC GLOSSY RECEIVERS (mark roughness >= RTR_ROT_ROUGH = RTR_STOCH_ROUGH, the rough lobe on): their
// resolve already integrates lobe samples over 8-20 frames without anti-lag, so a moving lattice is just more
// positions in the same average (AMD bench, club dance floor / rough emitter: the lattice dots and squares gone
// from the settled image, its brightness within 0.1 %). The glossy receivers below it trace MIRROR rays and keep
// the anti-lag rule: a lattice moving under a sharp reflected edge reset their history at the edge every frame
// (the same bench: edge shimmer, temporal p99 +30 %), so they keep the fixed lattice. Selection and resolve both
// decide from the pixel's mark word (rtrLatticeOff(w)): they always agree on where its rays are.
#define RTR_ROT_ROUGH 0.25   // (= RTR_STOCH_ROUGH; scripts/check rt-refl-lattice keeps them equal)
uvec2 rtrLatticePhase(uint f)
{
    const uint a = f & 0x55u, b = (f >> 1u) & 0x55u;   // (bit 2k: a level's y bit; bit 2k+1: its diagonal)
    const uint c = a ^ b;
    return uvec2((c & 1u) | ((c >> 1u) & 2u) | ((c >> 2u) & 4u) | ((c >> 3u) & 8u),
                 (a & 1u) | ((a >> 1u) & 2u) | ((a >> 2u) & 4u) | ((a >> 3u) & 8u));
}
// (w: the pixel's mark word; rtt_param2.x bit 31 the rough lobe, rtrStochastic's flag)
bool rtrLatticeRot(uint w)
{
    return (rtt_opts4 & 8u) != 0u && (rtt_param2.x & 0x80000000u) != 0u
        && float(rtrMarkRough16(w)) >= RTR_ROT_ROUGH * 65535.0;
}
uvec2 rtrLatticeOff(uint w) { return rtrLatticeRot(w) ? rtrLatticePhase(rtt_param2.x & 0xFFu) : uvec2(0u); }
#if DEFER_RT_TILES && CLEAN_DEFER_PASS != 13
// ---- RAY DENSITY (#859; see the header): the 8x8 workgroup = one 8 px tile, lane = y * 8 + x ----
// DENSITY GRADIENT selection (see the header). The 16 x 16 ordered-dither (Bayer) rank of render
// pixel p, 0..255: the finest position bits in the HIGH rank bits, so rank < 256 / L^2 is exactly
// the lattice of multiples of L (L = 1, 2, 4, 8, 16) -- the top-left pixel of every aligned L x L
// cell, which is also that cell's lowest rank -- and any threshold spreads its pixels evenly.
uint rtrRank(uvec2 p)
{
    const uint x = p.x & 15u, y = p.y & 15u, v = x ^ y;
    return ((v & 1u) << 7) | ((y & 1u) << 6) | ((v & 2u) << 4) | ((y & 2u) << 3)
         | ((v & 4u) << 1) | (y & 4u) | ((v & 8u) >> 2) | ((y & 8u) >> 3);
}
// (LATTICE ROTATION) the lowest rank of the aligned s x s cell at c (s = 2, 4, 8): the pixel whose phased position
// is a multiple of s -- exactly one per aligned cell, since its s phased positions per axis are s consecutive
// integers. Phase 0: the cell's top-left, as before. (off: the asking candidate's phase, rtrLatticeOff)
uint rtrCellRank(uvec2 c, uint s, uvec2 off) { return rtrRank((c + off + (s - 1u)) & ~(s - 1u)); }
shared uint s_rtg_rank[64];   // the lane's rank if a candidate, else 0xFFFF
shared uint s_rtg_min2[16];   // per aligned 2 x 2 cell of the tile: its lowest candidate rank
shared uint s_rtg_min4[4];    // per 4 x 4 cell
shared uint s_rtg_min8;       // the tile
// Every invocation of the 8x8 workgroup, uniform control flow (org: the tile's first pixel).
void rtrGradBuild(uint lid, uvec2 org, bool cand, uint w)
{
    s_rtg_rank[lid] = cand ? rtrRank(org + uvec2(lid & 7u, lid >> 3) + rtrLatticeOff(w)) : 0xFFFFu;
    barrier();
    if (lid < 16u)
    {
        const uint b = (lid >> 2) * 16u + (lid & 3u) * 2u;   // the cell's top-left lane
        s_rtg_min2[lid] = min(min(s_rtg_rank[b], s_rtg_rank[b + 1u]), min(s_rtg_rank[b + 8u], s_rtg_rank[b + 9u]));
    }
    barrier();
    if (lid < 4u)
    {
        const uint c = (lid >> 1) * 8u + (lid & 1u) * 2u;    // the cell's top-left 2 x 2 cell
        s_rtg_min4[lid] = min(min(s_rtg_min2[c], s_rtg_min2[c + 1u]), min(s_rtg_min2[c + 4u], s_rtg_min2[c + 5u]));
    }
    barrier();
    if (lid == 0u) s_rtg_min8 = min(min(s_rtg_min4[0], s_rtg_min4[1]), min(s_rtg_min4[2], s_rtg_min4[3]));
    barrier();
}
// The candidate's EFFECTIVE rank (0xFFFF: not a candidate): its own, or -- for each aligned cell
// (2, 4, 8) whose lowest-ranked CANDIDATE it is -- that cell's lowest rank (rtrCellRank). A cell whose
// lattice pixel is no candidate (a surface edge, a thin feature) hands its ray to its best
// candidate instead: at density 1 / L^2 every aligned L x L cell holding a candidate casts exactly
// one ray (pixels are never dropped), the others none; between those steps the dither fills in.
uint rtrGradRank(uint lid, uvec2 org, uint w)
{
    const uint r = s_rtg_rank[lid];
    if (r == 0xFFFFu) return r;
    const uint x = lid & 7u, y = lid >> 3;
    uint er = r;
    const uvec2 off = rtrLatticeOff(w);
    if (s_rtg_min2[(y >> 1) * 4u + (x >> 1)] == r) er = min(er, rtrCellRank(org + uvec2(x & ~1u, y & ~1u), 2u, off));
    if (s_rtg_min4[(y >> 2) * 2u + (x >> 2)] == r) er = min(er, rtrCellRank(org + uvec2(x & ~3u, y & ~3u), 4u, off));
    if (s_rtg_min8 == r) er = min(er, rtrCellRank(org, 8u, off));
    return er;
}
// The candidate casts at density rho_eff: its effective rank below rho_eff x 256.
bool rtrGradRay(uint er, float rhoEff) { return er != 0xFFFFu && float(er) < rhoEff * 256.0; }
