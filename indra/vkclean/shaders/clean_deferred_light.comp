// ---- (LVC STATS, RenderVKReSTIROcclusionCull 3; research/LVC_DESIGN_2026-11-16.md section 5, counters 1, 2, 4) ----
// ASTRA: why a traced local-light job survived the reach map. Mutually exclusive,
// ordered like lvcBlocked; no new ray and no production-VIS code. Words 54..63
// count all pass-0 traced jobs; 148..157 count their static-blocked subset
// (including near-surface blocks). Churn occupies 84..147, noise 64..81.
uint lvcAdmissionReason(uint li, vec3 P)
{
    if (!lvcOn()) return 0u;
    if (lights[li].proj_origin.w >= 0.5) return 1u;
    if (lights[li].proj_axis.y >= 0.5) return 2u;
    const uint e = lvcLiWord(li);
    if ((e & LVC_LI_HAS) == 0u) return 3u;
    if ((e & LVC_LI_USABLE) == 0u) return 4u;
    const vec3 d = P - lights[li].pos_radius.xyz;
    const float dist = length(d), soft = pdnSampleDisc(li);
    if (!(dist > LVC_NEAR)) return 5u;
    if (soft > 0.05 * dist) return 6u;
    const float depth = lvcMapLoad(e & LVC_LI_SLOT, lvcTexel(d));
    // The map is half precision: compare to the similarly rounded open value.
    const float openDepth = unpackHalf2x16(packHalf2x16(vec2(lights[li].pos_radius.w))).x;
    if (depth >= openDepth) return 7u;
    return dist > depth + LVC_MARGIN + LVC_MARGIN_K * dist + 2.0 * soft ? 9u : 8u;
