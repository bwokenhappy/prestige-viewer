// The fresh candidate's target p0 (its luminance x cosine; 0 for an untraced texel or a grazing direction -- giCosMin:
// its W = pi / cos would be stored and re-weighed head-on by the neighbours, the firefly seeds of the spatial reuse),
// its cosine c0 and pdf q0 (cos / pi) -- N the receiver's normal, d the fresh direction, L its radiance
float giFreshTarget(vec3 N, vec3 d, bool traced, vec3 L, out float c0, out float q0)
{
    GIR_PREC const float c0raw = dot(N, d);
    const bool c0ok = c0raw >= giCosMin();
    c0 = max(c0raw, 1e-4);
    q0 = c0 * (1.0 / 3.14159265);
    return (traced && c0ok) ? giLum(L) * c0 : 0.0;
}
// The reuse's FINISH (FUSED / REUSE after the trace loop):
// the visibility verdict on the pick (visOk; a blocked reused pick falls back to the fresh sample y0), the
// estimate + firefly clamp, the reservoir store, the radiance cache, the debug views, the GI denoiser's inputs
// (IN / GEOM / MOT) and the counters. S: the fresh estimate (L; the reservoirs replace it), chgShare: the
// changed lights' share of the candidates (MOT w; debug view 8); visSkip: (#985) the pick kept without its ray (a stat).
#ifdef CLEAN_GI_STEREO_TRACE
// (#1139 VR GI) the stereo trace's finish: this eye's fresh estimate S (L: one bounce, no reservoirs -- the
// host never sets GI_F_RES in a stereo frame) clamped as the desktop's, into its world cell (keyed by the head:
// GI_CACHE_CAM), + the ray counters. No image store: the GI denoiser's images are one view's, and nothing reads
// them in a stereo frame (the eyes' readers take the resolved cache).
void giStereoFinish(vec3 P, vec3 N, bool traced, bool hit, float hdist, vec3 S, bool noInfo, vec3 d)
{
    const uint gf = gi.cfg.x;
    const float clampL = gi.prm2.w;
    if (clampL > 0.0)
    {
        const float l = giLum(S);
        if (l > clampL) S *= clampL / l;
    }
    if (any(isnan(S)) || any(isinf(S))) noInfo = true;
    const bool stats = (gf & GI_F_STATS) != 0u;   // (a header word: uniform)
    if (stats)
    {
        const uint sR = subgroupAdd(traced ? 1u : 0u);
        const uint sH = subgroupAdd(hit ? 1u : 0u);
        const uint sD = subgroupAdd(hit ? uint(min(hdist, 1000.0) * 10.0) : 0u);
        if (subgroupElect())
        {
            atomicAdd(gi.stat.x, sR);
            atomicAdd(gi.stat.y, sH);
            atomicAdd(gi.stat.z, sR - sH);
            atomicAdd(gi.stat.w, sD);
        }
    }
    uint cInserts = 0u, cFull = 0u;
    if ((gf & GI_F_CACHE_FILL) != 0u && giCacheSlots() != 0u && !noInfo)
    {
        float edge;
        const uint key = giCellKey(P, N, GI_CACHE_CAM, edge);
        bool ins;
        const uint slot = giCacheFindOrInsert(key, giCellCentre(P, edge), edge, ins);
        if (slot != 0xFFFFFFFFu)
        {
            giCacheAddWave(slot, S, d);
            if (ins) ++cInserts;
        }
        else ++cFull;
    }
    if (stats)
    {
        const uint sL = subgroupAdd(g_gi_lookups), sF = subgroupAdd(g_gi_found);
        const uint sI = subgroupAdd(cInserts), sX = subgroupAdd(cFull);
        if (subgroupElect() && (sL | sI | sX) != 0u)
        {
            atomicAdd(gi.stat3.x, sL);
            atomicAdd(gi.stat3.y, sF);
            atomicAdd(gi.stat3.z, sI);
            atomicAdd(gi.stat3.w, sX);
        }
    }
}
#endif
void giReuseFinish(ivec2 m, ivec2 D, int par, vec3 P, vec3 N, vec3 d, float vz, vec2 grad, bool traced, bool hit,
                   float hdist, bool freshBack, vec3 S, GiSample y0, float p0, float q0, float c0, GiSample y,
                   uint src, bool visOk, float W, float Msum, bool noInfo, uint keptT, uint keptS, uint chgRej,
                   uint chgSkip, float chgShare, bool reuseTried, bool visSkip)
{
#ifdef CLEAN_GI_STEREO_TRACE
    giStereoFinish(P, N, traced, hit, hdist, S, noInfo, d);
    return;
#endif
    const uint gf = gi.cfg.x;
    const vec3 cam = pc.u_cam_time.xyz;
    float Mout = 1.0;
    uint visRej = 0u;
    bool wClamped = false;   // (debug view 8: the firefly clamp scaled the stored W)
    // (GI-4, the sealed-room fade) THE CACHE TAKES THE FRESH ESTIMATE: this frame's own ray (L, firefly-clamped;
    // a back-face stop is no estimate of this receiver's light), never the reservoirs' resampled one. The
    // reservoirs' estimate is an exponential mean of ~1 / Msum per frame (16 x (1 + the spatial taps) + 1:
    // ~65 frames); fed to the cache -- which GI hits read for the next bounce -- every bounce of a closed
    // room waited for it, and its picks are correlated across texels and frames, so the cell's window
    // averaged few independent draws. The fresh rays are independent and immediate (the stereo trace
    // already fills the cache this way). Untraced texels (RenderVKGITraceEvery) add nothing.
    vec3 Sf = S;
    {
        const float clampF = gi.prm2.w, l = giLum(Sf);
        if (clampF > 0.0 && l > clampF) Sf *= clampF / l;
    }
    const bool freshOk = traced && !freshBack && !any(isnan(Sf)) && !any(isinf(Sf));
    // the receiver's cell (found once: the fill, the debug view, the disocclusion prior) and whether it is
    // CHANGED (giCellHold, the resolve: its region's light really changed within GI_CELL_HOLD frames)
    uint slot = 0xFFFFFFFFu;
    bool ins = false, cellChg = false;
    if ((gf & GI_F_CACHE_FILL) != 0u && giCacheSlots() != 0u)
    {
        float edge;
        const uint key = giCellKey(P, N, cam, edge);
        slot = freshOk ? giCacheFindOrInsert(key, giCellCentre(P, edge), edge, ins) : giCacheFind(key);
        cellChg = slot != 0xFFFFFFFFu && !ins && ((gi_data[3u * giCacheSlots() + slot].w >> 8u) & 0xFFu) != 0u;
    }
    // a CHANGED cell's receivers: the GI denoiser takes the light-change history cap (MOT w below:
    // RenderVKGILightChangeHistory frames), the reservoir stores at most GI_CELL_MCAP confidence (next
    // frame's fresh samples take over at once, not at 1 / Msum)
    if (cellChg) chgShare = 1.0;
    if ((gf & GI_F_RES) != 0u)
    {
        if (src != 0u && !visOk)
        {
            ++visRej;
            y = y0; src = 0u;
            Msum = traced ? 1.0 : 0.0;
            W = p0 > 0.0 ? (p0 / q0) / p0 : 0.0;
        }
        if (!(W > 0.0) || !(W < 3.0e38)) W = 0.0;
        if (!traced && src == 0u) noInfo = true;   // (nothing traced, nothing reused: no estimate)
        Mout = min(Msum, max(gi.prm2.x, 1.0));
        if (cellChg) Mout = min(Mout, GI_CELL_MCAP);
        // the estimate of the chosen sample: L x cos / pi x W (fresh alone: L). The fresh sample's
        // cosine is its own direction's (c0, the one its target and pdf took), not the receiver's
        // P -> x_s direction: the ray leaves from the offset origin o, and a contact hit (a crease)
        // seen from P can face it far more than d did -- L x cos(P) / c0 was a crease firefly.
        GIR_PREC const float cyr = dot(N, giNormalize(y.xs - P));
        const float cy = src == 0u ? c0 : max(cyr, 0.0);
        S = y.L * (cy * (1.0 / 3.14159265)) * W;
        if (any(isnan(S)) || any(isinf(S))) S = vec3(0.0);
        // FIREFLY CLAMP BEFORE THE REUSE SEES IT (RenderVKGIFireflyClamp): the clamped estimate
        // k S = f(y) (k W) -- the reservoir stores k W, so what neighbours / next frame resample is
        // what this texel showed (before, the clamp touched S only: the unclamped W was stored and
        // handed on by the spatial reuse -- a firefly re-seeded every frame)
        // RELATIVE FIREFLY GUARD (on with the absolute clamp, prm2.w > 0; header word: uniform -- the subgroup sums
        // see every lane that reached the finish). The absolute clamp (4.0) never bites in a dark room, where a rare
        // path to a lit spot / emitter carries 10-100x the local light: the RIS pick then keeps it (temporal M ~16,
        // the spatial taps hand it on) and, with DLSS-RR taking the raw GI (no GI denoiser history clamp), it stays a
        // persistent single-texel speck. The threshold is GI_REL_CLAMP x a LOCAL REFERENCE: the larger of
        //   * the subgroup's (an 8 x 4 / 8 x 8 texel block) WINSORISED mean -- each lane's luminance capped at
        //     GI_REL_WINSOR x the plain mean first, so one outlier cannot lift its own threshold;
        //   * the receiver's radiance-cache cell (an independent ~32-frame mean of fresh rays here): where the
        //     light really is concentrated (a lit patch in a dark block) the cell says so and the guard relaxes.
        // S and the stored W scale together (as the absolute clamp): the reuse hands on what this texel showed.
        // Bias: only the part of an estimate above that threshold; the cell keeps genuine bright regions.
        float clampR = gi.prm2.w;
        if (clampR > 0.0)
        {
            const float ls = giLum(S);
            const bool info = !noInfo && ls >= 0.0;
            const float cnt = subgroupAdd(info ? 1.0 : 0.0);
            const float m1 = subgroupAdd(info ? ls : 0.0) / max(cnt, 1.0);
            const float m2 = subgroupAdd(info ? min(ls, GI_REL_WINSOR * m1) : 0.0) / max(cnt, 1.0);
            float lc = 0.0;
            vec3 Ec;
            if (slot != 0xFFFFFFFFu && !ins && giCacheRead(slot, Ec)) lc = giLum(Ec);
            // (REUSE's TAIL run, push rtr.z: its lanes are listed texels from anywhere on screen -- no local block;
            //  the cell alone, where there is one)
            bool local = cnt >= 4.0;
#if CLEAN_GI_STAGE == GI_STAGE_REUSE
            if (g_draw_push.rtr.z > 0.5) local = false;
#endif
            if (local) clampR = min(clampR, max(GI_REL_CLAMP * max(m2, lc), 1e-5));
            else if (lc > 0.0) clampR = min(clampR, GI_REL_CLAMP * lc);
            const float l = ls;
            if (l > clampR) { const float k = clampR / l; S *= k; W *= k; wClamped = true; }
        }
        if (noInfo) giResStore(m, D, uint(par), y0, 0.0, 0.0);   // (W 0: nothing for the neighbours)
        else giResStore(m, D, uint(par), y, W, Mout);
    }
    const float clampL = gi.prm2.w;
    if (clampL > 0.0)
    {
        const float l = giLum(S);
        if (l > clampL) S *= clampL / l;
    }
    // (no estimate this frame: a weight-0 sample for the GI denoiser -- its history holds, DN_F_INFO)
    vec4 l0 = vec4(S, noInfo ? -1.0 : 1.0);
    const uint dbg = gi.cfg.w;
    // (#1039) everything that does not depend on the radiance cache comes first -- the debug views' colour (applied
    // after the cache: it replaces its prior), IN layer 1, the guides, MOT, the counters but the cache's -- so the
    // cache's probe and wave loops carry only what they use
    vec3 dbgC = vec3(0.0);
    if (dbg == GI_DBG_RES)
        dbgC = (src == 0u ? vec3(1.0, 0.0, 0.0) : (src == 1u ? vec3(0.0, 1.0, 0.0) : vec3(0.0, 0.3, 1.0)))
             * (0.2 + 0.8 * clamp(Mout / max(gi.prm2.x, 1.0), 0.0, 1.0));
    if (dbg == GI_DBG_CHG)
        dbgC = vec3(chgShare, chgRej != 0u ? 1.0 : (chgSkip != 0u ? 0.3 : 0.0), wClamped ? 1.0 : 0.0);
    if (dbg == GI_DBG_OUTCOME)   // (gi-glass) the fresh ray's outcome (clean_gi_common.glsl GI_DBG_OUTCOME)
    {
        const uint oc = traced ? g_gi_fresh_oc : 0xFFu;
        const vec3 kC[6] = vec3[6](vec3(0.1, 0.35, 1.0), vec3(0.45), vec3(0.0, 0.8, 0.1), vec3(0.45, 0.28, 0.1),
                                   vec3(1.0, 0.5, 0.0), vec3(0.25, 0.0, 0.3));
        dbgC = oc == 0xFFu ? vec3(0.0) : kC[min(oc & 7u, 5u)];
        if (oc != 0xFFu && (oc & GIO_FB) != 0u) dbgC = (oc & GIO_EMDROP) != 0u ? vec3(1.0, 0.0, 0.0) : vec3(1.0, 1.0, 0.0);
        if (oc != 0xFFu && (oc >> GIO_LAYER_SHIFT) != 0u)
            dbgC = mix(dbgC, vec3(1.0, 0.0, 1.0), min(float(oc >> GIO_LAYER_SHIFT), 2.0) * 0.35);
    }
    if (dbg == GI_DBG_SPATIAL)
    {
        // the spatial taps' most frequent REJECTION reason (g_gi_sp_why), as bright as its share of the taps;
        // dark grey: every tap kept (or no spatial reuse this frame)
        const vec3 kC[8] = vec3[8](vec3(0.15), vec3(1.0, 0.0, 1.0), vec3(0.0, 1.0, 0.0), vec3(1.0, 0.0, 0.0),
                                   vec3(0.5), vec3(1.0, 1.0, 0.0), vec3(0.0, 0.4, 1.0), vec3(1.0));
        uint best = 0u, bn = 0u, tot = 0u;
        for (uint k = 0u; k < 8u; ++k)
        {
            const uint c = (g_gi_sp_why >> (4u * k)) & 15u;
            tot += c;
            if (k != 0u && c > bn) { bn = c; best = k; }
        }
        dbgC = best == 0u ? kC[0] : kC[best] * (0.25 + 0.75 * float(bn) / float(max(tot, 1u)));
    }
    // (RenderVKGIDebug 11 / 12, clean_gi_lamp_why.h) THE SPECKS THEMSELVES on black: a texel whose estimate is a
    // luminance OUTLIER of its 8 x 4 block (> 4x the other lanes' mean, view 9's test) at full intensity, by where
    // its light came from (giLampSpeckColour: the fresh hit's lamp-ray reason, a fresh non-lamp sample, a reused
    // one); 11 also shows the non-outlier texels whose fresh hit took lamp light through a passed ray, faint; 12
    // the outliers alone, white. Everything else black.
    if (dbg == GI_DBG_LAMP || dbg == GI_DBG_SPECK)   // (header words: uniform -- the subgroup sums see every lane)
    {
        const float ls = giLum(S);
        const float sum = subgroupAdd(noInfo ? 0.0 : ls);
        const float cnt = subgroupAdd(noInfo ? 0.0 : 1.0);
        const float meanO = cnt > 1.0 ? (sum - (noInfo ? 0.0 : ls)) / (cnt - (noInfo ? 0.0 : 1.0)) : ls;
        const bool outlier = !noInfo && ls > 4.0 * meanO && ls > 1e-3;
        const uint why = (traced && hit) ? g_gi_fresh_why : 0u;
        dbgC = dbg == GI_DBG_SPECK ? (outlier ? vec3(1.0) : vec3(0.0))
                                   : giLampSpeckColour(outlier, src, why);
        // THE OVERLAY BUFFER (push rtr3.zw while one of these views is on; LLCleanRTVK::recordDebug view
        // GI_DBG_OVERLAY_VIEW draws it per GI texel, nearest, over the final image -- after the GI denoiser, the
        // combine, DLSS / the upscaler and the tonemap, none of which see it): RGB8 + a hold age (bits 24-31). A
        // mark (an outlier) is held GI_DBG_HOLD frames at full colour -- max-hold, never averaged; else the texel's
        // own colour.
        if (any(notEqual(g_draw_push.rtr3.zw, uvec2(0u))) && CLEAN_VIEW == 0u)   // (#1608: one view's debug overlay)
        {
            GiDbgOverlay ov = GiDbgOverlay(g_draw_push.rtr3.zw);
            const uint i = uint(m.y) * uint(D.x) + uint(m.x);   // (view 0's texels: the overlay is drawn over view 0)
            const uint old = ov.w[i];
            const uint rgb = packUnorm4x8(vec4(dbgC, 0.0)) & 0xFFFFFFu;
            ov.w[i] = outlier ? (rgb | (GI_DBG_HOLD << 24u))
                    : ((old >> 24u) != 0u ? ((old & 0xFFFFFFu) | (((old >> 24u) - 1u) << 24u)) : rgb);
        }
    }
    if (dbg == GI_DBG_OUTLIER)   // (a header word: uniform -- the subgroup sums see every surface lane)
    {
        // SPARKLE CAUSES: this texel's estimate against its subgroup's mean (the other lanes')
        const float ls = giLum(S);
        const float sum = subgroupAdd(noInfo ? 0.0 : ls);
        const float cnt = subgroupAdd(noInfo ? 0.0 : 1.0);
        const float meanO = cnt > 1.0 ? (sum - (noInfo ? 0.0 : ls)) / (cnt - (noInfo ? 0.0 : 1.0)) : ls;
        vec3 c = vec3(clamp(ls, 0.0, 1.0) * 0.25);
        if (!noInfo && ls > 4.0 * meanO && ls > 1e-3)
        {
            if (src == 1u)       c = chgRej != 0u ? vec3(0.0, 1.0, 1.0) : vec3(0.0, 1.0, 0.0);
            else if (src == 2u)  c = chgRej != 0u ? vec3(0.0, 1.0, 1.0) : vec3(0.0, 0.3, 1.0);
            else if (!hit)       c = vec3(1.0, 0.0, 0.0);
            else if (dot(N, d) < 0.2) c = vec3(1.0, 0.5, 0.0);
            else if (reuseTried && keptT == 0u && keptS == 0u) c = vec3(1.0);   // (a disocclusion: no candidate)
            else                 c = vec3(1.0, 1.0, 0.0);
        }
        else if (freshBack) c = vec3(0.3, 0.0, 0.3);   // (not a sparkle: a caught leak is dark; dim so the outliers stand out)
        dbgC = c;
    }
    // layer 1 (the denoiser's "specular" signal, rough 1: a full-length history and every a-trous
    // iteration): the SKY VISIBILITY -- did this frame's FRESH cosine-weighted ray escape (the
    // reservoir's pick is radiance-weighted, not cosine: never used here). The consumers occlude
    // the probe / SSR / env specular with it (RenderVKGISpecOcclusion): a sealed room reflects no sky.
    imageStore(uGiIn, ivec3(m, PDN_L(1)), traced ? vec4(vec3(hit ? 0.0 : 1.0), 0.0) : vec4(1.0, 1.0, 1.0, -1.0));
    // ---- guides (the denoiser's: clean_pdn_common.glsl; grad: above) ----
    imageStore(uGiGeom, ivec3(m, PDN_L(par)), uvec4(floatBitsToUint(vz), pdnPackNR(N, 1.0), packHalf2x16(grad),
                                            pdnPackMeta(0.0, 0.0, 0u, 1.0)));
    {
        float pw;
        const vec2 dS = giPrevDelta(P, m, vec2(D), pw);
        // (#1406) NO hard history cut inside the change spheres: the emitter spheres then carried two ray lengths
        // (>= 128 m at the default RenderVKGIRayLength) and some sphere is queued nearly every frame, so a
        // pw = 0 here discarded the GI denoiser's history across almost the whole view every frame -- 1-spp
        // GI after three a-trous passes, the noise RR hid by integrating it again. The reservoirs and the
        // cache still drop their stale samples there (giReusePick / giCacheRead); the denoiser takes a
        // changed emitter's light through its neighbourhood clamp + anti-lag, as every other light change.
        // (w: the changed lights' share x 255 -- clean_dn_temporal.comp's moving-light history cap, read
        //  only when the host gives the GI denoiser a move history: RenderVKGILightChangeHistory; bit 8,
        //  GI_MOT_CHANGED: the receiver's cache cell is CHANGED -- the GI denoiser's own short cap
        //  (DN_GI_CHANGED_HIST) and, under DLSS Ray Reconstruction, the responsivity guide: RR drops its
        //  history there, the GI reaching it raw)
        GIR_PREC const float sh = chgShare * 255.0 + 0.5;
        imageStore(uGiMot, PDN_MOT(m), uvec4(packHalf2x16(dS), packHalf2x16(dS), floatBitsToUint(pw),
                                    uint(sh) | (cellChg ? GI_MOT_CHANGED : 0u)));
    }
    // ---- stats (one atomic per subgroup; only while the host reads them: GI_F_STATS) ----
    const bool stats = (gf & GI_F_STATS) != 0u;   // (a header word: uniform)
    if (stats)
    {
        const uint sR = subgroupAdd(traced ? 1u : 0u);
        const uint sH = subgroupAdd(hit ? 1u : 0u);
        const uint sD = subgroupAdd(hit ? uint(min(hdist, 1000.0) * 10.0) : 0u);
        const uint sT = subgroupAdd(keptT), sS = subgroupAdd(keptS), sV = subgroupAdd(visRej);
        const uint sM = subgroupAdd(uint(Mout * 4.0 + 0.5));
        if (subgroupElect())
        {
            atomicAdd(gi.stat.x, sR);
            atomicAdd(gi.stat.y, sH);
            atomicAdd(gi.stat.z, sR - sH);
            atomicAdd(gi.stat.w, sD);
            if (sT != 0u) atomicAdd(gi.stat2.x, sT);
            if (sS != 0u) atomicAdd(gi.stat2.y, sS);
            if (sV != 0u) atomicAdd(gi.stat2.z, sV);
            atomicAdd(gi.stat2.w, sM);
        }
        const uint sC = subgroupAdd(chgRej), sK = subgroupAdd(chgSkip), sQ = subgroupAdd(visSkip ? 1u : 0u);
        if (subgroupElect() && sC != 0u) atomicAdd(gi.stat4.w, sC);
        if (subgroupElect() && sK != 0u) atomicAdd(gi.sph_n.z, sK);
        if (subgroupElect() && sQ != 0u) atomicAdd(gi.sph_n.w, sQ);   // (#985)
    }
    // ---- (GI-4) THE RADIANCE CACHE: this receiver's estimate into its world cell ----
    uint cInserts = 0u, cFull = 0u;
    vec3 cacheDbg = vec3(1.0, 0.0, 0.0);
    if ((gf & GI_F_CACHE_FILL) != 0u && giCacheSlots() != 0u && !noInfo)
    {
        if (slot != 0xFFFFFFFFu)
        {
            if (dbg == GI_DBG_CACHE)
            {
                vec3 E;
                cacheDbg = giCacheRead(slot, E) ? E : vec3(1.0, 1.0, 0.0);
            }
            // (the FRESH estimate, above: the prior below never feeds back into the cell)
            if (freshOk) giCacheAddWave(slot, Sf, d);
            if (ins) ++cInserts;
            // (#1038, prm5.w RenderVKGIDisoccCache) THE DISOCCLUSION PRIOR: a texel left with its FRESH
            // SAMPLE ALONE (reservoirs on, no temporal / spatial candidate survived -- a surface just
            // uncovered, a history cut) shows the cell's resolved irradiance blended in as up to prm5.w
            // samples (the cell's own count caps it: a young cell weighs less) instead of a 1-spp
            // speckle. Its reservoir is untouched; the GI denoiser's history starts from this estimate.
            // Only on such texels (steady-state texels keep M > 1): one 2-word read of the slot found above.
            const float nCap = gi.prm5.w;
            // (visRej: a reused pick blocked by its visibility ray had candidates -- not a disocclusion)
            if (nCap > 0.0 && (gf & GI_F_RES) != 0u && (gf & GI_F_TEMPORAL) != 0u && src == 0u && Msum <= 1.0
                && visRej == 0u)
            {
                vec3 E;
                if (giCacheRead(slot, E))
                {
                    const float n = min(uintBitsToFloat(gi_data[3u * giCacheSlots() + slot].x) / HT_REF_MS, nCap);
                    GIR_PREC const vec3 pr = (S + n * E) / (1.0 + n);
                    l0.rgb = pr;
                }
            }
        }
        else if (freshOk) ++cFull;
    }
    if (dbg == GI_DBG_CACHE) l0.rgb = cacheDbg;
    else if (dbg == GI_DBG_RES || dbg == GI_DBG_CHG || dbg == GI_DBG_OUTLIER || dbg == GI_DBG_SPATIAL || dbg == GI_DBG_LAMP
             || dbg == GI_DBG_SPECK || dbg == GI_DBG_OUTCOME)
        l0.rgb = dbgC;
    imageStore(uGiIn, ivec3(m, PDN_L(0)), l0);
    if (stats)
    {
        const uint sL = subgroupAdd(g_gi_lookups), sF = subgroupAdd(g_gi_found);
        const uint sI = subgroupAdd(cInserts), sX = subgroupAdd(cFull);
        if (subgroupElect() && (sL | sI | sX) != 0u)
        {
            atomicAdd(gi.stat3.x, sL);
            atomicAdd(gi.stat3.y, sF);
            atomicAdd(gi.stat3.z, sI);
            atomicAdd(gi.stat3.w, sX);
        }
    }
}

// (GI-2 / GI-3) THE CANDIDATES: last frame's reservoirs reconnected to this receiver (P, N; m / rp its texel /
// render pixel, grad its depth gradient) -- the temporal tap (+ the reprojection search), the spatial taps, the
// disocclusion taps -- resampled into the running reservoir (wsum, Msum; the pick y, its target py, source src,
// change tag yChg; yq the picked reservoir's texel, x | y << 16) with the changed share's sums (wAll, wChg) and the
// counters. The fused kernel keeps y; REUSE keeps yq and rebuilds y from it (giResPick).
void giReusePick(ivec2 m, ivec2 D, int par, uint frame, ivec2 rp, vec3 P, vec3 N, vec2 grad, inout float wsum,
                 inout float Msum, inout float wAll, inout float wChg, inout uint keptT, inout uint keptS,
                 inout bool reuseTried, inout GiSample y, inout float py, inout uint src, inout uint yChg, inout uint yq)
{
    const uint gf = gi.cfg.x;
    g_gi_sp_why = 0u;
    // (#1406) the receiver in a HARD change sphere: no reuse (its history may be wrong). A SOFT one caps the
    // reused samples by where THEY lie (giTap: what the emitter's change does to their light), not the
    // receiver -- under the flat A/B (GI_F_SPH_FLAT) the receiver's reservoirs too, as a638ea06f6
    const uint sph = giSphereHit(P, 0.0);
    if (sph == 2u) return;
    const bool reuse = (gf & GI_F_TEMPORAL) != 0u && (gf & GI_F_RES_PREV) != 0u && ssr.taa_params.z < 0.5;
    if (reuse)
    {
        const float mcap = (sph == 1u && (gf & GI_F_SPH_FLAT) != 0u) ? min(max(gi.prm2.x, 1.0), GI_SPHERE_MCAP)
                                                                     : max(gi.prm2.x, 1.0);
        uint rng = giPcg(uint(m.x) * 7919u + uint(m.y) * 104729u + frame * 15485863u);
        float pw;
        vec2 dS = giPrevDelta(P, m, vec2(D), pw);
        float zx = 0.0;   // (#1038) the extra depth tolerance of a surface that moved on its own (m)
#ifdef GI_REUSE_MV_BOUND
        // (#1038, GI_F_REUSE_MV) a MOVING surface (an avatar): last frame's texel of this point is
        // along the motion vectors, not at the camera-only point (reuseMotionDelta)
        if ((gf & GI_F_REUSE_MV) != 0u) zx = reuseMotionDelta(m, rp, vec2(D), pw, dS);
#endif
        const ivec2 qt = ivec2(floor(vec2(m) + dS + 0.5));
        const uint pl = uint(par) ^ 1u;
        GiSample yt;
        float pt, Mt;
        uint tc;
        if (pw > 0.0)
        {
            reuseTried = true;
            float wt = giTap(qt, D, pl, pw, max(0.04 * pw, 0.03) + zx, P, N, mcap, yt, pt, Mt, tc);
            ivec2 tq = qt;   // (the temporal candidate's texel: qt, or the search's)
            if (!(Mt > 0.0) && (gf & GI_F_REPROJ_SEARCH) != 0u)
            {
                // (GI_F_REPROJ_SEARCH) REPROJECTION SEARCH: the nearest texel is not this surface
                // (sub-texel motion across a thin strand / a silhouette at the GI extent): the
                // best-matching texel of the 3 x 3 around the reprojected point -- its depth against
                // this surface's plane carried there (pw + the gradient over the offset), normal
                // within ~25 deg -- is the temporal candidate (giTap's own tests at that plane depth)
                const vec2 hc = vec2(m) + dS;
                float best = 1.0, bz = 0.0, btol = 0.0;
                ivec2 bq = ivec2(-1);
                [[dont_unroll]] for (int k = 0; k < 9; ++k)
                {
                    const ivec2 q = qt + ivec2(k % 3 - 1, k / 3 - 1);
                    if (q == qt || any(lessThan(q, ivec2(0))) || any(greaterThanEqual(q, D))) continue;
                    const uvec4 gq = imageLoad(uGiGeom, ivec3(q, PDN_L(int(pl))));
                    const float zq = uintBitsToFloat(gq.x);
                    if (!(zq > 0.0) || dot(pdnUnpackN(gq.y), N) < 0.9) continue;
                    const float dz = dot(grad, vec2(q) - hc);
                    const float tq = max(0.04 * pw, 0.03) + 0.5 * abs(dz) + zx;
                    const float e = abs(zq - (pw + dz)) / tq;
                    if (e < best) { best = e; bq = q; bz = pw + dz; btol = tq; }
                }
                if (bq.x >= 0)
                {
                    wt = giTap(bq, D, pl, bz, btol, P, N, mcap, yt, pt, Mt, tc);
                    tq = bq;
                }
            }
            if (Mt > 0.0)
            {
                const bool first = Msum == 0.0;
                wsum += wt; Msum += Mt; ++keptT; wAll += wt;
                if (giTagCounts(tc)) wChg += wt;
                if (giRand(rng) * wsum < wt || first)
                {
                    y = yt; py = pt; src = 1u; yChg = tc;
                    yq = uint(tq.x) | (uint(tq.y) << 16u);
                }
            }
            if ((gf & GI_F_SPATIAL) != 0u)
            {
                const uint taps = uint(gi.prm2.y + 0.5);
                const float rad = max(gi.prm2.z, 1.0);
                // (GI_F_SP_LINEAR off) a tap rejected for its GEOMETRY -- off the extent, off the plane, the
                // other wall's normal, a Jacobian a close-range move cannot stand for: one retry at half the
                // offset, toward the receiver (the disc's far half lands on the other wall of a corner or past
                // a silhouette). Bounded: at most 2 x taps reconnections, the retry's reject is mostly the
                // geometry image's one load.
                const bool retry = (gf & GI_F_SP_LINEAR) == 0u;
                [[dont_unroll]] for (uint t = 0u; t < min(taps, 6u); ++t)
                {
                    const float a = 6.2831853 * giRand(rng);
                    vec2 off = vec2(cos(a), sin(a)) * (rad * sqrt(max(giRand(rng), 0.02)));
                    [[dont_unroll]] for (uint k = 0u; k < 2u; ++k)
                    {
                        const ivec2 q = qt + ivec2(round(off));
                        if (q == qt) break;
                        const float dz = dot(grad, vec2(q - qt));
                        const float ze = giPlaneZ(pw, dz);
                        float ws = 0.0;
                        Mt = 0.0;
                        g_gi_tap_why = GI_TAP_DEPTH;
                        if (ze > 0.0)
                            ws = giTap(q, D, pl, ze, max(0.05 * pw, 0.05) + 0.25 * abs(ze - pw) + zx, P, N, mcap, yt,
                                       pt, Mt, tc);
                        g_gi_sp_why += 1u << (4u * min(g_gi_tap_why, 7u));
                        if (Mt > 0.0)
                        {
                            const bool first = Msum == 0.0;
                            wsum += ws; Msum += Mt; ++keptS; wAll += ws;
                            if (giTagCounts(tc)) wChg += ws;
                            if (giRand(rng) * wsum < ws || first)
                            {
                                y = yt; py = pt; src = 2u; yChg = tc;
                                yq = uint(q.x) | (uint(q.y) << 16u);
                            }
                            break;
                        }
                        const uint why = g_gi_tap_why;
                        if (!retry || !(why <= GI_TAP_NORMAL || why == GI_TAP_JACOB)) break;
                        off *= 0.5;
                    }
                }
            }
            // (prm4.z, RenderVKGIDisoccTaps) DISOCCLUSION: no temporal candidate (camera motion
            // revealed this texel, or a thin strand's texel had none) -- extra neighbour taps at a
            // SMALL radius (<= 3 texels: along a strand, beside a silhouette, where the wide taps
            // above rarely land on the same surface), so the texel does not restart from M = 1.
            // Also at RenderVKGI 2. Bounded: up to 8 taps, only on such texels; still one
            // visibility ray for the pick.
            const uint extra = min(uint(gi.prm4.z + 0.5), 8u);
            if (keptT == 0u && extra > 0u)
            {
                const float rad2 = min(max(gi.prm2.z, 1.0), 3.0);
                [[dont_unroll]] for (uint t = 0u; t < extra; ++t)
                {
                    const float a = 6.2831853 * giRand(rng);
                    const float rr = rad2 * sqrt(max(giRand(rng), 0.1));
                    const ivec2 q = qt + ivec2(round(vec2(cos(a), sin(a)) * rr));
                    if (q == qt) continue;
                    const float dz = dot(grad, vec2(q - qt));
                    const float ze = giPlaneZ(pw, dz);
                    if (!(ze > 0.0)) continue;
                    const float ws = giTap(q, D, pl, ze, max(0.05 * pw, 0.05) + 0.25 * abs(ze - pw) + zx, P, N, mcap, yt,
                                           pt, Mt, tc);
                    if (Mt > 0.0)
                    {
                        const bool first = Msum == 0.0;
                        wsum += ws; Msum += Mt; ++keptS; wAll += ws;
                        if (giTagCounts(tc)) wChg += ws;
                        if (giRand(rng) * wsum < ws || first)
                        {
                            y = yt; py = pt; src = 2u; yChg = tc;
                            yq = uint(q.x) | (uint(q.y) << 16u);
                        }
                    }
                }
            }
        }
    }
}

#if CLEAN_GI_STAGE == GI_STAGE_REUSE
// (REUSE) the FRESH sample from the GI record ri (TRACE + SHADE's words; an untraced texel: the
// defaults the fused kernel's loop starts from -- no radiance, the receiver itself), as the reservoir's y0 (d: the
// fresh direction) -- and hit / its distance / the back-face stop
GiSample giRecFresh(uint ri, bool traced, vec3 P, vec3 N, vec3 d, out bool hit, out float hdist, out bool bt)
{
    vec3 L = vec3(0.0), xs = P, ns = N;
    hit = false;
    bt = false;
    hdist = 0.0;
    if (traced)
    {
        const uvec4 rq0 = gi_hit[ri], q1 = gi_hit[ri + 1u], q2 = gi_hit[ri + 2u], q3 = gi_hit[ri + 3u];
        L = uintBitsToFloat(q1.xyz);
        hdist = uintBitsToFloat(q1.w);
        xs = uintBitsToFloat(q2.xyz);
        ns = vec3(uintBitsToFloat(q2.w), uintBitsToFloat(q3.xy));
        hit = (rq0.w & GI_REC_HIT) != 0u;
        bt = (rq0.w & GI_REC_BACK) != 0u;
        g_gi_fresh_why = q3.z & GLW_MASK;   // (RenderVKGIDebug 11: SHADE / HIT-LIGHT left the hit's lamp-ray reasons)
        g_gi_fresh_oc = q3.w & 0xFFu;   // (gi-glass: RenderVKGIDebug 13)
    }
    GIR_PREC const float cv = dot(ns, -d);
    return GiSample(xs, ns, L, hit ? hdist : 0.0, hit ? abs(cv) : 1.0);
}
// (REUSE) the pick y rebuilt: last frame's reservoir at q (layer pl: nothing writes it this frame) seen
// from P -- giTap's words and expressions (a picked reservoir passed every giTap test)
GiSample giResPick(ivec2 q, ivec2 D, uint pl, vec3 P)
{
    const uint i = giResIndex(q, D, pl);
    const uvec4 r0 = gi_res[i], r1 = gi_res[i + 1u];
    GiSample y;
    y.xs = uintBitsToFloat(r0.xyz);
    y.ns = giUnpackN(r1.x);
    const vec2 lrg = unpackHalf2x16(r1.y), lbm = unpackHalf2x16(r1.z), dc = unpackHalf2x16(r1.w);
    y.L = vec3(lrg, lbm.x);
    const vec3 v = y.xs - P;
    GIR_PREC const float d2 = dot(v, v);
    const float dn = sqrt(d2);
    const vec3 w = v / dn;
    const bool sky = !(dc.x > 0.0);
    GIR_PREC const float cv = dot(y.ns, w);
    y.dist = sky ? 0.0 : dn;
    y.cosv = sky ? 1.0 : abs(cv);
    return y;
}
