#define GI_TAP_DEPTH   2u    // not on the receiver's plane (its expected depth +- the tolerance)
#define GI_TAP_NORMAL  3u    // its normal more than ~25 deg off the receiver's (the other wall of a corner)
#define GI_TAP_RES     4u    // its reservoir unusable (empty, NaN, a hard change sphere at its sample)
#define GI_TAP_BEHIND  5u    // its sample behind the receiver (cosine below giCosMin) or at it
