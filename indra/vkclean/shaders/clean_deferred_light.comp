}
bool rftReproject(vec3 P, vec3 ng, vec3 dir, float tRefl, bool virtualFirst, ivec2 hsz, int prevRow, out vec3 hist,
                  out ivec2 q)
{
    hist = vec3(0.0);
    q = ivec2(0);
    if (ssr.taa_params.z >= 0.5 || (rftFlags() & RFT_PUSH_PREV) == 0u) return false;   // (a camera cut / no previous camera)
    const vec3 Pr = P - ssr.cam_origin.xyz;
    vec4 h;
    if (virtualFirst && tRefl > 0.0 && rftHistTexel(Pr + dir * tRefl, hsz, prevRow, h, q))
    {
        // the layer's plane under that texel, through the previous camera: its previous view depth
        const vec4 cv = ssr.views[CLEAN_VIEW].taa_prev_vp * vec4(Pr + dir * tRefl, 1.0);
        const mat4 iM = inverse(ssr.views[CLEAN_VIEW].taa_prev_vp);
        const vec2 ndc = cv.xy / cv.w;
        vec4 a = iM * vec4(ndc, 1.0, 1.0), b = iM * vec4(ndc, 0.5, 1.0);
        a.xyz /= a.w;
        b.xyz /= b.w;
        const vec3 dl = b.xyz - a.xyz;
        const float den = dot(ng, dl);
        if (abs(den) > 1e-6 * length(dl))
        {
            const vec3 Q = a.xyz + dl * (dot(ng, Pr - a.xyz) / den);
            const float ew = (ssr.views[CLEAN_VIEW].taa_prev_vp * vec4(Q, 1.0)).w;
            if (rftSameLayer(h.a, ew) && all(lessThan(abs(h.rgb), vec3(60000.0)))) { hist = h.rgb; return true; }
        }
    }
    if (rftHistTexel(Pr, hsz, prevRow, h, q))
    {
        const float pw = (ssr.views[CLEAN_VIEW].taa_prev_vp * vec4(Pr, 1.0)).w;
        if (rftSameLayer(h.a, pw) && all(lessThan(abs(h.rgb), vec3(60000.0)))) { hist = h.rgb; return true; }
    }
    return false;
}
// THE LAYER'S GI history texel q of the layer point P (the surface itself: the GI sits on the layer, not in its
// reflection), accepted on the previous frame's layer depth there (the reflection's history rows: |a|).
bool rfgReproject(vec3 P, ivec2 hsz, int prevRow, out ivec2 q)
{
    q = ivec2(0);
    if (ssr.taa_params.z >= 0.5 || (rftFlags() & RFT_PUSH_PREV) == 0u) return false;
    const vec3 Pr = P - ssr.cam_origin.xyz;
    vec4 h;
    if (!rftHistTexel(Pr, hsz, prevRow, h, q)) return false;
    return rftSameLayer(abs(h.a), (ssr.views[CLEAN_VIEW].taa_prev_vp * vec4(Pr, 1.0)).w);
}
