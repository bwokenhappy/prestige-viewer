// ---- (#1031) VIS: ONE THREAD PER GATED LIGHT SAMPLE (SELECT's job list, an indirect dispatch: every
//      lane has a sample to trace). The job's texel's receiver, its light sample j (pdnProjSample /
//      rsEmSample), the receiver rules (shadowRecvLight: the terminator / rig probes) and the sample's
//      walk(s) (shadowSampleVis: its disc rays + the translucent split, the inputs parked between
//      rays) -> its visibility slot. No per-texel sample loop: nothing of a texel's other samples is
//      live across a walk. ----
// (RenderVKShadowMoverMask 2) ONE MOVER-EXACT JOB: texel x light (SELECT's exact list) -> one ray against ALL casters
// (g_pdn_mv_local: PDN_OPT_MOVER_ALL), pass 15's own sample set-up and receiver rules exactly as a light sample below --
// pdnVisRecv, pdnProjSample (ONE disc ray: its Vogel disc rotated by the frame's phase, the sun path's rate), the
// own-fixture rule, shadowRecvLight + the facing gate, shadowSampleVis -- into the job's visibility; the job word becomes
// its result (the moving-caster bit, the nearest blocker).
void pdnVisExactJob(ivec2 D)
{
    const uint e = gl_WorkGroupID.x * 64u + gl_LocalInvocationIndex;
    if (!pdnExactOn(D)) return;
    const uint XB = pdnExactBase(D);
    if (e >= min(pdn_vis[XB], pdnExactCap(D))) return;   // (the count clamped to the list)
    const uint job = pdn_vis[pdnExactJob(D, e)];
    if (job == PDN_EXACT_GAP) return;   // (the slots a texel reserved but could not fill: SELECT marks them)
    const uint tex = job >> 8u, li = job & 255u;
    uint vw;   // (#1608: the job's view-inclusive texel -- its view first, before any per-view read)
    const ivec2 m = pdnTexelAt(tex, D, vw);
    if (vw >= uint(kViewCount) || li >= min(uint(linfo.cam_pos.w), uint(lights.length()))) return;
    g_pdn_view = vw;
    const uvec4 sd0 = pdn_sel[pdnSelIndex(m, D)];
    const uint frame = uint(g_draw_push.rtr.z + 0.5);
    SurfaceLit s;
    vec3 P;
    float vz, dR;
    ShadowRecv Rv;
    bool ngOnPlane;
    if (!pdnVisRecv(m, D, frame, s, P, vz, dR, Rv, ngOnPlane)) return;   // (never: SELECT listed a surface)
    if ((sd0.x & PDN_SEL_CELL) != 0u || rsFrameOn()) rt_fix_max = rg.rs_params.y;
    ShadowSample S;
    pdnProjSample(li, vec2(m) + 0.5 + vec2(17.0, 59.0) * float(96u + li), S);   // (one disc ray: S.nRays 1)
    g_pdn_mv_local = true;   // (all casters: PDN_OPT_MOVER_ALL)
    vec3 Nin;
    const float nsl = shadowRecvLight(Rv, normalize(S.pos - P), Nin);
    const bool trace = !((pdnOpts() & PDN_OPT_FACING) != 0u && nsl < -0.25);
    rt_block_t = 1e30;
#ifdef RT_TRACK_BLOCKER
    rt_block_dyn = false;
#endif
    const vec3 vis = trace ? shadowSampleVis(S, P, Nin, pc.u_cam_time.xyz, pc.u_cam_time.w) : vec3(0.0);
    shadowRecvLightEnd();
    bool mover = false;
#ifdef RT_TRACK_BLOCKER
    mover = trace && rt_block_dyn;
#endif
    const float bt = (trace && rt_block_t < 1e29) ? min(rt_block_t, PDN_EXACT_NO_BLK - 1.0) : PDN_EXACT_NO_BLK;
    pdn_vis[pdnExactJob(D, e)] = li | (mover ? PDN_EXACT_MOVER : 0u) | (packHalf2x16(vec2(bt, 0.0)) << 16u);
    pdn_vis[pdnExactVisW(D, e)] = pdnVisPack(vis, false);
