    const float rl = clamp(1.0 - dot(lost, lw) / dl, 0.0, 1.0);
    vec3 r;
    for (int ch = 0; ch < 3; ++ch) r[ch] = d[ch] > 1e-3 * dl ? clamp(1.0 - lost[ch] / d[ch], 0.0, 1.0) : rl;
    return r;
}
// (pass 3's walled rule) with lost = 0 the ratio mvRestRatio returns is exactly 1 for this denominator d and every
// larger one: d is past the fallback's 1e-3 of the unshadowed sum, or that sum is ~0 (the ratio's own 1). Mirrors
// mvRestRatio's two tests exactly.
bool mvRestSettled(vec3 d, vec3 dFb)
{
    const vec3 lw = vec3(0.2126, 0.7152, 0.0722);
    return dot(d, lw) > 1e-3 * dot(dFb, lw) || !(dot(dFb, lw) > 1e-8);
