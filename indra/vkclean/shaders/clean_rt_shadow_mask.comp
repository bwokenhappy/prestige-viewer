    for (uint i = 0u; i < p; ++i)
    {
        slotV[k] = g_fc_vm[i]; ids[k] = g_fc_li[i] + 1u;
        if (g_fc_dyn[i]) dyn |= 2u << k;
        ++k;
        if (((cBits >> i) & 1u) != 0u) { slotV[k] = g_fc_vs[i]; ids[k] = MV_VS_TAG | (g_fc_li[i] + 1u); ++k; }
        rw -= cW[i]; rws -= cWs[i]; rwsm -= cWs[i] * g_fc_vm[i].rgb;
    }
    for (uint i = 0u; i < q; ++i)
    {
        slotV[k] = g_fq_vs[i]; ids[k] = MV_VS_TAG | (g_fq_li[i] + 1u); ++k;
        rw -= qW[i]; rws -= qWs[i]; rwsm -= qWs[i] * g_fq_vm[i];
