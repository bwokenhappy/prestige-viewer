// ---- MOVER SHADOW ROUTING (RenderVKShadowMoverMask; clean_rt_movers.glsl has the design) ----
// While the frame info's moverRouteOn(), the stochastic shadow pass left every mover out, and THIS pass
// traces the movers -- mover-ONLY rays -- for the stochastic path's lights: the sun / moon too on a merged
// frame (moverSunOnly: the merged pass's sun is static-only), else the sun stays the full trace below. They
// go through THE RT SHADOW PATH unchanged -- the sun / projector ray cores, the sun / projector slots, the
// mask's temporal pass (its moving-caster rules: rt_block_dyn) and spatial pass, the mask reader -- and the
// lighting multiplies the static stochastic result by them (clean_shadow_mask_read.glsl).
// The mover bounds (set 3 binding 23, the TLAS instance pass's): avatars (skeleton + worn) and moving
// objects as spheres; the header counts this pass's work for the host's log line (words 4-7).
layout(std430, set = 3, binding = 23) coherent buffer MoverBuf { uint mv[]; };
// (THE SHARED MOVER CULL: mvSphere / mvCullBuild / mvSegHitAny / mvLightRadius ... -- one body, clean_rt_movers.glsl,
//  shared with pass 15's mover-exact selection, RenderVKShadowMoverMask 2)
#define MV_CULL_BODIES
#include "clean_rt_movers.glsl"
// Caster sets of the walks (g_mv_and / g_mv_filter above): every caster (the default), the MOVERS alone (the mover
// rays: the mover classes + blend movers -- the receiver's own avatar included, exactly as the static RT shadow rays
// see it) or the STATIC casters alone (the weight rays of a light ratio).
void mvCastAll()    { g_mv_and = 0xFFu; g_mv_filter = 0u; }
void mvCastMovers() { g_mv_and = RT_MASK_MOVER | RT_MASK_BLEND; g_mv_filter = 2u; }
void mvCastStatic() { g_mv_and = RT_MASK_ALL & ~RT_MASK_MOVER; g_mv_filter = 1u; }

// ---- MOVER PROBE writers (RenderVKMoverProbePixel; clean_rt_mover_probe.glsl has the layout) ----
#include "clean_rt_mover_probe.glsl"
bool rtpOn() { return uint(rt_guard.length()) >= RTP_END && rt_guard[RTP_BASE] != 0u; }
ivec2 rtpMaskPx() { const uint p = rt_guard[RTP_BASE + 2u]; return ivec2(int(p & 0xFFFFu), int(p >> 16u)); }
void rtpPut(uint o, uint v)  { rt_guard[RTP_MASK + o] = v; }
void rtpPutF(uint o, float v) { rt_guard[RTP_MASK + o] = floatBitsToUint(v); }
void rtpOr(uint o, uint v)   { rt_guard[RTP_MASK + o] |= v; }
float rtpLum(vec3 v) { return dot(v, vec3(0.2126, 0.7152, 0.0722)); }
// The next event's first word (~0 = past the room; the count still grows).
uint rtpEvent()
{
    const uint n = rt_guard[RTP_MASK + RTP_M_EVN];
    rt_guard[RTP_MASK + RTP_M_EVN] = n + 1u;
    return n < RTP_EV_CAP ? RTP_MASK + RTP_M_EV + n * RTP_EV_WORDS : 0xFFFFFFFFu;
}
uint mvLightInfo(uint li, Light L);   // (below: the light's identity bits, MV_LST word 4's)
// A LIGHT event: phase 0 the pass-1 scan (bits: 1 a mover sphere on its segment), 1 the mover rays (bits: 1 own
// slot / top, 2 mover rays traced), 2 the static weight ray, 4 a light the pass-1 gate DROPPED (bits: 1 turned
// away, 2 no reach -- attenuation / frustum / a black gobo texel; vis = its smooth N.l, 0 without reach). vis: Vm (phase 1) / Vs (phase 2); bt: the nearest blocker of its rays (1e30 none),
// bid the last one noted; rays: g_mv_ray_n. Word [8]: the light's identity (mvLightInfo: 2 projector, 4 an RT
// record, 8 inside an avatar's padded bounds; bits 16+ its point-light own-prim radius in mm).
void rtpLight(uint phase, uint bits, uint li, vec3 w, vec3 vis, float bt, uint rays, float prad)
{
    const uint e = rtpEvent();
    if (e == 0xFFFFFFFFu) return;
    rt_guard[e] = 1u | (phase << 4u) | (bits << 8u);
    rt_guard[e + 1u] = li;
    rt_guard[e + 2u] = floatBitsToUint(rtpLum(w));
    rt_guard[e + 3u] = floatBitsToUint(rtpLum(vis));
    rt_guard[e + 4u] = floatBitsToUint(bt);
    rt_guard[e + 5u] = g_mpr_bid;
    rt_guard[e + 6u] = rays;
    rt_guard[e + 7u] = floatBitsToUint(prad);
    rt_guard[e + 8u] = li < uint(lights.length()) ? mvLightInfo(li, lights[li]) : 0u;
}
// A RAY event (a point light's disc ray k): its visibility, nearest blocker t, the blocker (id, its flags -- bit 0
// rigged, bit 13 the agent's own avatar --, skin, rt_geom.w) and the side it was met on (1 front, 2 behind).
void rtpRay(uint k, vec3 v, float t)
{
    const uint e = rtpEvent();
    if (e == 0xFFFFFFFFu) return;
    const uint id = g_mpr_bid;
    uint info = 0u, sk = 0xFFFFFFFFu, gw = 0u;
    if (t < 1e29 && id != RT_BAD_ID && rtIdIn(id))
    {
        sk = rt_instances[id].skin_id;
        gw = rt_geom[id].w;
        info = ((rt_instances[id].flags & 1u) != 0u ? 1u : 0u) | ((rt_instances[id].flags & 0xFFFFFFu) << 8u);
    }
    rt_guard[e] = 2u | (min(k, 255u) << 4u) | (g_mv_filter << 12u) | ((t < 1e29 ? g_mpr_bside : 0u) << 24u);
    rt_guard[e + 1u] = floatBitsToUint(rtpLum(v));
    rt_guard[e + 2u] = floatBitsToUint(t);
    rt_guard[e + 3u] = t < 1e29 ? id : RT_BAD_ID;
    rt_guard[e + 4u] = info;
    rt_guard[e + 5u] = sk;
    rt_guard[e + 6u] = gw;
    rt_guard[e + 7u] = 0u;
    rt_guard[e + 8u] = 0u;
}
// (clean_shadow_rt.glsl shadowDiscRay: every disc ray of the probed texel -- the cores', projectors and point lights)
void rtpDiscRay(vec3 v, float t) { rtpRay(0u, v, t); }
bool mvSunHit(vec3 P, vec3 L, float far)
{
    if (g_mv_sun_all) return true;
    for (uint k = 0u; k < g_mv_nsun; ++k)
    {
        const uint m = g_mv_sun[k];
        const vec4 s = mvSphere(m);
        if (mvRayHit(P, L, far, s.xyz, s.w) && mvBoxSeg(m, P, P + L * far, 0.0)) return true;   // (+ an avatar's box)
    }
    return false;
}
// ---- THE COST BREAKDOWN (stats frames only: frame info moverStatsFrame; clean_rt_movers.glsl words 10-23, MV_LST) ----
bool g_mv_stats = false;
void mvStat(uint li, uint w, uint v)
{
    if (!g_mv_stats || v == 0u || li >= MV_LST_N) return;
    atomicAdd(mv[MV_LST + li * MV_LST_W + w], v);
}
// light li's identity bits: 1 (set), 2 projector, 4 a ray-traced projector record, 8 its position lies inside an
// avatar's PADDED bounds (mvAvHolds: the sphere AND a joint cluster / the attachment box -- a lamp within MV_JOINT_PAD
// of a joint counts, so this is "near an avatar", not "worn"; the host's log names worn lights from the light list)
uint mvLightInfo(uint li, Light L)
{
    const bool proj = L.proj_origin.w > 0.5;
    const vec3 X = proj ? L.proj_origin.xyz : L.pos_radius.xyz;
    uint f = 1u | (proj ? 2u : 0u) | ((L.tex.z != 0u && L.tex.z - 1u < uint(pshadow.length())) ? 4u : 0u);
    const uint na = mvAvCount();
    for (uint m = 0u; m < na; ++m)
        if (mvAvHolds(m, X)) { f |= 8u; break; }
    if (!proj) f |= min(uint(max(L.proj_axis.x, 0.0) * 1000.0 + 0.5), 0xFFFFu) << 16u;
    return f;
}
// light li's identity for the log (the first texel of the frame to count it writes it): kind, record, range, position,
// disc, near an avatar, its split id (the host's key to the light's object)
void mvStatInfo(uint li, Light L)
{
    if (!g_mv_stats || li >= MV_LST_N) return;
    const uint b = MV_LST + li * MV_LST_W;
    if (mv[b + 4u] != 0u || atomicCompSwap(mv[b + 4u], 0u, 1u) != 0u) return;
    const uint f = mvLightInfo(li, L) & 0xFFFFu;
    const vec3 X = L.proj_origin.w > 0.5 ? L.proj_origin.xyz : L.pos_radius.xyz;
    mv[b + 5u] = floatBitsToUint(L.pos_radius.w);
    mv[b + 6u] = floatBitsToUint(X.x); mv[b + 7u] = floatBitsToUint(X.y); mv[b + 8u] = floatBitsToUint(X.z);
    mv[b + 9u] = floatBitsToUint(mvLightRadius(L));
    mv[b + 13u] = L.tex.w;   // (its split id: the host maps it back to the light's object -- local id, worn by whom)
    atomicOr(mv[b + 4u], f);
}
// (stats frames) one static-weight trace of light li: [11] traces, [12] ... that saw static light (Vs > 0)
void mvStatVs(uint li, vec3 vs)
{
    mvStat(li, 11u, 1u);
    mvStat(li, 12u, any(greaterThan(vs, vec3(0.0))) ? 1u : 0u);
}
// The stochastic path's lights (pass 15's set): the ray-traced projector records always; on a ReSTIR frame
// also the point lights and the record-less projectors IN PASS 15's LIGHT SET (LightInfo.rs_set = the ReSTIR
// header's rs_set: clean_deferred_light.comp deferRsStoch's rsInSet). Before, every point light and record-less
// projector counted: in radiance mode a light pass 15 does not carry (the lit pass shades it on its own) weighed
// into the radiance mode's pooled ratio -- a mover blocking IT darkened the stochastic radiance of the OTHER lights, and in
// a region no carried light reaches a faint mover shadow appeared that the ratio mode never shows (2026-11-11, the
// owner's radiance-only avatar shapes inside a projector's static shadow). (The grid bound -- deferRsStoch's
// regirCell -- is not tested here: past the grid the lit pass falls back for every light at once.)
bool mvRsInSet(uint li)
{
    return li < 256u && (linfo.rs_set[li >> 7u][(li >> 5u) & 3u] & (1u << (li & 31u))) != 0u;
}
bool mvLightEligible(Light L, uint li)
{
    if (L.tex.z != 0u && L.tex.z - 1u < uint(pshadow.length()))
    {
        const vec4 sp = pshadow[L.tex.z - 1u].params;
        if (sp.w > 0.5 && sp.z > 1.5) return true;
        if (sp.w > 0.5) return false;   // (a shadow-mapped record: not the stochastic path's)
    }
    return rsFrameOn() && (L.proj_origin.w < 0.5 || L.tex.z == 0u) && mvRsInSet(li);
}
// THE MOVER PATH'S LIGHTS AT A TEXEL, LOSSLESS (2026-11-12, the owner: an avatar lost its point-light shadow
// ENTIRELY once the camera zoomed out past ~5-10 m, and got it back zooming in -- light and avatar unchanged).
// The light cluster list (clean_lights.comp) holds at most CLUSTER_CAP lights, in the camera's importance order
// (shadowed projectors first); past it a light is simply not listed (cluster_count bits 16-31 still count it).
// The lighting never reads that list for these lights -- pass 15 samples its own set (rs_set, the ReGIR grid) and
// the deferred lighting walks uncapped tile lists -- so a light the cap dropped kept its light and its STATIC
// shadow (pass 15), while the mover rays here, which walked the capped list, never traced the avatar against it:
// that light's avatar shadow gone. Zooming out thickens the receiver's depth slice and widens its tile in world
// terms (more lights touch the cluster) and re-ranks the importance order, so the drop switched on at a camera
// distance (the lit guard's "light cluster overflow ... max count ~100" in the owner's scene). Now: a cluster
// that did NOT overflow is walked as before (its list is every light touching it); an OVERFLOWED one walks the
// whole light table, each light tested against the texel's own point (the cluster build's range sphere, a tighter
// test than the cluster's box). Either way the walk yields the lights in one fixed order, so the passes below
// agree on every light's position (their bitsets): the first CLUSTER_CAP lights that reach the texel itself --
// far more than the cluster ever listed for it (a texel is a point, the cluster a slab of space).
// elig: only the stochastic path's lights (mvLightEligible); else every light in range (the cull's reach). The two
// are DIFFERENT orders: the passes' bitsets index only the elig walk's positions (keep the reach walk separate).
// Past CLUSTER_CAP positions (64 eligible lights reaching ONE point) the passes stop, as the capped list did.
// Cost: an overflowed cluster's texels walk the light table (<= 256, a range test each) instead of <= 64 entries.
bool mvClusterOverflow(uint c)
{
    return c < uint(cluster_count.length()) && clusterCandidates(cluster_count[c]) > CLUSTER_CAP;
}
uint mvNextLight(uint c, bool ovf, uint count, vec3 P, bool elig, inout uint cur)
{
    const uint nt = min(count, uint(lights.length()));
    const uint n = ovf ? nt : (c < uint(cluster_count.length()) ? clusterLen(cluster_count[c]) : 0u);
    while (cur < n)
    {
        uint li = cur++;
        if (!ovf)
        {
            const uint ci = c * CLUSTER_CAP + li;
            if (!RTG_OK(ci < uint(cluster_index.length()), RTG_LIGHT, ci, uint(cluster_index.length())))
            { cur = n; break; }
            li = cluster_index[ci];
        }
        if (li >= nt) continue;
        const vec4 pr = lights[li].pos_radius;
        if (!(length(pr.xyz - P) < pr.w)) continue;
        if (elig && !mvLightEligible(lights[li], li)) continue;
        return li;
    }
    return 0xFFFFFFFFu;
}
// (the mover probe / the host's log line) light li is in cluster c's capped list
bool mvInClusterList(uint c, uint li)
{
    const uint n = c < uint(cluster_count.length()) ? clusterLen(cluster_count[c]) : 0u;
    for (uint i = 0u; i < n; ++i)
    {
        const uint ci = c * CLUSTER_CAP + i;
        if (ci >= uint(cluster_index.length())) break;
        if (cluster_index[ci] == li) return true;
    }
    return false;
}
// Its unshadowed light at P (the ratio weight: a projector's gobo x attenuation -- the exact path's REST
// weight --, a point light's colour x attenuation x the facet's N.l), the point its rays aim at (X) and
// whether the receiver faces away from it beyond normal-map slack (turned: the lighting's facing gate gives
// it nothing there -- no mover can change that, it stays out of every ratio). False: no light here.
// THE TERMINATOR (#664; the exact path's per-light rule above, for EVERY light kind -- point lights too): in
// the light's band the shared probe (rtTerminatorCached: one per texel for all lights) gives the exact facet
// (png), the SMOOTH shading normal (pns) and the Hanika lift (plift); the smooth normal decides the facing
// gate and weighs the light, and the caller hands the lift to the ray (rt_term_*: clean_shadow_rt.glsl
// rtPosOriginSetup) -- the static RT shadow rays' receiver rules exactly (projShadowRayCore's).
// (+ g_mv_base: the light without the receiver's N.l -- the specular weights' factor; g_mv_nshade: the smooth
//  shading normal it used; g_mv_l: the direction to the light)
vec3 g_mv_base = vec3(0.0), g_mv_nshade = vec3(0.0, 0.0, 1.0), g_mv_l = vec3(0.0, 0.0, 1.0);
float g_mv_nl = 0.0;   // (RenderVKMoverProbePixel) the smooth (or depth-plane) N.l mvLightWeight last weighed
bool mvLightWeight(Light L, vec3 P, vec3 Ng, vec3 cam, ivec2 rp, out vec3 w, out vec3 X, out bool turned,
                   out bool pterm, out vec3 plift, out vec3 pns, out vec3 png)
{
    w = vec3(0.0); X = P; turned = false;
    g_mv_nl = 0.0;
    pterm = false; plift = vec3(0.0); pns = vec3(0.0); png = vec3(0.0);
    vec3 lv;
    float dist;
    const float atten = lightReach(L.pos_radius, L.color_falloff, P, lv, dist);
    if (atten <= 0.0) return false;
    vec2 ptc = vec2(0.0);
    if (L.proj_origin.w > 0.5)
    {
        if (!lightProjFrustum(L.proj_mat, P, ptc)) return false;
        X = L.proj_origin.xyz;
    }
    else X = L.pos_radius.xyz;
    const vec3 l = normalize(X - P);
    // THE RECEIVER'S TRIANGLE AT EVERY ORIENTATION (2026-11-10): the facing gate and the weight take the SMOOTH
    // normal whenever the triangle is known, not only in the band. Outside it they took the depth-plane normal Ng
    // -- one value per flat facet: on a low-poly avatar each facet weighed the lights differently and a light
    // dropped out of the ratio facet by facet (Ng.l <= -0.5 is "turned" while the next facet, in the band, kept it
    // by its smooth normal), so wherever any light was mover-blocked the ratio sum w Vs Vm / sum w Vs stepped at
    // every facet edge: flat, straight-edged light / dark patches over a smooth body. The probe is per texel
    // (rtTerminatorCached: shared by every light); the LIFT stays the band's (the rays' origin rules unchanged).
    vec3 tlift, tns, tng;
    const bool tri = rtTerminatorOn() && rtTerminatorCached(P, cam, Ng, RT_TERM_MASK_COS, rp, tlift, tns, tng);
    pterm = tri && rtTerminatorBand(dot(Ng, l));
    if (pterm) { plift = tlift; pns = tns; png = tng; }
    turned = (tri ? max(dot(tns, l), dot(tng, l)) : dot(Ng, l)) < -0.25;
    const float nl = tri ? dot(tns, l) : dot(Ng, l);   // (the lit pass shades by the smooth normal)
    g_mv_nshade = tri ? tns : Ng;
    g_mv_l = l;
