    uint cBits = 0u, cBlk = 0u;
    vec3 cW[4], cWs[4], qW[4], qWs[4];
    for (uint i = 0u; i < 4u; ++i)
    {
        const bool ci = i < g_fc_n, qi = i < g_fq_n;
        cW[i] = ci ? g_fc_w[i] : vec3(0.0);
        cWs[i] = ci ? g_fc_w[i] * g_fc_vs[i].rgb : vec3(0.0);
        qW[i] = qi ? g_fq_w[i] : vec3(0.0);
        qWs[i] = qi ? g_fq_w[i] * g_fq_vs[i].rgb : vec3(0.0);
        if (ci && dot(g_fc_vs[i].rgb, lw) < MV_VS_FULL) cBits |= 1u << i;
        if (ci && g_fc_blk[i]) cBlk |= 1u << i;
    }
    const uint plan = mvFoldPlan(g_fc_n, cBlk, g_fc_blkOver, cBits, g_fq_n, g_fu_w, g_fu_ws, cW, cWs, qW, qWs);
    g_fold_plan = plan;
