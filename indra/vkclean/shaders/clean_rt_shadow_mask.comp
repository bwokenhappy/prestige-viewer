// a traced light (Vm, Vs known; Vm 1 for one no mover blocks; hit: a mover lies in front of it): the U sums + its list
void mvFoldTraced(uint li, vec4 vm, vec4 vs, vec3 w, bool dyn, bool hit)
{
    const vec3 lw = vec3(0.2126, 0.7152, 0.0722);
    g_fu_w += w; g_fu_ws += w * vs.rgb; g_fu_wsm += w * vs.rgb * vm.rgb;
    const float sl = dot(w * (vec3(1.0) - vs.rgb), lw);
    if (vs.a >= 0.0 && sl > 0.0) { g_fu_sr += sl * vs.a; g_fu_srw += sl; }
    const float vl = dot(vs.rgb, lw);
    if (hit && vl > MV_VS_OUT) mvFoldKeepC(li, vm, vs, w, dyn, any(lessThan(vm.rgb, vec3(1.0))));
    else if (vl < MV_VS_FULL) mvFoldKeepQ(li, vs, w, vm.rgb);
