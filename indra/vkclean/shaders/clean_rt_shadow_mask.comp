        g_fc_li[j] = g_fc_li[j - 1u]; g_fc_vm[j] = g_fc_vm[j - 1u]; g_fc_vs[j] = g_fc_vs[j - 1u];
        g_fc_w[j] = g_fc_w[j - 1u]; g_fc_dyn[j] = g_fc_dyn[j - 1u]; g_fc_blk[j] = g_fc_blk[j - 1u];
        --j;
    }
    g_fc_li[j] = li; g_fc_vm[j] = vm; g_fc_vs[j] = vs; g_fc_w[j] = w; g_fc_dyn[j] = dyn; g_fc_blk[j] = blk;
}
void mvFoldKeepQ(uint li, vec4 vs, vec3 w, vec3 vm)
{
    ++g_fq_tot;
    uint j = g_fq_n;
    if (j == 4u) { if (li > g_fq_li[3]) return; j = 3u; } else ++g_fq_n;
    while (j > 0u && g_fq_li[j - 1u] > li)
