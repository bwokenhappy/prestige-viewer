// THE U SET still needs its D share: some light left in it is in a static shadow (a channel's sum w Vs below 1 - 1/2
// of an 8-bit step of its sum w) -- never when nothing is left (rw within 1e-6 of the traced weight: the explicit
// lights' float cancellation; a D share there costs a slot, never the image -- the pixel's U set is then empty).
bool mvFoldDNeed(vec3 rw, vec3 rws, vec3 uW)
{
    const vec3 lw = vec3(0.2126, 0.7152, 0.0722);
    const float rl = dot(rw, lw);
    if (!(rl > 1e-6 * dot(uW, lw)) || !(rl > 1e-12)) return false;
    for (int ch = 0; ch < 3; ++ch)
        if (rw[ch] > 1e-3 * rl && rws[ch] < 0.998 * rw[ch]) return true;
    return false;
}
// THE SLOT PLAN (4 slots): p explicit C lights (lowest index first; each its Vm slot + its Vs slot where cBits says so),
// then q Q lights (a Vs slot each), then N (a mover-BLOCKED light is left in U: a cBlk bit at or past p, or one past the
// 4 kept -- blkOver) and D (mvFoldDNeed of what is left). The most C lights that fit, then the most Q lights that still
// leave D its slot (or make it unneeded). Returns p | q << 4 | N << 8 | D << 9. p = 0 always fits (N + D + 2 Q).
uint mvFoldPlan(uint nC, uint cBlk, bool blkOver, uint cBits, uint nQ, vec3 uW, vec3 uWs, vec3 cW[4], vec3 cWs[4],
                vec3 qW[4], vec3 qWs[4])
{
    for (int pp = int(nC); pp >= 0; --pp)
    {
        const uint p = uint(pp);
        uint used = 0u;
        vec3 rw = uW, rws = uWs;
        for (uint i = 0u; i < p; ++i) { used += 1u + ((cBits >> i) & 1u); rw -= cW[i]; rws -= cWs[i]; }
        const uint n = ((cBlk >> p) != 0u || blkOver) ? 1u : 0u;
        if (used + n > 4u) continue;
        const uint left = 4u - used - n;
        uint q = 0u;
        for (;;)
        {
            if (!mvFoldDNeed(rw, rws, uW)) return p | (q << 4u) | (n << 8u);
            if (q < nQ && left >= q + 1u)
            {
                const vec3 rw2 = rw - qW[q], rws2 = rws - qWs[q];
                if (left >= q + 2u || !mvFoldDNeed(rw2, rws2, uW)) { rw = rw2; rws = rws2; ++q; continue; }
            }
            if (left >= q + 1u) return p | (q << 4u) | (n << 8u) | 512u;
            break;
        }
    }
    return ((cBlk != 0u || blkOver) ? 256u : 0u) | 512u;
}
// (RenderVKMoverProbePixel) the fold's light lists at the probed texel (clean_rt_mover_probe.glsl RTP_M_FOLDL): which
// lights were explicit-slot candidates (C), Vs-slot candidates (Q) and unblocked hit lights (H); path 1 mvFoldWrite,
// 2 mvFoldWriteHit (no blocked light any static light reaches: no Vm < 1 slot at all -- the pixel reads factor 1).
void mvProbeFoldLists(uint path, uint cBits, uint cBlk)
{
    for (uint i = 0u; i < 4u; ++i)
    {
        rtpPut(RTP_M_FOLDL + i, i < g_fc_n ? g_fc_li[i] + 1u : 0u);
        rtpPut(RTP_M_FOLDL + 4u + i, i < g_fq_n ? g_fq_li[i] + 1u : 0u);
    }
    rtpPut(RTP_M_FOLDL + 8u, g_fc_n | (g_fq_n << 4u) | (g_fh_n << 8u) | (g_fc_blkOver ? 4096u : 0u) | ((cBits & 15u) << 16u)
                           | ((cBlk & 15u) << 20u) | (path << 28u));
    uint h = 0u;
    for (uint i = 0u; i < g_fh_n; ++i) h |= min(g_fh_li[i] + 1u, 255u) << (8u * i);
    rtpPut(RTP_M_FOLDL + 9u, h);
}
// The plan's slots into the texel's (k = 0 on entry: the radiance packing has no own slot). rpr: the blocked lights'
// penumbra radius (the N share's), ndyn: a moving caster blocks one of them. Returns the slots written.
uint mvFoldWrite(inout vec4 slotV[4], inout uvec4 ids, inout uint dyn, float rpr, bool ndyn)
{
