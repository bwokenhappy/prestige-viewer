        g_fq_li[j] = g_fq_li[j - 1u]; g_fq_vs[j] = g_fq_vs[j - 1u]; g_fq_w[j] = g_fq_w[j - 1u]; g_fq_vm[j] = g_fq_vm[j - 1u];
        --j;
    }
    g_fq_li[j] = li; g_fq_vs[j] = vs; g_fq_w[j] = w; g_fq_vm[j] = vm;
}
void mvFoldKeepH(uint li)
{
    uint j = g_fh_n;
    if (j == 4u) { if (li > g_fh_li[3]) return; j = 3u; } else ++g_fh_n;
    while (j > 0u && g_fh_li[j - 1u] > li) { g_fh_li[j] = g_fh_li[j - 1u]; --j; }
    g_fh_li[j] = li;
