#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_control_flow_attributes : require
// vkclean -- VOLUMETRIC FOG (#718), pass 3/4: TEMPORAL REPROJECTION (our own; it never
// relies on TAA / FSR to converge the fog).
//
// The light pass sampled every cell at ONE jittered point (Halton xyz per frame, rotated per
// cell), with ONE cascade tap: a noisy, aliased estimate on its
// own. Here each cell blends it into its history: exponential moving average, history
// weight p0.x (~0.9: ~10 frames to converge, the jitter integrated into a supersampled,
// soft-shadowed result).
//   * REPROJECTION: the cell's centre (unjittered) in this frame's camera-relative world ->
//     last frame's grid clip (push reproj, built in double on the CPU around the eye delta)
//     -> last frame's (uv, slice) -> a TRILINEAR tap of last frame's history. Off the grid
//     (newly revealed at the screen edge / in front of the near slices): no history.
//   * HISTORY REJECTION / ANTI-LAG: the history is clamped to the min / max box of this
//     frame's estimate over the cell's 3 x 3 neighbourhood in its slice and its two depth
//     neighbours (11 cells), widened by p0.z x its extent. The cells sample decorrelated points
//     of their jitter / pick sequences (clean_vol_pass.glsl volCellRotation, #1606), so the box
//     spans the sampling noise and a converged history survives it; a real change -- a light
//     switched on / off, a moving shadow, a local volume moving or changing density -- falls
//     outside it and the history follows within a frame or two instead of ghosting. A moving
//     volume still trails by about the box tolerance: say so, don't hide it. (Before #1606 the
//     whole grid shared one jitter phase per frame: the 7-cell box held only that phase and
//     clamped the history back to it every frame -- the fog crawled with the Halton cycle.)
//   * SPATIAL FALLBACK (#1606): no usable history (reset, a cell newly revealed at the screen
//     edge or in front of the near slices) takes the 3 x 3 tent-filtered estimate of its slice
//     instead of its single sample (std x ~0.38), so a disocclusion band starts as a soft
//     estimate, not as raw one-sample noise.
//   * AMBIENT SKY VISIBILITY (physical mode, uHeightCurrent.a; clean_vol_light.comp): a binary,
//     purely geometric sample, accumulated twice as long as the rest (history weight 1 - (1 -
//     p0.x) / 2) and never clamped: the 11-cell box of a sparse binary signal (a room that sees
//     the sky through one window) is usually all 0 and reset the history to it.
//   * RESET (p0.y = 1): first frame, grid resize / tier change, camera cut / teleport
//     (the renderer's temporal reset), camera jump: this frame's estimate only.
// rgb = in-scatter per metre, a = sigma_t: both filtered (the injection's jitter makes the
// extinction of a noise-shaped volume noisy too).
//
// push p0: x history weight [0, 0.98], y 1 = reset, z clamp widening (fraction of the box), w 0.
layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

#define CLEAN_MEDIUM_PASS
#include "clean_frame_info.glsl"
#include "clean_atmos_common.glsl"
#include "clean_vol_common.glsl"
#include "clean_vol_pass.glsl"

layout(set = VOL_SET, binding = 0, rgba16f) readonly uniform image3D uCur;
layout(set = VOL_SET, binding = 2) uniform sampler3D uHistPrev;
layout(set = VOL_SET, binding = 3, rgba16f) writeonly uniform image3D uHistCur;

layout(set=VOL_SET,binding=7,rgba16f) readonly uniform image3D uHeightCurrent;
layout(set=VOL_SET,binding=11,rgba16f) writeonly uniform image3D uHeightHistory;
layout(set=VOL_SET,binding=12) uniform sampler3D uHeightPrev;

// The 3 x 3 in-slice tent weights (4 centre, 2 edge, 1 corner) / 16 and the 11-cell box.
const ivec3 kNb[11] = ivec3[11](ivec3(0, 0, 0), ivec3(1, 0, 0), ivec3(-1, 0, 0), ivec3(0, 1, 0), ivec3(0, -1, 0),
                                ivec3(1, 1, 0), ivec3(-1, 1, 0), ivec3(1, -1, 0), ivec3(-1, -1, 0),
                                ivec3(0, 0, 1), ivec3(0, 0, -1));
const float kTent[11] = float[11](0.25, 0.125, 0.125, 0.125, 0.125, 0.0625, 0.0625, 0.0625, 0.0625, 0.0, 0.0);

void main()
{
    const uvec3 c = gl_GlobalInvocationID;
    const uvec3 dims = volDims();
    if (any(greaterThanEqual(c, dims))) return;
    const ivec3 ic = ivec3(c);
    const bool cm = cmOn();
    const ivec3 hi = ivec3(dims) - 1;
    // This frame's neighbourhood: box (min / max) and the in-slice tent mean, of both estimates.
    vec4 cur = vec4(0.0), height = vec4(0.0);
    vec4 mn = vec4(1e30), mx = vec4(-1e30), hmn = vec4(1e30), hmx = vec4(-1e30);
    vec4 curS = vec4(0.0), heightS = vec4(0.0);
    [[unroll]] for (int k = 0; k < 11; ++k)
    {
        const ivec3 q = clamp(ic + kNb[k], ivec3(0), hi);
        const vec4 s = imageLoad(uCur, q);
        const vec4 h = cm ? imageLoad(uHeightCurrent, q) : vec4(0.0);
        if (k == 0) { cur = s; height = h; }
        mn = min(mn, s); mx = max(mx, s);
        hmn = min(hmn, h); hmx = max(hmx, h);
        curS += kTent[k] * s; heightS += kTent[k] * h;
    }
    vec4 outv = curS;
    vec4 heightOut = heightS;
    if (vp.p0.y < 0.5 && vp.p0.x > 0.0)
    {
        const vec3 rel = volRelPos(vec3(c) + 0.5);
        const vec4 pc = vp.reproj * vec4(rel, 1.0);
        bool ok = pc.w > 1e-4;
        vec3 tc = vec3(0.0);
        if (ok)
        {
            tc.xy = pc.xy / pc.w * 0.5 + 0.5;
            if(cm)
            {
                const CameraMediumView view=ssr.medium[MEDIUM_EYE];
                const mat4 previousProjection=ssr.views[MEDIUM_EYE].prev_proj;
                const bool ortho=abs(previousProjection[3][3])>0.5;
                const vec4 ray=ssr.views[MEDIUM_EYE].prev_inv_proj*vec4(tc.xy*2.0-1.0,0.5,1.0);
                const vec3 direction=normalize(ray.xyz/ray.w);
                const float factor=ortho ? 1.0 : max(-direction.z,1e-5);
                const float previousDepth=ortho ? (previousProjection[3][2]-pc.z)/previousProjection[2][2] : pc.w;
                tc.z=cmSliceMapping(previousDepth,factor,view.mapping.y,view.mapping.z,max(view.mapping.w,1e-4));
                ok=previousDepth>=0.0 && previousDepth<=view.mapping.z;
            }
            else tc.z = volSliceOfDepth(pc.w);
            ok = ok && all(greaterThanEqual(tc, vec3(0.0))) && all(lessThanEqual(tc, vec3(1.0)));
        }
        if (ok)
        {
            const float w = clamp(vp.p0.x, 0.0, 0.98);
            vec4 hist = textureLod(uHistPrev, tc, 0.0);
            const vec4 widen = (mx - mn) * vp.p0.z;
            hist = clamp(hist, mn - widen, mx + widen);
            outv = (!any(isnan(hist)) && !any(isinf(hist))) ? mix(cur, hist, w) : cur;
            if(cm)
            {
                const vec4 heightHist=textureLod(uHeightPrev,tc,0.0);
                heightOut=height;
                if(!any(isnan(heightHist)) && !any(isinf(heightHist)))
                {
                    const vec3 hw=(hmx.rgb-hmn.rgb)*vp.p0.z;
                    heightOut.rgb=mix(height.rgb,clamp(heightHist.rgb,hmn.rgb-hw,hmx.rgb+hw),w);
                    heightOut.a=mix(height.a,clamp(heightHist.a,0.0,1.0),1.0-(1.0-w)*0.5);
                }
            }
        }
    }
    imageStore(uHistCur, ic, max(outv, vec4(0.0)));
    if(cm) imageStore(uHeightHistory,ic,max(heightOut,vec4(0.0)));
}
